{
  "name": "@contentfn/client",
  "version": "0.2.0",
  "description": "Typed browser and Node HTTP client for ContentFn",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "author": "21n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "contentfn/client"
  },
  "publishConfig": {
    "access": "public"
  },
  "superfunctions": {
    "initFunction": "contentFn",
    "schemaVersion": 1,
    "namespace": "contentfn"
  },
  "scripts": {
    "build": "tsup",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "keywords": [
    "contentfn",
    "client"
  ],
  "sideEffects": false,
  "dependencies": {
    "@contentfn/core": "0.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
