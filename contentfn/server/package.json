{
  "name": "@contentfn/server",
  "version": "0.0.2",
  "description": "ContentFn server - HTTP endpoints and storage",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "author": "21n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "contentfn/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "superfunctions": {
    "initFunction": "contentFn",
    "schemaVersion": 1,
    "namespace": "contentfn"
  },
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "engines": {
    "node": ">=20 <25"
  },
  "keywords": [
    "contentfn",
    "server",
    "storage"
  ],
  "sideEffects": false,
  "dependencies": {
    "@contentfn/core": "0.0.2",
    "@mdfn/markdown": "0.1.0",
    "@mdfn/extensions": "0.1.0",
    "@mdfn/contentfn": "0.1.0",
    "@superfunctions/db": "0.1.4",
    "@superfunctions/http": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "^24.9.1",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
