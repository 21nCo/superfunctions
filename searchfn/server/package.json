{
  "name": "@searchfn/server",
  "version": "0.1.0",
  "description": "Server SDK for SearchFn - Full text search for DataFn",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "test": "vitest"
  },
  "dependencies": {
    "@superfunctions/http": "workspace:*",
    "@superfunctions/db": "workspace:*",
    "@datafn/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "tsup": "^8.0.0",
    "vitest": "^1.0.0"
  }
}
