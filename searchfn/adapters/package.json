{
  "name": "@searchfn/adapters",
  "version": "0.3.0",
  "description": "SearchAdapter interface and built-in adapters (Memory, IndexedDB) for searchfn.",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "test": "npm run test:unit && npm run benchmark",
    "test:unit": "node ./scripts/run-vitest.mjs",
    "test:integration": "vitest run --config vitest.integration.config.ts --runInBand",
    "test:integration:matrix": "node ./scripts/run-integration-matrix.mjs",
    "benchmark": "node ./scripts/run-vitest.mjs run --config vitest.benchmark.config.ts --runInBand",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run lint && npm run build"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "keywords": [
    "search",
    "adapter",
    "full-text-search",
    "browser",
    "bm25",
    "memory",
    "indexeddb"
  ],
  "author": "21n",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "searchfn/adapters"
  },
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "@searchfn/core": "file:../core",
    "pg": "^8.17.2"
  },
  "devDependencies": {
    "@types/pg": "^8.15.4",
    "@types/node": "^24.9.1",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "eslint": "^9.38.0",
    "eslint-config-prettier": "^10.1.8",
    "fake-indexeddb": "^6.2.4",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
