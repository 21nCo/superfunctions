{
  "name": "@plugfn/providers",
  "version": "0.0.4",
  "description": "First-party provider implementations for PlugFn",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./github": {
      "types": "./dist/github/index.d.ts",
      "default": "./dist/github/index.js"
    },
    "./github-app": {
      "types": "./dist/github-app/index.d.ts",
      "default": "./dist/github-app/index.js"
    },
    "./linear": {
      "types": "./dist/linear/index.d.ts",
      "default": "./dist/linear/index.js"
    },
    "./gmail": {
      "types": "./dist/gmail/index.d.ts",
      "default": "./dist/gmail/index.js"
    },
    "./notion": {
      "types": "./dist/notion/index.d.ts",
      "default": "./dist/notion/index.js"
    },
    "./clickup": {
      "types": "./dist/clickup/index.d.ts",
      "default": "./dist/clickup/index.js"
    },
    "./google-drive": {
      "types": "./dist/google-drive/index.d.ts",
      "default": "./dist/google-drive/index.js"
    },
    "./google-docs": {
      "types": "./dist/google-docs/index.d.ts",
      "default": "./dist/google-docs/index.js"
    },
    "./google-sheets": {
      "types": "./dist/google-sheets/index.d.ts",
      "default": "./dist/google-sheets/index.js"
    },
    "./google-calendar": {
      "types": "./dist/google-calendar/index.d.ts",
      "default": "./dist/google-calendar/index.js"
    },
    "./jira": {
      "types": "./dist/jira/index.d.ts",
      "default": "./dist/jira/index.js"
    },
    "./onedrive": {
      "types": "./dist/onedrive/index.d.ts",
      "default": "./dist/onedrive/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run && vitest run --config vitest.workerd.config.ts",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "test:node": "vitest run",
    "test:workerd": "vitest run --config vitest.workerd.config.ts"
  },
  "author": "21n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/superfunctions.git",
    "directory": "plugfn/providers"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@superfunctions/oauth-providers": "0.1.1",
    "imapflow": "^1.7.0",
    "jose": "^5.10.0",
    "plugfn": "0.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.4",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4",
    "zod-to-json-schema": "^3.25.2"
  }
}
