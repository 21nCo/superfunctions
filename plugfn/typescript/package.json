{
  "name": "plugfn",
  "version": "0.0.1",
  "description": "Self-hosted integration platform for developers - Connect your apps to the world",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "integrations",
    "oauth",
    "webhooks",
    "api",
    "superfunctions",
    "zapier",
    "self-hosted"
  ],
  "author": "21n",
  "license": "MIT",
  "dependencies": {
    "@superfunctions/http": "*",
    "@superfunctions/db": "*",
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "@superfunctions/db": "*"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2",
    "vitest": "^1.0.4"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "plugfn"
  },
  "publishConfig": {
    "access": "public"
  },
  "superfunctions": {
    "initFunction": "plugFn",
    "schemaVersion": 1,
    "namespace": "plugfn"
  }
}
