{
  "name": "plugfn",
  "version": "0.2.1",
  "description": "Self-hosted integration platform for developers",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "clean": "rm -rf dist",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:ui": "vitest --ui",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "integrations",
    "oauth",
    "webhooks",
    "api",
    "superfunctions",
    "zapier",
    "self-hosted"
  ],
  "author": "21n",
  "license": "MIT",
  "dependencies": {
    "@superfunctions/oauth-core": "0.2.1",
    "@superfunctions/oauth-flow": "0.1.1",
    "@superfunctions/oauth-http": "0.2.1",
    "@superfunctions/oauth-providers": "0.1.1",
    "@superfunctions/oauth-storage": "0.1.1",
    "@superfunctions/auth": "0.2.1",
    "@superfunctions/envelope": "0.0.2",
    "@superfunctions/errors": "0.0.2",
    "@superfunctions/http": "0.2.0",
    "@superfunctions/metrics": "0.1.1",
    "@superfunctions/middleware": "0.3.1",
    "@superfunctions/queue": "0.2.0",
    "@superfunctions/webhooks": "0.1.1",
    "@superfunctions/db": "0.3.2",
    "zod": "^3.22.4"
  },
  "peerDependencies": {
    "@superfunctions/db": "0.3.2"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "eslint": "^8.54.0",
    "prettier": "^3.1.0",
    "typescript": "^5.3.2",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/superfunctions.git",
    "directory": "plugfn/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "superfunctions": {
    "initFunction": "plugFn",
    "schemaVersion": 6,
    "namespace": "plugfn"
  }
}
