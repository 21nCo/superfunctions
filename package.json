{
  "name": "superset",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Building blocks for software development",
  "workspaces": [
    "docs",
    "contentfn/*",
    "searchfn/*",
    "botfn/*",
    "hostfn/*",
    "authfn/*",
    "browsefn/*",
    "cachefn/*",
    "datafn/*",
    "datafn/examples/todo-app/*",
    "flowfn/*",
    "logfn/*",
    "sendfn/*",
    "packages/*",
    "21n/*",
    "uifn/*",
    "memoryfn/*",
    "watchfn/*",
    "secfn/*",
    "plugfn/*",
    "testfn/*",
    "langfn/*",
    "catchfn/*",
    "chartfn/*",
    "clifn/*",
    "docsfn/*",
    "drawfn/*",
    "filefn/*",
    "filefn/examples/full-demo/*",
    "filefn/examples/production/*",
    "iconfn/*",
    "userfn/*",
    "cifn/typescript/*",
    "compfn",
    "cmsfn/*",
    "recfn/*",
    "recfn/platforms/*",
    "recfn/adapters/*",
    "apifn/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "clean": "turbo run clean && rm -rf node_modules",
    "check:duplication": "node scripts/check-duplication.mjs",
    "gate:audit-fix-o4u9k2m7": "node scripts/gate-audit-fix-o4u9k2m7.mjs",
    "verify:uifn-release": "node scripts/verify-uifn-release.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.4",
    "@types/node": "^20.0.0",
    "@vitest/ui": "^3.2.4",
    "fast-glob": "^3.3.3",
    "jscpd": "^4.0.5",
    "msw": "^2.11.6",
    "prettier": "^3.0.0",
    "turbo": "^2.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "author": "21n",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git"
  },
  "bugs": {
