{
  "name": "@mcpfn/core",
  "version": "0.1.0",
  "description": "Protocol-correct MCP runtime, tool registry, manifests, and compatibility diffing",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./openapi": {
      "import": { "types": "./dist/openapi.d.ts", "default": "./dist/openapi.js" },
      "require": { "types": "./dist/openapi.d.cts", "default": "./dist/openapi.cjs" }
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsup && node scripts/verify-bundled-zod.mjs && node ../../scripts/verify-mcpfn-bundled-sdk.mjs",
    "clean": "node --input-type=module -e \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.6",
    "@modelcontextprotocol/sdk": "1.32.2",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "fast-uri": "3.1.9"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.11",
    "@types/node": "^20.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "zod": "4.6.6"
  },
  "engines": { "node": ">=18.18.0" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/superfunctions.git",
    "directory": "mcpfn/core"
  },
  "publishConfig": { "access": "public" },
  "sideEffects": false
}
