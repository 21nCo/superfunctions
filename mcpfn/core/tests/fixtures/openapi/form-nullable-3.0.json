{
  "openapi": "3.0.3",
  "info": {
    "title": "fixture",
    "version": "1.0.0"
  },
  "paths": {
    "/profiles": {
      "post": {
        "operationId": "createProfile",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nickname": {
                    "type": "string",
                    "nullable": true
                  },
                  "color": {
                    "type": "string",
                    "enum": [
                      "red",
                      "blue"
                    ],
                    "nullable": true
                  },
                  "shade": {
                    "type": "string",
                    "enum": [
                      "light",
                      null
                    ],
                    "nullable": true
                  },
                  "address": {
                    "nullable": true,
                    "allOf": [
                      {
                        "$ref": "#/components/schemas/Address"
                      }
                    ]
                  }
                },
                "required": [
                  "nickname"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Address": {
        "type": "object",
        "properties": {
          "city": {
            "type": "string"
          }
        },
        "required": [
          "city"
        ]
      }
    }
  }
}
