{
  "name": "@mcpfn/client",
  "version": "0.1.3",
  "description": "Production MCP client, target, session, lifecycle, and diagnostic engine for McpFn",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    },
    "./stdio": {
      "import": { "types": "./dist/stdio.d.ts", "default": "./dist/stdio.js" },
      "require": { "types": "./dist/stdio.d.cts", "default": "./dist/stdio.cjs" }
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#stdio-target": {
      "workerd": {
        "import": "./dist/stdio-unavailable.js",
        "require": "./dist/stdio-unavailable.cjs"
      },
      "worker": {
        "import": "./dist/stdio-unavailable.js",
        "require": "./dist/stdio-unavailable.cjs"
      },
      "edge-light": {
        "import": "./dist/stdio-unavailable.js",
        "require": "./dist/stdio-unavailable.cjs"
      },
      "browser": {
        "import": "./dist/stdio-unavailable.js",
        "require": "./dist/stdio-unavailable.cjs"
      },
      "node": { "import": "./dist/stdio.js", "require": "./dist/stdio.cjs" },
      "default": {
        "import": "./dist/stdio-unavailable.js",
        "require": "./dist/stdio-unavailable.cjs"
      }
    }
  },
  "files": ["dist", "!dist/.build-stamp.json", "README.md", "CHANGELOG.md"],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "node --input-type=module -e \"import('node:fs').then(({ rmSync }) => rmSync('dist', { recursive: true, force: true }))\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@modelcontextprotocol/sdk": "1.32.2"
  },
  "devDependencies": {
    "@hono/node-server": "2.1.11",
    "@mcpfn/core": "0.3.0",
    "@superfunctions/oauth-core": "0.1.1",
    "@types/node": "^20.0.0",
    "esbuild": "0.21.5",
    "miniflare": "4.20251113.0",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": { "node": ">=18.18.0" },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/superfunctions.git",
    "directory": "mcpfn/client"
  },
  "publishConfig": { "access": "public" },
  "sideEffects": false
}
