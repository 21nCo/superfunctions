{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cifn.superfunctions.dev/schemas/pipeline.schema.json",
  "title": "CiFn Pipeline Configuration",
  "type": "object",
  "required": ["on", "jobs"],
  "additionalProperties": false,
  "properties": {
    "name": { "type": "string" },
    "on": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "push": { "type": "object", "properties": { "branches": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
        "pull_request": { "type": "object", "properties": { "branches": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
        "schedule": { "oneOf": [ { "type": "object", "properties": { "cron": { "type": "string" } }, "required": [ "cron" ], "additionalProperties": false }, { "type": "array", "items": { "$ref": "#/$defs/cronEntry" } } ] },
        "workflow_dispatch": { "type": "object", "additionalProperties": false }
      }
    },
    "env": { "type": "object", "additionalProperties": { "type": "string" } },
    "jobs": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/job" } }
  },
  "$defs": {
    "cronEntry": { "type": "object", "properties": { "cron": { "type": "string" } }, "required": ["cron"], "additionalProperties": false },
    "job": { "type": "object", "required": ["runs-on", "steps"], "additionalProperties": false, "properties": { "runs-on": { "type": "string" }, "image": { "type": "string" }, "needs": { "type": "array", "items": { "type": "string" } }, "if": { "type": "string" }, "env": { "type": "object", "additionalProperties": { "type": "string" } }, "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } } } },
    "step": { "oneOf": [{ "$ref": "#/$defs/runStep" }, { "$ref": "#/$defs/checkoutStep" }, { "$ref": "#/$defs/cacheRestoreStep" }, { "$ref": "#/$defs/cacheSaveStep" }, { "$ref": "#/$defs/artifactUploadStep" }, { "$ref": "#/$defs/artifactDownloadStep" }, { "$ref": "#/$defs/testfnRunStep" }, { "$ref": "#/$defs/hostfnDeployStep" }] },
    "runStep": { "type": "object", "required": ["run"], "additionalProperties": false, "properties": { "run": { "type": "string" }, "if": { "type": "string" } } },
    "checkoutStep": { "type": "object", "required": ["uses"], "additionalProperties": false, "properties": { "uses": { "const": "checkout" }, "with": { "type": "object", "properties": { "repository": { "type": "string" }, "ref": { "type": "string" }, "token": { "type": "string" } }, "additionalProperties": false }, "if": { "type": "string" } } },
    "cacheRestoreStep": { "type": "object", "required": ["uses", "with"], "additionalProperties": false, "properties": { "uses": { "const": "cache/restore" }, "with": { "type": "object", "required": ["key"], "properties": { "key": { "type": "string", "maxLength": 1024 }, "paths": { "oneOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "string" }] }, "path": { "type": "string" } }, "additionalProperties": false }, "if": { "type": "string" } } },
    "cacheSaveStep": { "type": "object", "required": ["uses", "with"], "additionalProperties": false, "properties": { "uses": { "const": "cache/save" }, "with": { "type": "object", "required": ["key"], "properties": { "key": { "type": "string", "maxLength": 1024 }, "paths": { "oneOf": [{ "type": "array", "items": { "type": "string" } }, { "type": "string" }] }, "path": { "type": "string" } }, "additionalProperties": false }, "if": { "type": "string" } } },
    "artifactUploadStep": { "type": "object", "required": ["uses", "with"], "additionalProperties": false, "properties": { "uses": { "const": "artifact/upload" }, "with": { "type": "object", "required": ["name", "path"], "properties": { "name": { "type": "string", "maxLength": 256 }, "path": { "type": "string" } }, "additionalProperties": false }, "if": { "type": "string" } } },
    "artifactDownloadStep": { "type": "object", "required": ["uses", "with"], "additionalProperties": false, "properties": { "uses": { "const": "artifact/download" }, "with": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string", "maxLength": 256 }, "path": { "type": "string" } }, "additionalProperties": false }, "if": { "type": "string" } } },
    "testfnRunStep": { "type": "object", "required": ["uses"], "additionalProperties": false, "properties": { "uses": { "const": "testfn/run" }, "with": { "type": "object", "properties": { "framework": { "type": "string" }, "testPattern": { "type": "string" }, "reporter": { "type": "string" }, "outputPath": { "type": "string" } }, "additionalProperties": false }, "if": { "type": "string" } } },
    "hostfnDeployStep": { "type": "object", "required": ["uses", "with"], "additionalProperties": false, "properties": { "uses": { "const": "hostfn/deploy" }, "with": { "type": "object", "required": ["environment"], "properties": { "environment": { "type": "string" }, "ci": { "type": "boolean" } }, "additionalProperties": false }, "if": { "type": "string" } } }
  }
}
