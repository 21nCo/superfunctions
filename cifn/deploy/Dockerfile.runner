FROM node:20-slim AS builder

WORKDIR /build
COPY ../typescript/runner/package.json ./runner/package.json
COPY ../typescript/runner/tsconfig.json ./runner/tsconfig.json
COPY ../typescript/runner/tsup.config.ts ./runner/tsup.config.ts
COPY ../typescript/runner/src ./runner/src
COPY ../typescript/control-plane ./control-plane

WORKDIR /build/runner
RUN npm install --ignore-scripts
RUN npm run build

FROM node:20-slim

RUN apt-get update && apt-get install -y --no-install-recommends git && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /build/runner/dist ./dist
COPY --from=builder /build/runner/package.json ./package.json
COPY --from=builder /build/runner/node_modules ./node_modules

ENV NODE_ENV=production

CMD ["node", "dist/server.js"]
