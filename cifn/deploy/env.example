# =============================================================================
# CiFn Deployment Environment Variables
# Copy this file to .env and fill in the values before running docker compose.
# =============================================================================

# --- Required (control plane) ------------------------------------------------

# Comma-separated list of valid API keys for authenticating API requests.
# Store production keys in secfn; this env var seeds the memory adapter.
CIFN_API_KEYS=your-api-key-here

# Token used by runners to register with the control plane.
# Must match a value stored in secfn under key "cifn.runner.registration_token".
CIFN_RUNNER_REGISTRATION_TOKEN=your-registration-token

# --- Required (runner) -------------------------------------------------------

# Runner identity (returned by POST /api/v1/runners/register).
CIFN_RUNNER_ID=runner_example
CIFN_RUNNER_SECRET=rs_example

# --- Optional (runner) -------------------------------------------------------

# Comma-separated runner labels (default: "default").
CIFN_RUNNER_LABELS=default

# Polling interval in milliseconds (default: 5000).
CIFN_POLL_INTERVAL_MS=5000

# --- Optional (control plane) ------------------------------------------------

# Port the control plane listens on (default: 3100).
CIFN_PORT=3100

# GitHub webhook HMAC secret for signature verification.
CIFN_WEBHOOK_SECRET=

# --- Adapter selection --------------------------------------------------------
# Each adapter can be "memory" (default, for dev/smoke) or "real" (production).

CIFN_QUEUE_ADAPTER=memory
CIFN_ARTIFACTS_ADAPTER=memory
CIFN_SECRETS_ADAPTER=memory
CIFN_LOGS_ADAPTER=memory

# --- Production adapter URLs (required when corresponding adapter = "real") ---

# flowfn queue
FLOWFN_BASE_URL=
FLOWFN_API_KEY=

# filefn artifacts
FILEFN_BASE_URL=
FILEFN_API_KEY=

# secfn secrets
SECFN_BASE_URL=
SECFN_API_KEY=
SECFN_VAULT_PATH=

# logfn logs
LOGFN_BASE_URL=
LOGFN_API_KEY=
LOGFN_SINK=
