{
  "name": "@cifn/runner",
  "version": "0.0.3",
  "description": "CiFn runner - executes CI/CD pipeline jobs",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "test:remote": "vitest run src/remote-runner.test.ts && tsc -p tsconfig.remote.json"
  },
  "author": "21n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "cifn/typescript/runner"
  },
  "publishConfig": {
    "access": "public"
  },
  "superfunctions": {
    "initFunction": "cifn",
    "schemaVersion": 1,
    "namespace": "cifn"
  },
  "dependencies": {
    "@cifn/control-plane": "0.0.2",
    "@testfn/core": "0.0.3",
    "uuid": "^9.0.0",
    "@logfn/core": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  },
  "files": [
    "dist",
    "scripts"
  ]
}
