{
  "name": "@cifn/control-plane",
  "version": "0.0.2",
  "description": "Self-hosted CI/CD pipeline runner for the superfunctions ecosystem",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "test:startup": "npm run build && node scripts/verify-startup.mjs",
    "test:durable": "vitest run src/store/database-store.test.ts && tsc -p tsconfig.durable.json && npm run build && node scripts/verify-durable-startup.mjs"
  },
  "keywords": [
    "ci",
    "cd",
    "pipeline",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "cifn/typescript/control-plane"
  },
  "publishConfig": {
    "access": "public"
  },
  "superfunctions": {
    "initFunction": "cifn",
    "schemaVersion": 1,
    "namespace": "cifn"
  },
  "dependencies": {
    "@superfunctions/webhooks": "0.0.1",
    "ajv": "^8.12.0",
    "hono": "^4.11.8",
    "js-yaml": "^4.1.0",
    "uuid": "^9.0.0",
    "@superfunctions/envelope": "0.0.1",
    "@superfunctions/errors": "0.0.1",
    "@superfunctions/queue": "0.0.1",
    "@superfunctions/http": "0.3.1",
    "@superfunctions/db": "0.4.0"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4",
    "@types/better-sqlite3": "^7.6.13"
  },
  "optionalDependencies": {
    "better-sqlite3": "^12.5.0",
    "kysely": "^0.28.0"
  }
}
