{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/datafn/docs/content/docs/**",
        "$TURBO_ROOT$/datafn/python/tests/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/__pycache__/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/.pytest_cache/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/.venv/**"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/datafn/docs/content/docs/**",
        "$TURBO_ROOT$/datafn/python/tests/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/__pycache__/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/.pytest_cache/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/.venv/**"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/datafn/docs/content/docs/**",
        "$TURBO_ROOT$/datafn/python/tests/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/__pycache__/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/.pytest_cache/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/.venv/**"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/datafn/docs/content/docs/**",
        "$TURBO_ROOT$/datafn/python/tests/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/__pycache__/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/.pytest_cache/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/.venv/**"
      ]
    }
  }
}
