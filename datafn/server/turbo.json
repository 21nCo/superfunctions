{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/datafn/docs/content/docs/**",
        "$TURBO_ROOT$/datafn/python/tests/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/__pycache__/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/.pytest_cache/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/.venv/**"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/datafn/docs/content/docs/**",
        "$TURBO_ROOT$/datafn/python/tests/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/__pycache__/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/.pytest_cache/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/.venv/**"
      ]
    },
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.github/workflows/ci.yml",
        "$TURBO_ROOT$/.github/workflows/publish-python.yml",
        "$TURBO_ROOT$/.github/workflows/publish-tag.yml",
        "$TURBO_ROOT$/datafn/admin/package.json",
        "$TURBO_ROOT$/datafn/cli/package.json",
        "$TURBO_ROOT$/datafn/client/package.json",
        "$TURBO_ROOT$/datafn/core/package.json",
        "$TURBO_ROOT$/datafn/extfn/package.json",
        "$TURBO_ROOT$/datafn/svelte/package.json",
        "$TURBO_ROOT$/datafn/swift-bridge/package.json",
        "$TURBO_ROOT$/datafn/docs/content/docs/**",
        "$TURBO_ROOT$/datafn/python/tests/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/__pycache__/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/.pytest_cache/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/.venv/**"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/datafn/docs/content/docs/**",
        "$TURBO_ROOT$/datafn/python/tests/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/__pycache__/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/.pytest_cache/**",
        "!$TURBO_ROOT$/datafn/python/tests/**/.venv/**"
      ]
    }
  }
}
