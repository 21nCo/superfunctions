{
  "compilerOptions": {
    "target": "ES2021",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2021", "DOM"],
    "baseUrl": ".",
    "paths": {
      "@datafn/client": ["../client/src/index.ts"],
      "@datafn/core": ["../core/src/index.ts"],
      "@superfunctions/http": ["./node_modules/@superfunctions/http"]
    },
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*", "__tests__/**/*"]
}
