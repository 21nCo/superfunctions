{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/datafn/server/src/**",
        "$TURBO_ROOT$/datafn/cli/src/**",
        "$TURBO_ROOT$/datafn/swift-bridge/src/**"
      ]
    },
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/datafn/server/src/**",
        "$TURBO_ROOT$/datafn/cli/src/**",
        "$TURBO_ROOT$/datafn/swift-bridge/src/**"
      ]
    },
    "test": {
      "dependsOn": [
        "^build",
        "@superfunctions/http#build",
        "@superfunctions/observability#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/datafn/server/src/**",
        "$TURBO_ROOT$/datafn/cli/src/**",
        "$TURBO_ROOT$/datafn/swift-bridge/src/**"
      ]
    }
  }
}
