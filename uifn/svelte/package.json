{
  "name": "@uifn/svelte",
  "version": "0.0.2",
  "description": "GA Svelte adapter for uifn primitives",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "src/index.d.mts",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.mts",
      "svelte": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup --silent",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@uifn/core": "0.0.1"
  },
  "peerDependencies": {
    "svelte": ">=5.0.0 <6"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "esbuild-svelte": "^0.9.4",
    "jsdom": "^27.0.1",
    "svelte": "^5.46.1",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vite": "^5.4.21",
    "vitest": "^1.6.1",
    "vitest-axe": "^0.1.0"
  },
  "keywords": [
    "svelte",
    "ui",
    "components",
    "primitives",
    "headless",
    "accessible"
  ],
  "files": [
    "dist",
    "src/*.svelte",
    "src/index.d.mts",
    "src/index.ts",
    "src/internal/*.ts",
    "src/svelte-shims.d.ts",
    "README.md",
    "CHANGELOG.md"
  ],
  "author": "21n",
  "license": "MIT",
  "engines": {
    "node": ">=18 <23"
  },
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "uifn/svelte"
  },
  "publishConfig": {
    "access": "public"
  }
}
