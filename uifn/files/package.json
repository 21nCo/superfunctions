{
  "name": "@uifn/files",
  "version": "0.1.0",
  "description": "FileFn UI components for file upload/preview",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": ["ui", "file", "upload", "filefn"],
  "author": "21n",
  "license": "MIT",
  "bugs": { "url": "https://github.com/21nCo/super-functions/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "uifn/files"
  },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@superfunctions/files": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
