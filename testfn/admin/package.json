{
  "name": "@testfn/admin",
  "version": "0.1.0",
  "description": "Function-owned Super Console administration capability for TestFn",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "lint": "npm run typecheck"
  },
  "keywords": [
    "testfn",
    "admin",
    "super-console",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@testfn/core": "0.0.4",
    "@superfunctions/admin": "0.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
