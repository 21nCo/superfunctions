{
  "name": "@testfn/core",
  "version": "0.0.4",
  "description": "Comprehensive self-hosted testing platform",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./dist/types.d.ts"
    },
    "./storage": {
      "types": "./dist/storage/index.d.ts",
      "default": "./dist/storage/index.js"
    },
    "./analytics": {
      "types": "./dist/analytics/index.d.ts",
      "default": "./dist/analytics/index.js"
    },
    "./reporters": {
      "types": "./dist/reporters/index.d.ts",
      "default": "./dist/reporters/index.js"
    },
    "./visual": {
      "types": "./dist/visual/index.d.ts",
      "default": "./dist/visual/index.js"
    },
    "./storage/indexeddb": {
      "types": "./dist/storage/indexeddb-manager.d.ts",
      "default": "./dist/storage/indexeddb-manager.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "npm run typecheck",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "testing",
    "test-runner",
    "e2e",
    "visual-testing",
    "test-analytics",
    "playwright",
    "vitest",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "testfn/typescript"
  },
  "publishConfig": {
    "access": "public"
  },
  "superfunctions": {
    "initFunction": "testFn",
    "schemaVersion": 1,
    "namespace": "testfn"
  },
  "dependencies": {
    "fake-indexeddb": "^6.0.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "pixelmatch": "^6.0.0",
    "pngjs": "^7.0.0",
    "@superfunctions/db": "0.4.0",
    "tinyglobby": "^0.2.17"
  },
  "peerDependencies": {
    "vitest": ">=3.0.0",
    "playwright": ">=1.40.0",
    "@playwright/test": ">=1.40.0",
    "jest": ">=29",
    "puppeteer": ">=21"
  },
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    },
    "playwright": {
      "optional": true
    },
    "@playwright/test": {
      "optional": true
    },
    "jest": {
      "optional": true
    },
    "puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pixelmatch": "^5.2.6",
    "@types/pngjs": "^6.0.5",
    "typescript": "^5.6.0",
    "vitest": "4.1.11",
    "playwright": "1.64.1",
    "@playwright/test": "1.64.1",
    "jest": "30.5.2",
    "puppeteer": "24.43.1",
    "drizzle-orm": "^0.45.4",
    "better-sqlite3": "^12.5.0"
  },
  "engines": {
    "node": ">=18.18"
  }
}
