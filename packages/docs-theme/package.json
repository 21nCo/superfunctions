{
  "name": "@superfunctions/docs-theme",
  "version": "0.1.0",
  "description": "Shared Fumadocs theme primitives for Superfunctions docs apps",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./tokens.css": "./src/tokens.css"
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --project tsconfig.json --noEmit"
  },
  "keywords": [
    "docs",
    "theme",
    "fumadocs",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "peerDependencies": {
    "fumadocs-ui": "^15",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19",
    "typescript": "^5.6.0"
  }
}
