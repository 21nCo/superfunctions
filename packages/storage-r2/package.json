{
  "name": "@superfunctions/storage-r2",
  "version": "0.3.0",
  "description": "Cloudflare R2 storage adapter for @superfunctions/storage (Workers-native; the adapter does not use or bundle the AWS SDK)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "npm run test:node && npm run test:workers",
    "test:node": "vitest run",
    "test:workers": "vitest run --config tests/workers/vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc -p tests/workers/tsconfig.json",
    "clean": "rm -rf dist"
  },
  "keywords": ["storage", "r2", "cloudflare", "workers", "superfunctions"],
  "author": "21n",
  "license": "MIT",
  "bugs": { "url": "https://github.com/21nCo/super-functions/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/superfunctions.git",
    "directory": "packages/storage-r2"
  },
  "publishConfig": { "access": "public" },
  "dependencies": {
    "@superfunctions/storage": "0.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "miniflare": "4.20251113.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4",
    "wrangler": "4.49.0"
  }
}
