{
  "name": "@filefn/processing-container",
  "version": "0.2.1",
  "private": true,
  "description": "FileFn processing container entry: an HTTP server that runs one queued processing job per request (Cloudflare Containers image)",
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "build": "rm -rf dist && tsc",
    "start": "node dist/main.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "clean": "rm -rf dist"
  },
  "license": "MIT",
  "dependencies": {
    "@filefn/processing": "0.4.0",
    "@filefn/server": "0.7.2",
    "@superfunctions/db": "0.2.0",
    "@superfunctions/storage-r2": "0.3.0",
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@superfunctions/storage": "0.2.1",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
