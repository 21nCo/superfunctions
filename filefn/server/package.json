{
  "name": "@filefn/server",
  "version": "0.3.1",
  "description": "FileFn server SDK for file upload/download handling",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "npm run clean && tsc",
    "test": "npm run test:node && npm run test:workers",
    "test:node": "vitest run",
    "test:workers": "vitest run --config tests/workers/vitest.config.ts",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit && tsc -p tests/workers/tsconfig.json",
    "clean": "rm -rf dist"
  },
  "keywords": ["file", "upload", "server", "filefn"],
  "author": "21n",
  "license": "MIT",
  "bugs": { "url": "https://github.com/21nCo/super-functions/issues" },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/superfunctions.git",
    "directory": "filefn/server"
  },
  "publishConfig": { "access": "public" },
  "superfunctions": {
    "initFunction": "createFileFn",
    "schemaVersion": 1,
    "libraryNames": [
      "filefn"
    ]
  },
  "dependencies": {
    "@superfunctions/storage": "0.2.1",
    "@superfunctions/files": "0.1.1",
    "@superfunctions/db": "0.2.0",
    "@superfunctions/http": "0.2.0",
    "@superfunctions/middleware": "0.2.0",
    "@superfunctions/observability": "0.0.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20251120.0",
    "@filefn/processing": "0.1.2",
    "@superfunctions/storage-local": "0.2.1",
    "sharp": "^0.33.5",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4",
    "hono": "4.11.9",
    "miniflare": "4.20251113.0",
    "wrangler": "4.49.0"
  }
}
