{
  "name": "recfn-teams",
  "version": "0.1.0",
  "description": "RecFn Microsoft Teams platform adapter — join Teams via headless browser, capture audio, track participants, capture chat",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "echo 'lint not configured'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": ["meeting", "recording", "microsoft-teams", "bot", "recfn", "superfunctions"],
  "author": "21n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "recfn/platforms/teams"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "recfn-browser-core": "*",
    "recfn": "*",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
