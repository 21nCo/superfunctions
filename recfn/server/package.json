{
  "name": "recfn-server",
  "version": "0.1.0",
  "description": "RecFn server — meeting recording API server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "lint": "echo 'lint not configured'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "meeting",
    "recording",
    "transcription",
    "server",
    "recfn",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "recfn/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "recfn": "*",
    "@superfunctions/http": "*",
    "@superfunctions/webhooks": "*",
    "@superfunctions/metrics": "*",
    "@superfunctions/config": "*",
    "@superfunctions/auth": "*",
    "@superfunctions/middleware": "*",
    "@superfunctions/oauth-flow": "*",
    "@superfunctions/oauth-http": "*",
    "@superfunctions/oauth-storage": "*",
    "@searchfn/adapter-memory": "*",
    "recfn-deepgram": "*",
    "recfn-assemblyai": "*",
    "recfn-google-stt": "*",
    "@superfunctions/envelope": "*",
    "@superfunctions/errors": "*",
    "@superfunctions/queue": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
