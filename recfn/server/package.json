{
  "name": "recfn-server",
  "version": "0.1.0",
  "description": "RecFn server — meeting recording API server",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "poc:hosted-bot": "node dist/hosted-bot-poc.js",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "echo 'lint not configured'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "meeting",
    "recording",
    "transcription",
    "server",
    "recfn",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "recfn/server"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "recfn": "0.1.0",
    "@superfunctions/db": "0.1.4",
    "@superfunctions/http": "0.1.3",
    "@superfunctions/storage": "0.1.0",
    "@superfunctions/webhooks": "0.0.1",
    "@superfunctions/metrics": "0.0.1",
    "@superfunctions/config": "0.0.1",
    "@superfunctions/auth": "0.1.2",
    "@superfunctions/middleware": "0.1.0",
    "@superfunctions/oauth-flow": "0.0.1",
    "@superfunctions/oauth-http": "0.0.1",
    "@superfunctions/oauth-storage": "0.0.1",
    "@searchfn/adapter-memory": "0.1.0",
    "recfn-deepgram": "0.1.0",
    "recfn-assemblyai": "0.1.0",
    "recfn-google-stt": "0.1.0",
    "recfn-meet": "0.1.0",
    "@superfunctions/envelope": "0.0.1",
    "@superfunctions/errors": "0.0.1",
    "@superfunctions/queue": "0.0.1",
    "playwright-core": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@superfunctions/storage-local": "0.1.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
