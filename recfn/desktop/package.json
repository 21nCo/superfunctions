{
  "name": "@recfn/desktop",
  "version": "0.1.0",
  "description": "RecFn desktop capture SDK — system audio + screen capture, local Whisper transcription, server upload",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "recording",
    "desktop",
    "capture",
    "whisper",
    "recfn",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "recfn/desktop"
  },
  "dependencies": {
    "@recfn/core": "0.1.0",
    "@recfn/whisper": "0.1.0",
    "@recfn/client": "0.1.0"
  },
  "optionalDependencies": {
    "electron": "^28.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "jsdom": "^24.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
