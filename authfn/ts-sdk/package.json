{
  "name": "@authfn/legacy-ts-sdk",
  "version": "0.0.1",
  "description": "Authentication self deployed",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "legacy:build": "tsc",
    "legacy:test": "vitest",
    "legacy:test:watch": "vitest --watch",
    "lint": "echo 'lint not configured'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "auth",
    "authentication",
    "api-keys",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "authfn"
  },
  "publishConfig": {
    "access": "public"
  },
  "superfunctions": {
    "initFunction": "createAuthFn",
    "schemaVersion": 1,
    "namespace": "authfn"
  },
  "dependencies": {
    "@superfunctions/auth": "0.1.1",
    "@superfunctions/db": "0.1.3",
    "@superfunctions/http": "0.1.2",
    "@superfunctions/oauth-core": "0.0.1",
    "@superfunctions/oauth-flow": "0.0.1",
    "@superfunctions/oauth-http": "0.0.1",
    "@superfunctions/oauth-providers": "0.0.1",
    "@superfunctions/oauth-storage": "0.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
