{
  "name": "@authfn/api-keys",
  "version": "0.1.4",
  "description": "API key plugin for AuthFn",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/superfunctions.git",
    "directory": "authfn/api-keys"
  },
  "type": "module",
  "main": "./dist/index.js",
