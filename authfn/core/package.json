{
  "name": "authfn",
  "version": "0.4.1",
  "description": "Core authfn contracts and plugin composition primitives",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin-types": {
      "types": "./dist/plugin-types.d.ts",
      "default": "./dist/plugin-types.js"
    },
    "./core/*": {
      "types": "./dist/core/*.d.ts",
      "default": "./dist/core/*.js"
    },
    "./http/*": {
      "types": "./dist/http/*.d.ts",
      "default": "./dist/http/*.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "default": "./dist/schema.js"
    },
    "./openapi": {
      "types": "./dist/openapi.d.ts",
      "default": "./dist/openapi.js"
    },
    "./plugin-runner": {
      "types": "./dist/plugin-runner.d.ts",
      "default": "./dist/plugin-runner.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run && vitest run --config vitest.workerd.config.ts",
    "test:node": "vitest run",
    "test:workerd": "vitest run --config vitest.workerd.config.ts",
    "test:watch": "vitest --watch",
    "lint": "echo 'lint not configured'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "authfn",
    "authentication",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "superfunctions": {
    "initFunction": "authfn",
    "schemaVersion": 2,
    "libraryNames": [
      "authfn"
    ]
  },
  "dependencies": {
    "@superfunctions/auth": "0.2.0",
    "@superfunctions/delivery": "0.1.0",
    "@superfunctions/db": "0.2.0",
    "@superfunctions/http": "0.2.0",
    "@superfunctions/http-openapi": "0.1.0",
    "@superfunctions/oauth-storage": "0.1.0",
    "@superfunctions/observability": "0.0.1"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.10.4",
    "@superfunctions/oauth-core": "0.1.1",
    "@superfunctions/oauth-flow": "0.1.0",
    "@superfunctions/oauth-http": "0.1.0",
    "@superfunctions/oauth-providers": "0.1.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "better-sqlite3": "^12.5.0",
    "drizzle-orm": "^0.35.0",
    "jose": "^5.10.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
