{
  "name": "@authfn/client",
  "version": "0.5.0",
  "description": "Typed browser client for authfn",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "author": "21n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/superfunctions.git",
    "directory": "authfn/client"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "authfn": "0.10.0",
    "@superfunctions/http": "0.2.0"
  },
  "devDependencies": {
    "@authfn/api-keys": "0.3.2",
    "@authfn/email-otp": "0.2.1",
    "@authfn/multi-region": "0.2.6",
    "@authfn/password": "0.3.0",
    "@authfn/social-oauth": "0.2.4",
    "@authfn/two-factor": "0.2.1",
    "@types/node": "^22.0.0",
    "esbuild": "0.21.5",
    "fake-indexeddb": "^6.0.0",
    "playwright": "^1.57.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
