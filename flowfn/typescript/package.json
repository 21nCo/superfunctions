{
  "name": "@flowfn/core",
  "version": "0.0.2",
  "description": "Self-hosted flow control platform for developers - Queues, Streams, and Workflows",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "keywords": [
    "queue",
    "stream",
    "workflow",
    "redis",
    "kafka",
    "sqs",
    "postgres",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "flowfn/typescript"
  },
  "publishConfig": {
    "access": "public"
  },
  "superfunctions": {
    "initFunction": "flowFn",
    "schemaVersion": 1,
    "namespace": "flowfn"
  },
  "dependencies": {
    "@superfunctions/http": "0.3.0",
    "cron-parser": "^4.9.0",
    "drizzle-orm": "^0.29.0",
    "eventemitter3": "^5.0.1",
    "ioredis": "^5.0.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^9.0.0",
    "ioredis-mock": "^8.9.0",
    "pg": "^8.23.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^4.1.11"
  },
  "peerDependencies": {
    "@aws-sdk/client-sqs": "^3.0.0",
    "ioredis": "^5.0.0",
    "kafkajs": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "kafkajs": {
      "optional": true
    },
    "@aws-sdk/client-sqs": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
