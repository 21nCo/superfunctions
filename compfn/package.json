{
  "name": "compfn",
  "version": "0.1.2",
  "description": "Self-hosted compliance function: controls, frameworks, evidence, checks, audit-ready export",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bundles/soc2-type2.json": "./bundles/soc2-type2.json"
  },
  "bin": {
    "compfn": "./cli/dist/index.js"
  },
  "files": [
    "dist",
    "cli/dist",
    "bundles"
  ],
  "scripts": {
    "build": "npm run build:core && npm run build:cli",
    "build:core": "tsc",
    "build:cli": "tsc -p cli/tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p cli/tsconfig.json",
    "clean": "rm -rf dist cli/dist",
    "lint": "npm run typecheck"
  },
  "keywords": [
    "compliance",
    "controls",
    "frameworks",
    "evidence",
    "audit",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "compfn"
  },
  "dependencies": {
    "@superfunctions/db": "0.4.0",
    "commander": "^4.1.1",
    "@superfunctions/http": "0.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "4.1.11",
    "better-sqlite3": "^12.5.0",
    "drizzle-orm": "^0.45.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20"
  }
}
