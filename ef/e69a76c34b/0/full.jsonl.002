d: resource?.idField,\n      moduleId: manifest.id,\n      sourceModuleId: manifest.id,\n      label,\n      pluralLabel: label,\n      description: resource?.description ?? list?.operation.description ?? get?.operation.description,\n      ...(resource?.icon ? { icon: resource.icon } : {}),\n      ...(resource ? { resource } : {}),\n      href: `${navigation?.path ?? `/modules/${manifest.id}`}/${id}`,\n      apiHref: list?.routePath,\n      listApiHref: list?.routePath,\n      listInputSchema: list?.operation.inputSchema,\n      detailApiHref: get?.routePath,\n      detailIdInput: get?.operation.target?.idInput,\n      detailInputSchema: get?.operation.inputSchema,\n      listable: Boolean(list),\n      standaloneList: resource?.presentation?.standaloneList !== false,\n      presentation: resource?.presentation,\n      actions,\n    };\n  });\n  const childViews = children.map(({ manifest: childManifest, entries: childEntries }) => ({\n    manifest: childManifest,\n    view: moduleView(childManifest, childEntries),\n  }));\n  const foldedResources = childViews.flatMap(({ manifest: childManifest, view: child }) => child.resources.map((resource) => ({\n    ...resource,\n    id: `${child.id}:${resource.resourceId}`,\n    moduleId: child.id,\n    sourceModuleId: child.id,\n    foldedIntoModuleId: manifest.id,\n  sourceModuleId?: string;\n  foldedIntoModuleId?: string;\n  href?: string;\n  apiHref?: string;\n  method?: 'GET' | 'POST' | 'PUT' | 'PATCH' | 'DELETE';\n  tone?: 'default' | 'danger';\n  requiresConfirmation?: boolean;\n  disabled?: boolean;\n  permission?: string;\n}\n\nexport interface AdminResourceViewModel {\n  id: string;\n  resourceId?: string;\n  idField?: string;\n  sourceModuleId?: string;\n  foldedIntoModuleId?: string;\n  label: string;\n  pluralLabel?: string;\n  description?: string;\n  href: string;\n  apiHref?: string;\n  listApiHref?: string;\n  listInputSchema?: AdminJsonSchema;\n  detailApiHref?: string;\n  detailIdInput?: string;\n  detailInputSchema?: AdminJsonSchema;\n  listable?: boolean;\n  standaloneList?: boolean;\n  presentation?: AdminResourcePresentation;\n  count?: number;\n  createAction?: AdminActionViewModel;\n  actions?: AdminActionViewModel[];\n}\n\nexport interface AdminModuleViewModel {\n  id: string;\n  name: string;\n  description: string;\n  href: string;\n  group?: string;\n  enabled: boolean;\n  visibleInNavigation?: boolean;\n  parentModuleId?: string;\n  foldedModuleIds?: string[];\n  health?: HealthTone;\nfunction adminItemId(\n  item: Record<string, unknown>,\n  resourceId: string,\n  idField?: string\n): string | undefined {\n  const singular = resourceId.endsWith('ies')\n    ? `${resourceId.slice(0, -3)}y`\n    : resourceId.endsWith('s')\n      ? resourceId.slice(0, -1)\n      : resourceId;\n  for (const key of [...new Set([idField, 'id', `${singular}Id`, 'runId', 'key', 'slug'].filter(Boolean))] as string[]) {\n    const value = item[key];\n    if (typeof value === 'string' && value) return value;\n    if (typeof value === 'number') return String(value);\n  }\n  return undefined;\n}\n\nfunction detailInputForRow(\n  item: Record<string, unknown>,\n  source: Record<string, unknown>,\n  resource: AdminResourceViewModel,\n  identity: string\n): Record<string, unknown> | undefined {\n  if (!resource.detailApiHref) return undefined;\n  const idInput = resource.detailIdInput ?? 'id';\n  const input: Record<string, unknown> = { [idInput]: identity };\n  const required = resource.detailInputSchema?.type === 'object'\n    ? resource.detailInputSchema.required ?? []\n    : [];\n  for (const key of required) {\n    if (key === idInput) continue;\n    const value = source[key] ?? item[key];\n    if (value === undefined || value === null || value === '') return undefined;\n    input[key] = value;\n  }\n  return input;\n}\n\nfunction detailHref(\n  href: string,\n  input: Record<string, unknown>,\n  idInput: string\n): string {\n  const url = new URL(`${href}/${encodeURIComponent(String(input[idInput]))}`, 'http://superconsole.local');\n  for (const [key, value] of Object.entries(input)) {\nimport type { AdminOperationDefinition } from \"./types.js\";\n\nconst SUPPORTED_METHODS = new Set([\"GET\", \"POST\", \"PUT\", \"PATCH\", \"DELETE\"]);\n\nexport interface ParsedAdminOperationRoute {\n  method: \"GET\" | \"POST\" | \"PUT\" | \"PATCH\" | \"DELETE\";\n  path: string;\n}\n\nexport function parseAdminOperationRoute(operation: AdminOperationDefinition): ParsedAdminOperationRoute | undefined {\n  const rawMethod = typeof operation.route === \"string\"\n    ? operation.route.trim().split(/\\s+/, 1)[0]\n    : operation.route.method;\n  const path = typeof operation.route === \"string\"\n    ? operation.route.trim().slice(rawMethod?.length ?? 0).trimStart()\n    : operation.route.path;\n  const method = rawMethod?.toUpperCase();\n  if (!method || !SUPPORTED_METHODS.has(method) || !path) return undefined;\n  return { method: method as ParsedAdminOperationRoute[\"method\"], path };\n}\n\n  async registry(options?: AdminClientRequestOptions): Promise<AdminCapabilityManifest[]> {\n    const response = await this.request<{ enabledModules: AdminCapabilityManifest[] }>(\"GET\", \"registry\", undefined, options);\n    return response.enabledModules;\n  }\n\n  async openApi(options?: AdminClientRequestOptions): Promise<Record<string, unknown>> {\n    return this.request(\"GET\", \"openapi.json\", undefined, options);\n  }\n\n  async overview(options?: AdminClientRequestOptions): Promise<AdminOverviewView> {\n    return this.request(\"GET\", \"overview\", undefined, options);\n  }\n\n  async search(query: string, options: AdminSearchOptions = {}): Promise<AdminSearchView> {\n    const { limit, cursor, ...requestOptions } = options;\n    return this.request(\"GET\", \"search\", { q: query, limit, cursor }, requestOptions);\n  }\n\n  async audit(options: AdminAuditListOptions = {}): Promise<AdminAuditView> {\n    const { limit, cursor, actor, module, outcome, query, ...requestOptions } = options;\n    return this.request(\"GET\", \"audit\", { limit, cursor, actor, module, outcome, q: query }, requestOptions);\n  }\n\n  async settings(options?: AdminClientRequestOptions): Promise<AdminSettingsView> {\n    return this.request(\"GET\", \"settings\", undefined, options);\n  }\n\n  async mcp(options?: AdminClientRequestOptions): Promise<AdminMcpView> {\n    return this.request(\"GET\", \"mcp\", undefined, options);\n  }\n\n  async issueConfirmation(operationId: string, input: unknown, options?: AdminClientRequestOptions): Promise<AdminConfirmationReceipt> {\n    return this.request(\"POST\", \"confirmations\", { operationId, input }, options);\n  }\n\n  async invoke<T = unknown>(\n    moduleId: string,\n    route: { method: \"GET\" | \"POST\" | \"PUT\" | \"PATCH\" | \"DELETE\"; path: string },\n    input?: unknown,\n    options?: AdminClientRequestOptions,\n  ): Promise<AdminOperationResult<T>> {\n    const routePath = materializeRoutePath(route.path, input);\n    const path = `modules/${encodeURIComponent(moduleId)}${routePath.startsWith(\"/\") ? routePath : `/${routePath}`}`;\n    return this.request<AdminOperationResult<T>>(route.method, path, input, options, false);\n  }\n\n  async invokeOperation<T = unknown>(\n    operationId: string,\n    input?: unknown,\n    options?: AdminClientRequestOptions,\n  ): Promise<AdminOperationResult<T>> {\n    return this.request<AdminOperationResult<T>>(\n      \"POST\",\n      `operations/${encodeURIComponent(operationId)}`,\n      input ?? {},\n      options,\n      false,\n    );\n  }\n\n  async invokeOperationRaw<T = unknown>(\n    operationId: string,\n    input?: unknown,\n    options?: AdminClientRequestOptions,\n  ): Promise<AdminRawResponse<AdminResult<T>>> {\n    return this.performRequest<AdminResult<T>>(\n      \"POST\",\n      `operations/${encodeURIComponent(operationId)}`,\n      input ?? {},\n      options,\n    );\n  }\n\n  async invokeRaw<T = unknown>(\n    moduleId: string,\n    route: { method: \"GET\" | \"POST\" | \"PUT\" | \"PATCH\" | \"DELETE\"; path: string },\n    input?: unknown,\n    options?: AdminClientRequestOptions,\n  ): Promise<AdminRawResponse<AdminResult<T>>> {\n    const routePath = materializeRoutePath(route.path, input);\n    const path = `modules/${encodeURIComponent(moduleId)}${routePath.startsWith(\"/\") ? routePath : `/${routePath}`}`;\n    return this.performRequest<AdminResult<T>>(route.method, path, input, options);\n  }\n\n  private async request<T>(\n    method: string,\n    path: string,\n    input?: unknown,\n    options: AdminClientRequestOptions = {},\n    unwrap = true,\n  ): Promise<T> {\n    const { response, payload } = await this.performRequest<T | AdminResult>(method, path, input, options);\n    if (!response.ok) {\n      const result = payload && typeof payload === \"object\" && \"ok\" in payload ? payload as AdminResult : undefined;\n      throw new AdminClientError(result && result.ok === false ? result.error.message : `Administration request failed with HTTP ${response.status}.`, response.status, result, response);\n    }\n    if (unwrap && payload && typeof payload === \"object\" && \"ok\" in payload && (payload as AdminResult).ok !== false) {\n      return (payload as { data: T }).data;\n    }\n    return payload as T;\nsuperconsole/tests/ui/resource-pages.test.ts:2:import { loadResourceDetail, loadResourceList } from '../../src/lib/components/resource-pages';\nsuperconsole/tests/ui/resource-pages.test.ts:152:            detailApiHref: '/api/admin/v1/modules/cifn/runs/:id', detailIdInput: 'id',\nsuperconsole/tests/ui/resource-pages.test.ts:174:    const loaded = await loadResourceDetail({\nsuperconsole/tests/ui/admin-api.test.ts:25:import { loadResourceDetail } from '../../src/lib/components/resource-pages';\nsuperconsole/tests/ui/admin-api.test.ts:303:      detailApiHref: '/api/admin/v1/modules/authfn/resources/users/:id',\nsuperconsole/tests/ui/admin-api.test.ts:320:      detailApiHref: '/api/admin/v1/modules/cmsfn/resources/documents/:id', detailIdInput: 'id',\nsuperconsole/tests/ui/admin-api.test.ts:326:      detailApiHref: '/api/admin/v1/modules/flowfn/resources/jobs/:id', detailIdInput: 'id',\nsuperconsole/tests/ui/admin-api.test.ts:347:        detailApiHref: '/api/admin/v1/modules/flowfn/resources/jobs/:id', detailIdInput: 'id',\nsuperconsole/tests/ui/admin-api.test.ts:352:    const loaded = await loadResourceDetail({\nsuperconsole/tests/ui/admin-api.test.ts:360:    const missing = await loadResourceDetail({\nsuperconsole/tests/server/super-console.test.ts:564:      detailApiHref: '/api/admin/v1/modules/examplefn/resources/records/:id',\nsuperconsole/tests/server/super-console.test.ts:661:      detailApiHref: '/api/admin/v1/modules/examplefn/resources/records/:id',\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a03df6-e6e1-7a72-a0b5-21d4875eed74","create_time":1787746186.188871}}}
