ror('No module capabilities are visible to the active operator.', { status: 404, code: 'MODULE_NOT_ENABLED' });\\n  1303\\t      }\\n  1304\\t      return this.headAware(request, success({\\n  1305\\t        module: view,\\n  1306\\t        summary: [\\n  1307\\t          { id: 'resources', label: 'Resources', value: view.resources.length },\\n  1308\\t          { id: 'operations', label: 'Operations', value: view.capabilities.length },\\n  1309\\t        ],\\n  1310\\t        notices: [],\\n  1311\\t      }, state.context.requestId));\\n  1312\\t    }\\n  1313\\t\\n  1314\\t    const url = new URL(request.url);\\n  1315\\t    let matchedPath = url.pathname;\\n  1316\\t    const resourceAliasPath = rest[0] !== 'resources'\\n  1317\\t      ? `${this.registry.apiBasePath}/modules/${encodeURIComponent(moduleId)}/resources/${rest.join('/')}`\\n  1318\\t      : undefined;\\n  1319\\t    const routeMethod = request.method === 'HEAD' ? 'GET' : request.method;\\n  1320\\t    let entry = this.registry.matchRoute(routeMethod, matchedPath);\\n  1321\\t    if (!entry && resourceAliasPath) {\\n  1322\\t      entry = this.registry.matchRoute(routeMethod, resourceAliasPath);\\n  1323\\t      if (entry) matchedPath = resourceAliasPath;\\n  1324\\t    }\\n  1325\\t    if (!entry) {\\n  1326\\t      const methodExists = this.registry.operations.some((candidate) => candidate.moduleId === moduleId &&\\n  1327\\t        [matchedPath, resourceAliasPath].filter((path): path is string => Boolean(path)).some((path) =>\\n  1328\\t          this.registry.matchRoute(routeDefinition(candidate.operation).method, path)?.operation.id === candidate.operation.id));\\n  1329\\t      if (methodExists) throw new SuperConsoleHttpError('This module operation does not support the requested method.', { status: 405, code: 'METHOD_NOT_ALLOWED' });\\n  1330\\t    }\\n  1331\\t    if (!entry || entry.moduleId !== moduleId) throw new SuperConsoleHttpError('The requested module operation is not enabled.', { status: 404, code: 'OPERATION_NOT_ENABLED' });\\n  1332\\t    if (!(await this.operationDiscoverable(entry, state))) {\\n  1333\\t      throw new SuperConsoleHttpError('The requested module operation is not enabled.', { status: 404, code: 'OPERATION_NOT_ENABLED' });\\n  1334\\t    }\\n  1335\\t    if (entry.operation.safety.classification !== 'read' && READ_METHODS.has(request.method)) {\\n  1336\\t      await this.options.auth.authorizeMutation?.({ principal: state.principal, request });\\n  1337\\t    }\\n  1338\\t    const input = await operationInput(request, entry, matchedPath);\\n  1339\\t    const dispatched = await this.dispatcher.dispatch({ operationId: entry.operation.id, input, context: state.context });\\n  1340\\t    return this.headAware(request, resultResponse(dispatched));\\n  1341\\t  }\\n  1342\\t\\n  1343\\t  private requirePermission(principal: SuperConsolePrincipal, permission: string): void {\\n  1344\\t    if (!this.hasPermission(principal.actor.permissions, permission)) {\\n  1345\\t      throw new SuperConsoleHttpError('The active operator lacks the required permission.', { status: 403, code: 'PERMISSION_DENIED' });\\n  1346\\t    }\\n  1347\\t  }\\n  1348\\t\\n  1349\\t  private hasPermission(permissions: readonly string[] | undefined, permission: string): boolean {\\n  1350\\t    return Boolean(permissions?.includes('*') || permissions?.includes(permission));\\n  1351\\t  }\\n  1352\\t\\n  1353\\t  private async authorizeShell(surface: 'registry' | 'overview' | 'api' | 'mcp' | 'settings' | 'audit' | 'search', state: SuperConsoleRequestState): Promise<void> {\\n  1354\\t    if (!(await this.options.shellPolicy.authorize({ surface, principal: state.principal, context: state.context }))) {\\n  1355\\t      throw new SuperConsoleHttpError('The active operator cannot access this administration surface.', { status: 403, code: 'PERMISSION_DENIED' });\\n  1356\\t    }\\n  1357\\t  }\\n  1358\\t\\n  1359\\t  private async authorizedSurfaces(state: SuperConsoleRequestState) {\\n  1360\\t    const policy = async (surface: 'overview' | 'api' | 'mcp' | 'settings' | 'audit' | 'search') =>\\n    85\\t}\\n    86\\t\\n    87\\tfunction parametersFor(schema: AdminJsonSchema, parameterNames: readonly string[], includeQuery: boolean): Record<string, unknown>[] {\\n    88\\t  const parameters: Record<string, unknown>[] = [];\\n    89\\t  for (const name of parameterNames) {\\n    90\\t    parameters.push({ name, in: \\\"path\\\", required: true, schema: schema.properties?.[name] ?? { type: \\\"string\\\" } });\\n    91\\t  }\\n    92\\t  if (includeQuery && schema.type === \\\"object\\\") {\\n    93\\t    for (const [name, property] of Object.entries(schema.properties ?? {})) {\\n    94\\t      if (!parameterNames.includes(name)) {\\n    95\\t        const types = property.type === undefined\\n    96\\t          ? []\\n    97\\t          : Array.isArray(property.type) ? property.type : [property.type];\\n    98\\t        parameters.push({\\n    99\\t          name,\\n   100\\t          in: \\\"query\\\",\\n   101\\t          required: schema.required?.includes(name) ?? false,\\n   102\\t          ...(types.includes(\\\"object\\\") || types.includes(\\\"array\\\")\\n   103\\t            ? {\\n   104\\t                description: \\\"JSON-encoded query parameter.\\\",\\n   105\\t                content: { \\\"application/json\\\": { schema: property } },\\n   106\\t              }\\n   107\\t            : { schema: property }),\\n   108\\t        });\\n   109\\t      }\\n   110\\t    }\\n   111\\t  }\\n   112\\t  return parameters;\\n   113\\t}\\n   114\\t\\n   115\\texport function createAdminOpenApiDocument(\\n   116\\t  registry: AdminCapabilityRegistry,\\n   117\\t  options: AdminOpenApiOptions,\\n   118\\t): AdminOpenApiDocument {\\n   119\\t  const securitySchemes = options?.securitySchemes;\\n   120\\t  if (!securitySchemes?.operatorSession || !securitySchemes.operatorApiKey) {\\n   121\\t    throw new AdminError(\\n   122\\t      \\\"invalid_argument\\\",\\n   123\\t      \\\"OpenAPI security schemes must define operatorSession and operatorApiKey because protected operations reference both schemes.\\\",\\n   124\\t    );\\n   125\\t  }\\n   126\\t  if (options.csrfHeader && !options.csrfHeader.name.trim()) {\\n   127\\t    throw new AdminError(\\\"invalid_argument\\\", \\\"OpenAPI CSRF header metadata must define a nonblank provider header name.\\\");\\n   128\\t  }\\n   129\\t  const paths = Object.create(null) as Record<string, Record<string, unknown>>;\\n   130\\t  for (const entry of registry.operations) {\\n   131\\t    const { method, path, parameterNames } = route(entry);\\n   132\\t    const input = entry.operation.inputSchema;\\n   133\\t    const output = entry.operation.outputSchema;\\n   134\\t    if (!input || !output) throw new AdminError(\\\"internal\\\", `Operation ${entry.operation.id} has incomplete schemas.`);\\n   135\\t    const usesQueryInput = method === \\\"GET\\\" || method === \\\"DELETE\\\";\\n   136\\t    const parameters = parametersFor(input, parameterNames, usesQueryInput);\\n   137\\t    for (const scopeParameter of adminOpenApiScopeParameters()) {\\n   138\\t      if (!parameters.some((parameter) => parameter.name === scopeParameter.name && parameter.in === scopeParameter.in)) {\\n   139\\t        parameters.push(scopeParameter);\\n   140\\t      }\\n   141\\t    }\\n   142\\t    if (entry.operation.safety.classification !== \\\"read\\\" && entry.operation.safety.idempotent) {\\n   143\\t      parameters.push({\\n   144\\t        name: \\\"Idempotency-Key\\\",\\n   145\\t        in: \\\"header\\\",\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a03df6-e6e1-7a72-a0b5-21d4875eed74","create_time":1787746074.973546}}}
