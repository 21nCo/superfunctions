0\t    const second = await secondService.attachDomain(scope, { targetId: target.id, hostname: \"api.example.test\" });\n   231\t    expect(second).toMatchObject({ status: \"pending\" });\n   232\t    releaseProvider();\n   233\t    const completed = await first;\n   234\t    expect(second.id).toBe(completed.id);\n   235\t    expect(attachDomain).toHaveBeenCalledTimes(1);\n   236\t    await expect(store.listDomains(scope)).resolves.toEqual([expect.objectContaining({ id: completed.id, status: \"active\" })]);\n   237\t  });\n   238\t\n   239\t  it(\"reconciles a stale variable record when the provider already deleted it\", async () => {\n   240\t    class LostDeleteStore extends MemoryHostFnOperatorStore {\n   241\t      private loseFirstAcknowledgement = true;\n   242\t      override async deleteVariable(variableScope: HostFnScope, id: string) {\n   243\t        if (this.loseFirstAcknowledgement) {\n   244\t          this.loseFirstAcknowledgement = false;\n   245\t          throw new Error(\"variable deletion persistence unavailable\");\n  1040\t    try {\n  1041\t      entry = this.registry.requireOperation(operationId);\n  1042\t      if (!(await this.operationDiscoverable(entry, state))) {\n  1043\t        throw new AdminError('not_found', 'The requested confirmation operation is unavailable.');\n  1044\t      }\n  1045\t      if (!entry.operation.safety.requiresConfirmation) throw new SuperConsoleHttpError('This operation does not require a confirmation token.', { status: 400, code: 'CONFIRMATION_NOT_REQUIRED' });\n  1046\t      const schema = entry.operation.inputSchema;\n  1047\t      if (!schema) throw new SuperConsoleHttpError('The operation has no input schema.', { status: 500, code: 'OPERATION_SCHEMA_MISSING' });\n  1048\t      assertAdminValue(schema, input);\n  1049\t      immutable = immutableConfirmationState(input, state);\n  1050\t    } catch (error) {\n  1051\t      await this.auditConfirmation(undefined, operationId, undefined, state.context, 'denied', started, normalizeAdminError(error).error.code);\n  1052\t      throw error;\n  1053\t    }\n  1054\t    try {\n  1055\t      await this.auditConfirmation(entry, operationId, immutable.input, immutable.state.context, 'attempted', started);\n  1056\t    } catch {\n  1057\t      throw new SuperConsoleHttpError('The confirmation attempt could not be audited.', { status: 503, code: 'AUDIT_UNAVAILABLE', details: { retryable: true } });\n  1058\t    }\n  1059\t    let receipt: { token: string; expiresAt: string };\n  1060\t    try {\n  1061\t      receipt = await this.performConfirmOperation(entry, immutable.input, immutable.state);\n  1062\t    } catch (error) {\n  1063\t      await this.auditConfirmation(entry, operationId, immutable.input, immutable.state.context, 'denied', started, normalizeAdminError(error).error.code);\n  1064\t      throw error;\n  1065\t    }\n  1066\t    const confirmation = this.options.confirmation;\n  1067\t    if (!confirmation) throw new SuperConsoleHttpError('Confirmation issuance is unavailable.', { status: 503, code: 'CONFIRMATION_UNAVAILABLE' });\n  1068\t    const successAuditId = `audit_${crypto.randomUUID()}`;\n  1069\t    try {\n  1070\t      await confirmation.prepareActivation({\n  1071\t        token: receipt.token,\n  1072\t        auditId: successAuditId,\n  1073\t        operationId,\n  1074\t        input: immutable.input,\n  1075\t        principal: immutable.state.principal,\n  1076\t        context: immutable.state.context,\n  1077\t      });\n  1078\t    } catch {\n  1079\t      try {\n  1080\t        await confirmation.revoke({\n  1081\t          token: receipt.token,\n  1082\t          operationId,\n  1083\t          input: immutable.input,\n  1084\t          principal: immutable.state.principal,\n  1085\t          context: immutable.state.context,\n  1086\t        });\n  1087\t      } catch {\n  1088\t        // The token remains staged and unusable when activation preparation fails.\n  1089\t      }\n  1090\t      try {\n  1091\t        await this.auditConfirmation(entry, operationId, immutable.input, immutable.state.context, 'denied', started, 'CONFIRMATION_ACTIVATION_PREPARE_FAILED');\n  1092\t      } catch {\n  1093\t        throw new SuperConsoleHttpError('The confirmation activation preparation failure could not be audited.', { status: 503, code: 'AUDIT_UNAVAILABLE', details: { retryable: true } });\n  1094\t      }\n  1095\t      throw new SuperConsoleHttpError('The confirmation token could not be prepared for activation.', { status: 503, code: 'CONFIRMATION_ACTIVATION_FAILED', details: { retryable: true } });\n  1096\t    }\n  1097\t    try {\n  1098\t      await this.auditConfirmation(entry, operationId, immutable.input, immutable.state.context, 'succeeded', started, undefined, successAuditId);\n  1099\t    } catch {\n  1100\t      try {\n  1101\t        await confirmation.revoke({\n  1102\t          token: receipt.token,\n  1103\t          operationId,\n  1104\t          input: immutable.input,\n  1105\t          principal: immutable.state.principal,\n  1106\t          context: immutable.state.context,\n  1107\t        });\n  1108\t      } catch {\n  1109\t        // The token is still staged and unusable because activation has not run.\n  1110\t      }\n  1111\t      throw new SuperConsoleHttpError('The confirmation issuance could not be audited.', { status: 503, code: 'AUDIT_UNAVAILABLE', details: { retryable: true } });\n  1112\t    }\n  1113\t    try {\n  1114\t      await confirmation.activate({\n  1115\t        token: receipt.token,\n  1116\t        auditId: successAuditId,\n  1117\t        operationId,\n  1118\t        input: immutable.input,\n  1119\t        principal: immutable.state.principal,\n  1120\t        context: immutable.state.context,\n  1121\t      });\n  1122\t    } catch (error) {\n  1123\t      const denialAuditId = `audit_${crypto.randomUUID()}`;\n  1124\t      let cancellationDurable = false;\n  1125\t      try {\n  1126\t        await confirmation.cancelActivation({\n  1127\t          token: receipt.token,\n  1128\t          auditId: successAuditId,\n  1129\t          denialAuditId,\n  1130\t          operationId,\n  1131\t          input: immutable.input,\n  1132\t          principal: immutable.state.principal,\n  1133\t          context: immutable.state.context,\n  1134\t        });\n  1135\t        cancellationDurable = true;\n  1136\t      } catch {\n  1137\t        // A durable revoke below is an equivalent cancellation fence.\n  1138\t      }\n  1139\t      try {\n  1140\t        await confirmation.revoke({\n  1141\t          token: receipt.token,\n  1142\t          operationId,\n  1143\t          input: immutable.input,\n  1144\t          principal: immutable.state.principal,\n  1145\t          context: immutable.state.context,\n  1146\t        });\n  1147\t        cancellationDurable = true;\n  1148\t      } catch {\n  1149\t        // The explicit cancellation record, when present, remains authoritative.\n  1150\t      }\n  1151\t      if (!cancellationDurable) {\n  1152\t        throw new SuperConsoleHttpError('The confirmation activation failure could not be durably cancelled.', { status: 503, code: 'CONFIRMATION_ACTIVATION_FAILED', details: { retryable: true } });\n  1153\t      }\n  1154\t      try {\n  1155\t        await this.auditConfirmation(\n  1156\t          entry,\n  1157\t          operationId,\n  1158\t          immutable.input,\n  1159\t          immutable.state.context,\n  1160\t          'denied',\n  1161\t          started,\n  1162\t          'CONFIRMATION_ACTIVATION_FAILED',\n  1163\t          denialAuditId,\n  1164\t        );\n  1165\t      } catch {\n  1166\t        throw new SuperConsoleHttpError('The confirmation activation failure could not be audited.', { status: 503, code: 'AUDIT_UNAVAILABLE', details: { retryable: true } });\n  1167\t      }\n  1168\t      throw new SuperConsoleHttpError('The confirmation token could not be activated.', { status: 503, code: 'CONFIRMATION_ACTIVATION_FAILED', details: { retryable: true } });\n  1169\t    }\n  1170\t    return receipt;\n  1171\t  }\n  1172\t\n  1173\t  private async performConfirmOperation(entry: AdminRegistryOperation, input: unknown, state: SuperConsoleRequestState) {\n  1174\t    if (!this.options.confirmation) throw new SuperConsoleHttpError('Confirmation issuance is unavailable.', { status: 503, code: 'CONFIRMATION_UNAVAILABLE' });\n  1175\t    const permission = entry.operation.permission;\n  1176\t    this.requirePermission(state.principal, permission);\n  1177\t    if (this.options.policy) {\n  1178\t      const decision = await this.options.policy.authorize({ entry, input, context: state.context });\n  1179\t      if (!decision.allowed) throw new SuperConsoleHttpError(decision.reason ?? 'The confirmation policy denied this operation.', { status: 403, code: 'CONFIRMATION_DENIED' });\n  1180\t    }\n   120\t    candidate.status === 404 || candidate.statusCode === 404;\n   121\t}\n   122\t\n   123\tfunction scopeKey(scope: HostFnScope): string {\n   124\t  return JSON.stringify([\n   125\t    scope.installationId,\n   126\t    scope.workspaceId,\n   127\t    scope.projectId,\n   128\t    scope.environmentId,\n   129\t  ]);\n   130\t}\n   131\t\n   132\tfunction scoped<T extends { scope: HostFnScope }>(\n   133\t  values: Iterable<T>,\n   134\t  scope: HostFnScope,\n   135\t): T[] {\n   136\t  const key = scopeKey(scope);\n   137\t  return [...values]\n   138\t    .filter((value) => scopeKey(value.scope) === key)\n   139\t    .map((value) => structuredClone(value));\n   140\t}\n   141\t\n   142\t/** Self-hosted reference persistence for development and single-process installations. */\n   143\texport class MemoryHostFnOperatorStore implements HostFnOperatorStore {\n   144\t  private readonly targets = new Map<string, HostFnTarget>();\n   145\t  private readonly deployments = new Map<string, HostFnDeployment>();\n   146\t  private readonly domains = new Map<string, HostFnDomain>();\n   147\t  private readonly domainAttachmentClaims = new Map<string, string>();\n   148\t  private readonly variables = new Map<\n   149\t    string,\n   150\t    HostFnVariable & { secretValue: string }\n   151\t  >();\n   152\t  private key(scope: HostFnScope, id: string) {\n   153\t    return JSON.stringify([\n   154\t      scope.installationId,\n   155\t      scope.workspaceId,\n   156\t      scope.projectId,\n   157\t      scope.environmentId,\n   158\t      id,\n   159\t    ]);\n   160\t  }\n   161\t  async listTargets(scope: HostFnScope) {\n   162\t    return scoped(this.targets.values(), scope);\n   163\t  }\n   164\t  async getTarget(scope: HostFnScope, id: string) {\n   165\t    const target = this.targets.get(this.key(scope, id));\n   166\t    return target ? structuredClone(target) : undefined;\n   167\t  }\n   168\t  async putTarget(target: HostFnTarget) {\n   169\t    this.targets.set(\n   170\t      this.key(target.scope, target.id),\n   171\t      structuredClone(target),\n   172\t    );\n   173\t  }\n   174\t  async listDeployments(scope: HostFnScope, targetId?: string) {\n   175\t    return scoped(this.deployments.values(), scope).filter(\n   176\t      (item) => !targetId || item.targetId === targetId,\n   177\t    );\n   178\t  }\n   179\t  async getDeployment(scope: HostFnScope, id: string) {\n   180\t    const deployment = this.deployments.get(this.key(scope, id));\n   181\t    return deployment ? structuredClone(deployment) : undefined;\n   182\t  }\n   183\t  async putDeployment(deployment: HostFnDeployment) {\n   184\t    this.deployments.set(\n   185\t      this.key(deployment.scope, deployment.id),\n   186\t      structuredClone(deployment),\n   187\t    );\n   188\t  }\n   189\t  async listDomains(scope: HostFnScope, targetId?: string) {\n   190\t    return scoped(this.domains.values(), scope).filter(\n   191\t      (item) => !targetId || item.targetId === targetId,\n   192\t    );\n   193\t  }\n   194\t  async claimDomainAttachment(domain: HostFnDomain) {\n   195\t    const existing = [...this.domains.values()].find(\n   196\t      (candidate) =>\n   197\t        scopeKey(candidate.scope) === scopeKey(domain.scope) &&\n   198\t        candidate.targetId === domain.targetId &&\n   199\t        candidate.hostname === domain.hostname,\n   200\t    );\n   201\t    if (existing) {\n   202\t      if (existing.tls !== domain.tls) {\n   203\t        throw new Error(\"HostFn domain already exists with different TLS configuration.\");\n   204\t      }\n   205\t      const existingKey = this.key(existing.scope, existing.id);\n   206\t      if (existing.status === \"active\" || this.domainAttachmentClaims.has(existingKey)) {\n   207\t        return { domain: structuredClone(existing), acquired: false };\n   208\t      }\n   209\t      const retry = { ...existing, status: \"pending\" as const, updatedAt: domain.updatedAt };\n   210\t      const claimToken = crypto.randomUUID();\n   211\t      this.domains.set(existingKey, structuredClone(retry));\n   212\t      this.domainAttachmentClaims.set(existingKey, claimToken);\n   213\t      return { domain: structuredClone(retry), acquired: true, claimToken };\n   214\t    }\n   215\t    const domainKey = this.key(domain.scope, domain.id);\n   216\t    const claimToken = crypto.randomUUID();\n   217\t    this.domains.set(domainKey, structuredClone(domain));\n   218\t    this.domainAttachmentClaims.set(domainKey, claimToken);\n   219\t    return { domain: structuredClone(domain), acquired: true, claimToken };\n   220\t  }\n   221\t  async releaseDomainAttachmentClaim(scope: HostFnScope, id: string, claimToken: string) {\n   222\t    const key = this.key(scope, id);\n   223\t    if (this.domainAttachmentClaims.get(key) === claimToken) {\n   224\t      this.domainAttachmentClaims.delete(key);\n   225\t    }\n   226\t  }\n   227\t  async completeDomainAttachment(domain: HostFnDomain, claimToken: string) {\n   228\t    const key = this.key(domain.scope, domain.id);\n   229\t    if (this.domainAttachmentClaims.get(key) !== claimToken) return false;\n   230\t    this.domains.set(key, structuredClone(domain));\n   231\t    this.domainAttachmentClaims.delete(key);\n   232\t    return true;\n   233\t  }\n   234\t  async putDomain(domain: HostFnDomain) {\n   235\t    const key = this.key(domain.scope, domain.id);\n   236\t    this.domains.set(key, structuredClone(domain));\n   237\t    if (domain.status !== \"pending\") this.domainAttachmentClaims.delete(key);\n   238\t  }\n   239\t  async deleteDomain(scope: HostFnScope, id: string) {\n   240\t    return this.domains.delete(this.key(scope, id));\n   241\t  }\n   242\t  async listVariables(scope: HostFnScope, targetId?: string) {\n   243\t    return scoped(this.variables.values(), scope)\n   244\t      .filter((item) => !targetId || item.targetId === targetId)\n   245\t      .map(({ secretValue: _secretValue, ...item }) => item);\n   246\t  }\n   247\t  async putVariable(variable: HostFnVariable, secretValue: string) {\n   248\t    this.variables.set(this.key(variable.scope, variable.id), {\n   249\t      ...structuredClone(variable),\n   250\t      secretValue,\n   251\t    });\n   252\t  }\n   253\t  async deleteVariable(scope: HostFnScope, id: string) {\n   254\t    return this.variables.delete(this.key(scope, id));\n   255\t  }\n   256\t}\n   257\t\n   258\tfunction identifier(prefix: string): string {\n   259\t  return `${prefix}_${crypto.randomUUID()}`;\n   260\t}\n   261\t\n   262\texport class HostFnOperatorService {\n   263\t  private readonly domainAttachments = new Map<\n   264\t    string,\n   265\t    { tls: boolean; promise: Promise<HostFnDomain> }\n   266\t  >();\n   267\t\n   268\t  constructor(\n   269\t    private readonly store: HostFnOperatorStore,\n   270\t    private readonly executor: HostFnDeploymentExecutor,\n   271\t  ) {}\n   272\t  listTargets(scope: HostFnScope) {\n   273\t    return this.store.listTargets(scope);\n   274\t  }\n   275\t  getTarget(scope: HostFnScope, id: string) {\n   276\t    return this.store.getTarget(scope, id);\n   277\t  }\n   278\t  listDeployments(scope: HostFnScope, targetId?: string) {\n   279\t    return this.store.listDeployments(scope, targetId);\n   280\t  }\n   281\t  getDeployment(scope: HostFnScope, id: string) {\n   282\t    return this.store.getDeployment(scope, id);\n   283\t  }\n   284\t  listDomains(scope: HostFnScope, targetId?: string) {\n   285\t    return this.store.listDomains(scope, targetId);\n   286\t  }\n   287\t  listVariables(scope: HostFnScope, targetId?: string) {\n   288\t    return this.store.listVariables(scope, targetId);\n   289\t  }\n   290\t  private async target(scope: HostFnScope, id: string) {\n   291\t    const value = await this.store.getTarget(scope, id);\n   292\t    if (!value) throw new Error(`HostFn target not found: ${id}`);\n   293\t    return value;\n   294\t  }\n   295\t  async deploy(\n   296\t    scope: HostFnScope,\n   297\t    input: { targetId: string; revision: string },\n   298\t  ) {\n   299\t    const target = await this.target(scope, input.targetId);\n   300\t    const now = new Date().toISOString();\n   301\t    const deployment: HostFnDeployment = {\n   302\t      id: identifier(\"deployment\"),\n   303\t      scope,\n   304\t      targetId: target.id,\n   305\t      revision: input.revision,\n   306\t      status: \"queued\",\n   307\t      createdAt: now,\n   308\t      updatedAt: now,\n   309\t    };\n   310\t    await this.store.putDeployment(deployment);\n   311\t    await this.executor.deploy({ target, deployment });\n   312\t    return deployment;\n   313\t  }\n   314\t  async cancel(scope: HostFnScope, id: string) {\n   315\t    const deployment = await this.store.getDeployment(scope, id);\n   316\t    if (!deployment) throw new Error(`HostFn deployment not found: ${id}`);\n   317\t    const target = await this.target(scope, deployment.targetId);\n   318\t    await this.executor.cancel({ target, deployment });\n   319\t    const updated = {\n   320\t      ...deployment,\n   321\t      status: \"cancelled\" as const,\n   322\t      updatedAt: new Date().toISOString(),\n   323\t    };\n   324\t    await this.store.putDeployment(updated);\n   325\t    return updated;\n   326\t  }\n   327\t  async rollback(scope: HostFnScope, id: string) {\n   328\t    const deployment = await this.store.getDeployment(scope, id);\n   329\t    if (!deployment) throw new Error(`HostFn deployment not found: ${id}`);\n   330\t    const target = await this.target(scope, deployment.targetId);\n   331\t    await this.executor.rollback({ target, deployment });\n   332\t    const updated = {\n   333\t      ...deployment,\n   334\t      status: \"rolled-back\" as const,\n   335\t      updatedAt: new Date().toISOString(),\n   336\t    };\n   337\t    await this.store.putDeployment(updated);\n   338\t    return updated;\n   339\t  }\n   340\t  async restart(scope: HostFnScope, targetId: string) {\n   341\t    const target = await this.target(scope, targetId);\n   342\t    await this.executor.restart({ target });\n   343\t    return target;\n   344\t  }\n   345\t  async attachDomain(\n   346\t    scope: HostFnScope,\n   347\t    input: { targetId: string; hostname: string; tls?: boolean },\n   348\t  ) {\n   349\t    const requestedTls = input.tls ?? true;\n   350\t    const attachmentKey = JSON.stringify([scopeKey(scope), input.targetId, input.hostname]);\n   351\t    const inFlight = this.domainAttachments.get(attachmentKey);\n   352\t    if (inFlight) {\n   353\t      if (inFlight.tls !== requestedTls) {\n   354\t        throw new Error(\"HostFn domain already exists with different TLS configuration.\");\n   355\t      }\n   356\t      return inFlight.promise;\n   357\t    }\n   358\t    const promise = this.attachDomainOnce(scope, { ...input, tls: requestedTls });\n   359\t    this.domainAttachments.set(attachmentKey, { tls: requestedTls, promise });\n   360\t    try {\n"}],"internal_chat_message_metadata_passthro