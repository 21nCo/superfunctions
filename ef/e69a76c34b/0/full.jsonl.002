 AdminScope): T {\n    34\t  try {\n    35\t    const payload = JSON.parse(fromBase64Url(cursor)) as AdminCursorPayload<T>;\n    36\t    if (payload.version !== 1 || stableSerialize(payload.scope) !== stableSerialize(expectedScope)) {\n    37\t      throw new Error(\"scope mismatch\");\n    38\t    }\n    39\t    return payload.position;\n    40\t  } catch (error) {\n    41\t    throw new AdminError(\"invalid_argument\", \"The pagination cursor is invalid for the active scope.\", { cause: error });\n    42\t  }\n    43\t}\n    44\t\n    45\texport function normalizeAdminPageLimit(\n    46\t  value: unknown,\n    47\t  options: { defaultLimit?: number; maxLimit?: number } = {},\n    48\t): number {\n    49\t  const defaultLimit = options.defaultLimit ?? 50;\n    50\t  const maxLimit = options.maxLimit ?? 200;\n    51\t  const limit = value === undefined ? defaultLimit : Number(value);\n    52\t  if (!Number.isInteger(limit) || limit < 1 || limit > maxLimit) {\n    53\t    throw new AdminError(\"invalid_argument\", `Page limit must be an integer between 1 and ${maxLimit}.`);\n    54\t  }\n    55\t  return limit;\n    56\t}\n   155\t  required: [\"accepted\", \"item\"],\n   156\t  additionalProperties: false,\n   157\t};\n   158\tconst pageProperties = { cursor: { type: \"string\", minLength: 1 }, limit: { type: \"integer\", minimum: 1, maximum: 100, default: 50 } } as const;\n   159\tconst pageInputSchema: AdminObjectSchema = { type: \"object\", properties: pageProperties, additionalProperties: false };\n   160\tconst idInputSchema: AdminObjectSchema = { type: \"object\", properties: { id: { type: \"string\", minLength: 1 } }, required: [\"id\"], additionalProperties: false };\n   161\tconst fileChildListInputSchema: AdminObjectSchema = { type: \"object\", properties: { fileId: { type: \"string\", minLength: 1 }, ...pageProperties }, required: [\"fileId\"], additionalProperties: false };\n   162\tconst fileChildInputSchema: AdminObjectSchema = { type: \"object\", prop