: string;\n    23\t  status:\n    24\t    | \"queued\"\n    25\t    | \"running\"\n    26\t    | \"succeeded\"\n    27\t    | \"failed\"\n    28\t    | \"cancelled\"\n    29\t    | \"rolled-back\";\n    30\t  createdAt: string;\n    31\t  updatedAt: string;\n    32\t}\n    33\t\n    34\texport interface HostFnDomain {\n    35\t  id: string;\n    36\t  scope: HostFnScope;\n    37\t  targetId: string;\n    38\t  hostname: string;\n    39\t  tls: boolean;\n    40\t  status: \"pending\" | \"active\" | \"failed\";\n    41\t  updatedAt: string;\n    42\t}\n    43\t\n    44\texport interface HostFnVariable {\n    45\t  id: string;\n    46\t  scope: HostFnScope;\n    47\t  targetId: string;\n    48\t  key: string;\n    49\t  updatedAt: string;\n    50\t}\n    51\t\n    52\texport interface HostFnOperatorStore {\n    53\t  listTargets(scope: HostFnScope): Promise<HostFnTarget[]>;\n    54\t  getTarget(scope: HostFnScope, id: string): Promise<HostFnTarget | undefined>;\n    55\t  putTarget(target: HostFnTarget): Promise<void>;\n    56\t  listDeployments(\n    57\t    scope: HostFnScope,\n    58\t    targetId?: string,\n    59\t  ): Promise<HostFnDeployment[]>;\n    60\t  getDeployment(\n    61\t    scope: HostFnScope,\n    62\t    id: string,\n    63\t  ): Promise<HostFnDeployment | undefined>;\n    64\t  putDeployment(deployment: HostFnDeployment): Promise<void>;\n    65\t  listDomains(scope: HostFnScope, targetId?: string): Promise<HostFnDomain[]>;\n    66\t  /** Atomically reserve one immutable identity and acquire a reclaimable provider-work lease. */\n    67\t  claimDomainAttachment(domain: HostFnDomain): Promise<{\n    68\t    domain: HostFnDomain;\n    69\t    acquired: boolean;\n    70\t    claimToken?: string;\n    71\t  }>;\n    72\t  /** Persist a terminal state only when `claimToken` is still the current lease. */\n    73\t  completeDomainAttachment(domain: HostFnDomain, claimToken: string): Promise<boolean>;\n    74\t  releaseDomainAttachmentClaim(scope: HostFnScope, id: string, claimToken: string): Promise<void>;\n    75\t  putDomain(domain: HostFnDomain): Promise<void>;\n    76\t  deleteDomain(scope: HostFnScope, id: string): Promise<boolean>;\n    77\t  listVariables(\n    78\t    scope: HostFnScope,\n    79\t    targetId?: string,\n    80\t  ): Promise<HostFnVariable[]>;\n    81\t  putVariable(variable: HostFnVariable, secretValue: string): Promise<void>;\n    82\t  deleteVariable(scope: HostFnScope, id: string): Promise<boolean>;\n    83\t}\n    84\t\n    85\texport interface HostFnDeploymentExecutor {\n    86\t  deploy(input: {\n    87\t    target: HostFnTarget;\n    88\t    deployment: HostFnDeployment;\n    89\t  }): Promise<void>;\n    90\t  cancel(input: {\n    91\t    target: HostFnTarget;\n    92\t    deployment: HostFnDeployment;\n    93\t  }): Promise<void>;\n    94\t  rollback(input: {\n    95\t    target: HostFnTarget;\n    96\t    deployment: HostFnDeployment;\n    97\t  }): Promise<void>;\n    98\t  restart(input: { target: HostFnTarget }): Promise<void>;\n    99\t  /** Must be idempotent when retried with the same domain ID. */\n   100\t  attachDomain(input: {\n   101\t    target: HostFnTarget;\n   102\t    domain: HostFnDomain;\n   103\t  }): Promise<void>;\n   104\t  detachDomain(input: {\n   105\t    target: HostFnTarget;\n   106\t    domain: HostFnDomain;\n   107\t  }): Promise<void>;\n   108\t  setVariable(input: {\n   109\t    target: HostFnTarget;\n   110\t    key: string;\n   111\t    value: string;\n   112\t  }): Promise<void>;\n   113\t  deleteVariable(input: { target: HostFnTarget; key: string }): Promise<void>;\n   114\t}\n   115\t\n   116\tfunction providerReportedNotFound(error: unknown): boolean {\n   117\t  if (!error || typeof error !== \"object\") return false;\n   118\t  const candidate = error as { code?: unknown; status?: unknown; statusCode?: unknown };\n   119\t  return candidate.code === \"not_found\" || candidate.code === \"NOT_FOUND\" ||\n   120\t    candidate.status === 404 || candidate.statusCode === 404;\n   121\t}\n   122\t\n   123\tfunction scopeKey(scope: HostFnScope): string {\n   124\t  return JSON.stringify([\n   125\t    scope.installationId,\n   340\t  async restart(scope: HostFnScope, targetId: string) {\n   341\t    const target = await this.target(scope, targetId);\n   342\t    await this.executor.restart({ target });\n   343\t    return target;\n   344\t  }\n   345\t  async attachDomain(\n   346\t    scope: HostFnScope,\n   347\t    input: { targetId: string; hostname: string; tls?: boolean },\n   348\t  ) {\n   349\t    const requestedTls = input.tls ?? true;\n   350\t    const attachmentKey = JSON.stringify([scopeKey(scope), input.targetId, input.hostname]);\n   351\t    const inFlight = this.domainAttachments.get(attachmentKey);\n   352\t    if (inFlight) {\n   353\t      if (inFlight.tls !== requestedTls) {\n   354\t        throw new Error(\"HostFn domain already exists with different TLS configuration.\");\n   355\t      }\n   356\t      return inFlight.promise;\n   357\t    }\n   358\t    const promise = this.attachDomainOnce(scope, { ...input, tls: requestedTls });\n   359\t    this.domainAttachments.set(attachmentKey, { tls: requestedTls, promise });\n   360\t    try {\n   361\t      return await promise;\n   362\t    } finally {\n   363\t      if (this.domainAttachments.get(attachmentKey)?.promise === promise) {\n   364\t        this.domainAttachments.delete(attachmentKey);\n   365\t      }\n   366\t    }\n   367\t  }\n   368\t\n   369\t  private async attachDomainOnce(\n   370\t    scope: HostFnScope,\n   371\t    input: { targetId: string; hostname: string; tls: boolean },\n   372\t  ) {\n   373\t    const target = await this.target(scope, input.targetId);\n   374\t    const claim = await this.store.claimDomainAttachment({\n   375\t      id: identifier(\"domain\"),\n   376\t      scope,\n   377\t      targetId: target.id,\n   378\t      hostname: input.hostname,\n   379\t      tls: input.tls,\n   380\t      status: \"pending\",\n   381\t      updatedAt: new Date().toISOString(),\n   382\t    });\n   383\t    const domain = claim.domain;\n   384\t    if (!claim.acquired) return domain;\n   385\t    const claimToken = claim.claimToken!;\n   386\t    const currentDomain = async () =>\n   387\t      (await this.store.listDomains(scope, target.id)).find((candidate) => candidate.id === domain.id);\n   388\t    try {\n   389\t      // Executors must make retries with the same domain ID idempotent. Reusing\n   390\t      // a failed/pending intent lets ambiguous provider outcomes converge.\n   391\t      await this.executor.attachDomain({ target, domain });\n   392\t    } catch (error) {\n   393\t      try {\n   394\t        const completed = await this.store.completeDomainAttachment({\n   395\t          ...domain,\n   396\t          status: \"failed\",\n   397\t          updatedAt: new Date().toISOString(),\n   398\t        }, claimToken);\n   399\t        if (!completed) {\n   400\t          const current = await currentDomain();\n   401\t          if (current) return current;\n   402\t        }\n   403\t      } catch {\n   404\t        // The already-durable pending intent remains discoverable and reusable.\n   405\t      }\n   406\t      try {\n   407\t        await this.store.releaseDomainAttachmentClaim(scope, domain.id, claimToken);\n   408\t      } catch {\n   409\t        // Durable stores must expire abandoned provider-work leases.\n   410\t      }\n   411\t      throw error;\n   412\t    }\n   413\t    const active = { ...domain, status: \"active\" as const };\n   414\t    try {\n   415\t      const completed = await this.store.completeDomainAttachment(active, claimToken);\n   416\t      if (!completed) {\n   417\t        const current = await currentDomain();\n   418\t        if (current) return current;\n   419\t        throw new Error(\"HostFn domain attachment lease was superseded.\");\n   420\t      }\n   421\t    } catch (error) {\n   422\t      try {\n   423\t        await this.store.releaseDomainAttachmentClaim(scope, domain.id, claimToken);\n   424\t      } catch {\n   425\t        // Durable stores must expire abandoned provider-work leases.\n   426\t      }\n   427\t      throw error;\n   428\t    }\n   429\t    return active;\n   430\t  }\n   431\t  async detachDomain(scope: HostFnScope, id: string) {\n   432\t    const domain = (await this.store.listDomains(scope)).find(\n   433\t      (item) => item.id === id,\n   434\t    );\n   435\t    if (!domain) throw new Error(`HostFn domain not found: ${id}`);\n   436\t    const target = await this.target(scope, domain.targetId);\n   437\t    try {\n   438\t      await this.executor.detachDomain({ target, domain });\n   439\t    } catch (error) {\n   440\t      if (!providerReportedNotFound(error)) throw error;\n   441\t    }\n   442\t    await this.store.deleteDomain(scope, id);\n   443\t    return domain;\n   444\t  }\n   445\t  async setVariable(\n   446\t    scope: HostFnScope,\n   447\t    input: { targetId: string; key: string; value: string },\n   448\t  ) {\n   449\t    if (!/^[A-Z_][A-Z0-9_]*$/.test(input.key))\n   450\t      throw new Error(\"Invalid environment variable key.\");\n   451\t    const target = await this.target(scope, input.targetId);\n   452\t    const variable: HostFnVariable = {\n   453\t      id: `${target.id}:${input.key}`,\n   454\t      scope,\n   455\t      targetId: target.id,\n   456\t      key: input.key,\n   457\t      updatedAt: new Date().toISOString(),\n   458\t    };\n   459\t    // Persist a deletion-capable intent before the provider side effect so an\n   460\t    // ambiguous or acknowledged provider write always remains reconcilable.\n   461\t    await this.store.putVariable(variable, input.value);\n   462\t    await this.executor.setVariable({\n   463\t      target,\n   464\t      key: input.key,\n   465\t      value: input.value,\n   466\t    });\n   467\t    return variable;\n   468\t  }\n   469\t  async deleteVariable(scope: HostFnScope, id: string) {\n   470\t    const variable = (await this.store.listVariables(scope)).find(\n   471\t      (item) => item.id === id,\n   472\t    );\n   473\t    if (!variable) throw new Error(`HostFn variable not found: ${id}`);\n   474\t    const target = await this.target(scope, variable.targetId);\n   475\t    try {\n   476\t      await this.executor.deleteVariable({ target, key: variable.key });\n   477\t    } catch (error) {\n   478\t      if (!providerReportedNotFound(error)) throw error;\n   479\t    }\n   480\t    await this.store.deleteVariable(scope, id);\n   481\t    return variable;\n   482\t  }\n   483\t}\n   680\t    const compose = (withChild: boolean) => createSuperConsole({\n   681\t      adapters: withChild ? [ownerAdapter, childAdapter] : [ownerAdapter],\n   682\t      enabledModules: withChild ? ['watchfn', 'catchfn'] : ['watchfn'],\n   683\t      auth: auth(),\n   684\t      shellPolicy: { authorize: () => true },\n   685\t    });\n   686\t    const folded = await (await compose(true).handle(request('/api/admin/v1/modules/watchfn'))).json();\n   687\t    const registry = await (await compose(true).handle(request('/api/admin/v1/registry'))).json();\n   688\t    expect(registry.data.enabledModules.map((module: { id: string }) => module.id)).toEqual(['watchfn', 'catchfn']);\n   689\t    expect(registry.data.modules.map((module: { id: string }) => module.id)).toEqual(['watchfn']);\n   690\t    expect(folded.data.module.foldedModuleIds).toEqual(['catchfn']);\n   691\t    expect(folded.data.module.resources).toEqual(expect.arrayContaining([\n   692\t      expect.objectContaining({ id: 'monitors', sourceModuleId: 'watchfn' }),\n   693\t      expect.objectContaining({ id: 'catchfn:errors', resourceId: 'errors', sourceModuleId: 'catchfn', foldedIntoModuleId: 'watchfn', href: '/modules/watchfn/catchfn%3Aerrors', apiHref: expect.stringContaining('/modules/catchfn/') }),\n   694\t    ]));\n   695\t    const ownerOnly = await (await compose(false).handle(request('/api/admin/v1/modules/watchfn'))).json();\n   696\t    expect(ownerOnly.data.module.foldedModuleIds).toEqual([]);\n   697\t    expect(JSON.stringify(ownerOnly.data.module)).not.toContain('catchfn:errors');\n   698\t  });\n   699\t\n   700\t  it('fails startup when enabled mutations lack required infrastructure while shell-only installs work', () => {\n   701\t    const capability = manifest({ destructive: true });\n   702\t    const adapter = createAdminCapabilityAdapter(capability, { [capability.operations[0]!.id]: async () => ({ ok: true as const, data: { accepted: true } }) });\n   703\t    expect(() => createSuperConsole({ adapters: [adapter], enabledModules: ['examplefn'], auth: auth(), shellPolicy: { authorize: () => true } })).toThrow(/audit sink/);\n   704\t    expect(() => createSuperConsole({ adapters: [adapter], enabledModules: ['examplefn'], auth: auth(), shellPolicy: { authorize: () => true }, audit: new MemoryAdminAuditSink() })).toThrow(/idempotency store/);\n   705\t    expect(() => createSuperConsole({ adapters: [adapter], enabledModules: ['examplefn'], auth: auth(), shellPolicy: { authorize: () => true }, audit: new MemoryAdminAuditSink(), idempotency: new MemoryAdminIdempotencyStore() })).toThrow(/staged confirmation/);\n   706\t    expect(() => createSuperConsole({\n   707\t      adapters: [adapter],\n   708\t      enabledModules: ['examplefn'],\n   709\t      auth: { ...auth(), authorizeMutation: undefined },\n   710\t      shellPolicy: { authorize: () => true },\n   711\t      audit: new MemoryAdminAuditSink(),\n   712\t      idempotency: new MemoryAdminIdempotencyStore(),\n   713\t      confirmation: { issue: async () => ({ token: 'bound', expiresAt: new Date(Date.now() + 60_000).toISOString() }), prepareActivation: async () => undefined, activate: async () => undefined, revoke: async () => undefined, verify: async () => true },\n   714\t    })).toThrow(/mutation authorization/);\n   715\t    expect(() => createSuperConsole({ adapters: [], enabledModules: [], auth: auth(), shellPolicy: { authorize: () => true } })).not.toThrow();\n   716\t    expect(() => createSuperConsole({ adapters: [], enabledModules: [], auth: auth() } as never)).toThrow(/shell authorization policy/);\n   717\t  });\n   718\t\n   719\t  it('issues input-bound confirmation only after input/permission/policy checks and verifies it on dispatch', async () => {\n   720\t    const { console, confirmation, handler, audit } = installation({ destructive: true, permissions: ['examplefn.records.delete'] });\n   721\t    const invalid = await console.handle(request('/api/admin/v1/confirmations', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ operationId: 'examplefn.records.delete', input: {} }) }));\n   722\t    expect(invalid.status).toBe(400);\n   723\t    const issued = await console.handle(request('/api/admin/v1/confirmations', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ operationId: 'examplefn.records.delete', input: { id: 'record_1' } }) }));\n   724\t    expect(issued.status).toBe(201);\n   725\t    expect(await issued.json()).toMatchObject({ ok: true as const, data: { token: 'bound-token', expiresAt: expect.any(String) } });\n   726\t    expect(confirmation.issue).toHaveBeenCalledWith(expect.objectContaining({\n   727\t      operationId: 'examplefn.records.delete',\n   728\t      input: { id: 'record_1' },\n   729\t      context: expect.objectContaining({ scope: expect.objectContaining({ installationId: 'org_1' }) }),\n   730\t    }));\n   731\t    const successAuditId = audit.events.find((event) => event.operationId === 'superconsole.confirmations.issue' && event.outcome === 'succeeded')?.id;\n   732\t    expect(successAuditId).toEqual(expect.any(String));\n   733\t    expect(confirmation.prepareActivation).toHaveBeenCalledWith(expect.objectContaining({ token: 'bound-token', auditId: successAuditId }));\n   734\t    expect(confirmation.activate).toHaveBeenCalledWith(expect.objectContaining({ token: 'bound-token', auditId: successAuditId }));\n   735\t    expect(confirmation.revoke).not.toHaveBeenCalled();\n   736\t    const executed = await console.handle(request('/api/admin/v1/modules/examplefn/records/record_1', {\n   737\t      method: 'DELETE',\n   738\t      headers: { 'idempotency-key': 'idem_1', 'x-admin-confirmation': 'bound-token' },\n   739\t    }));\n   740\t    expect(executed.status).toBe(200);\n   741\t    expect(handler).toHaveBeenCalledTimes(1);\n   742\t    expect(confirmation.verify).toHaveBeenCalled();\n   743\t  });\n   744\t\n   745\t  it('never activates a staged confirmation when its terminal audit fails', async () => {\n   746\t    const capability = manifest({ destructive: true });\n   747\t    const issue = vi.fn(async () => ({ token: 'staged-token', expiresAt: new Date(Date.now() + 60_000).toISOString() }));\n   748\t    let active = false;\n   749\t    const activate = vi.fn(async () => { active = true; });\n   750\t    const revoke = vi.fn(async () => { throw new Error('revocation unavailable'); });\n   751\t    const console = createSuperConsole({\n   752\t      adapters: [createAdminCapabilityAdapter(capability, {\n   753\t        'examplefn.records.delete': async () => ({ ok: true as const, data: { accepted: true } }),\n   754\t      })],\n   755\t      enabledModules: ['examplefn'],\n   756\t      auth: auth(),\n   757\t      shellPolicy: { authorize: () => true },\n   758\t      audit: {\n   759\t        idempotentById: true,\n   760\t        write: async (event) => {\n   761\t          if (event.operationId === 'superconsole.confirmations.issue' && event.outcome === 'succeeded') {\n   762\t            throw new Error('terminal confirmation audit unavailable');\n   763\t          }\n   764\t        },\n   765\t      },\n   766\t      idempotency: new MemoryAdminIdempotencyStore(),\n   767\t      confirmation: { issue, prepareActivation: async () => undefined, activate, revoke, verify: async () => active },\n   768\t    });\n   769\t\n   770\t    const response = await console.handle(request('/api/admin/v1/confirmations', {\n   771\t      method: 'POST',\n   772\t      headers: { 'content-type': 'application/json' },\n   773\t      body: JSON.stringify({ operationId: 'examplefn.records.delete', input: { id: 'record_1' } }),\n   774\t    }));\n   775\t\n   776\t    expect(response.status).toBe(503);\n   777\t    expect(issue).toHaveBeenCalledTimes(1);\n   778\t    expect(activate).not.toHaveBeenCalled();\n   779\t    expect(revoke).toHaveBeenCalledWith(expect.objectContaining({ token: 'staged-token' }));\n   780\t    expect(active).toBe(false);\n   781\t  });\n   782\t\n   783\t  it('records activation failure as denied and leaves the staged token unusable', async () => {\n   784\t    const capability = manifest({ destructive: true });\n   785\t    const outcomes: Array<{ outcome: string; errorCode?: string }> = [];\n   786\t    let active = false;\n   787\t    const revoke = vi.fn(async () => { active = false; });\n   788\t    const verify = vi.fn(async () => active);\n   789\t    const console = createSuperConsole({\n   790\t      adapters: [createAdminCapabilityAdapter(capability, {\n   791\t        'examplefn.records.delete': async () => ({ ok: true as const, data: { accepted: true } }),\n   792\t      })],\n   793\t      enabledModules: ['examplefn'],\n   794\t      auth: auth(),\n   795\t      shellPolicy: { authorize: () => true },\n   796\t      audit: {\n   797\t        idempotentById: true,\n   798\t        write: async (event) => {\n   799\t          if (event.operationId === 'superconsole.confirmations.issue') {\n   800\t            outcomes.push({ outcome: event.outcome, errorCode: event.errorCode });\n   801\t          }\n   802\t        },\n   803\t      },\n   804\t      idempotency: new MemoryAdminIdempotencyStore(),\n   805\t      confirmation: {\n   806\t        issue: async () => ({ token: 'staged-token', expiresAt: new Date(Date.now() + 60_000).toISOString() }),\n   807\t        prepareActivation: async () => undefined,\n   808\t        activate: async () => { active = true; throw new Error('activation unavailable'); },\n   809\t        revoke,\n   810\t        verify,\n   811\t      },\n   812\t    });\n   813\t\n   814\t    const response = await console.handle(request('/api/admin/v1/confirmations', {\n   815\t      method: 'POST',\n   816\t      headers: { 'content-type': 'application/json' },\n   817\t      body: JSON.stringify({ operationId: 'examplefn.records.delete', input: { id: 'record_1' } }),\n   818\t    }));\n   819\t\n   820\t    expect(response.status).toBe(503);\n   821\t    expect(await verify({} as never)).toBe(false);\n   822\t    expect(revoke).toHaveBeenCalledWith(expect.objectContaining({ token: 'staged-token' }));\n   823\t    expect(outcomes).toEqual([\n   824\t      { outcome: 'attempted', errorCode: undefined },\n   825\t      { outcome: 'succeeded', errorCode: undefined },\n   826\t      { outcome: 'denied', errorCode: 'CONFIRMATION_ACTIVATION_FAILED' },\n   827\t    ]);\n   828\t  });\n   829\t\n   830\t  it('returns 405/OPTIONS/HEAD semantics instead of route ambiguity', async () => {\n{\n  \"name\": \"hostfn\",\n  \"version\": \"0.1.7\",\n  \"license\": \"MIT\",\n  \"description\": \"Universal application deployment CLI\",\n  \"type\": \"module\",\n  \"bin\": {\n    \"hostfn\": \"./dist/index.js\"\n  },\n  \"exports\": {\n    \"./operator\": {\n      \"types\": \"./dist/operator.d.ts\",\n      \"default\": \"./dist/operator.js\"\n    }\n  },\n  \"scripts\": {\n    \"dev\": \"tsx watch src/index.ts\",\n    \"build\": \"tsc\",\n    \"clean\": \"rm -rf dist\",\n    \"lint\": \"tsc --noEmit\",\n    \"test\": \"vitest\",\n    \"test:watch\": \"vitest --watch\",\n    \"test:coverage\": \"vitest --coverage\"\n  },\n  \"dependencies\": {\n    \"commander\": \"^11.1.0\",\n    \"chalk\": \"^5.3.0\",\n    \"ora\": \"^7.0.1\",\n    \"inquirer\": \"^9.2.12\",\n    \"semver\": \"^7.7.2\",\n    \"zod\": \"^3.22.4\",\n    \"ssh2\": \"^1.15.0\",\n    \"dotenv\": \"^16.3.1\",\n    \"execa\": \"^8.0.1\"\n  },\n  \"devDependencies\": {\n    \"@types/semver\": \"^7.7.1\",\n    \"@types/node\": \"^20.10.0\",\n    \"@types/ssh2\": \"^1.15.0\",\n    \"@types/inquirer\": \"^9.0.7\",\n    \"@vitest/coverage-v8\": \"^1.6.1\",\n    \"typescript\": \"^5.3.0\",\n    \"tsx\": \"^4.7.0\",\n    \"vitest\": \"^1.6.0\",\n    \"fast-glob\": \"^3.3.2\"\n  },\n  \"author\": \"21n\",\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/21nCo/super-functions.git\",\n    \"directory\": \"hostfn/cli\"\n  },\n  \"bugs\": {\n    \"url\": \"https://github.com/21nCo/super-functions/issues\"\n  },\n  \"keywords\": [\n    \"deployment\",\n    \"vps\"\n  ],\n  \"engines\": {\n    \"node\": \">=18.0.0\"\n  },\n  \"publishConfig\": {\n    \"access\": \"public\"\n  },\n  \"superfunctions\": {\n    \"initFunction\": \"hostFn\",\n    \"schemaVersion\": 1,\n    \"namespace\": \"hostfn\"\n  }\n}\n{\n  \"name\": \"@superfunctions/admin\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Shared administration contracts and runtime for Superfunctions\",\n  \"type\": \"module\",\n  \"main\": \"./dist/index.js\",\n  \"types\": \"./dist/index.d.ts\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"import\": \"./dist/index.js\"\n    }\n  },\n  \"files\": [\n    \"dist\",\n    \"README.md\"\n  ],\n  \"scripts\": {\n    \"build\": \"tsc -p tsconfig.json\",\n    \"review:mutation-risk\": \"node scripts/risk-review.mjs\",\n    \"verify:sdk-contracts\": \"node scripts/verify-sdk-contracts.mjs\",\n    \"test\": \"vitest run\",\n    \"typecheck\": \"tsc -p tsconfig.json --noEmit\"\n  },\n  \"dependencies\": {\n    \"@mcpfn/core\": \"0.0.1\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^5.7.2\",\n    \"vitest\": \"3.2.4\"\n  },\n  \"engines\": {\n    \"node\": \">=20\"\n  },\n  \"license\": \"MIT\"\n}\n{\n  \"name\": \"superconsole\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"description\": \"Self-hosted modular operator console for Superfunctions\",\n  \"type\": \"module\",\n  \"exports\": {\n    \"./server\": {\n      \"types\": \"./dist/server/index.d.ts\",\n      \"import\": \"./dist/server/index.js\"\n    }\n  },\n  \"scripts\": {\n    \"dev\": \"npm run build:server && vite dev --host 127.0.0.1 --port 4178\",\n    \"build\": \"npm run build:server && vite build\",\n    \"build:server\": \"tsc -p tsconfig.server.json\",\n    \"preview\": \"vite preview --host 127.0.0.1 --port 4178\",\n    \"check\": \"svelte-kit sync && svelte-check --tsconfig ./tsconfig.json\",\n    \"lint\": \"svelte-kit sync && svelte-check --tsconfig ./tsconfig.json\",\n    \"typecheck\": \"svelte-kit sync && svelte-check --tsconfig ./tsconfig.json\",\n    \"test\": \"npm run verify:function-agnostic && vitest run\",\n    \"test:ui\": \"vitest run tests/ui\",\n    \"probe:smoke\": \"node tests/probes/super-console.smoke.mjs\",\n    \"verify:function-agnostic\": \"node scripts/verify-function-agnostic.mjs\"\n  },\n  \"dependencies\": {\n    \"@mcpfn/core\": \"0.0.1\",\n    \"@superfunctions/admin\": \"0.1.0\",\n    \"@sveltejs/kit\": \"2.69.3\",\n    \"@uifn/components\": \"0.0.1\",\n    \"@uifn/components-svelte\": \"0.0.1\",\n    \"@uifn/theme\": \"0.0.1\",\n    \"@uifn/theme-tailwind\": \"0.0.1\",\n    \"svelte\": \"5.46.4\"\n  },\n  \"devDependencies\": {\n    \"@authfn/admin\": \"REDACTED\",\n    \"@authfn/password\": \"REDACTED\",\n    \"@authfn/two-factor\": \"REDACTED\",\n    \"@clifn/admin\": \"0.1.0\",\n    \"@extfn/admin\": \"0.1.0\",\n    \"@sveltejs/adapter-node\": \"^5.3.2\",\n    \"@sveltejs/vite-plugin-svelte\": \"4.0.4\",\n    \"@testing-library/jest-dom\": \"^6.9.1\",\n    \"@testing-library/svelte\": \"^5.2.8\",\n    \"@superfunctions/db\": \"0.1.4\",\n    \"@types/node\": \"^20.19.27\",\n    \"autoprefixer\": \"^10.4.21\",\n    \"jsdom\": \"^26.1.0\",\n    \"postcss\": \"^8.5.6\",\n    \"svelte-check\": \"4.3.4\",\n    \"tailwindcss\": \"3.4.17\",\n    \"typescript\": \"5.9.3\",\n    \"vite\": \"5.4.21\",\n    \"vitest\": \"3.2.4\"\n  },\n  \"engines\": {\n    \"node\": \">=20 <23\"\n  },\n  \"license\": \"Apache-2.0\",\n  \"superfunctions\": {\n    \"uses\": [\n      \"mcpfn\",\n      \"uifn\"\n    ],\n    \"schemaVersion\": 1\n  }\n}\n","stderr":"","aggregated_output":"     1\texport interface HostFnScope {\n     2\t  installationId: string;\n     3\t  workspaceId: string;\n     4\t  projectId: string;\n     5\t  environmentId: string;\n     6\t}\n     7\t\n     8\texport interface HostFnTarget {\n     9\t  id: string;\n    10\t  scope: HostFnScope;\n    11\t  name: string;\n    12\t  server: string;\n    13\t  runtime: string;\n    14\t  status: \"ready\" | \"degraded\" | \"offline\";\n    15\t  updatedAt: string;\n    16\t}\n    17\t\n    18\texport interface HostFnDeployment {\n    19\t  id: string;\n    20\t  scope: HostFnScope;\n    21\t  targetId: string;\n    22\t  revision: string;\n    23\t  status:\n    24\t    | \"queued\"\n    25\t    | \"running\"\n    26\t    | \"succeeded\"\n    27\t    | \"failed\"\n    28\t    | \"cancelled\"\n    29\t    | \"rolled-back\";\n    30\t  createdAt: string;\n    31\t  updatedAt: string;\n    32\t}\n    33\t\n    34\texport interface HostFnDomain {\n    35\t  id: string;\n    36\t  scope: HostFnScope;\n    37\t  targetId: string;\n    38\t  hostname: string;\n    39\t  tls: boolean;\n    40\t  status: \"pending\" | \"active\" | \"failed\";\n    41\t  updatedAt: string;\n    42\t}\n    43\t\n    44\texport interface HostFnVariable {\n    45\t  id: string;\n    46\t  scope: HostFnScope;\n    47\t  targetId: string;\n    48\t  key: string;\n    49\t  updatedAt: string;\n    50\t}\n    51\t\n    52\texport interface HostFnOperatorStore {\n    53\t  listTargets(scope: HostFnScope): Promise<HostFnTarget[]>;\n    54\t  getTarget(scope: HostFnScope, id: string): Promise<HostFnTarget | undefined>;\n    55\t  putTarget(target: HostFnTarget): Promise<void>;\n    56\t  listDeployments(\n    57\t    scope: HostFnScope,\n    58\t    targetId?: string,\n    59\t  ): Promise<HostFnDeployment[]>;\n    60\t  getDeployment(\n    61\t    scope: HostFnScope,\n    62\t    id: string,\n    63\t  ): Promise<HostFnDeployment | undefined>;\n    64\t  putDeployment(deployment: HostFnDeployment): Promise<void>;\n    65\t  listDomains(scope: HostFnScope, targetId?: string): Promise<HostFnDomain[]>;\n    66\t  /** Atomically reserve one immutable identity and acquire a reclaimable provider-work lease. */\n    67\t  claimDomainAttachment(domain: HostFnDomain): Promise<{\n    68\t    domain: HostFnDomain;\n    69\t    acquired: boolean;\n    70\t    claimToken?: string;\n    71\t  }>;\n    72\t  /** Persist a terminal state only when `claimToken` is still the current lease. */\n    73\t  completeDomainAttachment(domain: HostFnDomain, claimToken: string): Promise<boolean>;\n    74\t  releaseDomainAttachmentClaim(scope: HostFnScope, id: string, claimToken: string): Promise<void>;\n    75\t  putDomain(domain: HostFnDomain): Promise<void>;\n    76\t  deleteDomain(scope: HostFnScope, id: string): Promise<boolean>;\n    77\t  listVariables(\n    78\t    scope: HostFnScope,\n    79\t    targetId?: string,\n    80\t  ): Promise<HostFnVariable[]>;\n    81\t  putVariable(variable: HostFnVariable, secretValue: string): Promise<void>;\n    82\t  deleteVariable(scope: HostFnScope, id: string): Promise<boolean>;\n    83\t}\n    84\t\n    85\texport interface HostFnDeploymentExecutor {\n    86\t  deploy(input: {\n    87\t    target: HostFnTarget;\n    88\t    deployment: HostFnDeployment;\n    89\t  }): Promise<void>;\n    90\t  cancel(input: {\n    91\t    target: HostFnTarget;\n    92\t    deployment: HostFnDeployment;\n    93\t  }): Promise<void>;\n    94\t  rollback(input: {\n    95\t    target: HostFnTarget;\n    96\t    deployment: HostFnDeployment;\n    97\t  }): Promise<void>;\n    98\t  restart(input: { target: HostFnTarget }): Promise<void>;\n    99\t  /** Must be idempotent when retried with the same domain ID. */\n   100\t  attachDomain(input: {\n   101\t    target: HostFnTarget;\n   102\t    domain: HostFnDomain;\n   103\t  }): Promise<void>;\n   104\t  detachDomain(input: {\n   105\t    target: HostFnTarget;\n   106\t    domain: HostFnDomain;\n   107\t  }): Promise<void>;\n   108\t  setVariable(input: {\n   109\t    target: HostFnTarget;\n   110\t    key: string;\n   111\t    value: string;\n   112\t  }): Promise<void>;\n   113\t  deleteVariable(input: { target: HostFnTarget; key: string }): Promise<void>;\n   114\t}\n   115\t\n   116\tfunction providerReportedNotFound(error: unknown): boolean {\n   117\t  if (!error || typeof error !== \"object\") return false;\n   118\t  const candidate = error as { code?: unknown; status?: unknown; statusCode?: unknown };\n   119\t  return candidate.code === \"not_found\" || candidate.code === \"NOT_FOUND\" ||\n   120\t    candidate.status === 404 || candidate.statusCode === 404;\n   121\t}\n   122\t\n   123\tfunction scopeKey(scope: HostFnScope): string {\n   124\t  return JSON.stringify([\n   125\t    scope.installationId,\n   340\t  async restart(scope: HostFnScope, targetId: string) {\n   341\t    const target = await this.target(scope, targetId);\n   342\t    await this.executor.restart({ target });\n   343\t    return target;\n   344\t  }\n   345\t  async attachDomain(\n   346\t    scope: HostFnScope,\n   347\t    input: { targetId: string; hostname: string; tls?: boolean },\n   348\t  ) {\n   349\t    const requestedTls = input.tls ?? true;\n   350\t    const attachmentKey = JSON.stringify([scopeKey(scope), input.targetId, input.hostname]);\n   351\t    const inFlight = this.domainAttachments.get(attachmentKey);\n   352\t    if (inFlight) {\n   353\t      if (inFlight.tls !== requestedTls) {\n   354\t        throw new Error(\"HostFn domain already exists with different TLS configuration.\");\n   355\t      }\n   356\t      return inFlight.promise;\n   357\t    }\n   358\t    const promise = this.attachDomainOnce(scope, { ...input, tls: requestedTls });\n   359\t    this.domainAttachments.set(attachmentKey, { tls: requestedTls, promise });\n   360\t    try {\n   361\t      return await promise;\n   362\t    } finally {\n   363\t      if (this.domainAttachments.get(attachmentKey)?.promise === promise) {\n   364\t        this.domainAttachments.delete(attachmentKey);\n   365\t      }\n   366\t    }\n   367\t  }\n   368\t\n   369\t  private async attachDomainOnce(\n   370\t    scope: HostFnScope,\n   371\t    input: { targetId: string; hostname: string; tls: boolean },\n   372\t  ) {\n   373\t    const target = await this.target(scope, input.targetId);\n   374\t    const claim = await this.store.claimDomainAttachment({\n   375\t      id: identifier(\"domain\"),\n   376\t      scope,\n   377\t      targetId: target.id,\n   378\t      hostname: input.hostname,\n   379\t      tls: input.tls,\n   380\t      status: \"pending\",\n   381\t      updatedAt: new Date().toISOString(),\n   382\t    });\n   383\t    const domain = claim.domain;\n   384\t    if (!claim.acquired) return domain;\n   385\t    const claimToken = claim.claimToken!;\n   386\t    const currentDomain = async () =>\n   387\t      (await this.store.listDomains(scope, target.id)).find((candidate) => candidate.id === domain.id);\n   388\t    try {\n   389\t      // Executors must make retries with the same domain ID idempotent. Reusing\n   390\t      // a failed/pending intent lets ambiguous provider outcomes converge.\n   391\t      await this.executor.attachDomain({ target, domain });\n   392\t    } catch (error) {\n   393\t      try {\n   394\t        const completed = await this.store.completeDomainAttachment({\n   395\t          ...domain,\n   396\t          status: \"failed\",\n   397\t          updatedAt: new Date().toISOString(),\n   398\t        }, claimToken);\n   399\t        if (!completed) {\n   400\t          const current = await currentDomain();\n   401\t          if (current) return current;\n   402\t        }\n   403\t      } catch {\n   404\t        // The already-durable pending intent remains discoverable and reusable.\n   405\t      }\n   406\t      try {\n   407\t        await this.store.releaseDomainAttachmentClaim(scope, domain.id, claimToken);\n   408\t      } catch {\n   409\t        // Durable stores must expire abandoned provider-work leases.\n   410\t      }\n   411\t      throw error;\n   412\t    }\n   413\t    const active = { ...domain, status: \"active\" as const };\n   414\t    try {\n   415\t      const completed = await this.store.completeDomainAttachment(active, claimToken);\n   416\t      if (!completed) {\n   417\t        const current = await currentDomain();\n   418\t        if (current) return current;\n   419\t        throw new Error(\"HostFn domain attachment lease was superseded.\");\n   420\t      }\n   421\t    } catch (error) {\n   422\t      try {\n   423\t        await this.store.releaseDomainAttachmentClaim(scope, domain.id, claimToken);\n   424\t      } catch {\n   425\t        // Durable stores must expire abandoned provider-work leases.\n   426\t      }\n   427\t      throw error;\n   428\t    }\n   429\t    return active;\n   430\t  }\n   431\t  async detachDomain(scope: HostFnScope, id: string) {\n   432\t    const domain = (await this.store.listDomains(scope)).find(\n   433\t      (item) => item.id === id,\n   434\t    );\n   435\t    if (!domain) throw new Error(`HostFn domain not found: ${id}`);\n   436\t    const target = await this.target(scope, domain.targetId);\n   437\t    try {\n   438\t      await this.executor.detachDomain({ target, domain });\n   439\t    } catch (error) {\n   440\t      if (!providerReportedNotFound(error)) throw error;\n   441\t    }\n   442\t    await this.store.deleteDomain(scope, id);\n   443\t    return domain;\n   444\t  }\n   445\t  async setVariable(\n   446\t    scope: HostFnScope,\n   447\t    input: { targetId: string; key: string; value: string },\n   448\t  ) {\n   449\t    if (!/^[A-Z_][A-Z0-9_]*$/.test(input.key))\n   450\t      throw new Error(\"Invalid environment variable key.\");\n   451\t    const target = await this.target(scope, input.targetId);\n   452\t    const variable: HostFnVariable = {\n   453\t      id: `${target.id}:${input.key}`,\n   454\t      scope,\n   455\t      targetId: target.id,\n   456\t      key: input.key,\n   457\t      updatedAt: new Date().toISOString(),\n   458\t    };\n   459\t    // Persist a deletion-capable intent before the provider side effect so an\n   460\t    // ambiguous or acknowledged provider write always remains reconcilable.\n   461\t    await this.store.putVariable(variable, input.value);\n   462\t    await this.executor.setVariable({\n   463\t      target,\n   464\t      key: input.key,\n   465\t      value: input.value,\n   466\t    });\n   467\t    return variable;\n   468\t  }\n   469\t  async deleteVariable(scope: HostFnScope, id: string) {\n   470\t    const variable = (await this.store.listVariables(scope)).find(\n   471\t      (item) => item.id === id,\n   472\t    );\n   473\t    if (!variable) throw new Error(`HostFn variable not found: ${id}`);\n   474\t    const target = await this.target(scope, variable.targetId);\n   475\t    try {\n   476\t      await this.executor.deleteVariable({ target, key: variable.key });\n   477\t    } catch (error) {\n   478\t      if (!providerReportedNotFound(error)) throw error;\n   479\t    }\n   480\t    await this.store.deleteVariable(scope, id);\n   481\t    return variable;\n   482\t  }\n   483\t}\n   680\t    const compose = (withChild: boolean) => createSuperConsole({\n   681\t      adapters: withChild ? [ownerAdapter, childAdapter] : [ownerAdapter],\n   682\t      enabledModules: withChild ? ['watchfn', 'catchfn'] : ['watchfn'],\n   683\t      auth: auth(),\n   684\t      shellPolicy: { authorize: () => true },\n   685\t    });\n   686\t    const folded = await (await compose(true).handle(request('/api/admin/v1/modules/watchfn'))).json();\n   687\t    const registry = await (await compose(true).handle(request('/api/admin/v1/registry'))).json();\n   688\t    expect(registry.data.enabledModules.map((module: { id: string }) => module.id)).toEqual(['watchfn', 'catchfn']);\n   689\t    expect(registry.data.modules.map((module: { id: string }) => module.id)).toEqual(['watchfn']);\n   690\t    expect(folded.data.module.foldedModuleIds).toEqual(['catchfn']);\n   691\t    expect(folded.data.module.resources).toEqual(expect.arrayContaining([\n   692\t      expect.objectContaining({ id: 'monitors', sourceModuleId: 'watchfn' }),\n   693\t      expect.objectContaining({ id: 'catchfn:errors', resourceId: 'errors', sourceModuleId: 'catchfn', foldedIntoModuleId: 'watchfn', href: '/modules/watchfn/catchfn%3Aerrors', apiHref: expect.stringContaining('/modules/catchfn/') }),\n   694\t    ]));\n   695\t    const ownerOnly = await (await compose(false).handle(request('/api/admin/v1/modules/watchfn'))).json();\n   696\t    expect(ownerOnly.data.module.foldedModuleIds).toEqual([]);\n   697\t    expect(JSON.stringify(ownerOnly.data.module)).not.toContain('catchfn:errors');\n   698\t  });\n   699\t\n   700\t  it('fails startup when enabled mutations lack required infrastructure while shell-only installs work', () => {\n   701\t    const capability = manifest({ destructive: true });\n   702\t    const adapter = createAdminCapabilityAdapter(capability, { [capability.operations[0]!.id]: async () => ({ ok: true as const, data: { accepted: true } }) });\n   703\t    expect(() => createSuperConsole({ adapters: [adapter], enabledModules: ['examplefn'], auth: auth(), shellPolicy: { authorize: () => true } })).toThrow(/audit sink/);\n   704\t    expect(() => createSuperConsole({ adapters: [adapter], enabledModules: ['examplefn'], auth: auth(), shellPolicy: { authorize: () => true }, audit: new MemoryAdminAuditSink() })).toThrow(/idempotency store/);\n   705\t    expect(() => createSuperConsole({ adapters: [adapter], enabledModules: ['examplefn'], auth: auth(), shellPolicy: { authorize: () => true }, audit: new MemoryAdminAuditSink(), idempotency: new MemoryAdminIdempotencyStore() })).toThrow(/staged confirmation/);\n   706\t    expect(() => createSuperConsole({\n   707\t      adapters: [adapter],\n   708\t      enabledModules: ['examplefn'],\n   709\t      auth: { ...auth(), authorizeMutation: undefined },\n   710\t      shellPolicy: { authorize: () => true },\n   711\t      audit: new MemoryAdminAuditSink(),\n   712\t      idempotency: new MemoryAdminIdempotencyStore(),\n   713\t      confirmation: { issue: async () => ({ token: 'bound', expiresAt: new Date(Date.now() + 60_000).toISOString() }), prepareActivation: async () => undefined, activate: async () => undefined, revoke: async () => undefined, verify: async () => true },\n   714\t    })).toThrow(/mutation authorization/);\n   715\t    expect(() => createSuperConsole({ adapters: [], enabledModules: [], auth: auth(), shellPolicy: { authorize: () => true } })).not.toThrow();\n   716\t    expect(() => createSuperConsole({ adapters: [], enabledModules: [], auth: auth() } as never)).toThrow(/shell authorization policy/);\n   717\t  });\n   718\t\n   719\t  it('issues input-bound confirmation only after input/permission/policy checks and verifies it on dispatch', async () => {\n   720\t    const { console, confirmation, handler, audit } = installation({ destructive: true, permissions: ['examplefn.records.delete'] });\n   721\t    const invalid = await console.handle(request('/api/admin/v1/confirmations', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ operationId: 'examplefn.records.delete', input: {} }) }));\n   722\t    expect(invalid.status).toBe(400);\n   723\t    const issued = await console.handle(request('/api/admin/v1/confirmations', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ operationId: 'examplefn.records.delete', input: { id: 'record_1' } }) }));\n   724\t    expect(issued.status).toBe(201);\n   725\t    expect(await issued.json()).toMatchObject({ ok: true as const, data: { token: 'bound-token', expiresAt: expect.any(String) } });\n   726\t    expect(confirmation.issue).toHaveBeenCalledWith(expect.objectContaining({\n   727\t      operationId: 'examplefn.records.delete',\n   728\t      input: { id: 'record_1' },\n   729\t      context: expect.objectContaining({ scope: expect.objectContaining({ installationId: 'org_1' }) }),\n   730\t    }));\n   731\t    const successAuditId = audit.events.find((event) => event.operationId === 'superconsole.confirmations.issue' && event.outcome === 'succeeded')?.id;\n   732\t    expect(successAuditId).toEqual(expect.any(String));\n   733\t    expect(confirmation.prepareActivation).toHaveBeenCalledWith(expect.objectContaining({ token: 'bound-token', auditId: successAuditId }));\n   734\t    expect(confirmation.activate).toHaveBeenCalledWith(expect.objectContaining({ token: 'bound-token', auditId: successAuditId }));\n   735\t    expect(confirmation.revoke).not.toHaveBeenCalled();\n   736\t    const executed = await console.handle(request('/api/admin/v1/modules/examplefn/records/record_1', {\n   737\t      method: 'DELETE',\n   738\t      headers: { 'idempotency-key': 'idem_1', 'x-admin-confirmation': 'bound-token' },\n   739\t    }));\n   740\t    expect(executed.status).toBe(200);\n   741\t    expect(handler).toHaveBeenCalledTimes(1);\n   742\t    expect(confirmation.verify).toHaveBeenCalled();\n   743\t  });\n   744\t\n   745\t  it('never activates a staged confirmation when its terminal audit fails', async () => {\n   746\t    const capability = manifest({ destructive: true });\n   747\t    const issue = vi.fn(async () => ({ token: 'staged-token', expiresAt: new Date(Date.now() + 60_000).toISOString() }));\n   748\t    let active = false;\n   749\t    const activate = vi.fn(async () => { active = true; });\n   750\t    const revoke = vi.fn(async () => { throw new Error('revocation unavailable'); });\n   751\t    const console = createSuperConsole({\n   752\t      adapters: [createAdminCapabilityAdapter(capability, {\n   753\t        'examplefn.records.delete': async () => ({ ok: true as const, data: { accepted: true } }),\n   754\t      })],\n   755\t      enabledModules: ['examplefn'],\n   756\t      auth: auth(),\n   757\t      shellPolicy: { authorize: () => true },\n   758\t      audit: {\n   759\t        idempotentById: true,\n   760\t        write: async (event) => {\n   761\t          if (event.operationId === 'superconsole.confirmations.issue' && event.outcome === 'succeeded') {\n   762\t            throw new Error('terminal confirmation audit unavailable');\n   763\t          }\n   764\t        },\n   765\t      },\n   766\t      idempotency: new MemoryAdminIdempotencyStore(),\n   767\t      confirmation: { issue, prepareActivation: async () => undefined, activate, revoke, verify: async () => active },\n   768\t    });\n   769\t\n   770\t    const response = await console.handle(request('/api/admin/v1/confirmations', {\n   771\t      method: 'POST',\n   772\t      headers: { 'content-type': 'application/json' },\n   773\t      body: JSON.stringify({ operationId: 'examplefn.records.delete', input: { id: 'record_1' } }),\n   774\t    }));\n   775\t\n   776\t    expect(response.status).toBe(503);\n   777\t    expect(issue).toHaveBeenCalledTimes(1);\n   778\t    expect(activate).not.toHaveBeenCalled();\n   779\t    expect(revoke).toHaveBeenCalledWith(expect.objectContaining({ token: 'staged-token' }));\n   780\t    expect(active).toBe(false);\n   781\t  });\n   782\t\n   783\t  it('records activation failure as denied and leaves the staged token unusable', async () => {\n   784\t    const capability = manifest({ destructive: true });\n   785\t    const outcomes: Array<{ outcome: string; errorCode?: string }> = [];\n   786\t    let active = false;\n   787\t    const revoke = vi.fn(async () => { active = false; });\n   788\t    const verify = vi.fn(async () => active);\n   789\t    const console = createSuperConsole({\n   790\t      adapters: [createAdminCapabilityAdapter(capability, {\n   791\t        'examplefn.records.delete': async () => ({ ok: true as const, data: { accepted: true } }),\n   792\t      })],\n   793\t      enabledModules: ['examplefn'],\n   794\t      auth: auth(),\n   795\t      shellPolicy: { authorize: () => true },\n   796\t      audit: {\n   797\t        idempotentById: true,\n   798\t        write: async (event) => {\n   799\t          if (event.operationId === 'superconsole.confirmations.issue') {\n   800\t            outcomes.push({ outcome: event.outcome, errorCode: event.errorCode });\n   801\t          }\n   802\t        },\n   803\t      },\n   804\t      idempotency: new MemoryAdminIdempotencyStore(),\n   805\t      confirmation: {\n   806\t        issue: async () => ({ token: 'staged-token', expiresAt: new Date(Date.now() + 60_000).toISOString() }),\n   807\t        prepareActivation: async () => undefined,\n   808\t        activate: async () => { active = true; throw new Error('activation unavailable'); },\n   809\t        revoke,\n   810\t        verify,\n   811\t      },\n   812\t    });\n   813\t\n   814\t    const response = await console.handle(request('/api/admin/v1/confirmations', {\n   815\t      method: 'POST',\n   816\t      headers: { 'content-type': 'application/json' },\n   817\t      body: JSON.stringify({ operationId: 'examplefn.records.delete', input: { id: 'record_1' } }),\n   818\t    }));\n   819\t\n   820\t    expect(response.status).toBe(503);\n   821\t    expect(await verify({} as never)).toBe(false);\n   822\t    expect(revoke).toHaveBeenCalledWith(expect.objectContaining({ token: 'staged-token' }));\n   823\t    expect(outcomes).toEqual([\n   824\t      { outcome: 'attempted', errorCode: undefined },\n   825\t      { outcome: 'succeeded', errorCode: undefined },\n   826\t      { outcome: 'denied', errorCode: 'CONFIRMATION_ACTIVATION_FAILED' },\n   827\t    ]);\n   828\t  });\n   829\t\n   830\t  it('returns 405/OPTIONS/HEAD semantics instead of route ambiguity', async () => {\n{\n  \"name\": \"hostfn\",\n  \"version\": \"0.1.7\",\n  \"license\": \"MIT\",\n  \"description\": \"Universal application deployment CLI\",\n  \"type\": \"module\",\n  \"bin\": {\n    \"hostfn\": \"./dist/index.js\"\n  },\n  \"exports\": {\n    \"./operator\": {\n      \"types\": \"./dist/operator.d.ts\",\n      \"default\": \"./dist/operator.js\"\n    }\n  },\n  \"scripts\": {\n    \"dev\": \"tsx watch src/index.ts\",\n    \"build\": \"tsc\",\n    \"clean\": \"rm -rf dist\",\n    \"lint\": \"tsc --noEmit\",\n    \"test\": \"vitest\",\n    \"test:watch\": \"vitest --watch\",\n    \"test:coverage\": \"vitest --coverage\"\n  },\n  \"dependencies\": {\n    \"commander\": \"^11.1.0\",\n    \"chalk\": \"^5.3.0\",\n    \"ora\": \"^7.0.1\",\n    \"inquirer\": \"^9.2.12\",\n    \"semver\": \"^7.7.2\",\n    \"zod\": \"^3.22.4\",\n    \"ssh2\": \"^1.15.0\",\n    \"dotenv\": \"^16.3.1\",\n    \"execa\": \"^8.0.1\"\n  },\n  \"devDependencies\": {\n    \"@types/semver\": \"^7.7.1\",\n    \"@types/node\": \"^20.10.0\",\n    \"@types/ssh2\": \"^1.15.0\",\n    \"@types/inquirer\": \"^9.0.7\",\n    \"@vitest/coverage-v8\": \"^1.6.1\",\n    \"typescript\": \"^5.3.0\",\n    \"tsx\": \"^4.7.0\",\n    \"vitest\": \"^1.6.0\",\n    \"fast-glob\": \"^3.3.2\"\n  },\n  \"author\": \"21n\",\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/21nCo/super-functions.git\",\n    \"directory\": \"hostfn/cli\"\n  },\n  \"bugs\": {\n    \"url\": \"https://github.com/21nCo/super-functions/issues\"\n  },\n  \"keywords\": [\n    \"deployment\",\n    \"vps\"\n  ],\n  \"engines\": {\n    \"node\": \">=18.0.0\"\n  },\n  \"publishConfig\": {\n    \"access\": \"public\"\n  },\n  \"superfunctions\": {\n    \"initFunction\": \"hostFn\",\n    \"schemaVersion\": 1,\n    \"namespace\": \"hostfn\"\n  }\n}\n{\n  \"name\": \"@superfunctions/admin\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Shared administration contracts and runtime for Superfunctions\",\n  \"type\": \"module\",\n  \"main\": \"./dist/index.js\",\n  \"types\": \"./dist/index.d.ts\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"import\": \"./dist/index.js\"\n    }\n  },\n  \"files\": [\n    \"dist\",\n    \"README.md\"\n  ],\n  \"scripts\": {\n    \"build\": \"tsc -p tsconfig.json\",\n    \"review:mutation-risk\": \"node scripts/risk-review.mjs\",\n    \"verify:sdk-contracts\": \"node scripts/verify-sdk-contracts.mjs\",\n    \"test\": \"vitest run\",\n    \"typecheck\": \"tsc -p tsconfig.json --noEmit\"\n  },\n  \"dependencies\": {\n    \"@mcpfn/core\": \"0.0.1\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^5.7.2\",\n    \"vitest\": \"3.2.4\"\n  },\n  \"engines\": {\n    \"node\": \">=20\"\n  },\n  \"license\": \"MIT\"\n}\n{\n  \"name\": \"superconsole\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"description\": \"Self-hosted modular operator console for Superfunctions\",\n  \"type\": \"module\",\n  \"exports\": {\n    \"./server\": {\n      \"types\": \"./dist/server/index.d.ts\",\n      \"import\": \"./dist/server/index.js\"\n    }\n  },\n  \"scripts\": {\n    \"dev\": \"npm run build:server && vite dev --host 127.0.0.1 --port 4178\",\n    \"build\": \"npm run build:server && vite build\",\n    \"build:server\": \"tsc -p tsconfig.server.json\",\n    \"preview\": \"vite preview --host 127.0.0.1 --port 4178\",\n    \"check\": \"svelte-kit sync && svelte-check --tsconfig ./tsconfig.json\",\n    \"lint\": \"svelte-kit sync && svelte-check --tsconfig ./tsconfig.json\",\n    \"typecheck\": \"svelte-kit sync && svelte-check --tsconfig ./tsconfig.json\",\n    \"test\": \"npm run verify:function-agnostic && vitest run\",\n    \"test:ui\": \"vitest run tests/ui\",\n    \"probe:smoke\": \"node tests/probes/super-console.smoke.mjs\",\n    \"verify:function-agnostic\": \"node scripts/verify-function-agnostic.mjs\"\n  },\n  \"dependencies\": {\n    \"@mcpfn/core\": \"0.0.1\",\n    \"@superfunctions/admin\": \"0.1.0\",\n    \"@sveltejs/kit\": \"2.69.3\",\n    \"@uifn/components\": \"0.0.1\",\n    \"@uifn/components-svelte\": \"0.0.1\",\n    \"@uifn/theme\": \"0.0.1\",\n    \"@uifn/theme-tailwind\": \"0.0.1\",\n    \"svelte\": \"5.46.4\"\n  },\n  \"devDependencies\": {\n    \"@authfn/admin\": \"REDACTED\",\n    \"@authfn/password\": \"REDACTED\",\n    \"@authfn/two-factor\": \"REDACTED\",\n    \"@clifn/admin\": \"0.1.0\",\n    \"@extfn/admin\": \"0.1.0\",\n    \"@sveltejs/adapter-node\": \"^5.3.2\",\n    \"@sveltejs/vite-plugin-svelte\": \"4.0.4\",\n    \"@testing-library/jest-dom\": \"^6.9.1\",\n    \"@testing-library/svelte\": \"^5.2.8\",\n    \"@superfunctions/db\": \"0.1.4\",\n    \"@types/node\": \"^20.19.27\",\n    \"autoprefixer\": \"^10.4.21\",\n    \"jsdom\": \"^26.1.0\",\n    \"postcss\": \"^8.5.6\",\n    \"svelte-check\": \"4.3.4\",\n    \"tailwindcss\": \"3.4.17\",\n    \"typescript\": \"5.9.3\",\n    \"vite\": \"5.4.21\",\n    \"vitest\": \"3.2.4\"\n  },\n  \"engines\": {\n    \"node\": \">=20 <23\"\n  },\n  \"license\": \"Apache-2.0\",\n  \"superfunctions\": {\n    \"uses\": [\n      \"mcpfn\",\n      \"uifn\"\n    ],\n    \"schemaVersion\": 1\n  }\n}\n","exit_code":0,"duration":{"secs":0,"nanos":6292},"formatted_output":"     1\texport interface HostFnScope {\n     2\t  installationId: string;\n     3\t  workspaceId: string;\n     4\t  projectId: string;\n     5\t  environmentId: string;\n     6\t}\n     7\t\n     8\texport interface HostFnTarget {\n     9\t  id: string;\n    10\t  scope: HostFnScope;\n    11\t  name: string;\n    12\t  server: string;\n    13\t  runtime: string;\n    14\t  status: \"ready\" | \"degraded\" | \"offline\";\n    15\t  updatedAt: string;\n    16\t}\n    17\t\n    18\texport interface HostFnDeployment {\n    19\t  id: string;\n    20\t  scope: HostFnScope;\n    21\t  targetId: string;\n    22\t  revision: string;\n    23\t  status:\n    24\t    | \"queued\"\n    25\t    | \"running\"\n    26\t    | \"succeeded\"\n    27\t    | \"failed\"\n    28\t    | \"cancelled\"\n    29\t    | \"rolled-back\";\n    30\t  createdAt: string;\n    31\t  updatedAt: string;\n    32\t}\n    33\t\n    34\texport interface HostFnDomain {\n    35\t  id: string;\n    36\t  scope: HostFnScope;\n    37\t  targetId: string;\n    38\t  hostname: string;\n    39\t  tls: boolean;\n    40\t  status: \"pending\" | \"active\" | \"failed\";\n    41\t  updatedAt: string;\n    42\t}\n    43\t\n    44\texport interface HostFnVariable {\n    45\t  id: string;\n    46\t  scope: HostFnScope;\n    47\t  targetId: string;\n    48\t  key: string;\n    49\t  updatedAt: string;\n    50\t}\n    51\t\n    52\texport interface HostFnOperatorStore {\n    53\t  listTargets(scope: HostFnScope): Promise<HostFnTarget[]>;\n    54\t  getTarget(scope: HostFnScope, id: string): Promise<HostFnTarget | undefined>;\n    55\t  putTarget(target: HostFnTarget): Promise<void>;\n    56\t  listDeployments(\n    57\t    scope: HostFnScope,\n    58\t    targetId?: string,\n    59\t  ): Promise<HostFnDeployment[]>;\n    60\t  getDeployment(\n    61\t    scope: HostFnScope,\n    62\t    id: string,\n    63\t  ): Promise<HostFnDeployment | undefined>;\n    64\t  putDeployment(deployment: HostFnDeployment): Promise<void>;\n    65\t  listDomains(scope: HostFnScope, targetId?: string): Promise<HostFnDomain[]>;\n    66\t  /** Atomically reserve one immutable identity and acquire a reclaimable provider-work lease. */\n    67\t  claimDomainAttachment(domain: HostFnDomain): Promise<{\n    68\t    domain: HostFnDomain;\n    69\t    acquired: boolean;\n    70\t    claimToken?: string;\n    71\t  }>;\n    72\t  /** Persist a terminal state only when `claimToken` is still the current lease. */\n    73\t  completeDomainAttachment(domain: HostFnDomain, claimToken: string): Promise<boolean>;\n    74\t  releaseDomainAttachmentClaim(scope: HostFnScope, id: string, claimToken: string): Promise<void>;\n    75\t  putDomain(domain: HostFnDomain): Promise<void>;\n    76\t  deleteDomain(scope: HostFnScope, id: string): Promise<boolean>;\n    77\t  listVariables(\n    78\t    scope: HostFnScope,\n    79\t    targetId?: string,\n    80\t  ): Promise<HostFnVariable[]>;\n    81\t  putVariable(variable: HostFnVariable, secretValue: string): Promise<void>;\n    82\t  deleteVariable(scope: HostFnScope, id: string): Promise<boolean>;\n    83\t}\n    84\t\n    85\texport interface HostFnDeploymentExecutor {\n    86\t  deploy(input: {\n    87\t    target: HostFnTarget;\n    88\t    deployment: HostFnDeployment;\n    89\t  }): Promise<void>;\n    90\t  cancel(input: {\n    91\t    target: HostFnTarget;\n    92\t    deployment: HostFnDeployment;\n    93\t  }): Promise<void>;\n    94\t  rollback(input: {\n    95\t    target: HostFnTarget;\n    96\t    deployment: HostFnDeployment;\n    97\t  }): Promise<void>;\n    98\t  restart(input: { target: HostFnTarget }): Promise<void>;\n    99\t  /** Must be idempotent when retried with the same domain ID. */\n   100\t  attachDomain(input: {\n   101\t    target: HostFnTarget;\n   102\t    domain: HostFnDomain;\n   103\t  }): Promise<void>;\n   104\t  detachDomain(input: {\n   105\t    target: HostFnTarget;\n   106\t    domain: HostFnDomain;\n   107\t  }): Promise<void>;\n   108\t  setVariable(input: {\n   109\t    target: HostFnTarget;\n   110\t    key: string;\n   111\t    value: string;\n   112\t  }): Promise<void>;\n   113\t  deleteVariable(input: { target: HostFnTarget; key: string }): Promise<void>;\n   114\t}\n   115\t\n   116\tfunction providerReportedNotFound(error: unknown): boolean {\n   117\t  if (!error || typeof error !== \"object\") return false;\n   118\t  const candidate = error as { code?: unknown; status?: unknown; statusCode?: unknown };\n   119\t  return candidate.code === \"not_found\" || candidate.code === \"NOT_FOUND\" ||\n   120\t    candidate.status === 404 || candidate.statusCode === 404;\n   121\t}\n   122\t\n   123\tfunction scopeKey(scope: HostFnScope): string {\n   124\t  return JSON.stringify([\n   125\t    scope.installationId,\n   340\t  async restart(scope: HostFnScope, targetId: string) {\n   341\t    const target = await this.target(scope, targetId);\n   342\t    await this.executor.restart({ target });\n   343\t    return target;\n   344\t  }\n   345\t  async attachDomain(\n   346\t    scope: HostFnScope,\n   347\t    input: { targetId: string; hostname: string; tls?: boolean },\n   348\t  ) {\n   349\t    const requestedTls = input.tls ?? true;\n   350\t    const attachmentKey = JSON.stringify([scopeKey(scope), input.targetId, input.hostname]);\n   351\t    const inFlight = this.domainAttachments.get(attachmentKey);\n   352\t    if (inFlight) {\n   353\t      if (inFlight.tls !== requestedTls) {\n   354\t        throw new Error(\"HostFn domain already exists with different TLS configuration.\");\n   355\t      }\n   356\t      return inFlight.promise;\n   357\t    }\n   358\t    const promise = this.attachDomainOnce(scope, { ...input, tls: requestedTls });\n   359\t    this.domainAttachments.set(attachmentKey, { tls: requestedTls, promise });\n   360\t    try {\n   361\t      return await promise;\n   362\t    } finally {\n   363\t      if (this.domainAttachments.get(attachmentKey)?.promise === promise) {\n   364\t        this.domainAttachments.delete(attachmentKey);\n   365\t      }\n   366\t    }\n   367\t  }\n   368\t\n   369\t  private async attachDomainOnce(\n   370\t    scope: HostFnScope,\n   371\t    input: { targetId: string; hostname: string; tls: boolean },\n   372\t  ) {\n   373\t    const target = await this.target(scope, input.targetId);\n   374\t    const claim = await this.store.claimDomainAttachment({\n   375\t      id: identifier(\"domain\"),\n   376\t      scope,\n   377\t      targetId: target.id,\n   378\t      hostname: input.hostname,\n   379\t      tls: input.tls,\n   380\t      status: \"pending\",\n   381\t      updatedAt: new Date().toISOString(),\n   382\t    });\n   383\t    const domain = claim.domain;\n   384\t    if (!claim.acquired) return domain;\n   385\t    const claimToken = claim.claimToken!;\n   386\t    const currentDomain = async () =>\n   387\t      (await this.store.listDomains(scope, target.id)).find((candidate) => candidate.id === domain.id);\n   388\t    try {\n   389\t      // Executors must make retries with the same domain ID idempotent. Reusing\n   390\t      // a failed/pending intent lets ambiguous provider outcomes converge.\n   391\t      await this.executor.attachDomain({ target, domain });\n   392\t    } catch (error) {\n   393\t      try {\n   394\t        const completed = await this.store.completeDomainAttachment({\n   395\t          ...domain,\n   396\t          status: \"failed\",\n   397\t          updatedAt: new Date().toISOString(),\n   398\t        }, claimToken);\n   399\t        if (!completed) {\n   400\t          const current = await currentDomain();\n   401\t          if (current) return current;\n   402\t        }\n   403\t      } catch {\n   404\t        // The already-durable pending intent remains discoverable and reusable.\n   405\t      }\n   406\t      try {\n   407\t        await this.store.releaseDomainAttachmentClaim(scope, domain.id, claimToken);\n   408\t      } catch {\n   409\t        // Durable stores must expire abandoned provider-work leases.\n   410\t      }\n   411\t      throw error;\n   412\t    }\n   413\t    const active = { ...domain, status: \"active\" as const };\n   414\t    try {\n   415\t      const completed = await this.store.completeDomainAttachment(active, claimToken);\n   416\t      if (!completed) {\n   417\t        const current = await currentDomain();\n   418\t        if (current) return current;\n   419\t        throw new Error(\"HostFn domain attachment lease was superseded.\");\n   420\t      }\n   421\t    } catch (error) {\n   422\t      try {\n   423\t        await this.store.releaseDomainAttachmentClaim(scope, domain.id, claimToken);\n   424\t      } catch {\n   425\t        // Durable stores must expire abandoned provider-work leases.\n   426\t      }\n   427\t      throw error;\n   428\t    }\n   429\t    return active;\n   430\t  }\n   431\t  async detachDomain(scope: HostFnScope, id: string) {\n   432\t    const domain = (await this.store.listDomains(scope)).find(\n   433\t      (item) => item.id === id,\n   434\t    );\n   435\t    if (!domain) throw new Error(`HostFn domain not found: ${id}`);\n   436\t    const target = await this.target(scope, domain.targetId);\n   437\t    try {\n   438\t      await this.executor.detachDomain({ target, domain });\n   439\t    } catch (error) {\n   440\t      if (!providerReportedNotFound(error)) throw error;\n   441\t    }\n   442\t    await this.store.deleteDomain(scope, id);\n   443\t    return domain;\n   444\t  }\n   445\t  async setVariable(\n   446\t    scope: HostFnScope,\n   447\t    input: { targetId: string; key: string; value: string },\n   448\t  ) {\n   449\t    if (!/^[A-Z_][A-Z0-9_]*$/.test(input.key))\n   450\t      throw new Error(\"Invalid environment variable key.\");\n   451\t    const target = await this.target(scope, input.targetId);\n   452\t    const variable: HostFnVariable = {\n   453\t      id: `${target.id}:${input.key}`,\n   454\t      scope,\n   455\t      targetId: target.id,\n   456\t      key: input.key,\n   457\t      updatedAt: new Date().toISOString(),\n   458\t    };\n   459\t    // Persist a deletion-capable intent before the provider side effect so an\n   460\t    // ambiguous or acknowledged provider write always remains reconcilable.\n   461\t    await this.store.putVariable(variable, input.value);\n   462\t    await this.executor.setVariable({\n   463\t      target,\n   464\t      key: input.key,\n   465\t      value: input.value,\n   466\t    });\n   467\t    return variable;\n   468\t  }\n   469\t  async deleteVariable(scope: HostFnScope, id: string) {\n   470\t    const variable = (await this.store.listVariables(scope)).find(\n   471\t      (item) => item.id === id,\n   472\t    );\n   473\t    if (!variable) throw new Error(`HostFn variable not found: ${id}`);\n   474\t    const target = await this.target(scope, variable.targetId);\n   475\t    try {\n   476\t      await this.executor.deleteVariable({ target, key: variable.key });\n   477\t    } catch (error) {\n   478\t      if (!providerReportedNotFound(error)) throw error;\n   479\t    }\n   480\t    await this.store.deleteVariable(scope, id);\n   481\t    return variable;\n   482\t  }\n   483\t}\n   680\t    const compose = (withChild: boolean) => createSuperConsole({\n   681\t      adapters: withChild ? [ownerAdapter, childAdapter] : [ownerAdapter],\n   682\t      enabledModules: withChild ? ['watchfn', 'catchfn'] : ['watchfn'],\n   683\t      auth: auth(),\n   684\t      shellPolicy: { authorize: () => true },\n   685\t    });\n   686\t    const folded = await (await compose(true).handle(request('/api/admin/v1/modules/watchfn'))).json();\n   687\t    const registry = await (await compose(true).handle(request('/api/admin/v1/registry'))).json();\n   688\t    expect(registry.data.enabledModules.map((module: { id: string }) => module.id)).toEqual(['watchfn', 'catchfn']);\n   689\t    expect(registry.data.modules.map((module: { id: string }) => module.id)).toEqual(['watchfn']);\n   690\t    expect(folded.data.module.foldedModuleIds).toEqual(['catchfn']);\n   691\t    expect(folded.data.module.resources).toEqual(expect.arrayContaining([\n   692\t      expect.objectContaining({ id: 'monitors', sourceModuleId: 'watchfn' }),\n   693\t      expect.objectContaining({ id: 'catchfn:errors', resourceId: 'errors', sourceModuleId: 'catchfn', foldedIntoModuleId: 'watchfn', href: '/modules/watchfn/catchfn%3Aerrors', apiHref: expect.stringContaining('/modules/catchfn/') }),\n   694\t    ]));\n   695\t    const ownerOnly = await (await compose(false).handle(request('/api/admin/v1/modules/watchfn'))).json();\n   696\t    expect(ownerOnly.data.module.foldedModuleIds).toEqual([]);\n   697\t    expect(JSON.stringify(ownerOnly.data.module)).not.toContain('catchfn:errors');\n   698\t  });\n   699\t\n   700\t  it('fails startup when enabled mutations lack required infrastructure while shell-only installs work', () => {\n   701\t    const capability = manifest({ destructive: true });\n   702\t    const adapter = createAdminCapabilityAdapter(capability, { [capability.operations[0]!.id]: async () => ({ ok: true as const, data: { accepted: true } }) });\n   703\t    expect(() => createSuperConsole({ adapters: [adapter], enabledModules: ['examplefn'], auth: auth(), shellPolicy: { authorize: () => true } })).toThrow(/audit sink/);\n   704\t    expect(() => createSuperConsole({ adapters: [adapter], enabledModules: ['examplefn'], auth: auth(), shellPolicy: { authorize: () => true }, audit: new MemoryAdminAuditSink() })).toThrow(/idempotency store/);\n   705\t    expect(() => createSuperConsole({ adapters: [adapter], enabledModules: ['examplefn'], auth: auth(), shellPolicy: { authorize: () => true }, audit: new MemoryAdminAuditSink(), idempotency: new MemoryAdminIdempotencyStore() })).toThrow(/staged confirmation/);\n   706\t    expect(() => createSuperConsole({\n   707\t      adapters: [adapter],\n   708\t      enabledModules: ['examplefn'],\n   709\t      auth: { ...auth(), authorizeMutation: undefined },\n   710\t      shellPolicy: { authorize: () => true },\n   711\t      audit: new MemoryAdminAuditSink(),\n   712\t      idempotency: new MemoryAdminIdempotencyStore(),\n   713\t      confirmation: { issue: async () => ({ token: 'bound', expiresAt: new Date(Date.now() + 60_000).toISOString() }), prepareActivation: async () => undefined, activate: async () => undefined, revoke: async () => undefined, verify: async () => true },\n   714\t    })).toThrow(/mutation authorization/);\n   715\t    expect(() => createSuperConsole({ adapters: [], enabledModules: [], auth: auth(), shellPolicy: { authorize: () => true } })).not.toThrow();\n   716\t    expect(() => createSuperConsole({ adapters: [], enabledModules: [], auth: auth() } as never)).toThrow(/shell authorization policy/);\n   717\t  });\n   718\t\n   719\t  it('issues input-bound confirmation only after input/permission/policy checks and verifies it on dispatch', async () => {\n   720\t    const { console, confirmation, handler, audit } = installation({ destructive: true, permissions: ['examplefn.records.delete'] });\n   721\t    const invalid = await console.handle(request('/api/admin/v1/confirmations', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ operationId: 'examplefn.records.delete', input: {} }) }));\n   722\t    expect(invalid.status).toBe(400);\n   723\t    const issued = await console.handle(request('/api/admin/v1/confirmations', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ operationId: 'examplefn.records.delete', input: { id: 'record_1' } }) }));\n   724\t    expect(issued.status).toBe(201);\n   725\t    expect(await issued.json()).toMatchObject({ ok: true as const, data: { token: 'bound-token', expiresAt: expect.any(String) } });\n   726\t    expect(confirmation.issue).toHaveBeenCalledWith(expect.objectContaining({\n   727\t      operationId: 'examplefn.records.delete',\n   728\t      input: { id: 'record_1' },\n   729\t      context: expect.objectContaining({ scope: expect.objectContaining({ installationId: 'org_1' }) }),\n   730\t    }));\n   731\t    const successAuditId = audit.events.find((event) => event.operationId === 'superconsole.confirmations.issue' && event.outcome === 'succeeded')?.id;\n   732\t    expect(successAuditId).toEqual(expect.any(String));\n   733\t    expect(confirmation.prepareActivation).toHaveBeenCalledWith(expect.objectContaining({ token: 'bound-token', auditId: successAuditId }));\n   734\t    expect(confirmation.activate).toHaveBeenCalledWith(expect.objectContaining({ token: 'bound-token', auditId: successAuditId }));\n   735\t    expect(confirmation.revoke).not.toHaveBeenCalled();\n   736\t    const executed = await console.handle(request('/api/admin/v1/modules/examplefn/records/record_1', {\n   737\t      method: 'DELETE',\n   738\t      headers: { 'idempotency-key': 'idem_1', 'x-admin-confirmation': 'bound-token' },\n   739\t    }));\n   740\t    expect(executed.status).toBe(200);\n   741\t    expect(handler).toHaveBeenCalledTimes(1);\n   742\t    expect(confirmation.verify).toHaveBeenCalled();\n   743\t  });\n   744\t\n   745\t  it('never activates a staged confirmation when its terminal audit fails', async () => {\n   746\t    const capability = manifest({ destructive: true });\n   747\t    const issue = vi.fn(async () => ({ token: 'staged-token', expiresAt: new Date(Date.now() + 60_000).toISOString() }));\n   748\t    let active = false;\n   749\t    const activate = vi.fn(async () => { active = true; });\n   750\t    const revoke = vi.fn(async () => { throw new Error('revocation unavailable'); });\n   751\t    const console = createSuperConsole({\n   752\t      adapters: [createAdminCapabilityAdapter(capability, {\n   753\t        'examplefn.records.delete': async () => ({ ok: true as const, data: { accepted: true } }),\n   754\t      })],\n   755\t      enabledModules: ['examplefn'],\n   756\t      auth: auth(),\n   757\t      shellPolicy: { authorize: () => true },\n   758\t      audit: {\n   759\t        idempotentById: true,\n   760\t        write: async (event) => {\n   761\t          if (event.operationId === 'superconsole.confirmations.issue' && event.outcome === 'succeeded') {\n   762\t            throw new Error('terminal confirmation audit unavailable');\n   763\t          }\n   764\t        },\n   765\t      },\n   766\t      idempotency: new MemoryAdminIdempotencyStore(),\n   767\t      confirmation: { issue, prepareActivation: async () => undefined, activate, revoke, verify: async () => active },\n   768\t    });\n   769\t\n   770\t    const response = await console.handle(request('/api/admin/v1/confirmations', {\n   771\t      method: 'POST',\n   772\t      headers: { 'content-type': 'application/json' },\n   773\t      body: JSON.stringify({ operationId: 'examplefn.records.delete', input: { id: 'record_1' } }),\n   774\t    }));\n   775\t\n   776\t    expect(response.status).toBe(503);\n   777\t    expect(issue).toHaveBeenCalledTimes(1);\n   778\t    expect(activate).not.toHaveBeenCalled();\n   779\t    expect(revoke).toHaveBeenCalledWith(expect.objectContaining({ token: 'staged-token' }));\n   780\t    expect(active).toBe(false);\n   781\t  });\n   782\t\n   783\t  it('records activation failure as denied and leaves the staged token unusable', async () => {\n   784\t    const capability = manifest({ destructive: true });\n   785\t    const outcomes: Array<{ outcome: string; errorCode?: string }> = [];\n   786\t    let active = false;\n   787\t    const revoke = vi.fn(async () => { active = false; });\n   788\t    const verify = vi.fn(async () => active);\n   789\t    const console = createSuperConsole({\n   790\t      adapters: [createAdminCapabilityAdapter(capability, {\n   791\t        'examplefn.records.delete': async () => ({ ok: true as const, data: { accepted: true } }),\n   792\t      })],\n   793\t      enabledModules: ['examplefn'],\n   794\t      auth: auth(),\n   795\t      shellPolicy: { authorize: () => true },\n   796\t      audit: {\n   797\t        idempotentById: true,\n   798\t        write: async (event) => {\n   799\t          if (event.operationId === 'superconsole.confirmations.issue') {\n   800\t            outcomes.push({ outcome: event.outcome, errorCode: event.errorCode });\n   801\t          }\n   802\t        },\n   803\t      },\n   804\t      idempotency: new MemoryAdminIdempotencyStore(),\n   805\t      confirmation: {\n   806\t        issue: async () => ({ token: 'staged-token', expiresAt: new Date(Date.now() + 60_000).toISOString() }),\n   807\t        prepareActivation: async () => undefined,\n   808\t        activate: async () => { active = true; throw new Error('activation unavailable'); },\n   809\t        revoke,\n   810\t        verify,\n   811\t      },\n   812\t    });\n   813\t\n   814\t    const response = await console.handle(request('/api/admin/v1/confirmations', {\n   815\t      method: 'POST',\n   816\t      headers: { 'content-type': 'application/json' },\n   817\t      body: JSON.stringify({ operationId: 'examplefn.records.delete', input: { id: 'record_1' } }),\n   818\t    }));\n   819\t\n   820\t    expect(response.status).toBe(503);\n   821\t    expect(await verify({} as never)).toBe(false);\n   822\t    expect(revoke).toHaveBeenCalledWith(expect.objectContaining({ token: 'staged-token' }));\n   823\t    expect(outcomes).toEqual([\n   824\t      { outcome: 'attempted', errorCode: undefined },\n   825\t      { outcome: 'succeeded', errorCode: undefined },\n   826\t      { outcome: 'denied', errorCode: 'CONFIRMATION_ACTIVATION_FAILED' },\n   827\t    ]);\n   828\t  });\n   829\t\n   830\t  it('returns 405/OPTIONS/HEAD semantics instead of route ambiguity', async () => {\n{\n  \"name\": \"hostfn\",\n  \"version\": \"0.1.7\",\n  \"license\": \"MIT\",\n  \"description\": \"Universal application deployment CLI\",\n  \"type\": \"module\",\n  \"bin\": {\n    \"hostfn\": \"./dist/index.js\"\n  },\n  \"exports\": {\n    \"./operator\": {\n      \"types\": \"./dist/operator.d.ts\",\n      \"default\": \"./dist/operator.js\"\n    }\n  },\n  \"scripts\": {\n    \"dev\": \"tsx watch src/index.ts\",\n    \"build\": \"tsc\",\n    \"clean\": \"rm -rf dist\",\n    \"lint\": \"tsc --noEmit\",\n    \"test\": \"vitest\",\n    \"test:watch\": \"vitest --watch\",\n    \"test:coverage\": \"vitest --coverage\"\n  },\n  \"dependencies\": {\n    \"commander\": \"^11.1.0\",\n    \"chalk\": \"^5.3.0\",\n    \"ora\": \"^7.0.1\",\n    \"inquirer\": \"^9.2.12\",\n    \"semver\": \"^7.7.2\",\n    \"zod\": \"^3.22.4\",\n    \"ssh2\": \"^1.15.0\",\n    \"dotenv\": \"^16.3.1\",\n    \"execa\": \"^8.0.1\"\n  },\n  \"devDependencies\": {\n    \"@types/semver\": \"^7.7.1\",\n    \"@types/node\": \"^20.10.0\",\n    \"@types/ssh2\": \"^1.15.0\",\n    \"@types/inquirer\": \"^9.0.7\",\n    \"@vitest/coverage-v8\": \"^1.6.1\",\n    \"typescript\": \"^5.3.0\",\n    \"tsx\": \"^4.7.0\",\n    \"vitest\": \"^1.6.0\",\n    \"fast-glob\": \"^3.3.2\"\n  },\n  \"author\": \"21n\",\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/21nCo/super-functions.git\",\n    \"directory\": \"hostfn/cli\"\n  },\n  \"bugs\": {\n    \"url\": \"https://github.com/21nCo/super-functions/issues\"\n  },\n  \"keywords\": [\n    \"deployment\",\n    \"vps\"\n  ],\n  \"engines\": {\n    \"node\": \">=18.0.0\"\n  },\n  \"publishConfig\": {\n    \"access\": \"public\"\n  },\n  \"superfunctions\": {\n    \"initFunction\": \"hostFn\",\n    \"schemaVersion\": 1,\n    \"namespace\": \"hostfn\"\n  }\n}\n{\n  \"name\": \"@superfunctions/admin\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Shared administration contracts and runtime for Superfunctions\",\n  \"type\": \"module\",\n  \"main\": \"./dist/index.js\",\n  \"types\": \"./dist/index.d.ts\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"import\": \"./dist/index.js\"\n    }\n  },\n  \"files\": [\n    \"dist\",\n    \"README.md\"\n  ],\n  \"scripts\": {\n    \"build\": \"tsc -p tsconfig.json\",\n    \"review:mutation-risk\": \"node scripts/risk-review.mjs\",\n    \"verify:sdk-contracts\": \"node scripts/verify-sdk-contracts.mjs\",\n    \"test\": \"vitest run\",\n    \"typecheck\": \"tsc -p tsconfig.json --noEmit\"\n  },\n  \"dependencies\": {\n    \"@mcpfn/core\": \"0.0.1\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^5.7.2\",\n    \"vitest\": \"3.2.4\"\n  },\n  \"engines\": {\n    \"node\": \">=20\"\n  },\n  \"license\": \"MIT\"\n}\n{\n  \"name\": \"superconsole\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"description\": \"Self-hosted modular operator console for Superfunctions\",\n  \"type\": \"module\",\n  \"exports\": {\n    \"./server\": {\n      \"types\": \"./dist/server/index.d.ts\",\n      \"import\": \"./dist/server/index.js\"\n    }\n  },\n  \"scripts\": {\n    \"dev\": \"npm run build:server && vite dev --host 127.0.0.1 --port 4178\",\n    \"build\": \"npm run build:server && vite build\",\n    \"build:server\": \"tsc -p tsconfig.server.json\",\n    \"preview\": \"vite preview --host 127.0.0.1 --port 4178\",\n    \"check\": \"svelte-kit sync && svelte-check --tsconfig ./tsconfig.json\",\n    \"lint\": \"svelte-kit sync && svelte-check --tsconfig ./tsconfig.json\",\n    \"typecheck\": \"svelte-kit sync && svelte-check --tsconfig ./tsconfig.json\",\n    \"test\": \"npm run verify:function-agnostic && vitest run\",\n    \"test:ui\": \"vitest run tests/ui\",\n    \"probe:smoke\": \"node tests/probes/super-console.smoke.mjs\",\n    \"verify:function-agnostic\": \"node scripts/verify-function-agnostic.mjs\"\n  },\n  \"dependencies\": {\n    \"@mcpfn/core\": \"0.0.1\",\n    \"@superfunctions/admin\": \"0.1.0\",\n    \"@sveltejs/kit\": \"2.69.3\",\n    \"@uifn/components\": \"0.0.1\",\n    \"@uifn/components-svelte\": \"0.0.1\",\n    \"@uifn/theme\": \"0.0.1\",\n    \"@uifn/theme-tailwind\": \"0.0.1\",\n    \"svelte\": \"5.46.4\"\n  },\n  \"devDependencies\": {\n    \"@authfn/admin\": \"REDACTED\",\n    \"@authfn/password\": \"REDACTED\",\n    \"@authfn/two-factor\": \"REDACTED\",\n    \"@clifn/admin\": \"0.1.0\",\n    \"@extfn/admin\": \"0.1.0\",\n    \"@sveltejs/adapter-node\": \"^5.3.2\",\n    \"@sveltejs/vite-plugin-svelte\": \"4.0.4\",\n    \"@testing-library/jest-dom\": \"^6.9.1\",\n    \"@testing-library/svelte\": \"^5.2.8\",\n    \"@superfunctions/db\": \"0.1.4\",\n    \"@types/node\": \"^20.19.27\",\n    \"autoprefixer\": \"^10.4.21\",\n    \"jsdom\": \"^26.1.0\",\n    \"postcss\": \"^8.5.6\",\n    \"svelte-check\": \"4.3.4\",\n    \"tailwindcss\": \"3.4.17\",\n    \"typescript\": \"5.9.3\",\n    \"vite\": \"5.4.21\",\n    \"vitest\": \"3.2.4\"\n  },\n  \"engines\": {\n    \"node\": \">=20 <23\"\n  },\n  \"license\": \"Apache-2.0\",\n  \"superfunctions\": {\n    \"uses\": [\n      \"mcpfn\",\n      \"uifn\"\n    ],\n    \"schemaVersion\": 1\n  }\n}\n"},"started_at_ms":1787476033233,"completed_at_ms":1787476033233}}
{"timestamp":"2026-08-23T09:07:13.240Z","ordinal":12452,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a02ddf-bed8-7590-a3bf-cfab279a043c","call_id":"call_6k6SXaYvsQ3sbHrxQGvOqHFi","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"     1\texport interface HostFnScope {\n     2\t  installationId: string;\n     3\t  workspaceId: string;\n     4\t  projectId: string;\n     5\t  environmentId: string;\n     6\t}\n     7\t\n     8\texport interface HostFnTarget {\n     9\t  id: string;\n    10\t  scope: HostFnScope;\n    11\t  name: string;\n    12\t  server: string;\n    13\t  runtime: string;\n    14\t  status: \"ready\" | \"degraded\" | \"offline\";\n    15\t  updatedAt: string;\n    16\t}\n    17\t\n    18\texport interface HostFnDeployment {\n    19\t  id: string;\n    20\t  scope: HostFnScope;\n    21\t  targetId: string;\n    22\t  revision: string;\n    23\t  status:\n    24\t    | \"queued\"\n    25\t    | \"running\"\n    26\t    | \"succeeded\"\n    27\t    | \"failed\"\n    28\t    | \"cancelled\"\n    29\t    | \"rolled-back\";\n    30\t  createdAt: string;\n    31\t  updatedAt: string;\n    32\t}\n    33\t\n    34\texport interface HostFnDomain {\n    35\t  id: string;\n    36\t  scope: HostFnScope;\n    37\t  targetId: string;\n    38\t  hostname: string;\n    39\t  tls: boolean;\n    40\t  status: \"pending\" | \"active\" | \"failed\";\n    41\t  updatedAt: string;\n    42\t}\n    43\t\n    44\texport interface HostFnVariable {\n    45\t  id: string;\n    46\t  scope: HostFnScope;\n    47\t  targetId: string;\n    48\t  key: string;\n    49\t  updatedAt: string;\n    50\t}\n    51\t\n    52\texport interface HostFnOperatorStore {\n    53\t  listTargets(scope: HostFnScope): Promise<HostFnTarget[]>;\n    54\t  getTarget(scope: HostFnScope, id: string): Promise<HostFnTarget | undefined>;\n    55\t  putTarget(target: HostFnTarget): Promise<void>;\n    56\t  listDeployments(\n    57\t    scope: HostFnScope,\n    58\t    targetId?: string,\n    59\t  ): Promise<HostFnDeployment[]>;\n    60\t  getDeployment(\n    61\t    scope: HostFnScope,\n    62\t    id: string,\n    63\t  ): Promise<HostFnDeployment | undefined>;\n    64\t  putDeployment(deployment: HostFnDeployment): Promise<void>;\n    65\t  listDomains(scope: HostFnScope, targetId?: string): Promise<HostFnDomain[]>;\n    66\t  /** Atomically reserve one immutable identity and acquire a reclaimable provider-work lease. */\n    67\t  claimDomainAttachment(domain: HostFnDomain): Promise<{\n    68\t    domain: HostFnDomain;\n    69\t    acquired: boolean;\n    70\t    claimToken?: string;\n    71\t  }>;\n    72\t  /** Persist a terminal state only when `claimToken` is still the current lease. */\n    73\t  completeDomainAttachment(domain: HostFnDomain, claimToken: string): Promise<boolean>;\n    74\t  releaseDomainAttachmentClaim(scope: HostFnScope, id: string, claimToken: string): Promise<void>;\n    75\t  putDomain(domain: HostFnDomain): Promise<void>;\n    76\t  deleteDomain(scope: HostFnScope, id: string): Promise<boolean>;\n    77\t  listVariables(\n    78\t    scope: HostFnScope,\n    79\t    targetId?: string,\n    80\t  ): Promise<HostFnVariable[]>;\n    81\t  putVariable(variable: HostFnVariable, secretValue: string): Promise<void>;\n    82\t  deleteVariable(scope: HostFnScope, id: string): Promise<boolean>;\n    83\t}\n    84\t\n    85\texport interface HostFnDeploymentExecutor {\n    86\t  deploy(input: {\n    87\t    target: HostFnTarget;\n    88\t    deployment: HostFnDeployment;\n    89\t  }): Promise<void>;\n    90\t  cancel(input: {\n    91\t    target: HostFnTarget;\n    92\t    deployment: HostFnDeployment;\n    93\t  }): Promise<void>;\n    94\t  rollback(input: {\n    95\t    target: HostFnTarget;\n    96\t    deployment: HostFnDeployment;\n    97\t  }): Promise<void>;\n    98\t  restart(input: { target: HostFnTarget }): Promise<void>;\n    99\t  /** Must be idempotent when retried with the same domain ID. */\n   100\t  attachDomain(input: {\n   101\t    target: HostFnTarget;\n   102\t    domain: HostFnDomain;\n   103\t  }): Promise<void>;\n   104\t  detachDomain(input: {\n   105\t    target: HostFnTarget;\n   106\t    domain: HostFnDomain;\n   107\t  }): Promise<void>;\n   108\t  setVariable(input: {\n   109\t    target: HostFnTarget;\n   110\t    key: string;\n   111\t    value: string;\n   112\t  }): Promise<void>;\n   113\t  deleteVariable(input: { target: HostFnTarget; key: string }): Promise<void>;\n   114\t}\n   115\t\n   116\tfunction providerReportedNotFound(error: unknown): boolean {\n   117\t  if (!error || typeof error !== \"object\") return false;\n   118\t  const candidate = error as { code?: unknown; status?: unknown; statusCode?: unknown };\n   119\t  return candidate.code === \"not_found\" || candidate.code === \"NOT_FOUND\" ||\n   120\t    candidate.status === 404 || candidate.statusCode === 404;\n   121\t}\n   122\t\n   123\tfunction scopeKey(scope: HostFnScope): string {\n   124\t  return JSON.stringify([\n   125\t    scope.installationId,\n   340\t  async restart(scope: HostFnScope, targetId: string) {\n   341\t    const target = await this.target(scope, targetId);\n   342\t    await this.executor.restart({ target });\n   343\t    return target;\n   344\t  }\n   345\t  async attachDomain(\n   346\t    scope: HostFnScope,\n   347\t    input: { targetId: string; hostname: string; tls?: boolean },\n   348\t  ) {\n   349\t    const requestedTls = input.tls ?? true;\n   350\t    const attachmentKey = JSON.stringify([scopeKey(scope), input.targetId, input.hostname]);\n   351\t    const inFlight = this.domainAttachments.get(attachmentKey);\n   352\t    if (inFlight) {\n   353\t      if (inFlight.tls !== requestedTls) {\n   354\t        throw new Error(\"HostFn domain already exists with different TLS configuration.\");\n   355\t      }\n   356\t      return inFlight.promise;\n   357\t    }\n   358\t    const promise = this.attachDomainOnce(scope, { ...input, tls: requestedTls });\n   359\t    this.domainAttachments.set(attachmentKey, { tls: requestedTls, promise });\n   360\t    try {\n   361\t      return await promise;\n   362\t    } finally {\n   363\t      if (this.domainAttachments.get(attachmentKey)?.promise === promise) {\n   364\t        this.domainAttachments.delete(attachmentKey);\n   365\t      }\n   366\t    }\n   367\t  }\n   368\t\n   369\t  private async attachDomainOnce(\n   370\t    scope: HostFnScope,\n   371\t    input: { targetId: string; hostname: string; tls: boolean },\n   372\t  ) {\n   373\t    const target = await this.target(scope, input.targetId);\n   374\t    const claim = await this.store.claimDomainAttachment({\n   375\t      id: identifier(\"domain\"),\n   376\t      scope,\n   377\t      targetId: target.id,\n   378\t      hostname: input.hostname,\n   379\t      tls: input.tls,\n   380\t      status: \"pending\",\n   381\t      updatedAt: new Date().toISOString(),\n   382\t    });\n   383\t    const domain = claim.domain;\n   384\t    if (!claim.acquired) return domain;\n   385\t    const claimToken = claim.claimToken!;\n   386\t    const currentDomain = async () =>\n   387\t      (await this.store.listDomains(scope, target.id)).find((candidate) => candidate.id === domain.id);\n   388\t    try {\n   389\t      // Executors must make retries with the same domain ID idempotent. Reusing\n   390\t      // a failed/pending intent lets ambiguous provider outcomes converge.\n   391\t      await this.executor.attachDomain({ target, domain });\n   392\t    } catch (error) {\n   393\t      try {\n   394\t        const completed = await this.store.completeDomainAttachment({\n   395\t          ...domain,\n   396\t          status: \"failed\",\n   397\t          updatedAt: new Date().toISOString(),\n   398\t        }, claimToken);\n   399\t        if (!completed) {\n   400\t          const current = await currentDomain();\n   401\t          if (current) return current;\n   402\t        }\n   403\t      } catch {\n   404\t        // The already-durable pending intent remains discoverable and reusable.\n   405\t      }\n   406\t      try {\n   407\t        await this.store.releaseDomainAttachmentClaim(scope, domain.id, claimToken);\n   408\t      } catch {\n   409\t        // Durable stores must expire abandoned provider-work leases.\n   410\t      }\n   411\t      throw error;\n   412\t    }\n   413\t    const active = { ...domain, status: \"active\" as const };\n   414\t    try {\n   415\t      const completed = await this.store.completeDomainAttachment(active, claimToken);\n   416\t      if (!completed) {\n   417\t        const current = await currentDomain();\n   418\t        if (current) return current;\n   419\t        throw new Error(\"HostFn domain attachment lease was superseded.\");\n   420\t      }\n   421\t    } catch (error) {\n   422\t      try {\n   423\t        await this.store.releaseDomainAttachmentClaim(scope, domain.id, claimToken);\n   424\t      } catch {\n   425\t        // Durable stores must expire abandoned provider-work leases.\n   426\t      }\n   427\t      throw error;\n   428\t    }\n   429\t    return active;\n   430\t  }\n   431\t  async detachDomain(scope: HostFnScope, id: string) {\n   432\t    const domain = (await this.store.listDomains(scope)).find(\n   433\t      (item) => item.id === id,\n   434\t    );\n   435\t    if (!domain) throw new Error(`HostFn domain not found: ${id}`);\n   436\t    const target = await this.target(scope, domain.targetId);\n   437\t    try {\n   438\t      await this.executor.detachDomain({ target, domain });\n   439\t    } catch (error) {\n   440\t      if (!providerReportedNotFound(error)) throw error;\n   441\t    }\n   442\t    await this.store.deleteDomain(scope, id);\n   443\t    return domain;\n   444\t  }\n   445\t  async setVariable(\n   446\t    scope: HostFnScope,\n   447\t    input: { targetId: string; key: string; value: string },\n   448\t  ) {\n   449\t    if (!/^[A-Z_][A-Z0-9_]*$/.test(input.key))\n   450\t      throw new Error(\"Invalid environment variable key.\");\n   451\t    const target = await this.target(scope, input.targetId);\n   452\t    const variable: HostFnVariable = {\n   453\t      id: `${target.id}:${input.key}`,\n   454\t      scope,\n   455\t      targetId: target.id,\n   456\t      key: input.key,\n   457\t      updatedAt: new Date().toISOString(),\n   458\t    };\n   459\t    // Persist a deletion-capable intent before the provider side effect so an\n   460\t    // ambiguous or acknowledged provider write always remains reconcilable.\n   461\t    await this.store.putVariable(variable, input.value);\n   462\t    await this.executor.setVariable({\n   463\t      target,\n   464\t      key: input.key,\n   465\t      value: input.value,\n   466\t    });\n   467\t    return variable;\n   468\t  }\n   469\t  async deleteVariable(scope: HostFnScope, id: string) {\n   470\t    const variable = (await this.store.listVariables(scope)).find(\n   471\t      (item) => item.id === id,\n   472\t    );\n   473\t    if (!variable) throw new Error(`HostFn variable not found: ${id}`);\n   474\t    const target = await this.target(scope, variable.targetId);\n   475\t    try {\n   476\t      await this.executor.deleteVariable({ target, key: variable.key });\n   477\t    } catch (error) {\n   478\t      if (!providerReportedNotFound(error)) throw error;\n   479\t    }\n   480\t    await this.store.deleteVariable(scope, id);\n   481\t    return variable;\n   482\t  }\n   483\t}\n   680\t    const compose = (withChild: boolean) => createSuperConsole({\n   681\t      adapters: withChild ? [ownerAdapter, childAdapter] : [ownerAdapter],\n   682\t      enabledModules: withChild ? ['watchfn', 'catchfn'] : ['watchfn'],\n   683\t      auth: auth(),\n   684\t      shellPolicy: { authorize: () => true },\n   685\t    });\n   686\t    const folded = await (await compose(true).handle(request('/api/admin/v1/modules/watchfn'))).json();\n   687\t    const registry = await (await compose(true).handle(request('/api/admin/v1/registry'))).json();\n   688\t    expect(registry.data.enabledModules.map((module: { id: string }) => module.id)).toEqual(['watchfn', 'catchfn']);\n   689\t    expect(registry.data.modules.map((module: { id: string }) => module.id)).toEqual(['watchfn']);\n   690\t    expect(folded.data.module.foldedModuleIds).toEqual(['catchfn']);\n   691\t    expect(folded.data.module.resources).toEqual(expect.arrayContaining([\n   692\t      expect.objectContaining({ id: 'monitors', sourceModuleId: 'watchfn' }),\n   693\t      expect.objectContaining({ id: 'catchfn:errors', resourceId: 'errors', sourceModuleId: 'catchfn', foldedIntoModuleId: 'watchfn', href: '/modules/watchfn/catchfn%3Aerrors', apiHref: expect.stringContaining('/modules/catchfn/') }),\n   694\t    ]));\n   695\t    const ownerOnly = await (await compose(false).handle(request('/api/admin/v1/modules/watchfn'))).json();\n   696\t    expect(ownerOnly.data.module.foldedModuleIds).toEqual([]);\n   697\t    expect(JSON.stringify(ownerOnly.data.module)).not.toContain('catchfn:errors');\n   698\t  });\n   699\t\n   700\t  it('fails startup when enabled mutations lack required infrastructure while shell-only installs work', () => {\n   701\t    const capability = manifest({ destructive: true });\n   702\t    const adapter = createAdminCapabilityAdapter(capability, { [capability.operations[0]!.id]: async () => ({ ok: true as const, data: { accepted: true } }) });\n   703\t    expect(() => createSuperConsole({ adapters: [adapter], enabledModules: ['examplefn'], auth: auth(), shellPolicy: { authorize: () => true } })).toThrow(/audit sink/);\n   704\t    expect(() => createSuperConsole({ adapters: [adapter], enabledModules: ['examplefn'], auth: auth(), shellPolicy: { authorize: () => true }, audit: new MemoryAdminAuditSink() })).toThrow(/idempotency store/);\n   705\t    expect(() => createSuperConsole({ adapters: [adapter], enabledModules: ['examplefn'], auth: auth(), shellPolicy: { authorize: () => true }, audit: new MemoryAdminAuditSink(), idempotency: new MemoryAdminIdempotencyStore() })).toThrow(/staged confirmation/);\n   706\t    expect(() => createSuperConsole({\n   707\t      adapters: [adapter],\n   708\t      enabledModules: ['examplefn'],\n   709\t      auth: { ...auth(), authorizeMutation: undefined },\n   710\t      shellPolicy: { authorize: () => true },\n   711\t      audit: new MemoryAdminAuditSink(),\n   712\t      idempotency: new MemoryAdminIdempotencyStore(),\n   713\t      confirmation: { issue: async () => ({ token: 'bound', expiresAt: new Date(Date.now() + 60_000).toISOString() }), prepareActivation: async () => undefined, activate: async () => undefined, revoke: async () => undefined, verify: async () => true },\n   714\t    })).toThrow(/mutation authorization/);\n   715\t    expect(() => createSuperConsole({ adapters: [], enabledModules: [], auth: auth(), shellPolicy: { authorize: () => true } })).not.toThrow();\n   716\t    expect(() => createSuperConsole({ adapters: [], enabledModules: [], auth: auth() } as never)).toThrow(/shell authorization policy/);\n   717\t  });\n   718\t\n   719\t  it('issues input-bound confirmation only after input/permission/policy checks and verifies it on dispatch', async () => {\n   720\t    const { console, confirmation, handler, audit } = installation({ destructive: true, permissions: ['examplefn.records.delete'] });\n   721\t    const invalid = await console.handle(request('/api/admin/v1/confirmations', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ operationId: 'examplefn.records.delete', input: {} }) }));\n   722\t    expect(invalid.status).toBe(400);\n   723\t    const issued = await console.handle(request('/api/admin/v1/confirmations', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ operationId: 'examplefn.records.delete', input: { id: 'record_1' } }) }));\n   724\t    expect(issued.status).toBe(201);\n   725\t    expect(await issued.json()).toMatchObject({ ok: true as const, data: { token: 'bound-token', expiresAt: expect.any(String) } });\n   726\t    expect(confirmation.issue).toHaveBeenCalledWith(expect.objectContaining({\n   727\t      operationId: 'examplefn.records.delete',\n   728\t      input: { id: 'record_1' },\n   729\t      context: expect.objectContaining({ scope: expect.objectContaining({ installationId: 'org_1' }) }),\n   730\t    }));\n   731\t    const successAuditId = audit.events.find((event) => event.operationId === 'superconsole.confirmations.issue' && event.outcome === 'succeeded')?.id;\n   732\t    expect(successAuditId).toEqual(expect.any(String));\n   733\t    expect(confirmation.prepareActivation).toHaveBeenCalledWith(expect.objectContaining({ token: 'bound-token', auditId: successAuditId }));\n   734\t    expect(confirmation.activate).toHaveBeenCalledWith(expect.objectContaining({ token: 'bound-token', auditId: successAuditId }));\n   735\t    expect(confirmation.revoke).not.toHaveBeenCalled();\n   736\t    const executed = await console.handle(request('/api/admin/v1/modules/examplefn/records/record_1', {\n   737\t      method: 'DELETE',\n   738\t      headers: { 'idempotency-key': 'idem_1', 'x-admin-confirmation': 'bound-token' },\n   739\t    }));\n   740\t    expect(executed.status).toBe(200);\n   741\t    expect(handler).toHaveBeenCalledTimes(1);\n   742\t    expect(confirmation.verify).toHaveBeenCalled();\n   743\t  });\n   744\t\n   745\t  it('never activates a staged confirmation when its terminal audit fails', async () => {\n   746\t    const capability = manifest({ destructive: true });\n   747\t    const issue = vi.fn(async () => ({ token: 'staged-token', expiresAt: new Date(Date.now() + 60_000).toISOString() }));\n   748\t    let active = false;\n   749\t    const activate = vi.fn(async () => { active = true; });\n   750\t    const revoke = vi.fn(async () => { throw new Error('revocation unavailable'); });\n   751\t    const console = createSuperConsole({\n   752\t      adapters: [createAdminCapabilityAdapter(capability, {\n   753\t        'examplefn.records.delete': async () => ({ ok: true as const, data: { accepted: true } }),\n   754\t      })],\n   755\t      enabledModules: ['examplefn'],\n   756\t      auth: auth(),\n   757\t      shellPolicy: { authorize: () => true },\n   758\t      audit: {\n   759\t        idempotentById: true,\n   760\t        write: async (event) => {\n   761\t          if (event.operationId === 'superconsole.confirmations.issue' && event.outcome === 'succeeded') {\n   762\t            throw new Error('terminal confirmation audit unavailable');\n   763\t          }\n   764\t        },\n   765\t      },\n   766\t      idempotency: new MemoryAdminIdempotencyStore(),\n   767\t      confirmation: { issue, prepareActivation: async () => undefined, activate, revoke, verify: async () => active },\n   768\t    });\n   769\t\n   770\t    const response = await console.handle(request('/api/admin/v1/confirmations', {\n   771\t      method: 'POST',\n   772\t      headers: { 'content-type': 'application/json' },\n   773\t      body: JSON.stringify({ operationId: 'examplefn.records.delete', input: { id: 'record_1' } }),\n   774\t    }));\n   775\t\n   776\t    expect(response.status).toBe(503);\n   777\t    expect(issue).toHaveBeenCalledTimes(1);\n   778\t    expect(activate).not.toHaveBeenCalled();\n   779\t    expect(revoke).toHaveBeenCalledWith(expect.objectContaining({ token: 'staged-token' }));\n   780\t    expect(active).toBe(false);\n   781\t  });\n   782\t\n   783\t  it('records activation failure as denied and leaves the staged token unusable', async () => {\n   784\t    const capability = manifest({ destructive: true });\n   785\t    const outcomes: Array<{ outcome: string; errorCode?: string }> = [];\n   786\t    let active = false;\n   787\t    const revoke = vi.fn(async () => { active = false; });\n   788\t    const verify = vi.fn(async () => active);\n   789\t    const console = createSuperConsole({\n   790\t      adapters: [createAdminCapabilityAdapter(capability, {\n   791\t        'examplefn.records.delete': async () => ({ ok: true as const, data: { accepted: true } }),\n   792\t      })],\n   793\t      enabledModules: ['examplefn'],\n   794\t      auth: auth(),\n   795\t      shellPolicy: { authorize: () => true },\n   796\t      audit: {\n   797\t        idempotentById: true,\n   798\t        write: async (event) => {\n   799\t          if (event.operationId === 'superconsole.confirmations.issue') {\n   800\t            outcomes.push({ outcome: event.outcome, errorCode: event.errorCode });\n   801\t          }\n   802\t        },\n   803\t      },\n   804\t      idempotency: new MemoryAdminIdempotencyStore(),\n   805\t      confirmation: {\n   806\t        issue: async () => ({ token: 'staged-token', expiresAt: new Date(Date.now() + 60_000).toISOString() }),\n   807\t        prepareActivation: async () => undefined,\n   808\t        activate: async () => { active = true; throw new Error('activation unavailable'); },\n   809\t        revoke,\n   810\t        verify,\n   811\t      },\n   812\t    });\n   813\t\n   814\t    const response = await console.handle(request('/api/admin/v1/confirmations', {\n   815\t      method: 'POST',\n   816\t      headers: { 'content-type': 'application/json' },\n   817\t      body: JSON.stringify({ operationId: 'examplefn.records.delete', input: { id: 'record_1' } }),\n   818\t    }));\n   819\t\n   820\t    expect(response.status).toBe(503);\n   821\t    expect(await verify({} as never)).toBe(false);\n   822\t    expect(revoke).toHaveBeenCalledWith(expect.objectContaining({ token: 'staged-token' }));\n   823\t    expect(outcomes).toEqual([\n   824\t      { outcome: 'attempted', errorCode: undefined },\n   825\t      { outcome: 'succeeded', errorCode: undefined },\n   826\t      { outcome: 'denied', errorCode: 'CONFIRMATION_ACTIVATION_FAILED' },\n   827\t    ]);\n   828\t  });\n   829\t\n   830\t  it('returns 405/OPTIONS/HEAD semantics instead of route ambiguity', async () => {\n{\n  \"name\": \"hostfn\",\n  \"version\": \"0.1.7\",\n  \"license\": \"MIT\",\n  \"description\": \"Universal application deployment CLI\",\n  \"type\": \"module\",\n  \"bin\": {\n    \"hostfn\": \"./dist/index.js\"\n  },\n  \"exports\": {\n    \"./operator\": {\n      \"types\": \"./dist/operator.d.ts\",\n      \"default\": \"./dist/operator.js\"\n    }\n  },\n  \"scripts\": {\n    \"dev\": \"tsx watch src/index.ts\",\n    \"build\": \"tsc\",\n    \"clean\": \"rm -rf dist\",\n    \"lint\": \"tsc --noEmit\",\n    \"test\": \"vitest\",\n    \"test:watch\": \"vitest --watch\",\n    \"test:coverage\": \"vitest --coverage\"\n  },\n  \"dependencies\": {\n    \"commander\": \"^11.1.0\",\n    \"chalk\": \"^5.3.0\",\n    \"ora\": \"^7.0.1\",\n    \"inquirer\": \"^9.2.12\",\n    \"semver\": \"^7.7.2\",\n    \"zod\": \"^3.22.4\",\n    \"ssh2\": \"^1.15.0\",\n    \"dotenv\": \"^16.3.1\",\n    \"execa\": \"^8.0.1\"\n  },\n  \"devDependencies\": {\n    \"@types/semver\": \"^7.7.1\",\n    \"@types/node\": \"^20.10.0\",\n    \"@types/ssh2\": \"^1.15.0\",\n    \"@types/inquirer\": \"^9.0.7\",\n    \"@vitest/coverage-v8\": \"^1.6.1\",\n    \"typescript\": \"^5.3.0\",\n    \"tsx\": \"^4.7.0\",\n    \"vitest\": \"^1.6.0\",\n    \"fast-glob\": \"^3.3.2\"\n  },\n  \"author\": \"21n\",\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/21nCo/super-functions.git\",\n    \"directory\": \"hostfn/cli\"\n  },\n  \"bugs\": {\n    \"url\": \"https://github.com/21nCo/super-functions/issues\"\n  },\n  \"keywords\": [\n    \"deployment\",\n    \"vps\"\n  ],\n  \"engines\": {\n    \"node\": \">=18.0.0\"\n  },\n  \"publishConfig\": {\n    \"access\": \"public\"\n  },\n  \"superfunctions\": {\n    \"initFunction\": \"hostFn\",\n    \"schemaVersion\": 1,\n    \"namespace\": \"hostfn\"\n  }\n}\n{\n  \"name\": \"@superfunctions/admin\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Shared administration contracts and runtime for Superfunctions\",\n  \"type\": \"module\",\n  \"main\": \"./dist/index.js\",\n  \"types\": \"./dist/index.d.ts\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"import\": \"./dist/index.js\"\n    }\n  },\n  \"files\": [\n    \"dist\",\n    \"README.md\"\n  ],\n  \"scripts\": {\n    \"build\": \"tsc -p tsconfig.json\",\n    \"review:mutation-risk\": \"node scripts/risk-review.mjs\",\n    \"verify:sdk-contracts\": \"node scripts/verify-sdk-contracts.mjs\",\n    \"test\": \"vitest run\",\n    \"typecheck\": \"tsc -p tsconfig.json --noEmit\"\n  },\n  \"dependencies\": {\n    \"@mcpfn/core\": \"0.0.1\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^5.7.2\",\n    \"vitest\": \"3.2.4\"\n  },\n  \"engines\": {\n    \"node\": \">=20\"\n  },\n  \"license\": \"MIT\"\n}\n{\n  \"name\": \"superconsole\",\n  \"version\": \"0.1.0\",\n  \"private\": true,\n  \"description\": \"Self-hosted modular operator console for Superfunctions\",\n  \"type\": \"module\",\n  \"exports\": {\n    \"./server\": {\n      \"types\": \"./dist/server/index.d.ts\",\n      \"import\": \"./dist/server/index.js\"\n    }\n  },\n  \"scripts\": {\n    \"dev\": \"npm run build:server && vite dev --host 127.0.0.1 --port 4178\",\n    \"build\": \"npm run build:server && vite build\",\n    \"build:server\": \"tsc -p tsconfig.server.json\",\n    \"preview\": \"vite preview --host 127.0.0.1 --port 4178\",\n    \"check\": \"svelte-kit sync && svelte-check --tsconfig ./tsconfig.json\",\n    \"lint\": \"svelte-kit sync && svelte-check --tsconfig ./tsconfig.json\",\n    \"typecheck\": \"svelte-kit sync && svelte-check --tsconfig ./tsconfig.json\",\n    \"test\": \"npm run verify:function-agnostic && vitest run\",\n    \"test:ui\": \"vitest run tests/ui\",\n    \"probe:smoke\": \"node tests/probes/super-console.smoke.mjs\",\n    \"verify:function-agnostic\": \"node scripts/verify-function-agnostic.mjs\"\n  },\n  \"dependencies\": {\n    \"@mcpfn/core\": \"0.0.1\",\n    \"@superfunctions/admin\": \"0.1.0\",\n    \"@sveltejs/kit\": \"2.69.3\",\n    \"@uifn/components\": \"0.0.1\",\n    \"@uifn/components-svelte\": \"0.0.1\",\n    \"@uifn/theme\": \"0.0.1\",\n    \"@uifn/theme-tailwind\": \"0.0.1\",\n    \"svelte\": \"5.46.4\"\n  },\n  \"devDependencies\": {\n    \"@authfn/admin\": \"REDACTED\",\n    \"@authfn/password\": \"REDACTED\",\n    \"@authfn/two-factor\": \"REDACTED\",\n    \"@clifn/admin\": \"0.1.0\",\n    \"@extfn/admin\": \"0.1.0\",\n    \"@sveltejs/adapter-node\": \"^5.3.2\",\n    \"@sveltejs/vite-plugin-svelte\": \"4.0.4\",\n    \"@testing-library/jest-dom\": \"^6.9.1\",\n    \"@testing-library/svelte\": \"^5.2.8\",\n    \"@superfunctions/db\": \"0.1.4\",\n    \"@types/node\": \"^20.19.27\",\n    \"autoprefixer\": \"^10.4.21\",\n    \"jsdom\": \"^26.1.0\",\n    \"postcss\": \"^8.5.6\",\n    \"svelte-check\": \"4.3.4\",\n    \"tailwindcss\": \"3.4.17\",\n    \"typescript\": \"5.9.3\",\n    \"vite\": \"5.4.21\",\n    \"vitest\": \"3.2.4\"\n  },\n  \"engines\": {\n    \"node\": \">=20 <23\"\n  },\n  \"license\": \"Apache-2.0\",\n  \"superfunctions\": {\n    \"uses\": [\n      \"mcpfn\",\n      \"uifn\"\n    ],\n    \"schemaVersion\": 1\n  }\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a02dda-f2ef-7f43-9257-ff0e7824b8c6","create_time":1787476033.240536}}}
