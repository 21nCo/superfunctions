; offset?: number },\\n   845\\t    ): Promise<{ versions: FileVersionRecord[] }> {\\n   846\\t      await this.getFile(fileId, ctx);\\n   847\\t\\n   848\\t      const versions = await db.findMany<FileVersionRecord>({\\n   849\\t        model: 'fileVersions',\\n   850\\t        where: [{ field: 'fileId', operator: 'eq', value: fileId }],\\n   851\\t        orderBy: [\\n   852\\t          { field: 'createdAt', direction: 'desc' },\\n   853\\t          { field: 'versionId', direction: 'desc' },\\n   854\\t        ],\\n   855\\t        limit: page?.limit,\\n   856\\t        offset: page?.offset,\\n   857\\t        namespace,\\n   858\\t      });\\n   859\\t\\n   860\\t      return { versions };\\n   861\\t    },\\n   862\\t\\n   863\\t    async canWriteFile(fileId: string, ctx: FileProviderContext): Promise<boolean> {\\n   864\\t      const file = await db.findOne<FileRecord>({\\n   865\\t        model: 'files',\\n   866\\t        where: [{ field: 'fileId', operator: 'eq', value: fileId }],\\n   867\\t        namespace,\\n   868\\t      });\\n   869\\t\\n   870\\t      if (!file) {\\n   871\\t        return true;\\n   872\\t      }\\n   873\\t\\n   874\\t      return authorizer.canWrite(file, ctx);\\n   875\\t    },\\ninterface FilePermissionGrantRecord {\\n  fileId: string;\\n  userId?: string;\\n  tenantId?: string | null;\\n  canRead?: boolean;\\n  canShare?: boolean;\\n  expiresAt?: string | null;\\n}\\n\\nexport interface Authorizer {\\n  canRead(file: FileRecord, ctx: FileProviderContext): Promise<boolean>;\\n  canWrite(file: FileRecord, ctx: FileProviderContext): Promise<boolean>;\\n  canDelete(file: FileRecord, ctx: FileProviderContext): Promise<boolean>;\\n}\\n\\nexport interface FileServiceConfig {\\n  db: Adapter;\\n  storage: StorageAdapter;\\n  policies?: Pick<PolicyRegistry, 'get'>;\\n  events: FileFnEventEmitter;\\n  logger?: Logger;\\n  quota?: QuotaProvider;\\n  authorizer?: Authorizer;\\n  namespace?: string;\\n  signedUrlTtlSeconds?: number;\\n}\\n\