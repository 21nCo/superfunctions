.ts:472:      const file = await this.getFile(fileId, ctx);\nfilefn/server/src/files/service.ts:494:      const file = await this.getFile(fileId, ctx);\nfilefn/server/src/files/service.ts:846:      await this.getFile(fileId, ctx);\nfilefn/server/src/files/service.ts:878:      await this.getFile(fileId, ctx);\nfilefn/server/src/index.ts:16:import { createFileService, type Authorizer, type FileService } from './files/service.js';\nfilefn/server/src/index.ts:407:    async getFile(input, ctx) {\nfilefn/server/src/index.ts:408:      return fileService.getFile(input.fileId, ctx, input.versionId);\n    90\t}\n    91\t\n    92\texport type FileReadResult = FileRecord & {\n    93\t  versionId?: string;\n    94\t  versionCreatedAt?: string;\n    95\t  checksumSha256Base64?: string | null;\n    96\t  storageKey?: string;\n    97\t};\n    98\t\n    99\ttype RenderIntent = 'thumbnail' | 'preview' | 'full' | 'download';\n   100\ttype RenderState = 'ready' | 'processing' | 'pending-local' | 'unsupported';\n   101\ttype RenderPlaceholderKind = 'generic-file' | 'pdf-processing' | 'unsupported-preview';\n   102\t\n   103\tinterface RenderDescriptor {\n   104\t  fileId: string;\n   105\t  versionId: string;\n   106\t  intent: RenderIntent;\n   107\t  state: RenderState;\n   108\t  mimeType: string;\n   109\t  name: string;\n   110\t  size: number;\n   111\t  source:\n   112\t    | {\n   113\t        mode: 'artifact';\n   114\t        artifactId: string;\n   115\t        artifactKind: string;\n   116\t        url: string;\n   117\t        headers?: Record<string, string>;\n   118\t      }\n   119\t    | {\n   120\t        mode: 'original';\n   121\t        url: string;\n   122\t        headers?: Record<string, string>;\n   123\t      }\n   124\t    | {\n   125\t        mode: 'placeholder';\n   126\t        placeholderKind: RenderPlaceholderKind;\n   127\t      };\n   128\t  warnings?: string[];\n   129\t}\n   130\t\n   131\tfunction createDefaultAuthorizer(): Authorizer {\n   132\t  return {\n   133\t    async canRead(file, ctx) {\n   134\t      if (file.visibility === 'public') return true;\n   135\t      if (file.ownerId === ctx.principalId) return true;\n   136\t      if (file.visibility === 'shared' && file.tenantId && file.tenantId === ctx.tenantId) return true;\n   137\t      return false;\n   138\t    },\n   139\t    async canWrite(file, ctx) {\n   140\t      return file.ownerId === ctx.principalId;\n   141\t    },\n   142\t    async canDelete(file, ctx) {\n   143\t      return file.ownerId === ctx.principalId;\n   144\t    },\n   145\t  };\n   146\t}\n   147\t\n   148\tfunction fileSortComparator(a: FileRecord, b: FileRecord): number {\n   149\t  const aTs = Date.parse(a.updatedAt);\n   150\t  const bTs = Date.parse(b.updatedAt);\n   151\t  if (aTs !== bTs) {\n   152\t    return bTs - aTs; // updatedAt DESC\n   153\t  }\n   154\t  return a.fileId.localeCompare(b.fileId); // fileId ASC\n   155\t}\n   156\t\n   157\tfunction encodeCursor(tuple: CursorTuple): string {\n   158\t  return Buffer.from(JSON.stringify(tuple), 'utf8').toString('base64url');\n   159\t}\n   160\t\n   161\tfunction isAfterCursor(file: FileRecord, cursor: CursorTuple): boolean {\n   162\t  const fileTs = Date.parse(file.updatedAt);\n   163\t  const cursorTs = Date.parse(cursor.updatedAt);\n   164\t\n   165\t  if (fileTs < cursorTs) return true;\n   166\t  if (fileTs > cursorTs) return false;\n   167\t\n   168\t  return file.fileId.localeCompare(cursor.fileId) > 0;\n   169\t}\n   170\t\n   171\tfunction isGrantExpired(expiresAt: string | null | undefined): boolean {\n   172\t  if (!expiresAt) {\n   173\t    return false;\n   174\t  }\n   175\t  const expiresAtMs = Date.parse(expiresAt);\n   176\t  if (Number.isNaN(expiresAtMs)) {\n   177\t    return false;\n   178\t  }\n   179\t  return expiresAtMs <= Date.now();\n   180\t}\n   430\t\n   431\t      const files = paged.slice(0, limit);\n   432\t      const hasMore = paged.length > limit;\n   433\t\n   434\t      return {\n   435\t        files,\n   436\t        nextCursor: hasMore && files.length > 0\n   437\t          ? encodeCursor({ updatedAt: files[files.length - 1].updatedAt, fileId: files[files.length - 1].fileId })\n   438\t          : undefined,\n   439\t      };\n   440\t    },\n   441\t\n   442\t    async getDownloadUrl(fileId: string, versionId: string | undefined, ctx: FileProviderContext): Promise<{\n   443\t      url: string;\n   444\t      headers?: Record<string, string>;\n   445\t    }> {\n   446\t      const file = await this.getFile(fileId, ctx);\n   447\t      const targetVersionId = versionId || file.currentVersionId;\n   448\t      const version = await getVersionChecked(fileId, targetVersionId);\n   449\t      const storageTarget = resolveStorageTarget(policies?.get(file.policy) ?? {});\n   450\t\n   451\t      if (getStorageCapabilities(storage, storageTarget).signedDownloadUrls && storage.signDownloadUrl) {\n   452\t        const result = await storage.signDownloadUrl({\n   453\t          key: version.storageKey,\n   454\t          target: storageTarget,\n   455\t          expiresInSeconds: signedUrlTtlSeconds,\n   456\t        });\n   457\t        return { url: result.url, headers: result.headers };\n   458\t      }\n   459\t\n   460\t      const proxyUrl = versionId\n   461\t        ? `/proxy/files/${fileId}/versions/${versionId}/download`\n   462\t        : `/proxy/files/${fileId}/download`;\n   463\t\n   464\t      return { url: proxyUrl };\n   465\t    },\n   466\t\n   467\t    async getDownloadStream(fileId: string, versionId: string | undefined, ctx: FileProviderContext): Promise<{\n   468\t      stream: ReadableStream;\n   469\t      contentType: string;\n   470\t      size: number;\n   471\t    }> {\n   472\t      const file = await this.getFile(fileId, ctx);\n   473\t      const targetVersionId = versionId || file.currentVersionId;\n   474\t      const version = await getVersionChecked(fileId, targetVersionId);\n   475\t      const storageTarget = resolveStorageTarget(policies?.get(file.policy) ?? {});\n   476\t\n   477\t      if (!storage.openDownloadStream) {\n   478\t        throw new Error('Storage adapter does not support streaming');\n   479\t      }\n   480\t\n   481\t      const stream = await storage.openDownloadStream({ key: version.storageKey, target: storageTarget });\n   482\t      return {\n   483\t        stream: stream as unknown as ReadableStream,\n   484\t        contentType: version.mimeType,\n   485\t        size: version.size,\n   486\t      };\n   487\t    },\n   488\t\n   489\t    async getRenderDescriptor(\n   490\t      fileId: string,\n   491\t      options: { intent: RenderIntent; versionId?: string },\n   492\t      ctx: FileProviderContext,\n   493\t    ): Promise<RenderDescriptor> {\n   494\t      const file = await this.getFile(fileId, ctx);\n   495\t      const versionId = options.versionId || file.currentVersionId;\n   496\t      const version = await getVersionChecked(fileId, versionId);\n   497\t      const artifacts = await db.findMany<FileArtifactRecord>({\n   498\t        model: 'fileArtifacts',\n   499\t        where: [\n   500\t          { field: 'fileId', operator: 'eq', value: fileId },\n   501\t          { field: 'versionId', operator: 'eq', value: versionId },\n   502\t        ],\n   503\t        namespace,\n   504\t      });\n   505\t\n   506\t      const originalDescriptor = async (): Promise<RenderDescriptor> => {\n   507\t        const original = await this.getDownloadUrl(fileId, versionId, ctx);\n   508\t        return {\n   509\t          fileId,\n   510\t          versionId,\n     1\timport { AdminError } from \"./errors.js\";\n     2\timport { stableSerialize } from \"./validator.js\";\n     3\timport type { AdminScope } from \"./types.js\";\n     4\t\n     5\texport interface AdminCursorPayload<T = unknown> {\n     6\t  version: 1;\n     7\t  scope: AdminScope;\n     8\t  position: T;\n     9\t}\n    10\t\n    11\tfunction toBase64Url(value: string): string {\n    12\t  const bytes = new TextEncoder().encode(value);\n    13\t  let binary = \"\";\n    14\t  bytes.forEach((byte) => { binary += String.fromCharCode(byte); });\n    15\t  return btoa(binary).replace(/\\+/g, \"-\").replace(/\\//g, \"_\").replace(/=+$/g, \"\");\n    16\t}\n    17\t\n    18\tfunction fromBase64Url(value: string): string {\n    19\t  const normalized = value.replace(/-/g, \"+\").replace(/_/g, \"/\").padEnd(Math.ceil(value.length / 4) * 4, \"=\");\n    20\t  const binary = atob(normalized);\n    21\t  return new TextDecoder().decode(Uint8Array.from(binary, (character) => character.charCodeAt(0)));\n    22\t}\n    23\t\n    24\texport function encodeAdminCursor<T>(scope: AdminScope, position: T): string {\n    25\t  return toBase64Url(JSON.stringify({ version: 1, scope, position } satisfies AdminCursorPayload<T>));\n    26\t}\n    27\t\n    28\t/**\n    29\t * Decodes the legacy encoded cursor after enforcing the embedded scope. This\n    30\t * helper does not authenticate cursor integrity: production domain providers\n    31\t * must issue opaque, signed cursor positions before exposing them.\n    32\t */\n    33\texport function decodeAdminCursor<T>(cursor: string, expectedScope: AdminScope): T {\n    34\t  try {\n    35\t    const payload = JSON.parse(fromBase64Url(cursor)) as AdminCursorPayload<T>;\n    36\t    if (payload.version !== 1 || stableSerialize(payload.scope) !== stableSerialize(expectedScope)) {\n    37\t      throw new Error(\"scope mismatch\");\n    38\t    }\n    39\t    return payload.position;\n    40\t  } catch (error) {\n    41\t    throw new AdminError(\"invalid_argument\", \"The pagination cursor is invalid for the active scope.\", { cause: error });\n    42\t  }\n    43\t}\n    44\t\n    45\texport function normalizeAdminPageLimit(\n    46\t  value: unknown,\n    47\t  options: { defaultLimit?: number; maxLimit?: number } = {},\n    48\t): number {\n    49\t  const defaultLimit = options.defaultLimit ?? 50;\n    50\t  const maxLimit = options.maxLimit ?? 200;\n    51\t  const limit = value === undefined ? defaultLimit : Number(value);\n    52\t  if (!Number.isInteger(limit) || limit < 1 || limit > maxLimit) {\n    53\t    throw new AdminError(\"invalid_argument\", `Page limit must be an integer between 1 and ${maxLimit}.`);\n    54\t  }\n    55\t  return limit;\n    56\t}\n   155\t  required: [\"accepted\", \"item\"],\n   156\t  additionalProperties: false,\n   157\t};\n   158\tconst pageProperties = { cursor: { type: \"string\", minLength: 1 }, limit: { type: \"integer\", minimum: 1, maximum: 100, default: 50 } } as const;\n   159\tconst pageInputSchema: AdminObjectSchema = { type: \"object\", properties: pageProperties, additionalProperties: false };\n   160\tconst idInputSchema: AdminObjectSchema = { type: \"object\", properties: { id: { type: \"string\", minLength: 1 } }, required: [\"id\"], additionalProperties: false };\n   161\tconst fileChildListInputSchema: AdminObjectSchema = { type: \"object\", properties: { fileId: { type: \"string\", minLength: 1 }, ...pageProperties }, required: [\"fileId\"], additionalProperties: false };\n   162\tconst fileChildInputSchema: AdminObjectSchema = { type: \"object\", properties: { fileId: { type: \"string\", minLength: 1 }, id: { type: \"string\", minLength: 1 } }, required: [\"fileId\", \"id\"], additionalProperties: false };\n   163\tconst uploadSessionInputSchema: AdminObjectSchema = { type: \"object\", properties: { id: { type: \"string\", minLength: 1 }, uploadSessionToken: { type: \"string\", minLength: 1 } }, required: [\"id\"], additionalProperties: false };\n   164\tconst createUploadInputSchema: AdminObjectSchema = { type: \"object\", properties: { policy: { type: \"string\", minLength: 1 }, fileName: { type: \"string\", minLength: 1 }, size: { type: \"integer\", minimum: 0 }, mimeType: { type: \"string\", minLength: 1 }, fileId: { type: \"string\", minLength: 1 }, metadata: { type: \"object\", additionalProperties: true } }