s/audit/+page.ts, line 12:\\n\\n<comment>The audit endpoint returns raw `AdminAuditEvent` objects, but this loader forwards them as `AuditEventViewModel` without mapping. Audit rows therefore read undefined `occurredAt`/`actor`/`action`, render the object target as `[object Object]`, and show raw outcomes as `Unknown`; map each event to the UI view model and normalize its outcome and target.</comment>\\n\\n<file context>\\n@@ -0,0 +1,23 @@\\n+    const value = url.searchParams.get(key);\\n+    if (value) query.set(key, value);\\n+  }\\n+  const result = await fetchAdmin<{ events: AuditEventViewModel[]; total?: number; nextCursor?: string }>(\\n+    fetch,\\n+    withAdminScope(`${ADMIN_API_PREFIX}/audit${query.size ? `?${query}` : ''}`, url.searchParams)\\n</file context>\\n```\\n\\n</details>\",\n            \"author\": {\n              \"login\": \"cubic-dev-ai\"\n            },\n            \"createdAt\": \"2026-08-21T16:19:44Z\",\n            \"outdated\": true,\n            \"url\": \"https://github.com/21nCo/super-functions/pull/116#discussion_r3831870346\",\n            \"diffHunk\": \"@@ -0,0 +1,23 @@\\n+import { ADMIN_API_PREFIX, fetchAdmin, withAdminScope } from '$lib/components/admin-api';\\n+import type { AuditEventViewModel } from '$lib/components/view-models';\\n+import type { PageLoad } from './$types';\\n+\\n+export const load: PageLoad = async ({ fetch, url, depends }) => {\\n+  depends('superconsole:audit');\\n+  const query = new URLSearchParams();\\n+  for (const key of ['cursor', 'actor', 'module', 'outcome', 'q']) {\\n+    const value = url.searchParams.get(key);\\n+    if (value) query.set(key, value);\\n+  }\\n+  const result = await fetchAdmin<{ events: AuditEventViewModel[]; total?: number; nextCursor?: string }>(\",\n            \"line\": null,\n            \"originalLine\": 12\n          }\n        ]\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6bODii\",\n      \"isResolved\": false,\n      \"path\": \"uifn/core/src/algorithms/