d-7903-9300-1a8abd51a18c","internal_chat_message_metadata_passthrough":{"create_time":1787408715.293934,"turn_id":"01a029dc-8da2-7172-995b-e8d90499f489"},"role":"user","type":"message"},{"content":[{"text":"now for gods sake - just complete the latest round and stop immediately after that and dont go in loops\n","type":"input_text"}],"id":"msg_01a029dd-2a40-7322-b492-70b95be8aa5f","internal_chat_message_metadata_passthrough":{"create_time":1787408755.264803,"turn_id":"01a029dd-29d9-7ae0-bdb1-a9b5e76406c6"},"role":"user","type":"message"},{"content":[{"text":"create a skill in splane for refetching and fixing pending valid review findings ( [$pr-refetch-fix](/Users/serro/.codex/skills/pr-refetch-fix/SKILL.md) ) and clearly mentioning to not go in loops and stop with only 1 round\n\ncreate in 21n workspace\n","type":"input_text"}],"id":"msg_01a02a68-3349-7381-8c4a-878d4ff64d0f","internal_chat_message_metadata_passthrough":{"create_time":1787417867.081735,"turn_id":"01a02a68-2f67-7541-ab60-9ee3220f5404"},"role":"user","type":"message"},{"content":[{"text":"splane pr-refetch-fix PR #116\n","type":"input_text"}],"id":"msg_01a02a6c-c2f0-7433-a38f-42405f4ab15d","internal_chat_message_metadata_passthrough":{"create_time":1787418166.00046,"turn_id":"01a02a6c-bf23-77c2-852c-ace83a5f0b8c"},"role":"user","type":"message"},{"content":[{"text":"push fixes to PR if not already\n","type":"input_text"}],"id":"msg_01a02a77-36c8-7963-be18-a61100bf6d49","internal_chat_message_metadata_passthrough":{"create_time":1787418851.016569,"turn_id":"01a02a76-a8c6-7d01-8241-5491029e780f"},"role":"user","type":"message"},{"content":[{"text":"splane pr-refetch-fix\n","type":"input_text"}],"id":"msg_01a02c98-5a01-7e33-abb0-ea78d1e2d1ef","internal_chat_message_metadata_passthrough":{"create_time":1787454577.153173,"turn_id":"01a02c98-535b-7192-a25f-4555ca7249a7"},"role":"user","type":"message"},{"content":[{"text":"splane pr-refetch-fix\n","type":"input_text"}],"id":"msg_01a02cee-be2c-7ad3-ab45-5ffbe5f1f1b3","internal_chat_message_metadata_passthrough":{"create_time":1787460238.892355,"turn_id":"01a02cee-b892-7582-97f6-f512ed7f1a15"},"role":"user","type":"message"},{"content":[{"text":"splane pr-refetch-fix\n","type":"input_text"}],"id":"msg_01a02d2f-2bc8-77e3-acf5-5a4bf3fb1130","internal_chat_message_metadata_passthrough":{"create_time":1787464461.256521,"turn_id":"01a02d2f-27d1-7853-a787-109ab79e7a86"},"role":"user","type":"message"},{"content":[{"text":"splane pr-refetch-fix\n","type":"input_text"}],"id":"msg_01a02d4a-96c3-7a72-8bad-e428e3b94e5e","internal_chat_message_metadata_passthrough":{"create_time":1787466258.115829,"turn_id":"01a02d4a-92df-7b42-963f-bb4d1258effd"},"role":"user","type":"message"},{"content":[{"text":"splane pr-refetch-fix\n","type":"input_text"}],"id":"msg_01a02d84-6b89-7992-ae40-f75b6ffd3ccc","internal_chat_message_metadata_passthrough":{"create_time":1787470048.137754,"turn_id":"01a02d84-67e7-7143-9c14-0a1cb505f664"},"role":"user","type":"message"},{"content":[{"text":"splane pr-refetch-fix\n","type":"input_text"}],"id":"msg_01a02dda-f6a4-74c1-a72e-e7c1d150e9f3","internal_chat_message_metadata_passthrough":{"create_time":1787475719.844419,"turn_id":"01a02dda-f2ef-7f43-9257-ff0e7824b8c6"},"role":"user","type":"message"},{"content":[{"text":"splane pr-refetch-fix\n","type":"input_text"}],"id":"msg_01a02e2d-d3f0-7623-8319-7fde9440bff8","internal_chat_message_metadata_passthrough":{"create_time":1787481150.448975,"turn_id":"01a02e2d-cfe6-7e21-8f45-566081da5b6e"},"role":"user","type":"message"},{"content":[{"text":"\u003capp-context\u003e\n# Codex desktop context\n- You are running inside the Codex (desktop) app, which allows some additional features not available in the CLI alone:\n\n### Images/Visuals/Files\n- In the app, the model can display images, videos, and audio using standard Markdown image syntax: ![alt](url)\n- When an app or connector generates or edits media at a remote URL and provides a user-facing preview or display tool, use that tool instead of embedding the URL in Markdown.\n- When sending or referencing a local image, video, or audio file, always use an absolute filesystem path in the Markdown image tag (e.g., ![alt](/absolute/path.png)); relative paths and plain text will not render the media.\n- When a user asks to play an audio file, render it using Markdown image syntax with an absolute path (e.g., ![audio](/absolute/path.mp3)).\n- When referencing code or workspace files in responses, always use full absolute file paths instead of relative paths.\n- If a user asks about an image, or asks you to create an image, it is often a good idea to show the image to them in your response.\n- Return web URLs as Markdown links (e.g., [label](https://example.com)).\n\n### Workspace Dependencies\n- For sheets, slides, and documents, call `load_workspace_dependencies` to find the bundled runtime and libraries.\n\n### Automations\n- This app supports recurring automations, reminders, monitors, follow-ups, and thread wakeups. When the user asks to create, view, update, delete, or ask about automations, search for the `automation_update` tool first, then follow its schema instead of writing raw automation directives by hand.\n- When an automation should archive a Codex thread on completion, use `set_thread_archived` instead of emitting raw archive directives.\n\n### Thread Coordination\n- Treat the terms \"task\", \"thread\", \"chat\", and \"conversation\" as synonyms when they clearly refer to Codex. Tool names use the term \"thread\" and Codex uses \"task\" in the UI. When providing user-facing responses, use \"task\".\n- When the user asks to create, fork, inspect, continue, hand off, pin, archive, unarchive, rename, or otherwise manage Codex threads, search for the relevant thread tool first: `create_thread`, `fork_thread`, `list_threads`, `list_archived_threads`, `read_thread`, `wait_threads`, `send_message_to_thread`, `handoff_thread`, `set_thread_pinned`, `set_thread_archived`, or `set_thread_title`.\n- When following another task's progress, prefer compact `wait_threads` snapshots over repeated `read_thread` calls. Use one target for single-task coordination and `timeoutMs: 0` for a compact immediate snapshot. `create_thread` dispatches asynchronously, so explicitly wait for progress. Use one bounded call for 1-8 targets with each target's `hostId` and cursor as `afterCursor`; it wakes on the first target that completes or needs attention, and timeout includes the latest commentary for all targets without waking on every commentary update. An up-to-date cursor suppresses already-delivered final text. Separate waits from one task may run serially. Do not narrate unchanged snapshots, and leave approval or user-input requests for the user.\n- Only use `create_thread` when the user explicitly asks to create a new thread. Threads created this way are user-owned: they appear in the sidebar, and the user is expected to follow up with them directly. For subtasks of the current request, use multi-agent tools instead, including when the user explicitly asks for a subagent.\n- After a successful `create_thread` call, emit `::created-thread{threadId=\"...\"}` for a created thread or `::created-thread{clientThreadId=\"...\"}` for queued worktree setup on its own line in your final response.\n\n### Inline Code Comments\n- Use the ::code-comment{...} directive when you need to attach feedback directly to specific code lines.\n- Emit one directive per inline comment; emit none when there are no actionable inline comments.\n- Required attributes: title (short label), body (one-paragraph explanation), file (path to the file).\n- Optional attributes: start, end (1-based line numbers), priority (0-3).\n- file should be an absolute path or include the workspace folder segment so it can be resolved relative to the workspace.\n- Keep line ranges tight; end defaults to start.\n- Example: ::code-comment{title=\"[P2] Off-by-one\" body=\"Loop iterates past the end when length is 0.\" file=\"/path/to/foo.ts\" start=10 end=11 priority=2}\n\n### Git\n- Branch prefix: `codex/`. Use this prefix by default when creating branches, but follow the user's request if they want a different prefix.\n\u003c/app-context\u003e","type":"input_text"},{"text":"## Memory\n\nYou have access to a memory folder with guidance from prior runs. It can save\ntime and help you stay consistent. Use it whenever it is likely to help.\n\nDecision boundary: should you use memory for a new user query?\n\n- Skip memory ONLY when the request is clearly self-contained and does not need\n  workspace history, conventions, or prior decisions.\n- Hard skip examples: current time/date, simple translation, simple sentence\n  rewrite, one-line shell command, trivial formatting.\n- Use memory by default when ANY of these are true:\n  - the query mentions workspace/repo/module/path/files in MEMORY_SUMMARY below,\n  - the user asks for prior context / consistency / previous decisions,\n  - the task is ambiguous and could depend on earlier project choices,\n  - the ask is a non-trivial and related to MEMORY_SUMMARY below.\n- If unsure, do a quick memory pass.\n\nMemory layout (general -\u003e specific):\n\n- /Users/serro/.codex/memories/memory_summary.md (already provided below; do NOT open again)\n- /Users/serro/.codex/memories/MEMORY.md (searchable registry; primary file to query)\n- /Users/serro/.codex/memories/skills/\u003cskill-name\u003e/ (skill folder)\n  - SKILL.md (entrypoint instructions)\n  - scripts/ (optional helper scripts)\n  - examples/ (optional example outputs)\n  - templates/ (optional templates)\n- /Users/serro/.codex/memories/rollout_summaries/ (per-rollout recaps + evidence snippets)\n  - The paths of these entries can be found in /Users/serro/.codex/memories/MEMORY.md or /Users/serro/.codex/memories/rollout_summaries/ as `rollout_path`\n  - These files are append-only `jsonl`: `session_meta.payload.id` identifies the session, `turn_context` marks turn boundaries, `event_msg` is the lightweight status stream, and `response_item` contains actual messages, tool calls, and tool outputs.\n  - For efficient lookup, prefer matching the filename suffix or `session_meta.payload.id`; avoid broad full-content scans unless needed.\n\nQuick memory pass (when applicable):\n\n1. Skim the MEMORY_SUMMARY below and extract task-relevant keywords.\n2. Search /Users/serro/.codex/memories/MEMORY.md using those keywords.\n3. Only if MEMORY.md directly points to rollout summaries/skills, open the 1-2\n   most relevant files under /Users/serro/.codex/memories/rollout_summaries/ or\n   /Users/serro/.codex/memories/skills/.\n4. If above are not clear and you need exact commands, error text, or precise evidence, search over `rollout_path` for more evidence.\n5. If there are no relevant hits, stop memory lookup and continue normally.\n\nQuick-pass budget:\n\n- Keep memory lookup lightweight: ideally \u003c= 4-6 search steps before main work.\n- Avoid broad scans of all rollout summaries.\n\nDuring execution: if you hit repeated errors, confusing behavior, or suspect\nrelevant prior context, redo the quick memory pass.\n\nHow to decide whether to verify memory:\n\n- Consider both risk of drift and verification effort.\n- If a fact is likely to drift and is cheap to verify, verify it before\n  answering.\n- If a fact is likely to drift but verification is expensive, slow, or\n  disruptive, it is acceptable to answer from memory in an interactive turn,\n  but you should say that it is memory-derived, note that it may be stale, and\n  consider offering to refresh it live.\n- If a fact is lower-drift and expensive to verify, it is usually fine to\n  answer from memory directly.\n\nWhen answering from memory without current verification:\n\n- If you rely on memory for a fact that you did not verify in the current turn,\n  say so briefly in the final answer.\n- If that fact is plausibly drift-prone or comes from an older note, older\n  snapshot, or prior run summary, say that it may be stale or outdated.\n- If live verification was skipped and a refresh would be useful in the\n  interactive context, consider offering to verify or refresh it live.\n- Do not present unverified memory-derived facts as confirmed-current.\n- Prefer a short refresh offer for interactive questions, especially about prior\n  results, commands, timing, or older snapshots.\n\nMemory citation requirements:\n\n- If ANY relevant memory files were used: append exactly one\n`\u003coai-mem-citation\u003e` block as the VERY LAST content of the final reply.\n  Normal responses should include the answer first, then append the\n`\u003coai-mem-citation\u003e` block at the end.\n- Use this exact structure for programmatic parsing:\n```\n\u003coai-mem-citation\u003e\n\u003ccitation_entries\u003e\nMEMORY.md:234-236|note=[responsesapi citation extraction code pointer]\nrollout_summaries/2026-02-17T21-23-02-LN3m-example.md:10-12|note=[weekly report format]\n\u003c/citation_entries\u003e\n\u003crollout_ids\u003e\n019c6e27-e55b-73d1-87d8-4e01f1f75043\n019c7714-3b77-74d1-9866-e1f484aae2ab\n\u003c/rollout_ids\u003e\n\u003c/oai-mem-citation\u003e\n```\n- `citation_entries` is for rendering:\n  - one citation entry per line\n  - format: `\u003cfile\u003e:\u003cline_start\u003e-\u003cline_end\u003e|note=[\u003chow memory was used\u003e]`\n  - use file paths relative to the memory base path (for example, `MEMORY.md`,\n    `rollout_summaries/...`, `skills/...`)\n  - only cite files actually used under the memory base path (do not cite\n    workspace files as memory citations)\n  - if you used `MEMORY.md` and then a rollout summary/skill file, cite both\n  - list entries in order of importance (most important first)\n  - `note` should be short, single-line, and use simple characters only (avoid\n    unusual symbols, no newlines)\n- `rollout_ids` is for us to track what previous rollouts you find useful:\n  - include one rollout id per line\n  - rollout ids should look like UUIDs (for example,\n    `019c6e27-e55b-73d1-87d8-4e01f1f75043`)\n  - include unique ids only; do not repeat ids\n  - an empty `\u003crollout_ids\u003e` section is allowed if no rollout ids are available\n  - you can find rollout ids in rollout summary files and MEMORY.md\n  - do not include file paths or notes in this section\n  - For every `citation_entries`, try to find and cite the corresponding rollout id if possible\n- Never include memory citations inside pull-request messages.\n- Never cite blank lines; double-check ranges.\n\nUpdating memories:\n\nYou can update the memories **only** when explicitly asked by the user. This must always come from a direct request from the user.\n- Write your update in /Users/serro/.codex/memories/extensions/ad_hoc/notes/\n- Each update must be one small file containing what you want to add/delete/update from the memories.\n- The name of this file must be `\u003ctimestamp\u003e-\u003cshort slug\u003e.md`\n- Do not try to edit the memory files yourself, only add one update note in /Users/serro/.codex/memories/extensions/ad_hoc/notes/\n\n========= MEMORY_SUMMARY BEGINS =========\nv1\n\n## User Profile\n\nWorks across Skillplane, Superfunctions, btnextjs/Serro, 21n, DiffPanel, and recurring browser/archive workflows on macOS/zsh. Values exact authority boundaries, preservation of dirty work, and evidence that separates local checks from browser, deployment, OAuth, or live proof. Uses Chrome profiles deliberately and expects honest blocked/partial states.\n\n## User preferences\n\n- “Thorough read-only code review” means snapshot staged/unstaged/untracked state and surrounding contracts; do not edit, format, stage, commit, push, deploy, or create artifacts without separate authority.\n- Preserve unrelated dirty work; use exact-head/dedicated worktrees. No commit/push means local-only.\n- Required Chrome profile `Ar@fyweb` is a hard constraint for feed workflows: no Default/Wavebox fallback; clean up workflow-created tabs.\n- Browser/archive work needs current-source evidence, `archive/`/`tmp/` hygiene, checkpoints for long runs, requested validation fields, and actual content synthesis—not just a runner receipt.\n- Do not fabricate external verification, URLs, website content, or success: report blocked/partial/unverified accurately.\n- For Daily Contem, source links, provenance/freshness caveats, zero coverage for missing families, standalone HTML, absolute artifact path, and automation-memory recording are acceptance criteria.\n- Lenny Product Pass email is “when and only when the product list changes”: empty canonical diff means no snapshot/log/latest/email mutation.\n- `splane \u003cslug-or-skill-name\u003e` means retrieve and follow the live hosted Skillplane MCP skill for the authorized workspace and exact published version; do not substitute local instructions. [ad-hoc note]\n\n## General Tips\n\n- `node` may be absent from PATH: use `/opt/homebrew/bin/node`; installed-Chrome rendering/native SQLite workflows may need `/opt/homebrew/opt/node@22/bin/node` to match Node/ABI requirements.\n- Quote zsh paths/URLs with brackets or `?`. Use `GH_CONFIG_DIR=/Users/serro/.config/gh-other` for private Superfunctions GitHub work.\n- A green focused test/build does not prove deployment, browser UX, OAuth completion, registry state, resolved review threads, or production write-back.\n- Attribute repo-wide test/type/lint failures to changed hunks before calling them regressions; do not fix baselines in read-only work.\n- Search `MEMORY.md` by exact cwd, API, error, command, or workflow term before reopening summaries.\n\n## What's in Memory\n\n### /Users/serro/Documents/dev/n/agent/experiments/skillplane\n\n#### 2026-08-22\n\n- Backlog capture through hosted MCP: `SKI-11`, `SKI-12`, `21n/add-to-backlog@1.1.0`, Git-hosted skill sources, skill groups\n  - desc: Separate Linear backlog issues and verified documents/links for skill groups/member assignments and repository imports.\n  - learnings: Retrieve live MCP workflows and dependencies before mutation; imports are untrusted and must be non-executing/idempotent.\n- Local E2E/OAuth and PostHog PR remediation: `app-local.skillplane.dev`, `pnpm test:local:oauth`, `ERR_PNPM_OUTDATED_LOCKFILE`, `PostHog wizard`\n  - desc: Local ports/tunnels, isolated development deployment, and the interactive OAuth/wizard completion boundary.\n  - learnings: Loopback bearer tests differ from browser OAuth; OTP/consent plus authenticated MCP call remain required for E2E proof.\n\n### /Users/serro/Documents/dev/n/agent/workflows\n\n#### 2026-08-22\n\n- Public-feed archive recovery: `Ar@fyweb`, `safe-continuation-helper.mjs`, `Sorry.`, `TweetResultByRestId`, `contentAccess`\n  - desc: Medium/X/Product Hunt partial recovery and validated HN/Lobsters archive workflows.\n  - learnings: Persist small batches; keep partial evidence truthful; use built-in HN retries and validate archive metadata independently.\n\n### /Users/serro/Documents/dev/n/agent/experiments/diffpanel\n\n#### 2026-08-22\n\n- DiffPanel migration and CLI repair: `conductor.sqlite3`, `diffpanel.sqlite3`, `immutable=1`, `spawn diffpanel ENOENT`, `diffpanel doctor`\n  - desc: Legacy Conductor review migration, global skill symlink repair, and extension CLI diagnosis.\n  - learnings: Move blobs/runs/SQLite together and use matching Node 22 native bindings.\n\n### /Users/serro/Documents/dev/n/21n\n\n#### 2026-08-22\n\n- Skillplane landing hero backgrounds: `Hero.svelte`, `ControlPlane.svelte`, `HeroBackgroundStepper.svelte`, `?bg=`, `ArrowLeft`\n  - desc: Query-selected backgrounds, extracted control plane, header steppers, and keyboard navigation in `landing/skillplane`.\n  - learnings: Valid background range is 1..112; keep intro spacing separate from control-plane spacing.\n\n### Older Memory Topics\n\n#### /Users/serro/Documents/dev/n/superfunctions\n\n- Superfunctions PR/release and worktree workflows: `sf-next/next`, `--match-head-commit`, `GH_CONFIG_DIR`, `splane`\n  - desc: Checkout-sensitive implementation, review, merge, and hosted-skill procedures; search by exact package/PR/branch.\n\n#### /Users/serro/Documents/dev/repos\n\n- btnextjs/kgqa/serro-mcp reviews: `Drizzle`, `OAuth 2.1/DCR`, `PostHog`, `Ask Serro`, `SRO-724`, `SRO-716`\n  - desc: Read-only and authorized local review/fix workflows; cwd-sensitive, with Node 22 and baseline-attribution guidance.\n\n#### /Users/serro/Documents/dev/n/agent/workflows and workflows2\n\n- Daily Contem and Lenny watcher: `daily-contem-summary`, `data-offer-card`, `latest.json`, `byte-identical`, `no-email`\n  - desc: Source-first reporting and strict change-only watcher side effects; inspect this before recurring automation work.\n========= MEMORY_SUMMARY ENDS =========\n\nWhen memory is likely relevant, start with the quick memory pass above before\ndeep repo exploration.\n","type":"input_text"},{"text":"\u003cskills_instructions\u003e\n## Skills\nA skill is a set of local instructions to follow that is stored in a `SKILL.md` file. Below is the list of skills that can be used. Each entry includes a name, description, and a short path that can be expanded into an absolute path using the skill roots table.\n### Skill roots\n- `r0` = `/Users/serro/.codex/skills`\n- `r1` = `/Users/serro/.agents/skills`\n- `r2` = `/Users/serro/.codex/skills/.system`\n- `r3` = `/Users/serro/.codex/plugins/cache/openai-bundled`\n- `r4` = `/Users/serro/.codex/plugins/cache/openai-bundled/sites/0.1.40/skills`\n- `r5` = `/Users/serro/.codex/plugins/cache/openai-curated-remote/figma/2.0.20/skills`\n- `r6` = `/Users/serro/.codex/plugins/cache/openai-curated-remote/google-drive/0.1.11/skills`\n- `r7` = `/Users/serro/.codex/plugins/cache/openai-curated-remote/notion/0.1.7/skills`\n- `r8` = `/Users/serro/.codex/plugins/cache/openai-curated-remote`\n- `r9` = `/Users/serro/.codex/plugins/cache/openai-primary-runtime`\n- `r10` = `/Users/serro/.codex/plugins/cache/openai-primary-runtime/spreadsheets/26.819.11345/skills`\n### Available skills\n- imagegen: Generate or edit raster images when the task benefits from AI-created bitmap visuals such as photos, illustrations, textures, sprites, mockups, or transparent-background cutouts. Use when Codex should create a brand-new image, transform an existing image, or derive visual variants from references, and the output should be a bitmap asset rather than repo-native code or vector. Do not use when the task is better hand (file: r2/imagegen/SKILL.md)\n- openai-docs: Use for Codex models/pricing, scheduled tasks, skills, settings, setup, troubleshooting, customization, automations, and self-knowledge—including 'you,' 'your,' 'this app,' or 'this coding agent' when they refer to Codex—and for OpenAI APIs/products and ChatGPT Work. Also use for model choice/migration, prompting, SDKs, Responses, Realtime, agents, evals, and Chat/Work/Codex comparisons. Do not use for generic ap (file: r2/openai-docs/SKILL.md)\n- plugin-creator: Create and scaffold plugin directories for Codex with a required `.codex-plugin/plugin.json`, optional plugin folders/files, valid manifest defaults, and personal-marketplace entries by default. Use when Codex needs to create a new personal plugin, add optional plugin structure, generate or update marketplace entries for plugin ordering and availability metadata, or update an existing local plugin during developmen (file: r2/plugin-creator/SKILL.md)\n- skill-creator: Create or update a Codex skill with appropriately scoped instructions and any needed supporting resources. (file: r2/skill-creator/SKILL.md)\n- skill-installer: Install Codex skills into $CODEX_HOME/skills from a curated list or a GitHub repo path. Use when a user asks to list installable skills, install a curated skill, or install a skill from another repo (including private repos). (file: r2/skill-installer/SKILL.md)\n- aside-browser: Read when you need a browser automation (QA, element interaction, screencapture/snapshot, network capture, so on), or have to work across user's logged-in accounts, apps (e.g. Slack, X, LinkedIn, etc.), memory, and browsing history. (file: r1/aside-browser/SKILL.md)\n- audit: You are an audit agent. Your job is to perform a THOROUGH, READ-ONLY audit of an implemented codebase against the spec provided. (file: r0/audit/SKILL.md)\n- browser:control-in-app-browser: Control the in-app Browser for opening, navigating, inspecting visible or interactive page state, clicking, typing, screenshots, and local web testing. It can have existing signed-in sessions. For semantic operations on linked resources, prefer a purpose-built connector, API, or CLI when available. (file: r3/browser/26.818.21641/skills/control-in-app-browser/SKILL.md)\n- check-codex-resets: Check a signed-in Codex Desktop account's current Codex usage windows, rate-limit reset times, banked reset-credit count, and reset-credit expiry dates. Use when the user asks how many Codex resets or reset credits they have, when Codex limits reset or expire, how much 5-hour or weekly Codex capacity remains, or to run the local Codex reset watcher style check from the existing Codex Desktop login. (file: r0/check-codex-resets/SKILL.md)\n- chrome:control-chrome: Control the user's Chrome browser for tasks that depend on existing Chrome state: tabs, logged-in sessions, or extensions. Prefer purpose-built connectors, APIs, or CLIs when available. (file: r3/chrome/26.818.21641/skills/control-chrome/SKILL.md)\n- chronicle: Allows you to view the user's screen as well as several hours of history. Use when the user makes a reference to their recent work, for which it'd be helpful to see the screen. This skill MUST be used whenever you need to resolve ambiguity in a user request, where the user hasn't specified enough context to do the task. Examples include disambiguating the specific user/app/document/error the user is referring to. (file: r0/chronicle/SKILL.md)\n- computer-use:computer-use: Control local Mac apps through Computer Use for tasks that require reading or operating app UI. Prefer purpose-built connectors, APIs, or CLIs when available. (file: r3/computer-use/1.0.1000790/skills/computer-use/SKILL.md)\n- create-pr-ghother: Create or update a GitHub pull request using `GH_CONFIG_DIR=~/.config/gh-other`, especially when the current worktree is dirty or based on the wrong branch. Use this when the user wants a PR against a specific remote and branch such as `origin/dev` or `next/next`, needs `.conduct` included or excluded based on target, wants branch/title prefixing, or needs a clean temporary worktree to avoid dragging unrelated hi (file: r0/create-pr-ghother/SKILL.md)\n- diffpanel-chapters: Generate and publish persistent Diffpanel review chapters for local Git worktrees, staged changes, branch or commit ranges, and repository-wide snapshots. Use when a user asks to organize code into review chapters, create a repo-wide review plan, review current changes through Diffpanel, or populate the Diffpanel VS Code/Cursor extension. (file: r1/diffpanel-chapters/SKILL.md)\n- docs-sync: Audit and synchronize project documentation against live implemented code. Use when Codex needs to scan a repo's docs tree, flag stale or contradictory docs, identify missing documentation coverage, improve examples or conceptual guides, or expand docs so the current implementation is the source of truth. (file: r0/docs-sync/SKILL.md)\n- documents:documents: Create, edit, redline, and comment on `.docx`, Word, and Google Docs-targeted document artifacts inside the container, with a strict render-and-verify workflow. Use `render_docx.py` to generate page PNGs (and optional PDF) for visual QA, then iterate until layout is flawless before delivering the final document. (file: r9/documents/26.819.11345/skills/documents/SKILL.md)\n- execute: You are an implementation agent. You will execute EXACTLY one phase: PHASE_{NN} (NN is provided by the user). You must not do work from other phases. (file: r0/execute/SKILL.md)\n- execute-issue: You are an issue resolution agent. You will work directly on an issue, skipping the spec generation part of the regular spec-execute flow. Your job is to thoroughly read the provided issue file or description and work on the issue completely. (file: r0/execute-issue/SKILL.md)\n- execute-phase: Execute exactly one numbered phase from a spec bundle. Use when Codex must implement a single PHASE_{NN}, verify it locally, write the required phase completion report, and update .conduct logs or tracker files without touching other phases. (file: r0/execute-phase/SKILL.md)\n- figma:figma-code-connect: Creates and maintains Figma Code Connect template files that map Figma components to code snippets. Use when the user mentions Code Connect, Figma component mapping, design-to-code translation, or asks to create/update .figma.ts or .figma.js files. (file: r5/figma-code-connect/SKILL.md)\n- figma:figma-create-new-file: **MANDATORY prerequisite** — you MUST invoke this skill BEFORE every `create_new_file` tool call. NEVER call `create_new_file` directly without loading this skill first. Trigger whenever the user wants a new blank Figma file — a new design, FigJam, or Slides file — or when you need a fresh file before calling `use_figma`. Usage — /figma-create-new-file [editorType] [fileName] (e.g. /figma-create-new-file figjam My  (file: r5/figma-create-new-file/SKILL.md)\n- figma:figma-design-to-code: **MANDATORY prerequisite** — you MUST invoke this skill BEFORE calling the `get_design_context` Figma MCP tool. You MUST trigger this skill whenever the user wants to implement, build, port, or code up a Figma design as code. Example prompts (not exhaustive) are 'implement this Figma design', 'build this screen from Figma', 'turn this Figma into code', 'design to code'. This skill provides critical instructions and (file: r5/figma-design-to-code/SKILL.md)\n- figma:figma-generate-design: Use this skill alongside figma-use when the task involves translating an application page, view, or multi-section layout into Figma. Triggers: 'write to Figma', 'create in Figma from code', 'push page to Figma', 'take this app/page and build it in Figma', 'create a screen', 'build a landing page in Figma', 'update the Figma screen to match code', 'convert this modal/dialog/drawer/panel to Figma'. This is the prefer (file: r5/figma-generate-design/SKILL.md)\n- figma:figma-generate-diagram: MANDATORY prerequisite — load this skill BEFORE every `generate_diagram` tool call. NEVER call `generate_diagram` directly without loading this skill first. Trigger whenever the user asks to create, generate, draw, render, sketch, or build a diagram — flowchart, architecture diagram, sequence diagram, ERD or entity-relationship diagram, state diagram or state machine, gantt chart, or timeline. Also trigger when t (file: r5/figma-generate-diagram/SKILL.md)\n- figma:figma-generate-library: Build or update a professional-grade design system in Figma from a codebase. Use when the user wants to create variables/tokens, build component libraries, create individual components with proper variant sets and variable bindings, set up theming (light/dark modes), document foundations, or reconcile gaps between code and Figma. Also use when the user asks to create or generate any component in Figma — even a sing (file: r5/figma-generate-library/SKILL.md)\n- figma:figma-implement-motion: Translates Figma motion and animations into production-ready application code. Use when implementing animation/motion from a Figma design — user mentions \"implement this motion\", \"add animation from Figma\", \"animate this component\", provides a Figma URL whose node is animated, or when `get_design_context` returns motion data or instructs you to call `get_motion_context`. (file: r5/figma-implement-motion/SKILL.md)\n- figma:figma-swiftui: SwiftUI ↔ Figma translation. Use whenever the user mentions Swift, SwiftUI, iOS, iPhone, or iPad — in EITHER direction — translating a Figma design into SwiftUI (design → code), or pushing SwiftUI views / screens / tokens back into a Figma file (code → design). Triggers on phrases like 'implement this Figma design in SwiftUI', 'build this screen in Swift', 'push this SwiftUI view to Figma', 'mirror my Swift code  (file: r5/figma-swiftui/SKILL.md)\n- figma:figma-use: **MANDATORY prerequisite** — you MUST invoke this skill BEFORE every `use_figma` tool call. NEVER call `use_figma` directly without loading this skill first. Skipping it causes common, hard-to-debug failures. Trigger whenever the user wants to perform a write action or a unique read action that requires JavaScript execution in the Figma file context — e.g. create/edit/delete nodes, set up variables or tokens, b (file: r5/figma-use/SKILL.md)\n- figma:figma-use-figjam: This skill helps agents use Figma's use_figma MCP tool in the FigJam context. Can be used alongside figma-use which has foundational context for using the use_figma tool. (file: r5/figma-use-figjam/SKILL.md)\n- figma:figma-use-motion: Motion / animation context for the `use_figma` MCP tool — animating Figma nodes via manual keyframes, animation styles, easing, and timeline duration. Load alongside figma-use whenever a task involves adding, editing, or inspecting animation on a node. (file: r5/figma-use-motion/SKILL.md)\n- figma:figma-use-slides: This skill helps agents use Figma's use_figma MCP tool in the Slides context. Can be used alongside figma-use which has foundational context for using the use_figma tool. (file: r5/figma-use-slides/SKILL.md)\n- find-skills: Helps users discover and install agent skills when they ask questions like \"how do I do X\", \"find a skill for X\", \"is there a skill that can...\", or express interest in extending capabilities. This skill should be used when the user is looking for functionality that might exist as an installable skill. (file: r1/find-skills/SKILL.md)\n- google-drive:google-docs: Prompt- and template-complete Google Docs creation and editing with explicit-instruction-authoritative structural preservation, including semantic roles, relationships, comparison dimensions, and instructed extensions; full-topology native-copy routing; source-grounded per-tab adaptation for past/example references; style-preserving hyperlink and table edits; canonical smart-chip-first authoring for dates and re (file: r6/google-docs/SKILL.md)\n- google-drive:google-drive: Use connected Google Drive as the single entrypoint for Drive, Docs, Sheets, and Slides work. Use when the user wants to find, fetch, organize, share, export, copy, or delete Drive files, or summarize and edit Google Docs, Google Sheets, and Google Slides through one unified Google Drive plugin. (file: r6/google-drive/SKILL.md)\n- google-drive:google-drive-comments: Write, reply to, and resolve Google Drive comments on Docs, Sheets, Slides, and Drive files with evidence-backed location context. Use when the user asks to leave comments, review a file with comments, respond to comment threads, or resolve Drive comments. (file: r6/google-drive-comments/SKILL.md)\n- google-drive:google-sheets: Analyze and edit connected Google Sheets with range precision. Use when the user wants to create Google Sheets, find a spreadsheet, inspect tabs or ranges, search rows, plan formulas, create or repair charts, clean or restructure tables, write concise summaries, or make explicit cell-range updates. (file: r6/google-sheets/SKILL.md)\n- google-drive:google-slides: Route Google Slides authoring requests and derive a design system from a native template or reference deck. Use this skill when the user provides an existing native Google Slides deck as a template, reference, or prior-period source, or asks to edit, update, repair, restyle, or clean up an existing native Google Slides deck. Use the Presentations skill instead for net-new presentation creation when no existing n (file: r6/google-slides/SKILL.md)\n- issue: You are a troubleshooting and documentation agent. Your job is to investigate the root cause of an issue reported by the user and document it comprehensively in the project's `.conduct/issues/` folder as a markdown file. (file: r0/issue/SKILL.md)\n- notion:notion-knowledge-capture: Capture conversations and decisions into structured Notion pages; use when turning chats/notes into wiki entries, how-tos, decisions, or FAQs with proper linking. (file: r7/notion-knowledge-capture/SKILL.md)\n- notion:notion-meeting-intelligence: Prepare meeting materials with Notion context and supplemental research; use when gathering context, drafting agendas/pre-reads, and tailoring materials to attendees. (file: r7/notion-meeting-intelligence/SKILL.md)\n- notion:notion-research-documentation: Research across Notion and synthesize into structured documentation; use when gathering info from multiple Notion sources to produce briefs, comparisons, or reports with citations. (file: r7/notion-research-documentation/SKILL.md)\n- notion:notion-spec-to-implementation: Turn Notion specs into implementation plans, tasks, and progress tracking; use when implementing PRDs/feature specs and creating Notion plans + tasks from them. (file: r7/notion-spec-to-implementation/SKILL.md)\n- pdf:pdf: Read, create, inspect, render, and verify PDF files where visual layout matters, including fillable AcroForms. Use Poppler rendering plus Python tools such as reportlab, pdfplumber, and pypdf for generation and extraction. (file: r9/pdf/26.819.11345/skills/pdf/SKILL.md)\n- plugin-management:plugin-management: Discover and suggest relevant plugins, inspect app permissions and dependencies, and manage plugin connections or removal. Use when the user asks about plugins or when a task would materially benefit from an external app, account, service, or data source that available tools cannot access. (file: r8/plugin-management/0.1.0/skills/plugin-management/SKILL.md)\n- pr-fixes: Fix code issues from a generated PR analysis report and return a terse issue-status summary. Use when Codex is asked to apply fixes from `.conduct/pr-reports`, address issues listed in a PR report, work through critical/medium/low findings from an automated review summary, or repair code based on a previously generated PR analysis markdown file. (file: r0/pr-fixes/SKILL.md)\n- pr-refetch-fix: Refetch the latest GitHub PR review feedback reliably before applying fixes. Use when a user asks to re-check review comments after a push, says there are newer PR comments that were missed, or when timestamp-only PR comment queries may be incomplete or misleading. This skill is for GitHub PR review triage where unresolved review threads, inline comments, review bodies, and issue comments must be checked togeth (file: r0/pr-refetch-fix/SKILL.md)\n- pr-report: Generate comprehensive GitHub pull request analysis reports from automated review feedback and organize issues by severity, filename, and review tool. Use when Codex is asked to create a PR report, analyze bot comments on a PR, summarize CodeRabbit/Sourcery/Cubic/Typo-app review findings, or write a timestamped markdown report under `.conduct/pr-reports` for the current repository. (file: r0/pr-report/SKILL.md)\n- presentation: Format general responses only when the runtime context explicitly identifies the Zed editor and zed:// file links are supported. Never use in Codex Desktop, Codex CLI, ChatGPT, or any other non-Zed environment. (file: r1/presentation/SKILL.md)\n- presentations:Presentations: Read, create or edit PowerPoint or Google Slides decks. Use for presentation, slide deck, PowerPoint, PPT, PPTX, or Google Slides requests. (file: r9/presentations/26.819.11345/skills/presentations/SKILL.md)\n- probe-fix: Reproduce and fix frontend app issues by creating or adapting impromptu Playwright probes, inspecting screenshots/HTML/JSON artifacts plus browser and app logs, then applying the narrowest non-regressive fix and rerunning until the flow is green. Use when existing tests do not cover a UI bug, when a frontend flow freezes or crashes, or when you need exploratory end-to-end verification of create/edit/open/reopen b (file: r0/probe-fix/SKILL.md)\n- response-formatting: Format code findings and source references only when the runtime context explicitly identifies the Zed editor and zed:// file links are supported. Never use in Codex Desktop, Codex CLI, ChatGPT, or any other non-Zed environment. (file: r1/response-formatting/SKILL.md)\n- sites:sites-building: Use Sites to build websites, including landing pages, portfolios, dashboards, portals, trackers, hubs, and internal tools. Always use Sites when the project contains `.openai/hosting.json`. (file: r4/sites-building/SKILL.md)\n- sites:sites-hosting: Host websites with Sites. Always use after `sites-building`, and use for website publishing, deployment, hosting management, or projects containing `.openai/hosting.json`. (file: r4/sites-hosting/SKILL.md)\n- spec: You are a senior software architect and spec-writer. Your job is to produce a HIGH-PRECISION spec and a phased implementation plan that can be executed by multiple agents without “checkbox completion” or missing core semantics. (file: r0/spec/SKILL.md)\n- spreadsheets:Spreadsheets: Create, edit, analyze, and verify standalone spreadsheet files or Google Sheets-ready workbooks, including .xlsx, .xls, .csv, and .tsv. Do not use for live controlling Microsoft Excel app or a live Excel session. (file: r10/spreadsheets/SKILL.md)\n- spreadsheets:excel-live-control: Control an open or active Microsoft Excel workbook through the ChatGPT add-in or connected session. Use when the user tags the Microsoft Excel app in Codex or follows up on an established live Excel task. Do not use for standalone spreadsheet files or Google Sheets. (file: r10/excel-live-control/SKILL.md)\n- stage-chapters: Generate Stage chapters for the current local git branch and open them in a browser for review. (file: r1/stage-chapters/SKILL.md)\n- sync-sf-next-to-dev: Inventory changes on local Superfunctions `next` that are relevant to local `dev`, limited to functions and shared packages already present on `dev`, ignoring `.conduct` artifacts and ignoring top-level functions/packages that exist only on `next`. (file: r0/sync-sf-next-to-dev/SKILL.md)\n- template-creator:template-creator: Create or update a reusable personal Codex artifact-template skill. Use when the user invokes $template-creator or asks in natural language to create a reusable template from a reference document, presentation, spreadsheet, Google Docs, Slides, or Sheets link, ImageGen or Product Design image, email, Slack message, or Site project, or explicitly asks to edit or update a passed artifact-template skill. Do not use  (file: r9/template-creator/26.819.11345/skills/template-creator/SKILL.md)\n- visualize:visualize: Create visualizations and interactive tools directly in conversation. Use when asked to show how something works, make simulators or labs, maps, plots, charts or graphs, comparisons, UI mockups, scenarios, adjustable inputs, and exploration beyond regular text. (file: r3/visualize/1.0.22/skills/visualize/SKILL.md)\n\u003c/skills_instructions\u003e","type":"input_text"},{"text":"\u003cpermissions instructions\u003e\nFilesystem sandboxing defines which files can be read or written. `sandbox_mode` is `danger-full-access`: No filesystem sandboxing - all commands are permitted. Network access is enabled.\nApproval policy is currently never. Do not provide the `sandbox_permissions` for any reason, commands will be rejected.\n\u003c/permissions instructions\u003e","type":"input_text"},{"text":"\u003ccollaboration_mode\u003e# Collaboration Mode: Default\n\nYou are now in Default mode. Any previous instructions for other modes (e.g. Plan mode) are no longer active.\n\nYour active mode changes only when new developer instructions with a different `\u003ccollaboration_mode\u003e...\u003c/collaboration_mode\u003e` change it; user requests or tool descriptions do not change mode by themselves. Known mode names are Default and Plan.\n\n## request_user_input availability\n\nUse the `request_user_input` tool only when it is listed in the available tools for this turn.\n\nIn Default mode, strongly prefer making reasonable assumptions and executing the user's request rather than stopping to ask questions. If you absolutely must ask a question because the answer cannot be discovered from local context and a reasonable assumption would be risky, ask the user directly with a concise plain-text question. Never write a multiple choice question as a textual assistant message.\n\u003c/collaboration_mode\u003e","type":"input_text"},{"text":"\u003capps_instructions\u003e\n## Apps (Connectors)\nApps (Connectors) can be explicitly triggered in user messages in the format `[$app-name](app://{connector_id})`. Apps can also be implicitly triggered as long as the context suggests usage of available apps.\nAn app is equivalent to a set of MCP tools within the `codex_apps` MCP.\nAn installed app's MCP tools are either provided to you already, or can be lazy-loaded through the `tool_search` tool. If `tool_search` is available, the apps that are searchable by `tools_search` will be listed by it.\nDo not additionally call list_mcp_resources or list_mcp_resource_templates for apps.\n\u003c/apps_instructions\u003e","type":"input_text"},{"text":"\u003cplugins_instructions\u003e\n## Plugins\nA plugin is a local bundle of skills, MCP servers, and apps.\n### How to use plugins\n- Skill naming: If a plugin contributes skills, those skill entries are prefixed with `plugin_name:` in the Skills list.\n- MCP naming: Plugin-provided MCP tools keep standard MCP identifiers such as `mcp__server__tool`; use tool provenance to tell which plugin they come from.\n- Trigger rules: If the user explicitly names a plugin, prefer capabilities associated with that plugin for that turn.\n- Relationship to capabilities: Plugins are not invoked directly. Use their underlying skills, MCP tools, and app tools to help solve the task.\n- Relevance: Determine what a plugin can help with from explicit user mention or from the plugin-associated skills, MCP tools, and apps exposed elsewhere in this turn.\n- Missing/blocked: If the user requests a plugin that does not have relevant callable capabilities for the task, say so briefly and continue with the best fallback.\n\u003c/plugins_instructions\u003e","type":"input_text"}],"id":"msg_01a02e75-3baa-72f0-9dcc-9fd945a0ae26","internal_chat_message_metadata_passthrough":{"turn_id":"01a02e6e-3560-7e22-a95e-b95a3d227c08"},"role":"developer","type":"message"},{"content":[{"text":"You are `/root`, the primary agent in a team of agents collaborating to fulfill the user's goals.\n\nAt the start of your turn, you are the active agent.\nYou can spawn sub-agents to handle subtasks, and those sub-agents can spawn their own sub-agents.\nAll agents in the team, including the agents that you can assign tasks to, are equally intelligent and capable, and have access to the same set of tools.\n\nYou can use `spawn_agent` to create a new agent, `followup_task` to give an existing agent a new task and trigger a turn, and `send_message` to pass a message to a running agent without triggering a turn.\nChild agents can also spawn their own sub-agents.\nYou can decide how much context you want to propagate to your sub-agents with the `fork_turns` parameter.\n\nYou will receive messages in the analysis channel in the form:\n```\nMessage Type: MESSAGE | FINAL_ANSWER\nTask name: \u003crecipient\u003e\nSender: \u003cauthor\u003e\nPayload:\n\u003cpayload text\u003e\n```\nThey may be addressed as to=/root\n\nNote that collaboration tools cannot be called from inside `functions.exec`. Call `spawn_agent`, `send_message`, `followup_task`, `wait_agent`, `interrupt_agent`, and `list_agents` only as direct tool calls using the recipient shown in their tool definitions, such as `to=functions.collaboration.spawn_agent`, since they are intentionally absent from the `functions.exec` `tools.*` namespace. Available tools in `functions.exec` are explicitly described with a `tools` namespace in the developer message.\n\nAll agents share the same directory. In detail:\n- All agents have access to the same container and filesystem as you.\n- All agents use the same current working directory.\n- As a result, edits made by one agent are immediately visible to all other agents.\n\nWhen calling `wait_agent`, prefer longer waits (minutes) to avoid busy polling.\n\nThere are 4 available concurrency slots, meaning that up to 4 agents can be active at once, including you.\n\nFull-history forks (`fork_turns` omitted or `\"all\"`) inherit the parent model and reasoning effort and do not accept overrides. Only set `model` or `reasoning_effort` when explicitly requested by the user, applicable `AGENTS.md` instructions, or skill instructions; when doing so, set `fork_turns` to `\"none\"` or a positive integer string.","type":"input_text"}],"id":"msg_01a02e75-3bab-7810-a260-7d3744315311","internal_chat_message_metadata_passthrough":{"turn_id":"01a02e6e-3560-7e22-a95e-b95a3d227c08"},"role":"developer","type":"message"},{"content":[{"text":"\u003cmulti_agent_mode\u003eAny earlier instruction enabling proactive multi-agent delegation no longer applies. Do not spawn sub-agents unless the user or applicable AGENTS.md/skill instructions explicitly ask for sub-agents, delegation, or parallel agent work.\u003c/multi_agent_mode\u003e","type":"input_text"}],"id":"msg_01a02e75-3bab-7810-a260-7d459fe07901","internal_chat_message_metadata_passthrough":{"turn_id":"01a02e6e-3560-7e22-a95e-b95a3d227c08"},"role":"developer","type":"message"},{"content":[{"text":"\u003crecommended_plugins\u003e\nHere is a list of plugins that are available but not installed.\n\n- Airtable (airtable@openai-curated-remote)\n- Alpaca (alpaca@openai-curated-remote)\n- Apollo.io (apollo@openai-curated-remote)\n- Spotify (app-68de829bf7648191acd70a907364c67c@openai-curated-remote)\n- Apple Music (app-6938a94a61d881918ef32cb999ff937c@openai-curated-remote)\n- LONA Trading Assistant (app-694336b0c0948191a4ad234f9942885b@openai-curated-remote)\n- SciSpace (app-69439d715a7c8191aed9e2f6649e105f@openai-curated-remote)\n- Tarot (app-6943a2c078b0819188de39e4fe168d9b@openai-curated-remote)\n- Todoist: To Do List \u0026 Calendar (app-6943b73823548191a9f9216c6790c453@openai-curated-remote)\n- Consensus (app-6943e6f4a928819195962de16fb9ffe4@openai-curated-remote)\n- Sider Scholar (app-6948b485f5bc8191adb4df13f369cec7@openai-curated-remote)\n- True Sky (app-69490a4a06148191a0dd78606a3dbf1f@openai-curated-remote)\n- Bigdata.com (app-69491eceef3c8191beb70788b7840429@openai-curated-remote)\n- Gamma (app-698a098735908191989f5788d7ee317e@openai-curated-remote)\n- Tredict (app-69aef5b699a0819184512d57743fc1cd@openai-curated-remote)\n- Maersk (app-69b2b5a768d4819190d3a86c5f12e6d9@openai-curated-remote)\n- Dropbox (app-69b31dc2110c8191b8b47dc98fe5a052@openai-curated-remote)\n- Parqet (app-69b68652f0308191a27d7c7096cab4f6@openai-curated-remote)\n- Interactive Brokers (IBKR) (app-69bc11db874881918718abaca20b68ce@openai-curated-remote)\n- Financial Datasets (app-69cacd9394a88191ba6564e1bb0430fa@openai-curated-remote)\n- Fathom (app-69d88b99c5c481918e8da9225737e1e9@openai-curated-remote)\n- vidIQ (app-69dd11f3e50c8191b1ca48d03cf7e2ad@openai-curated-remote)\n- TickTick:To-Do List \u0026 Calendar (app-69ddbaba3fb48191a825f22c21b0599d@openai-curated-remote)\n- Plaud (app-69f3c30d68288191bbd428a394a78407@openai-curated-remote)\n- Wolfram (app-69fe0bf66c8481919c513d799406436e@openai-curated-remote)\n- Runway (app-6a05e3b201788191be12b590b43e6ce3@openai-curated-remote)\n- Caliber (app-6a05e8f22d408191b13ba3897157f6df@openai-curated-remote)\n- COROS (app-6a0694cbb2608191bbefb74ba810ab68@openai-curated-remote)\n- TradingCursor (app-6a0d835ff1dc8191972eeabd14967446@openai-curated-remote)\n- CoinMarketCap (app-6a172fe86f5481919f73cbc3bc3ad5bb@openai-curated-remote)\n- Trello (app-6a20b18a639081918c1b438f8381b27e@openai-curated-remote)\n- Longbridge (app-6a2baf2fad748191812393c3e00308ef@openai-curated-remote)\n- freddy (app-6a322b52a82c8191b7fb653f9e9f7891@openai-curated-remote)\n- Higgsfield (app-6a3293e129088191abf0875820e839da@openai-curated-remote)\n- Stocktwits (app-6a427a19b1f481919c5db13838af00c2@openai-curated-remote)\n- CoinGecko (app-6a4f02d735388191959c8328877e0bbd@openai-curated-remote)\n- Asana (asana@openai-curated-remote)\n- Atlassian Rovo (atlassian-rovo@openai-curated-remote)\n- Base44 (base44@openai-curated-remote)\n- Binance (binance@openai-curated-remote)\n- Box (box@openai-curated-remote)\n- Canva (canva@openai-curated-remote)\n- ClickUp (clickup@openai-curated-remote)\n- Cloudflare (cloudflare@openai-curated-remote)\n- Codex Security (codex-security@openai-curated-remote)\n\u003c/recommended_plugins\u003e","type":"input_text"},{"text":"# AGENTS.md instructions for /Users/serro/Documents/dev/n/superfunctions\n\n\u003cINSTRUCTIONS\u003e\n# AGENTS.md - AI Agent Development Guide for Superfunctions\n\n\u003e **Purpose**: This document provides AI agents with essential information for working effectively on the Superfunctions monorepo.\n\n## 🏗️ Repository Structure\n\nSuperfunctions is a **Turbo monorepo** containing self-hosted developer tools and libraries. The repository is organized into:\n\n### Core Functions (Top-Level Directories)\n\nIndividual superfunction packages, each providing specific developer capabilities:\n\n- **`authfn/`** - Authentication \u0026 API key management\n- **`cachefn/`** - Multi-tier caching with function memoization\n- **`drawfn/`** - Cross-framework drawing canvas for brainstorming\n- **`plugfn/`** - Integration platform (OAuth, webhooks, 75+ providers)\n- **`searchfn/`** - Browser-first full-text search with IndexedDB\n- **`secfn/`** - Security functions (secrets vault, rate limiting, monitoring)\n- **`testfn/`** - Testing utilities and frameworks\n- **`botfn/`** - Bot framework (Discord, GitHub, Linear integrations)\n- **`hostfn/`** - Hosting and deployment utilities\n- **`uifn/`** - UI components and utilities\n- **`watchfn/`** - File watching and monitoring\n- **`billfn/`** - Billing and payment processing\n- **`browsefn/`** - Browser automation utilities\n- **`chartfn/`** - Charting and visualization\n- **`datafn/`** - Data processing utilities\n- **`docsfn/`** - Documentation generation\n- **`filefn/`** - File operations and management\n- **`flowfn/`** - Flow control (queues, streams, workflows)\n- **`iconfn/`** - Icon utilities\n- **`logfn/`** - Logging utilities\n- **`mailfn/`** - Programmable real inboxes for products, agents, and tests\n- **`sendfn/`** - Email/messaging utilities\n\n### Shared Packages (`packages/`)\n\nFramework-agnostic core libraries used across superfunctions:\n\n**TypeScript Packages:**\n\n- `@superfunctions/http` - HTTP abstractions\n- `@superfunctions/http-express` - Express.js adapter\n- `@superfunctions/http-fastify` - Fastify adapter\n- `@superfunctions/http-hono` - Hono adapter\n- `@superfunctions/http-next` - Next.js adapter\n- `@superfunctions/http-sveltekit` - SvelteKit adapter\n- `@superfunctions/db` - Database adapter system (Drizzle, Prisma, Kysely)\n- `@superfunctions/auth` - Authentication abstraction layer\n- `@superfunctions/cli` - CLI tool for schema management\n\n**Python Packages:**\n\n- `superfunctions` (from `python-core/`) - Core namespace package\n- `superfunctions-sqlalchemy` (from `python-sqlalchemy/`)\n- `superfunctions-fastapi` (from `python-fastapi/`)\n- `superfunctions-flask` (from `python-flask/`)\n\n### Other Directories\n\n- **`_conduct/`** - Root-level artifacts for shared code (implementation plans, specs, audits)\n- **`21n/`** - Organization-specific packages\n- **`.agent/`** - Agent workflows and automation\n- **`.github/`** - GitHub Actions and CI/CD\n\n## 📦 Package Naming Conventions\n\n### Rule A: Shared Packages Format\n\n**Any package shared across superfunctions uses `@superfunctions/{name}` format**\n\nExamples:\n\n```\npackages/db/          → @superfunctions/db\npackages/http/        → @superfunctions/http\npackages/auth/        → @superfunctions/auth\npackages/cli/         → @superfunctions/cli\n```\n\n### Rule B: Core Function Packages Format\n\n**Single-package functions**: Use simple name without scope\n\n```\nauthfn/ts-sdk/        → authfn\ndrawfn/core/          → drawfn\ncachefn/typescript/   → cachefn\nplugfn/core/         → plugfn\nsearchfn/             → searchfn\n```\n\n**Multi-package functions**: Use `@{functionname}/{sub-package}` format (if needed in future)\n\n```\n@authfn/core          (example for future multi-package structure)\n@authfn/providers     (example for future multi-package structure)\n```\n\n**Current Status**: All core functions currently use single-package structure. The scoped format is reserved for future expansion if a function needs multiple published packages.\n\n### Rule C: Monorepo Structure\n\n**The root `superfunctions` is a Turbo monorepo. Avoid nested monorepos.**\n\n- ✅ Use subfolders to organize functions (e.g., `authfn/python/`, `authfn/ts-sdk/`)\n- ❌ Do NOT create nested monorepos (e.g., `authfn/` should NOT be another monorepo)\n- ✅ Use Turbo workspaces defined in root `package.json`\n\nCurrent workspaces:\n\n```json\n{\n  \"workspaces\": [\n    \"searchfn\",\n    \"botfn/*\",\n    \"hostfn/*\",\n    \"authfn/*\",\n    \"packages/*\",\n    \"21n/*\"\n  ]\n}\n```\n\n### Rule D: Artifact Location\n\n**Create artifacts (`.md` files) in `.conduct` folders**\n\n- **Function-specific artifacts**: `{function}/.conduct/`\n  - Examples: `authfn/.conduct/implementation.md`, `drawfn/.conduct/audit_report.md`\n- **Shared/root artifacts**: `_conduct/`\n  - Examples: `_conduct/implementation.md`, `_conduct/spec.md`\n\nArtifact types:\n\n- `implementation.md` - Implementation plans\n- `spec.md` - Technical specifications\n- `audit_report.md` - Code audits and reviews\n- `task.md` - Task tracking\n- `walkthrough.md` - Feature walkthroughs\n\n## 🗂️ Language Support\n\nMost core functions support **both TypeScript and Python**:\n\n### TypeScript Structure\n\n```\n{function}/\n├── typescript/       or  core/\n│   ├── src/\n│   ├── package.json\n│   ├── tsconfig.json\n│   └── vitest.config.ts\n```\n\n### Python Structure\n\n```\n{function}/\n├── python/\n│   ├── {function}/        # Python package directory\n│   │   ├── __init__.py\n│   │   └── ...\n│   ├── tests/\n│   ├── pyproject.toml\n│   └── README.md\n```\n\n### Examples\n\n- `authfn/typescript/` + `authfn/python/`\n- `cachefn/typescript/` + `cachefn/python/`\n- `secfn/typescript/` + `secfn/python/`\n- `plugfn/core/` + `plugfn/python/`\n- `drawfn/core/` (TypeScript only, with React/Svelte adapters)\n- `searchfn/` (TypeScript only, browser-focused)\n\n## 🔧 Development Workflow\n\n### Building\n\n```bash\n# Build all packages\nnpm run build\n\n# Build specific package (from root)\nturbo run build --filter=authfn\nturbo run build --filter=@superfunctions/db\n\n# Build from package directory\ncd authfn/ts-sdk \u0026\u0026 npm run build\n```\n\n### Testing\n\n```bash\n# Test all packages\nnpm test\n\n# Test specific package\nturbo run test --filter=drawfn\n\n# Watch mode\nnpm run test:watch\n```\n\n### Linting\n\n```bash\nnpm run lint\n```\n\n### Package Manager\n\n- **npm** (v10.2.0+) - Specified in `packageManager` field\n- Uses npm workspaces for monorepo management\n- Turbo for build orchestration\n\n## 🎯 Key Superfunctions Features\n\n### AuthFn\n\n- Multi-provider authentication (OAuth, API keys, JWT)\n- Framework-agnostic with adapters for Express, Fastify, Hono, Next.js, SvelteKit\n- Database-agnostic (Drizzle, Prisma, Kysely)\n- TypeScript + Python SDKs\n\n### DrawFn\n\n- Cross-framework drawing canvas\n- React and Svelte adapters\n- Scene management, export capabilities\n- Tolerant parsing with version validation\n\n### PlugFn\n\n- Self-hosted integration platform\n- 75+ provider integrations (GitHub, Slack, Discord, Linear, Stripe)\n- OAuth 2.0 flow handling\n- Webhook support\n- Multi-tenant with secure token storage\n\n### SearchFn\n\n- Browser-first full-text search\n- IndexedDB persistence with in-memory LRU cache\n- BM25 scoring\n- FlexSearch-compatible API\n- Worker-ready with snapshot export/import\n\n### MailFn\n\n- Stable and expiring programmable inboxes\n- Cloudflare Email Workers, D1, R2, and Queues deployment adapter\n- Raw MIME and attachment evidence, waits, OTP/link extraction, threads, labels, and search\n- Typed client, test helpers, CLI, MCP server, custom domains, webhooks, and SendFn composition\n- Scoped credentials, retention, audit, quotas, and explicitly gated public-platform controls\n\n### CacheFn\n\n- Multi-tier caching (memory, IndexedDB, external)\n- Function memoization\n- TTL and invalidation strategies\n- Browser and server support\n\n### SecFn\n\n- Secrets vault management\n- Access control and permissions\n- Rate limiting\n- Security monitoring\n- Secret scanning\n\n### BotFn\n\n- Multi-platform bot framework\n- Discord, GitHub, Linear integrations\n- Shared types and persistence layer\n- Event-driven architecture\n\n## 🛠️ Common Tasks\n\n### Adding a New Function\n\n1. Create top-level directory: `{functionname}/`\n2. Add TypeScript SDK: `{functionname}/typescript/` or `{functionname}/ts-sdk/`\n3. (Optional) Add Python SDK: `{functionname}/python/`\n4. Create `.conduct/` for artifacts\n5. Add to workspace in root `package.json`\n6. Package name: `{functionname}` (not scoped unless multi-package)\n\n### Adding a Shared Package\n\n1. Create in `packages/{name}/`\n2. Package name: `@superfunctions/{name}`\n3. Add to workspace (already covered by `packages/*`)\n4. Update dependent packages\n\n### Creating Artifacts\n\n1. Function-specific: `{function}/.conduct/{artifact}.md`\n2. Shared/root: `_conduct/{artifact}.md`\n3. Use consistent naming: `implementation.md`, `spec.md`, `audit_report.md`, etc.\n\n### Working with Turbo\n\n```bash\n# Run task across all packages\nturbo run build\nturbo run test\n\n# Run for specific package\nturbo run build --filter=authfn\n\n# Run with dependencies\nturbo run build --filter=authfn...\n\n# Clear cache\nturbo run clean\n```\n\n## 📚 Important Files\n\n### Root Configuration\n\n- `package.json` - Workspace and script definitions\n- `turbo.json` - Turbo build configuration\n- `tsconfig.json` - TypeScript base config (if exists)\n\n### Package Configuration\n\n- `package.json` - Package metadata, dependencies, scripts\n- `tsconfig.json` - TypeScript configuration\n- `vitest.config.ts` - Test configuration\n- `pyproject.toml` - Python package configuration\n\n### Documentation\n\n- `README.md` - Package overview and usage\n- `SPEC.md` - Technical specification (common in larger functions)\n- `.conduct/*.md` - Implementation plans, audits, tasks\n\n## 🔍 Finding Code\n\n### Search Patterns\n\n- **Function implementations**: `{function}/typescript/src/` or `{function}/python/{function}/`\n- **Tests**: `__tests__/`, `tests/`, `*.test.ts`, `test_*.py`\n- **Types**: `types.ts`, `models.py`, `src/types/`\n- **Adapters**: `packages/http-*/`, `packages/python-*/`, `adapters/`\n- **Examples**: `examples/`, `{function}/examples/`\n\n### Key Directories\n\n```\nsuperfunctions/\n├── {function}/              # Core function packages\n│   ├── typescript/          # TS implementation\n│   ├── python/              # Python implementation\n│   ├── .conduct/            # Artifacts\n│   ├── README.md            # Documentation\n│   └── SPEC.md              # Specification (if exists)\n├── packages/                # Shared packages\n│   ├── {name}/              # @superfunctions/{name}\n│   └── python-{name}/       # Python shared packages\n└── _conduct/                # Root artifacts\n```\n\n## 🚀 Best Practices\n\n### Super functions ecosystem (Very important)\n\n- Reuse shared packages from `packages/` folder like http abstraction, db abstraction, etc.\n- Never duplicate shared code like http adapters, db abstractions, etc.\n- Don't reexport http-adapters etc - end consumers of the core function package will use the adapters directly. Refer `authfn` implementation for usage of core http router, core db, http adapters and db interface usage.\n- Function packages that accept a `@superfunctions/db` `Adapter` must wrap the incoming adapter internally with their own schema, for example `wrapWithSchema(config.database, getSchema(...))`, before passing it to services/storage. Do not require app consumers to pass `adapterSchema` to `drizzleAdapter`, `kyselyAdapter`, `prismaAdapter`, or `memoryAdapter`; `adapterSchema` is a deprecated compatibility escape hatch for direct app-level adapter use.\n\n### Code Organization\n\n- Keep shared code in `packages/`\n- Keep function-specific code in `{function}/`\n- Use TypeScript for type safety\n- Provide Python SDKs for backend-focused functions\n- Write comprehensive tests\n\n### Documentation\n\n- Update README.md with usage examples\n- Create SPEC.md for complex functions\n- Document breaking changes\n- Keep artifacts in `.conduct/` folders\n\n### Testing\n\n- Use Vitest for TypeScript\n- Use pytest for Python\n- Maintain high test coverage\n- Test adapters separately\n\n### Versioning\n\n- Follow semantic versioning\n- Coordinate versions across language SDKs\n- Document migration guides for breaking changes\n\n## 🔗 Related Resources\n\n- **Repository**: https://github.com/21nCo/super-functions\n- **License**: MIT (most packages) / Apache-2.0 (some packages)\n- **Organization**: 21n\n- **Contact**: hello@21n.org\n\n## 📝 Notes for AI Agents\n\n1. **Always check both TypeScript and Python** implementations when working on core functions\n2. **Respect the naming conventions** - shared packages use `@superfunctions/`, functions use simple names\n3. **Create artifacts in `.conduct/` folders**, not in root or arbitrary locations\n4. **Avoid nested monorepos** - use subfolders within the main Turbo monorepo\n5. **Use Turbo commands** for cross-package operations\n6. **Check existing patterns** in similar functions before implementing new features\n7. **Maintain consistency** across TypeScript and Python SDKs\n8. **Update workspaces** in root `package.json` when adding new packages\n9. **Follow existing test patterns** (Vitest for TS, pytest for Python)\n10. **Document thoroughly** - this is a developer-focused ecosystem\n\n---\n\n**Last Updated**: 2026-08-10\n**Monorepo Version**: 0.1.0\n**Package Manager**: npm@10.2.0\n**Build Tool**: Turbo v2.0.0\n\n\u003c/INSTRUCTIONS\u003e","type":"input_text"},{"text":"\u003cenvironment_context\u003e\n  \u003ccwd\u003e/Users/serro/Documents/dev/n/superfunctions\u003c/cwd\u003e\n  \u003cshell\u003ezsh\u003c/shell\u003e\n  \u003ccurrent_date\u003e2026-08-23\u003c/current_date\u003e\n  \u003ctimezone\u003eAsia/Kolkata\u003c/timezone\u003e\n  \u003cfilesystem\u003e\u003cworkspace_roots\u003e\u003croot\u003e/Users/serro/Documents/dev/n/superfunctions\u003c/root\u003e\u003croot\u003e/Users/serro/.codex/visualizations/2026/08/21/01a024c5-b91b-72b3-ad56-490032d022a1\u003c/root\u003e\u003c/workspace_roots\u003e\u003cpermission_profile type=\"disabled\"\u003e\u003cfile_system type=\"unrestricted\" /\u003e\u003c/permission_profile\u003e\u003c/filesystem\u003e\n\u003c/environment_context\u003e","type":"input_text"}],"id":"msg_01a02e75-3bab-7810-a260-7d5e9deb578d","internal_chat_message_metadata_passthrough":{"turn_id":"01a02e6e-3560-7e22-a95e-b95a3d227c08"},"role":"user","type":"message"},{"content":[{"text":"splane pr-refetch-fix\n","type":"input_text"}],"id":"msg_01a02e6e-3954-7241-bdf6-d031df0fc4f4","internal_chat_message_metadata_passthrough":{"create_time":1787485370.708013,"turn_id":"01a02e6e-3560-7e22-a95e-b95a3d227c08"},"role":"user","type":"message"}],"window_id":"01a02e75-3ba6-7273-9d15-3c72f59cd21a","window_number":20}}
{"timestamp":"2026-08-23T11:50:30.072Z","ordinal":13092,"type":"world_state","payload":{"full":true,"state":{"agents_md":{"directory":"/Users/serro/Documents/dev/n/superfunctions","text":"# AGENTS.md - AI Agent Development Guide for Superfunctions\n\n> **Purpose**: This document provides AI agents with essential information for working effectively on the Superfunctions monorepo.\n\n## 🏗️ Repository Structure\n\nSuperfunctions is a **Turbo monorepo** containing self-hosted developer tools and libraries. The repository is organized into:\n\n### Core Functions (Top-Level Directories)\n\nIndividual superfunction packages, each providing specific developer capabilities:\n\n- **`authfn/`** - Authentication & API key management\n- **`cachefn/`** - Multi-tier caching with function memoization\n- **`drawfn/`** - Cross-framework drawing canvas for brainstorming\n- **`plugfn/`** - Integration platform (OAuth, webhooks, 75+ providers)\n- **`searchfn/`** - Browser-first full-text search with IndexedDB\n- **`secfn/`** - Security functions (secrets vault, rate limiting, monitoring)\n- **`testfn/`** - Testing utilities and frameworks\n- **`botfn/`** - Bot framework (Discord, GitHub, Linear integrations)\n- **`hostfn/`** - Hosting and deployment utilities\n- **`uifn/`** - UI components and utilities\n- **`watchfn/`** - File watching and monitoring\n- **`billfn/`** - Billing and payment processing\n- **`browsefn/`** - Browser automation utilities\n- **`chartfn/`** - Charting and visualization\n- **`datafn/`** - Data processing utilities\n- **`docsfn/`** - Documentation generation\n- **`filefn/`** - File operations and management\n- **`flowfn/`** - Flow control (queues, streams, workflows)\n- **`iconfn/`** - Icon utilities\n- **`logfn/`** - Logging utilities\n- **`mailfn/`** - Programmable real inboxes for products, agents, and tests\n- **`sendfn/`** - Email/messaging utilities\n\n### Shared Packages (`packages/`)\n\nFramework-agnostic core libraries used across superfunctions:\n\n**TypeScript Packages:**\n\n- `@superfunctions/http` - HTTP abstractions\n- `@superfunctions/http-express` - Express.js adapter\n- `@superfunctions/http-fastify` - Fastify adapter\n- `@superfunctions/http-hono` - Hono adapter\n- `@superfunctions/http-next` - Next.js adapter\n- `@superfunctions/http-sveltekit` - SvelteKit adapter\n- `@superfunctions/db` - Database adapter system (Drizzle, Prisma, Kysely)\n- `@superfunctions/auth` - Authentication abstraction layer\n- `@superfunctions/cli` - CLI tool for schema management\n\n**Python Packages:**\n\n- `superfunctions` (from `python-core/`) - Core namespace package\n- `superfunctions-sqlalchemy` (from `python-sqlalchemy/`)\n- `superfunctions-fastapi` (from `python-fastapi/`)\n- `superfunctions-flask` (from `python-flask/`)\n\n### Other Directories\n\n- **`_conduct/`** - Root-level artifacts for shared code (implementation plans, specs, audits)\n- **`21n/`** - Organization-specific packages\n- **`.agent/`** - Agent workflows and automation\n- **`.github/`** - GitHub Actions and CI/CD\n\n## 📦 Package Naming Conventions\n\n### Rule A: Shared Packages Format\n\n**Any package shared across superfunctions uses `@superfunctions/{name}` format**\n\nExamples:\n\n```\npackages/db/          → @superfunctions/db\npackages/http/        → @superfunctions/http\npackages/auth/        → @superfunctions/auth\npackages/cli/         → @superfunctions/cli\n```\n\n### Rule B: Core Function Packages Format\n\n**Single-package functions**: Use simple name without scope\n\n```\nauthfn/ts-sdk/        → authfn\ndrawfn/core/          → drawfn\ncachefn/typescript/   → cachefn\nplugfn/core/         → plugfn\nsearchfn/             → searchfn\n```\n\n**Multi-package functions**: Use `@{functionname}/{sub-package}` format (if needed in future)\n\n```\n@authfn/core          (example for future multi-package structure)\n@authfn/providers     (example for future multi-package structure)\n```\n\n**Current Status**: All core functions currently use single-package structure. The scoped format is reserved for future expansion if a function needs multiple published packages.\n\n### Rule C: Monorepo Structure\n\n**The root `superfunctions` is a Turbo monorepo. Avoid nested monorepos.**\n\n- ✅ Use subfolders to organize functions (e.g., `authfn/python/`, `authfn/ts-sdk/`)\n- ❌ Do NOT create nested monorepos (e.g., `authfn/` should NOT be another monorepo)\n- ✅ Use Turbo workspaces defined in root `package.json`\n\nCurrent workspaces:\n\n```json\n{\n  \"workspaces\": [\n    \"searchfn\",\n    \"botfn/*\",\n    \"hostfn/*\",\n    \"authfn/*\",\n    \"packages/*\",\n    \"21n/*\"\n  ]\n}\n```\n\n### Rule D: Artifact Location\n\n**Create artifacts (`.md` files) in `.conduct` folders**\n\n- **Function-specific artifacts**: `{function}/.conduct/`\n  - Examples: `authfn/.conduct/implementation.md`, `drawfn/.conduct/audit_report.md`\n- **Shared/root artifacts**: `_conduct/`\n  - Examples: `_conduct/implementation.md`, `_conduct/spec.md`\n\nArtifact types:\n\n- `implementation.md` - Implementation plans\n- `spec.md` - Technical specifications\n- `audit_report.md` - Code audits and reviews\n- `task.md` - Task tracking\n- `walkthrough.md` - Feature walkthroughs\n\n## 🗂️ Language Support\n\nMost core functions support **both TypeScript and Python**:\n\n### TypeScript Structure\n\n```\n{function}/\n├── typescript/       or  core/\n│   ├── src/\n│   ├── package.json\n│   ├── tsconfig.json\n│   └── vitest.config.ts\n```\n\n### Python Structure\n\n```\n{function}/\n├── python/\n│   ├── {function}/        # Python package directory\n│   │   ├── __init__.py\n│   │   └── ...\n│   ├── tests/\n│   ├── pyproject.toml\n│   └── README.md\n```\n\n### Examples\n\n- `authfn/typescript/` + `authfn/python/`\n- `cachefn/typescript/` + `cachefn/python/`\n- `secfn/typescript/` + `secfn/python/`\n- `plugfn/core/` + `plugfn/python/`\n- `drawfn/core/` (TypeScript only, with React/Svelte adapters)\n- `searchfn/` (TypeScript only, browser-focused)\n\n## 🔧 Development Workflow\n\n### Building\n\n```bash\n# Build all packages\nnpm run build\n\n# Build specific package (from root)\nturbo run build --filter=authfn\nturbo run build --filter=@superfunctions/db\n\n# Build from package directory\ncd authfn/ts-sdk && npm run build\n```\n\n### Testing\n\n```bash\n# Test all packages\nnpm test\n\n# Test specific package\nturbo run test --filter=drawfn\n\n# Watch mode\nnpm run test:watch\n```\n\n### Linting\n\n```bash\nnpm run lint\n```\n\n### Package Manager\n\n- **npm** (v10.2.0+) - Specified in `packageManager` field\n- Uses npm workspaces for monorepo management\n- Turbo for build orchestration\n\n## 🎯 Key Superfunctions Features\n\n### AuthFn\n\n- Multi-provider authentication (OAuth, API keys, JWT)\n- Framework-agnostic with adapters for Express, Fastify, Hono, Next.js, SvelteKit\n- Database-agnostic (Drizzle, Prisma, Kysely)\n- TypeScript + Python SDKs\n\n### DrawFn\n\n- Cross-framework drawing canvas\n- React and Svelte adapters\n- Scene management, export capabilities\n- Tolerant parsing with version validation\n\n### PlugFn\n\n- Self-hosted integration platform\n- 75+ provider integrations (GitHub, Slack, Discord, Linear, Stripe)\n- OAuth 2.0 flow handling\n- Webhook support\n- Multi-tenant with secure token storage\n\n### SearchFn\n\n- Browser-first full-text search\n- IndexedDB persistence with in-memory LRU cache\n- BM25 scoring\n- FlexSearch-compatible API\n- Worker-ready with snapshot export/import\n\n### MailFn\n\n- Stable and expiring programmable inboxes\n- Cloudflare Email Workers, D1, R2, and Queues deployment adapter\n- Raw MIME and attachment evidence, waits, OTP/link extraction, threads, labels, and search\n- Typed client, test helpers, CLI, MCP server, custom domains, webhooks, and SendFn composition\n- Scoped credentials, retention, audit, quotas, and explicitly gated public-platform controls\n\n### CacheFn\n\n- Multi-tier caching (memory, IndexedDB, external)\n- Function memoization\n- TTL and invalidation strategies\n- Browser and server support\n\n### SecFn\n\n- Secrets vault management\n- Access control and permissions\n- Rate limiting\n- Security monitoring\n- Secret scanning\n\n### BotFn\n\n- Multi-platform bot framework\n- Discord, GitHub, Linear integrations\n- Shared types and persistence layer\n- Event-driven architecture\n\n## 🛠️ Common Tasks\n\n### Adding a New Function\n\n1. Create top-level directory: `{functionname}/`\n2. Add TypeScript SDK: `{functionname}/typescript/` or `{functionname}/ts-sdk/`\n3. (Optional) Add Python SDK: `{functionname}/python/`\n4. Create `.conduct/` for artifacts\n5. Add to workspace in root `package.json`\n6. Package name: `{functionname}` (not scoped unless multi-package)\n\n### Adding a Shared Package\n\n1. Create in `packages/{name}/`\n2. Package name: `@superfunctions/{name}`\n3. Add to workspace (already covered by `packages/*`)\n4. Update dependent packages\n\n### Creating Artifacts\n\n1. Function-specific: `{function}/.conduct/{artifact}.md`\n2. Shared/root: `_conduct/{artifact}.md`\n3. Use consistent naming: `implementation.md`, `spec.md`, `audit_report.md`, etc.\n\n### Working with Turbo\n\n```bash\n# Run task across all packages\nturbo run build\nturbo run test\n\n# Run for specific package\nturbo run build --filter=authfn\n\n# Run with dependencies\nturbo run build --filter=authfn...\n\n# Clear cache\nturbo run clean\n```\n\n## 📚 Important Files\n\n### Root Configuration\n\n- `package.json` - Workspace and script definitions\n- `turbo.json` - Turbo build configuration\n- `tsconfig.json` - TypeScript base config (if exists)\n\n### Package Configuration\n\n- `package.json` - Package metadata, dependencies, scripts\n- `tsconfig.json` - TypeScript configuration\n- `vitest.config.ts` - Test configuration\n- `pyproject.toml` - Python package configuration\n\n### Documentation\n\n- `README.md` - Package overview and usage\n- `SPEC.md` - Technical specification (common in larger functions)\n- `.conduct/*.md` - Implementation plans, audits, tasks\n\n## 🔍 Finding Code\n\n### Search Patterns\n\n- **Function implementations**: `{function}/typescript/src/` or `{function}/python/{function}/`\n- **Tests**: `__tests__/`, `tests/`, `*.test.ts`, `test_*.py`\n- **Types**: `types.ts`, `models.py`, `src/types/`\n- **Adapters**: `packages/http-*/`, `packages/python-*/`, `adapters/`\n- **Examples**: `examples/`, `{function}/examples/`\n\n### Key Directories\n\n```\nsuperfunctions/\n├── {function}/              # Core function packages\n│   ├── typescript/          # TS implementation\n│   ├── python/              # Python implementation\n│   ├── .conduct/            # Artifacts\n│   ├── README.md            # Documentation\n│   └── SPEC.md              # Specification (if exists)\n├── packages/                # Shared packages\n│   ├── {name}/              # @superfunctions/{name}\n│   └── python-{name}/       # Python shared packages\n└── _conduct/                # Root artifacts\n```\n\n## 🚀 Best Practices\n\n### Super functions ecosystem (Very important)\n\n- Reuse shared packages from `packages/` folder like http abstraction, db abstraction, etc.\n- Never duplicate shared code like http adapters, db abstractions, etc.\n- Don't reexport http-adapters etc - end consumers of the core function package will use the adapters directly. Refer `authfn` implementation for usage of core http router, core db, http adapters and db interface usage.\n- Function packages that accept a `@superfunctions/db` `Adapter` must wrap the incoming adapter internally with their own schema, for example `wrapWithSchema(config.database, getSchema(...))`, before passing it to services/storage. Do not require app consumers to pass `adapterSchema` to `drizzleAdapter`, `kyselyAdapter`, `prismaAdapter`, or `memoryAdapter`; `adapterSchema` is a deprecated compatibility escape hatch for direct app-level adapter use.\n\n### Code Organization\n\n- Keep shared code in `packages/`\n- Keep function-specific code in `{function}/`\n- Use TypeScript for type safety\n- Provide Python SDKs for backend-focused functions\n- Write comprehensive tests\n\n### Documentation\n\n- Update README.md with usage examples\n- Create SPEC.md for complex functions\n- Document breaking changes\n- Keep artifacts in `.conduct/` folders\n\n### Testing\n\n- Use Vitest for TypeScript\n- Use pytest for Python\n- Maintain high test coverage\n- Test adapters separately\n\n### Versioning\n\n- Follow semantic versioning\n- Coordinate versions across language SDKs\n- Document migration guides for breaking changes\n\n## 🔗 Related Resources\n\n- **Repository**: https://github.com/21nCo/super-functions\n- **License**: MIT (most packages) / Apache-2.0 (some packages)\n- **Organization**: 21n\n- **Contact**: hello@21n.org\n\n## 📝 Notes for AI Agents\n\n1. **Always check both TypeScript and Python** implementations when working on core functions\n2. **Respect the naming conventions** - shared packages use `@superfunctions/`, functions use simple names\n3. **Create artifacts in `.conduct/` folders**, not in root or arbitrary locations\n4. **Avoid nested monorepos** - use subfolders within the main Turbo monorepo\n5. **Use Turbo commands** for cross-package operations\n6. **Check existing patterns** in similar functions before implementing new features\n7. **Maintain consistency** across TypeScript and Python SDKs\n8. **Update workspaces** in root `package.json` when adding new packages\n9. **Follow existing test patterns** (Vitest for TS, pytest for Python)\n10. **Document thoroughly** - this is a developer-focused ecosystem\n\n---\n\n**Last Updated**: 2026-08-10\n**Monorepo Version**: 0.1.0\n**Package Manager**: npm@10.2.0\n**Build Tool**: Turbo v2.0.0\n"},"apps_instructions":true,"collaboration_mode":{"mode":"default","model":"gpt-5.6-sol"},"environments":{"environments":{"local":{"cwd":"/Users/serro/Documents/dev/n/superfunctions","status":"available","shell":"zsh"}},"current_date":"2026-08-23","timezone":"Asia/Kolkata","filesystem":"<filesystem><workspace_roots><root>/Users/serro/Documents/dev/n/superfunctions</root><root>/Users/serro/.codex/visualizations/2026/08/21/01a024c5-b91b-72b3-ad56-490032d022a1</root></workspace_roots><permission_profile type=\"disabled\"><file_system type=\"unrestricted\" /></permission_profile></filesystem>"},"environments_instructions":false,"git_attribution":false,"host_skills":{"body":"\n## Skills\nA skill is a set of local instructions to follow that is stored in a `SKILL.md` file. Below is the list of skills that can be used. Each entry includes a name, description, and a short path that can be expanded into an absolute path using the skill roots table.\n### Skill roots\n- `r0` = `/Users/serro/.codex/skills`\n- `r1` = `/Users/serro/.agents/skills`\n- `r2` = `/Users/serro/.codex/skills/.system`\n- `r3` = `/Users/serro/.codex/plugins/cache/openai-bundled`\n- `r4` = `/Users/serro/.codex/plugins/cache/openai-bundled/sites/0.1.40/skills`\n- `r5` = `/Users/serro/.codex/plugins/cache/openai-curated-remote/figma/2.0.20/skills`\n- `r6` = `/Users/serro/.codex/plugins/cache/openai-curated-remote/google-drive/0.1.11/skills`\n- `r7` = `/Users/serro/.codex/plugins/cache/openai-curated-remote/notion/0.1.7/skills`\n- `r8` = `/Users/serro/.codex/plugins/cache/openai-curated-remote`\n- `r9` = `/Users/serro/.codex/plugins/cache/openai-primary-runtime`\n- `r10` = `/Users/serro/.codex/plugins/cache/openai-primary-runtime/spreadsheets/26.819.11345/skills`\n### Available skills\n- imagegen: Generate or edit raster images when the task benefits from AI-created bitmap visuals such as photos, illustrations, textures, sprites, mockups, or transparent-background cutouts. Use when Codex should create a brand-new image, transform an existing image, or derive visual variants from references, and the output should be a bitmap asset rather than repo-native code or vector. Do not use when the task is better hand (file: r2/imagegen/SKILL.md)\n- openai-docs: Use for Codex models/pricing, scheduled tasks, skills, settings, setup, troubleshooting, customization, automations, and self-knowledge—including 'you,' 'your,' 'this app,' or 'this coding agent' when they refer to Codex—and for OpenAI APIs/products and ChatGPT Work. Also use for model choice/migration, prompting, SDKs, Responses, Realtime, agents, evals, and Chat/Work/Codex comparisons. Do not use for generic ap (file: r2/openai-docs/SKILL.md)\n- plugin-creator: Create and scaffold plugin directories for Codex with a required `.codex-plugin/plugin.json`, optional plugin folders/files, valid manifest defaults, and personal-marketplace entries by default. Use when Codex needs to create a new personal plugin, add optional plugin structure, generate or update marketplace entries for plugin ordering and availability metadata, or update an existing local plugin during developmen (file: r2/plugin-creator/SKILL.md)\n- skill-creator: Create or update a Codex skill with appropriately scoped instructions and any needed supporting resources. (file: r2/skill-creator/SKILL.md)\n- skill-installer: Install Codex skills into $CODEX_HOME/skills from a curated list or a GitHub repo path. Use when a user asks to list installable skills, install a curated skill, or install a skill from another repo (including private repos). (file: r2/skill-installer/SKILL.md)\n- aside-browser: Read when you need a browser automation (QA, element interaction, screencapture/snapshot, network capture, so on), or have to work across user's logged-in accounts, apps (e.g. Slack, X, LinkedIn, etc.), memory, and browsing history. (file: r1/aside-browser/SKILL.md)\n- audit: You are an audit agent. Your job is to perform a THOROUGH, READ-ONLY audit of an implemented codebase against the spec provided. (file: r0/audit/SKILL.md)\n- browser:control-in-app-browser: Control the in-app Browser for opening, navigating, inspecting visible or interactive page state, clicking, typing, screenshots, and local web testing. It can have existing signed-in sessions. For semantic operations on linked resources, prefer a purpose-built connector, API, or CLI when available. (file: r3/browser/26.818.21641/skills/control-in-app-browser/SKILL.md)\n- check-codex-resets: Check a signed-in Codex Desktop account's current Codex usage windows, rate-limit reset times, banked reset-credit count, and reset-credit expiry dates. Use when the user asks how many Codex resets or reset credits they have, when Codex limits reset or expire, how much 5-hour or weekly Codex capacity remains, or to run the local Codex reset watcher style check from the existing Codex Desktop login. (file: r0/check-codex-resets/SKILL.md)\n- chrome:control-chrome: Control the user's Chrome browser for tasks that depend on existing Chrome state: tabs, logged-in sessions, or extensions. Prefer purpose-built connectors, APIs, or CLIs when available. (file: r3/chrome/26.818.21641/skills/control-chrome/SKILL.md)\n- chronicle: Allows you to view the user's screen as well as several hours of history. Use when the user makes a reference to their recent work, for which it'd be helpful to see the screen. This skill MUST be used whenever you need to resolve ambiguity in a user request, where the user hasn't specified enough context to do the task. Examples include disambiguating the specific user/app/document/error the user is referring to. (file: r0/chronicle/SKILL.md)\n- computer-use:computer-use: Control local Mac apps through Computer Use for tasks that require reading or operating app UI. Prefer purpose-built connectors, APIs, or CLIs when available. (file: r3/computer-use/1.0.1000790/skills/computer-use/SKILL.md)\n- create-pr-ghother: Create or update a GitHub pull request using `GH_CONFIG_DIR=~/.config/gh-other`, especially when the current worktree is dirty or based on the wrong branch. Use this when the user wants a PR against a specific remote and branch such as `origin/dev` or `next/next`, needs `.conduct` included or excluded based on target, wants branch/title prefixing, or needs a clean temporary worktree to avoid dragging unrelated hi (file: r0/create-pr-ghother/SKILL.md)\n- diffpanel-chapters: Generate and publish persistent Diffpanel review chapters for local Git worktrees, staged changes, branch or commit ranges, and repository-wide snapshots. Use when a user asks to organize code into review chapters, create a repo-wide review plan, review current changes through Diffpanel, or populate the Diffpanel VS Code/Cursor extension. (file: r1/diffpanel-chapters/SKILL.md)\n- docs-sync: Audit and synchronize project documentation against live implemented code. Use when Codex needs to scan a repo's docs tree, flag stale or contradictory docs, identify missing documentation coverage, improve examples or conceptual guides, or expand docs so the current implementation is the source of truth. (file: r0/docs-sync/SKILL.md)\n- documents:documents: Create, edit, redline, and comment on `.docx`, Word, and Google Docs-targeted document artifacts inside the container, with a strict render-and-verify workflow. Use `render_docx.py` to generate page PNGs (and optional PDF) for visual QA, then iterate until layout is flawless before delivering the final document. (file: r9/documents/26.819.11345/skills/documents/SKILL.md)\n- execute: You are an implementation agent. You will execute EXACTLY one phase: PHASE_{NN} (NN is provided by the user). You must not do work from other phases. (file: r0/execute/SKILL.md)\n- execute-issue: You are an issue resolution agent. You will work directly on an issue, skipping the spec generation part of the regular spec-execute flow. Your job is to thoroughly read the provided issue file or description and work on the issue completely. (file: r0/execute-issue/SKILL.md)\n- execute-phase: Execute exactly one numbered phase from a spec bundle. Use when Codex must implement a single PHASE_{NN}, verify it locally, write the required phase completion report, and update .conduct logs or tracker files without touching other phases. (file: r0/execute-phase/SKILL.md)\n- figma:figma-code-connect: Creates and maintains Figma Code Connect template files that map Figma components to code snippets. Use when the user mentions Code Connect, Figma component mapping, design-to-code translation, or asks to create/update .figma.ts or .figma.js files. (file: r5/figma-code-connect/SKILL.md)\n- figma:figma-create-new-file: **MANDATORY prerequisite** — you MUST invoke this skill BEFORE every `create_new_file` tool call. NEVER call `create_new_file` directly without loading this skill first. Trigger whenever the user wants a new blank Figma file — a new design, FigJam, or Slides file — or when you need a fresh file before calling `use_figma`. Usage — /figma-create-new-file [editorType] [fileName] (e.g. /figma-create-new-file figjam My  (file: r5/figma-create-new-file/SKILL.md)\n- figma:figma-design-to-code: **MANDATORY prerequisite** — you MUST invoke this skill BEFORE calling the `get_design_context` Figma MCP tool. You MUST trigger this skill whenever the user wants to implement, build, port, or code up a Figma design as code. Example prompts (not exhaustive) are 'implement this Figma design', 'build this screen from Figma', 'turn this Figma into code', 'design to code'. This skill provides critical instructions and (file: r5/figma-design-to-code/SKILL.md)\n- figma:figma-generate-design: Use this skill alongside figma-use when the task involves translating an application page, view, or multi-section layout into Figma. Triggers: 'write to Figma', 'create in Figma from code', 'push page to Figma', 'take this app/page and build it in Figma', 'create a screen', 'build a landing page in Figma', 'update the Figma screen to match code', 'convert this modal/dialog/drawer/panel to Figma'. This is the prefer (file: r5/figma-generate-design/SKILL.md)\n- figma:figma-generate-diagram: MANDATORY prerequisite — load this skill BEFORE every `generate_diagram` tool call. NEVER call `generate_diagram` directly without loading this skill first. Trigger whenever the user asks to create, generate, draw, render, sketch, or build a diagram — flowchart, architecture diagram, sequence diagram, ERD or entity-relationship diagram, state diagram or state machine, gantt chart, or timeline. Also trigger when t (file: r5/figma-generate-diagram/SKILL.md)\n- figma:figma-generate-library: Build or update a professional-grade design system in Figma from a codebase. Use when the user wants to create variables/tokens, build component libraries, create individual components with proper variant sets and variable bindings, set up theming (light/dark modes), document foundations, or reconcile gaps between code and Figma. Also use when the user asks to create or generate any component in Figma — even a sing (file: r5/figma-generate-library/SKILL.md)\n- figma:figma-implement-motion: Translates Figma motion and animations into production-ready application code. Use when implementing animation/motion from a Figma design — user mentions \"implement this motion\", \"add animation from Figma\", \"animate this component\", provides a Figma URL whose node is animated, or when `get_design_context` returns motion data or instructs you to call `get_motion_context`. (file: r5/figma-implement-motion/SKILL.md)\n- figma:figma-swiftui: SwiftUI ↔ Figma translation. Use whenever the user mentions Swift, SwiftUI, iOS, iPhone, or iPad — in EITHER direction — translating a Figma design into SwiftUI (design → code), or pushing SwiftUI views / screens / tokens back into a Figma file (code → design). Triggers on phrases like 'implement this Figma design in SwiftUI', 'build this screen in Swift', 'push this SwiftUI view to Figma', 'mirror my Swift code  (file: r5/figma-swiftui/SKILL.md)\n- figma:figma-use: **MANDATORY prerequisite** — you MUST invoke this skill BEFORE every `use_figma` tool call. NEVER call `use_figma` directly without loading this skill first. Skipping it causes common, hard-to-debug failures. Trigger whenever the user wants to perform a write action or a unique read action that requires JavaScript execution in the Figma file context — e.g. create/edit/delete nodes, set up variables or tokens, b (file: r5/figma-use/SKILL.md)\n- figma:figma-use-figjam: This skill helps agents use Figma's use_figma MCP tool in the FigJam context. Can be used alongside figma-use which has foundational context for using the use_figma tool. (file: r5/figma-use-figjam/SKILL.md)\n- figma:figma-use-motion: Motion / animation context for the `use_figma` MCP tool — animating Figma nodes via manual keyframes, animation styles, easing, and timeline duration. Load alongside figma-use whenever a task involves adding, editing, or inspecting animation on a node. (file: r5/figma-use-motion/SKILL.md)\n- figma:figma-use-slides: This skill helps agents use Figma's use_figma MCP tool in the Slides context. Can be used alongside figma-use which has foundational context for using the use_figma tool. (file: r5/figma-use-slides/SKILL.md)\n- find-skills: Helps users discover and install agent skills when they ask questions like \"how do I do X\", \"find a skill for X\", \"is there a skill that can...\", or express interest in extending capabilities. This skill should be used when the user is looking for functionality that might exist as an installable skill. (file: r1/find-skills/SKILL.md)\n- google-drive:google-docs: Prompt- and template-complete Google Docs creation and editing with explicit-instruction-authoritative structural preservation, including semantic roles, relationships, comparison dimensions, and instructed extensions; full-topology native-copy routing; source-grounded per-tab adaptation for past/example references; style-preserving hyperlink and table edits; canonical smart-chip-first authoring for dates and re (file: r6/google-docs/SKILL.md)\n- google-drive:google-drive: Use connected Google Drive as the single entrypoint for Drive, Docs, Sheets, and Slides work. Use when the user wants to find, fetch, organize, share, export, copy, or delete Drive files, or summarize and edit Google Docs, Google Sheets, and Google Slides through one unified Google Drive plugin. (file: r6/google-drive/SKILL.md)\n- google-drive:google-drive-comments: Write, reply to, and resolve Google Drive comments on Docs, Sheets, Slides, and Drive files with evidence-backed location context. Use when the user asks to leave comments, review a file with comments, respond to comment threads, or resolve Drive comments. (file: r6/google-drive-comments/SKILL.md)\n- google-drive:google-sheets: Analyze and edit connected Google Sheets with range precision. Use when the user wants to create Google Sheets, find a spreadsheet, inspect tabs or ranges, search rows, plan formulas, create or repair charts, clean or restructure tables, write concise summaries, or make explicit cell-range updates. (file: r6/google-sheets/SKILL.md)\n- google-drive:google-slides: Route Google Slides authoring requests and derive a design system from a native template or reference deck. Use this skill when the user provides an existing native Google Slides deck as a template, reference, or prior-period source, or asks to edit, update, repair, restyle, or clean up an existing native Google Slides deck. Use the Presentations skill instead for net-new presentation creation when no existing n (file: r6/google-slides/SKILL.md)\n- issue: You are a troubleshooting and documentation agent. Your job is to investigate the root cause of an issue reported by the user and document it comprehensively in the project's `.conduct/issues/` folder as a markdown file. (file: r0/issue/SKILL.md)\n- notion:notion-knowledge-capture: Capture conversations and decisions into structured Notion pages; use when turning chats/notes into wiki entries, how-tos, decisions, or FAQs with proper linking. (file: r7/notion-knowledge-capture/SKILL.md)\n- notion:notion-meeting-intelligence: Prepare meeting materials with Notion context and supplemental research; use when gathering context, drafting agendas/pre-reads, and tailoring materials to attendees. (file: r7/notion-meeting-intelligence/SKILL.md)\n- notion:notion-research-documentation: Research across Notion and synthesize into structured documentation; use when gathering info from multiple Notion sources to produce briefs, comparisons, or reports with citations. (file: r7/notion-research-documentation/SKILL.md)\n- notion:notion-spec-to-implementation: Turn Notion specs into implementation plans, tasks, and progress tracking; use when implementing PRDs/feature specs and creating Notion plans + tasks from them. (file: r7/notion-spec-to-implementation/SKILL.md)\n- pdf:pdf: Read, create, inspect, render, and verify PDF files where visual layout matters, including fillable AcroForms. Use Poppler rendering plus Python tools such as reportlab, pdfplumber, and pypdf for generation and extraction. (file: r9/pdf/26.819.11345/skills/pdf/SKILL.md)\n- plugin-management:plugin-management: Discover and suggest relevant plugins, inspect app permissions and dependencies, and manage plugin connections or removal. Use when the user asks about plugins or when a task would materially benefit from an external app, account, service, or data source that available tools cannot access. (file: r8/plugin-management/0.1.0/skills/plugin-management/SKILL.md)\n- pr-fixes: Fix code issues from a generated PR analysis report and return a terse issue-status summary. Use when Codex is asked to apply fixes from `.conduct/pr-reports`, address issues listed in a PR report, work through critical/medium/low findings from an automated review summary, or repair code based on a previously generated PR analysis markdown file. (file: r0/pr-fixes/SKILL.md)\n- pr-refetch-fix: Refetch the latest GitHub PR review feedback reliably before applying fixes. Use when a user asks to re-check review comments after a push, says there are newer PR comments that were missed, or when timestamp-only PR comment queries may be incomplete or misleading. This skill is for GitHub PR review triage where unresolved review threads, inline comments, review bodies, and issue comments must be checked togeth (file: r0/pr-refetch-fix/SKILL.md)\n- pr-report: Generate comprehensive GitHub pull request analysis reports from automated review feedback and organize issues by severity, filename, and review tool. Use when Codex is asked to create a PR report, analyze bot comments on a PR, summarize CodeRabbit/Sourcery/Cubic/Typo-app review findings, or write a timestamped markdown report under `.conduct/pr-reports` for the current repository. (file: r0/pr-report/SKILL.md)\n- presentation: Format general responses only when the runtime context explicitly identifies the Zed editor and zed:// file links are supported. Never use in Codex Desktop, Codex CLI, ChatGPT, or any other non-Zed environment. (file: r1/presentation/SKILL.md)\n- presentations:Presentations: Read, create or edit PowerPoint or Google Slides decks. Use for presentation, slide deck, PowerPoint, PPT, PPTX, or Google Slides requests. (file: r9/presentations/26.819.11345/skills/presentations/SKILL.md)\n- probe-fix: Reproduce and fix frontend app issues by creating or adapting impromptu Playwright probes, inspecting screenshots/HTML/JSON artifacts plus browser and app logs, then applying the narrowest non-regressive fix and rerunning until the flow is green. Use when existing tests do not cover a UI bug, when a frontend flow freezes or crashes, or when you need exploratory end-to-end verification of create/edit/open/reopen b (file: r0/probe-fix/SKILL.md)\n- response-formatting: Format code findings and source references only when the runtime context explicitly identifies the Zed editor and zed:// file links are supported. Never use in Codex Desktop, Codex CLI, ChatGPT, or any other non-Zed environment. (file: r1/response-formatting/SKILL.md)\n- sites:sites-building: Use Sites to build websites, including landing pages, portfolios, dashboards, portals, trackers, hubs, and internal tools. Always use Sites when the project contains `.openai/hosting.json`. (file: r4/sites-building/SKILL.md)\n- sites:sites-hosting: Host websites with Sites. Always use after `sites-building`, and use for website publishing, deployment, hosting management, or projects containing `.openai/hosting.json`. (file: r4/sites-hosting/SKILL.md)\n- spec: You are a senior software architect and spec-writer. Your job is to produce a HIGH-PRECISION spec and a phased implementation plan that can be executed by multiple agents without “checkbox completion” or missing core semantics. (file: r0/spec/SKILL.md)\n- spreadsheets:Spreadsheets: Create, edit, analyze, and verify standalone spreadsheet files or Google Sheets-ready workbooks, including .xlsx, .xls, .csv, and .tsv. Do not use for live controlling Microsoft Excel app or a live Excel session. (file: r10/spreadsheets/SKILL.md)\n- spreadsheets:excel-live-control: Control an open or active Microsoft Excel workbook through the ChatGPT add-in or connected session. Use when the user tags the Microsoft Excel app in Codex or follows up on an established live Excel task. Do not use for standalone spreadsheet files or Google Sheets. (file: r10/excel-live-control/SKILL.md)\n- stage-chapters: Generate Stage chapters for the current local git branch and open them in a browser for review. (file: r1/stage-chapters/SKILL.md)\n- sync-sf-next-to-dev: Inventory changes on local Superfunctions `next` that are relevant to local `dev`, limited to functions and shared packages already present on `dev`, ignoring `.conduct` artifacts and ignoring top-level functions/packages that exist only on `next`. (file: r0/sync-sf-next-to-dev/SKILL.md)\n- template-creator:template-creator: Create or update a reusable personal Codex artifact-template skill. Use when the user invokes $template-creator or asks in natural language to create a reusable template from a reference document, presentation, spreadsheet, Google Docs, Slides, or Sheets link, ImageGen or Product Design image, email, Slack message, or Site project, or explicitly asks to edit or update a passed artifact-template skill. Do not use  (file: r9/template-creator/26.819.11345/skills/template-creator/SKILL.md)\n- visualize:visualize: Create visualizations and interactive tools directly in conversation. Use when asked to show how something works, make simulators or labs, maps, plots, charts or graphs, comparisons, UI mockups, scenarios, adjustable inputs, and exploration beyond regular text. (file: r3/visualize/1.0.22/skills/visualize/SKILL.md)\n","includeInstructions":true},"model":"gpt-5.6-sol","multi_agent_mode":{"mode":"explicitRequestOnly","usage_hint_hash":"0e2a3174d5f40de49ed383507497d69bbff42c5d"},"multi_agent_usage_hint":"0e2a3174d5f40de49ed383507497d69bbff42c5d","orchestrator_skills":{"includeInstructions":true,"enabled":false},"permissions":{"instructions":"32ca25d6d85edaeb6f1e19b2a5cc4e08d2a631cd","approved_command_prefixes":[["/bin/zsh","-lc","CI=true pnpm check"],["/bin/zsh","-lc","CI=true pnpm db:migrate"],["/bin/zsh","-lc","CI=true pnpm dev"],["/bin/zsh","-lc","CI=true pnpm smoke:github-webhook"],["/bin/zsh","-lc","UIFN_PHASE16_EVIDENCE_DIR=uifn/.conduct/evidence/phase-16/20260724T010655Z-PHASE-17-revalidation /opt/homebrew/bin/node scripts/verify-uifn-phase-16.mjs"],["/bin/zsh","-lc","UIFN_PHASE17_DOCS_EVIDENCE=uifn/.conduct/evidence/phase-17/20260724T010655Z-PHASE-17-final/docs.json /opt/homebrew/bin/node scripts/verify-uifn-phase-17-docs.mjs"],["/bin/zsh","-lc","UIFN_PHASE17_EVIDENCE_DIR=uifn/.conduct/evidence/phase-17/20260724T010655Z-PHASE-17-final /opt/homebrew/bin/node scripts/verify-uifn-phase-17.mjs"],["/bin/zsh","-lc","UIFN_PHASE17_STORY_EVIDENCE=/tmp/uifn-phase17-story-local-v8.json /opt/homebrew/bin/node scripts/verify-uifn-phase-17-storybook.mjs --use-existing"],["/bin/zsh","-lc","UIFN_PHASE18_MATRIX_FILTER=firefox UIFN_PHASE18_PRIMITIVE_FILTER='^(accordion|dialog|select)$' UIFN_PHASE18_PHASE17_STORY_EVIDEN