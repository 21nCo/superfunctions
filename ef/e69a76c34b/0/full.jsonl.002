es that decision. Route processing through the configured authorizer before enqueueing, or inject the authorizer into `ProcessingService`.</comment>\\\\n\\\\n<file context>\\\\n@@ -344,6 +350,18 @@ export function createFileFn(config: FileFnConfig): FileFn {\\\\n         getArtifactDownloadStreamForFile: processingService.getArtifactDownloadStreamForFile.bind(processingService),\\\\n         getReadableVersionForFile: processingService.getReadableVersionForFile.bind(processingService),\\\\n+        async triggerProcessingForFile(fileId, ctx, versionId) {\\\\n+          const readable = await processingService.getReadableVersionForFile(fileId, ctx, versionId);\\\\n+          return processingService.triggerProcessing({\\\\n+            fileId: readable.file.fileId,\\\\n</file context>\\\\n```\\\\n\\\\n</details>\\\",\\n    \\\"url\\\": \\\"https://github.com/21nCo/super-functions/pull/116#discussion_r3862287443\\\",\\n    \\\"in_reply_to_id\\\": null\\n  },\\n  {\\n    \\\"id\\\": 3862287452,\\n    \\\"path\\\": \\\"filefn/server/src/index.ts\\\",\\n    \\\"line\\\": 362,\\n    \\\"original_line\\\": 362,\\n    \\\"created_at\\\": \\\"2026-08-26T11:32:00Z\\\",\\n    \\\"updated_at\\\": \\\"2026-08-26T11:32:00Z\\\",\\n    \\\"user\\\": \\\"cubic-dev-ai[bot]\\\",\\n    \\\"body\\\": \\\"<!-- cubic:v=e3cdcd8f-95d0-45b0-9826-96a5bc9dc154 -->\\\\n<!-- cubic:review-run=516cd530-752b-45d6-908e-920badfaaba4 -->\\\\n<!-- metadata:{\\\\\\\"confidence\\\\\\\":8} -->\\\\nP2: When a tenant-scoped caller processes a file with no stored tenant, this drops the caller tenant from the processor job. Preserve the route behavior by falling back to `ctx.tenantId`.\\\\n\\\\n<details>\\\\n<summary>Prompt for AI agents</summary>\\\\n\\\\n```text\\\\nCheck if this issue is valid — if so, understand the root cause and fix it. At filefn/server/src/index.ts, line 362:\\\\n\\\\n<comment>When a tenant-scoped caller processes a file with no stored tenant, this drops the caller tenant from the processor job. Preserve the route behavior by falling back to `ctx.tenantId`.</comment>\\\\n\\\\n<file context>\\\\n@@ -344,6 +350,18 @@ export function createFileFn(config: FileFnConfig): FileFn {\\\\n+            mimeType: readable.version.mimeType,\\\\n+            size: readable.version.size,\\\\n+            fileName: readable.file.name,\\\\n+            tenantId: readable.file.tenantId ?? undefined,\\\\n+          }, ctx);\\\\n+        },\\\\n</file context>\\\\n```\\\\n\\\\n</details>\\\\n\\\\n```suggestion\\\\n            tenantId: readable.file.tenantId ?? ctx.tenantId,\\\\n```\\\",\\n    \\\"url\\\": \\\"https://github.com/21nCo/super-functions/pull/116#discussion_r3862287452\\\",\\n    \\\"in_reply_to_id\\\": null\\n  },\\n  {\\n    \\\"id\\\": 3862303745,\\n    \\\"path\\\": \\\"packages/admin/src/pagination.ts\\\",\\n    \\\"line\\\": 37,\\n    \\\"original_line\\\": 37,\\n    \\\"created_at\\\": \\\"2026-08-26T11:33:57Z\\\",\\n    \\\"updated_at\\\": \\\"2026-08-26T11:33:57Z\\\",\\n    \\\"user\\\": \\\"chatgpt-codex-connector[bot]\\\",\\n    \\\"body\\\": \\\"**<sub><sub>![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)</sub></sub>  Normalize optional scope fields before comparing cursors**\\\\n\\\\nWhen an authorized scope contains an optional property explicitly set to `undefined`, cursor encoding drops that property through `JSON.stringify`, while this comparison serializes the expected scope with the property still present. Super Console's `requestedScope` routinely materializes `namespace` and `region` this way when they are unset, so a cursor returned from the first page is rejected on the next request as a scope mismatch; normalize both scopes to their JSON representation or omit undefined fields before comparing them.\\\\n\\\\nUseful? React with 👍 / 👎.\\\",\\n    \\\"url\\\": \\\"https://github.com/21nCo/super-functions/pull/116#discussion_r3862303745\\\",\\n    \\\"in_reply_to_id\\\": null\\n  },\\n  {\\n    \\\"id\\\": 3862303754,\\