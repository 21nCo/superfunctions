tionId,\n  1158\t          immutable.input,\n  1159\t          immutable.state.context,\n  1160\t          'denied',\n  1161\t          started,\n  1162\t          'CONFIRMATION_ACTIVATION_FAILED',\n  1163\t          denialAuditId,\n  1164\t        );\n  1165\t      } catch {\n   780\t    expect(revoke).toHaveBeenCalledWith(expect.objectContaining({ token: 'staged-token' }));\n   781\t    expect(active).toBe(false);\n   782\t  });\n   783\t\n   784\t  it('records activation failure as denied and leaves the staged token unusable', async () => {\n   785\t    const capability = manifest({ destructive: true });\n   786\t    const outcomes: Array<{ outcome: string; errorCode?: string }> = [];\n   787\t    let active = false;\n   788\t    let cancelled = false;\n   789\t    const cancelActivation = vi.fn(async () => { cancelled = true; });\n   790\t    const revoke = vi.fn(async () => { throw new Error('revocation unavailable'); });\n   791\t    const verify = vi.fn(async () => active && !cancelled);\n   792\t    const console = createSuperConsole({\n   793\t      adapters: [createAdminCapabilityAdapter(capability, {\n   794\t        'examplefn.records.delete': async () => ({ ok: true as const, data: { accepted: true } }),\n   795\t      })],\n   796\t      enabledModules: ['examplefn'],\n   797\t      auth: auth(),\n   798\t      shellPolicy: { authorize: () => true },\n   799\t      audit: {\n   800\t        idempotentById: true,\n   801\t        write: async (event) => {\n   802\t          if (event.operationId === 'superconsole.confirmations.issue') {\n   803\t            outcomes.push({ outcome: event.outcome, errorCode: event.errorCode });\n   804\t          }\n   805\t        },\n   806\t      },\n   807\t      idempotency: new MemoryAdminIdempotencyStore(),\n   808\t      confirmation: {\n   809\t        issue: async () => ({ token: 'staged-token', expiresAt: new Date(Date.now() + 60_000).toISOString() }),\n   810\t        prepareActivation: async () => undefined,\n   811\t        cancelActivation,\n   812\t        activate: async () => { active = true; throw new Error('activation unavailable'); },\n   813\t        revoke,\n   814\t        verify,\n   815\t      },\n   816\t    });\n   817\t\n   818\t    const response = await console.handle(request('/api/admin/v1/confirmations', {\n   819\t      method: 'POST',\n   820\t      headers: { 'content-type': 'application/json' },\n   821\t      body: JSON.stringify({ operationId: 'examplefn.records.delete', input: { id: 'record_1' } }),\n   822\t    }));\n   823\t\n   824\t    expect(response.status).toBe(503);\n   825\t    expect(await verify()).toBe(false);\n   826\t    expect(cancelActivation).toHaveBeenCalledWith(expect.objectContaining({\n   827\t      token: 'staged-token',\n   828\t      auditId: expect.any(String),\n   829\t      denialAuditId: expect.any(String),\n   830\t    }));\n   831\t    expect(revoke).toHaveBeenCalledWith(expect.objectContaining({ token: 'staged-token' }));\n   832\t    expect(outcomes).toEqual([\n   833\t      { outcome: 'attempted', errorCode: undefined },\n   834\t      { outcome: 'succeeded', errorCode: undefined },\n   835\t      { outcome: 'denied', errorCode: 'CONFIRMATION_ACTIVATION_FAILED' },\n   836\t    ]);\n   837\t  });\n   838\t\n   839\t  it('returns audit unavailable when activation preparation and its denial audit both fail', async () => {\n   840\t    const capability = manifest({ destructive: true });\n   841\t    const activate = vi.fn(async () => undefined);\n   842\t    const console = createSuperConsole({\n   843\t      adapters: [createAdminCapabilityAdapter(capability, {\n   844\t        'examplefn.records.delete': async () => ({ ok: true as const, data: { accepted: true } }),\n   845\t      })],\n   846\t      enabledModules: ['examplefn'],\n   847\t      auth: auth(),\n   848\t      shellPolicy: { authorize: () => true },\n   849\t      audit: {\n   850\t        idempotentById: true,\n   851\t        write: async (event) => {\n   852\t          if (event.operationId === 'superconsole.confirmations.issue' && event.outcome === 'denied') {\n   853\t            throw new Error('denial audit unavailable');\n   854\t          }\n   855\t        },\n   856\t      },\n   857\t      idempotency: new MemoryAdminIdempotencyStore(),\n   858\t      confirmation: {\n   859\t        issue: async () => ({ token: 'staged-token', expiresAt: new Date(Date.now() + 60_000).toISOString() }),\n   860\t        prepareActivation: async () => { throw new Error('activation preparation unavailable'); },\n   861\t        cancelActivation: async () => undefined,\n   862\t        activate,\n   863\t        revoke: async () => undefined,\n   864\t        verify: async () => false,\n   865\t      },\n   866\t    });\n   867\t\n   868\t    const response = await console.handle(request('/api/admin/v1/confirmations', {\n   869\t      method: 'POST',\n   870\t      headers: { 'content-type': 'application/json' },\n   871\t      body: JSON.stringify({ operationId: 'examplefn.records.delete', input: { id: 'record_1' } }),\n   872\t    }));\n   873\t\n   874\t    expect(response.status).toBe(503);\n   875\t    expect(await response.json()).toMatchObject({ error: { code: 'AUDIT_UNAVAILABLE' } });\n   876\t    expect(activate).not.toHaveBeenCalled();\n   877\t  });\n   878\t\n   879\t  it('returns 405/OPTIONS/HEAD semantics instead of route ambiguity', async () => {\n   880\t    const { console, handler } = installation();\n"},"started_at_ms":1787481531891,"completed_at_ms":1787481531891}}
