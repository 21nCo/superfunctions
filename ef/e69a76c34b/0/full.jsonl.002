u003e{:else}\\u003cdiv class=\\\"tool-list\\\"\\u003e{#each data.mcp.tools as tool (tool.name)}\\u003cCardRoot class=\\\"tool-card\\\"\\u003e\\u003cCardHeader\\u003e\\u003cStatusBadge label={tool.mutation ? 'Mutation' : 'Read'} tone={tool.mutation ? 'warning' : 'info'} /\\u003e\\u003cCardTitle\\u003e{tool.name}\\u003c/CardTitle\\u003e\\u003cCardDescription\\u003e{tool.description ?? 'Function-owned administration capability.'}\\u003c/CardDescription\\u003e\\u003c/CardHeader\\u003e\\u003cCardContent\\u003e{#if tool.moduleId}\\u003cspan\\u003e{tool.moduleId}\\u003c/span\\u003e{/if}{#if tool.permission}\\u003ccode\\u003e{tool.permission}\\u003c/code\\u003e{/if}\\u003c/CardContent\\u003e\\u003c/CardRoot\\u003e{/each}\\u003c/div\\u003e{/if}\\n+    \\u003c/section\\u003e\\n+\\n+    \\u003csection aria-labelledby=\\\"mcp-clients-heading\\\"\\u003e\\n+      \\u003cdiv class=\\\"section-heading\\\"\\u003e\\u003cdiv\\u003e\\u003cp class=\\\"eyebrow\\\"\\u003eAuthenticated callers\\u003c/p\\u003e\\u003ch2 id=\\\"mcp-clients-heading\\\"\\u003eClients\\u003c/h2\\u003e\\u003c/div\\u003e\\u003c/div\\u003e\\n+      {#if !data.mcp.clients?.length}\\u003cStatePanel kind=\\\"empty\\\" title=\\\"No active clients\\\" message=\\\"Authenticated MCP client activity will appear here.\\\" /\\u003e{:else}\\u003cdiv class=\\\"client-list\\\"\\u003e{#each data.mcp.clients as client (client.id)}\\u003cdiv\\u003e\\u003cStatusBadge status={client.status ?? 'unknown'} /\\u003e\\u003cspan\\u003e\\u003cstrong\\u003e{client.name}\\u003c/strong\\u003e{#if client.lastSeenAt}\\u003csmall\\u003eLast seen {formatValue(client.lastSeenAt, 'datetime')}\\u003c/small\\u003e{/if}\\u003c/span\\u003e\\u003c/div\\u003e{/each}\\u003c/div\\u003e{/if}\",\"line\":null,\"originalLine\":34,\"outdated\":true,\"url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3831870571\"}]},\"isResolved\":false,\"path\":\"superconsole/src/routes/mcp/+page.svelte\"}\n{\"comments\":{\"nodes\":[{\"author\":{\"login\":\"cubic-dev-ai\"},\"body\":\"\\u003c!-- cubic:v=920d1cd8-402d-4409-8583-8cdfa37d870c --\\u003e\\n\\u003c!-- cubic:review-run=7bb8304f-392d-4952-ab05-eaf35f279889 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":10} --\\u003e\\nP2: When `TElement` is a valid falsy value such as `''`, `require` throws even though `register` and `has` report it present. Check map membership instead of element truthiness.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At uifn/adapter-kit/src/refs.ts, line 66:\\n\\n\\u003ccomment\\u003eWhen `TElement` is a valid falsy value such as `''`, `require` throws even though `register` and `has` report it present. Check map membership instead of element truthiness.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -0,0 +1,96 @@\\n+    require(key) {\\n+      const element = elements.get(key);\\n+\\n+      if (!element) {\\n+        throw createUIFnError({\\n+          code: 'UIFN_ERR_CONTEXT_MISSING',\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\",\"createdAt\":\"2026-08-21T16:19:46Z\",\"diffHunk\":\"@@ -0,0 +1,96 @@\\n+import { createUIFnError } from '@uifn/core/errors';\\n+\\n+export type AdapterRef\\u003cTElement\\u003e =\\n+  | ((element: TElement | null) =\\u003e void)\\n+  | { current: TElement | null }\\n+  | null\\n+  | undefined;\\n+\\n+export interface ElementRegistry\\u003cTElement\\u003e {\\n+  register: (key: string, element: TElement | null) =\\u003e () =\\u003e void;\\n+  unregister: (key: string) =\\u003e void;\\n+  get: (key: string) =\\u003e TElement | null;\\n+  require: (key: string) =\\u003e TElement;\\n+  has: (key: string) =\\u003e boolean;\\n+  clear: () =\\u003e void;\\n+  entries: () =\\u003e Array\\u003c[string, TElement]\\u003e;\\n+  snapshot: () =\\u003e Record\\u003cstring, TElement\\u003e;\\n+  size: () =\\u003e number;\\n+}\\n+\\n+export function assignRef\\u003cTElement\\u003e(ref: AdapterRef\\u003cTElement\\u003e, element: TElement | null): void {\\n+  if (!ref) {\\n+    return;\\n+  }\\n+\\n+  if (typeof ref === 'function') {\\n+    ref(element);\\n+    return;\\n+  }\\n+\\n+  ref.current = element;\\n+}\\n+\\n+export function composeRefs\\u003cTElement\\u003e(\\n+  ...refs: Array\\u003cAdapterRef\\u003cTElement\\u003e\\u003e\\n+): (element: TElement | null) =\\u003e void {\\n+  return (element) =\\u003e {\\n+    refs.forEach((ref) =\\u003e assignRef(ref, element));\\n+  };\\n+}\\n+\\n+export function createElementRegistry\\u003cTElement\\u003e(\\n+  options: { component?: string } = {}\\n+): ElementRegistry\\u003cTElement\\u003e {\\n+  const elements = new Map\\u003cstring, TElement\\u003e();\\n+\\n+  return {\\n+    register(key, element) {\\n+      if (element === null) {\\n+        elements.delete(key);\\n+      } else {\\n+        elements.set(key, element);\\n+      }\\n+\\n+      return () =\\u003e elements.delete(key);\\n+    },\\n+    unregister(key) {\\n+      elements.delete(key);\\n+    },\\n+    get(key) {\\n+      return elements.get(key) ?? null;\\n+    },\\n+    require(key) {\\n+      const element = elements.get(key);\\n+\\n+      if (!element) {\",\"line\":null,\"originalLine\":66,\"outdated\":true,\"url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3831870579\"}]},\"isResolved\":false,\"path\":\"uifn/adapter-kit/src/refs.ts\"}\n{\"comments\":{\"nodes\":[{\"author\":{\"login\":\"cubic-dev-ai\"},\"body\":\"\\u003c!-- cubic:v=8ab7b6f8-4504-440b-b726-c11498d52939 --\\u003e\\n\\u003c!-- cubic:review-run=7bb8304f-392d-4952-ab05-eaf35f279889 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":10} --\\u003e\\nP2: For valid ranges finer than twelve decimal places, the precision cap rounds aligned values to a different step. Preserve the definition's precision or reject unsupported precision explicitly before rounding.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At uifn/core/src/algorithms/range.ts, line 30:\\n\\n\\u003ccomment\\u003eFor valid ranges finer than twelve decimal places, the precision cap rounds aligned values to a different step. Preserve the definition's precision or reject unsupported precision explicitly before rounding.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -0,0 +1,63 @@\\n+      details: { value, min, max, step },\\n+    });\\n+  }\\n+  const precision = Math.min(12, Math.max(decimals(min), decimals(max), decimals(step)));\\n+  const aligned = min + Math.round((clampRangeValue(value, min, max) - min) / step) * step;\\n+  return clampRangeValue(Number(aligned.toFixed(precision)), min, max);\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\",\"createdAt\":\"2026-08-21T16:19:46Z\",\"diffHunk\":\"@@ -0,0 +1,63 @@\\n+import { createUIFnError } from '../errors';\\n+\\n+export interface RangeDefinition {\\n+  readonly min: number;\\n+  readonly max: number;\\n+  readonly step?: number;\\n+}\\n+\\n+function decimals(value: number): number {\\n+  const text = String(value).toLowerCase();\\n+  if (text.includes('e-')) return Number(text.split('e-')[1]);\\n+  return text.includes('.') ? text.length - text.indexOf('.') - 1 : 0;\\n+}\\n+\\n+export function clampRangeValue(value: number, min: number, max: number): number {\\n+  return Math.min(Math.max(value, min), max);\\n+}\\n+\\n+export function alignRangeValue(value: number, definition: RangeDefinition): number {\\n+  const { min, max } = definition;\\n+  const step = definition.step ?? 1;\\n+  if (!Number.isFinite(value) || !Number.isFinite(min) || !Number.isFinite(max) || min \\u003e max || step \\u003c= 0) {\\n+    throw createUIFnError({\\n+      code: 'UIFN_ERR_RANGE_OUT_OF_BOUNDS',\\n+      component: 'Range',\\n+      message: 'Range values require finite bounds, min \\u003c= max, and a positive step.',