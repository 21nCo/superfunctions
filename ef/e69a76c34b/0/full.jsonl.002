super-functions\") { pullRequest(number: 116) { reviewThreads(first: 100, after: $endCursor) { nodes { id isResolved isOutdated path line originalLine comments(first: 100) { nodes { id body author { login } createdAt updatedAt outdated url diffHunk originalLine line } } } pageInfo { hasNextPage endCursor } } } } }' > \"$snapshot_dir/threads.json\"\ngh pr view 116 --repo 21nCo/super-functions --json number,state,headRefName,headRefOid,baseRefName,reviews,comments,updatedAt,url > \"$snapshot_dir/pr.json\"\ngh api --paginate --slurp repos/21nCo/super-functions/pulls/116/comments > \"$snapshot_dir/inline.json\"\nprintf 'snapshot_dir=%s\\n' \"$snapshot_dir\"\njq '{number,state,headRefName,headRefOid,baseRefName,updatedAt,url,reviews:(.reviews|length),issueComments:(.comments|length)}' \"$snapshot_dir/pr.json\"\njq '[.[].data.repository.pullRequest.reviewThreads.nodes[] | select(.isResolved == false)] | {unresolvedCount:length, threads: map({id,path,isOutdated,line,comments:[.comments.nodes[]|{author:.author.login,createdAt,updatedAt,outdated,url,body}]})}' \"$snapshot_dir/threads.json\""}],"source":"unified_exec_startup","status":"completed","stdout":"snapshot_dir=/tmp/pr116-review-round.D4x5iZ\n{\n  \"number\": 116,\n  \"state\": \"OPEN\",\n  \"headRefName\": \"SFNS-2\",\n  \"headRefOid\": \"2011d9c67048f2e1eb7221edaca7d6d36568a019\",\n  \"baseRefName\": \"dev\",\n  \"updatedAt\": \"2026-08-23T09:20:42Z\",\n  \"url\": \"https://github.com/21nCo/super-functions/pull/116\",\n  \"reviews\": 123,\n  \"issueComments\": 7\n}\n{\n  \"unresolvedCount\": 141,\n  \"threads\": [\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6bNtar\",\n      \"path\": \"superconsole/src/lib/components/resource-pages.ts\",\n      \"isOutdated\": false,\n      \"line\": 87,\n      \"comments\": [\n        {\n          \"author\": \"github-advanced-security\",\n          \"createdAt\": \"2026-08-21T15:59:22Z\",\n          \"updatedAt\": \"2026-08-21T15:59:23Z\",\n          \"outdated\": false,\n          \"url\": \"https://github.com/21nCo/super-functions/pull/116#discussion_r3831736417\",\n          \"body\": \"## CodeQL / Prototype-polluting function\\n\\nThe property chain [segment](1) is recursively assigned to [current](2) without guarding against prototype pollution.\\n\\n[Show more details](https://github.com/21nCo/super-functions/security/code-scanning/49)\"\n        }\n      ]\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6bNv6J\",\n      \"path\": \"searchfn/admin/src/domain-service.ts\",\n      \"isOutdated\": true,\n      \"line\": null,\n      \"comments\": [\n        {\n          \"author\": \"chatgpt-codex-connector\",\n          \"createdAt\": \"2026-08-21T16:01:33Z\",\n          \"updatedAt\": \"2026-08-21T16:01:33Z\",\n          \"outdated\": true,\n          \"url\": \"https://github.com/21nCo/super-functions/pull/116#discussion_r3831751943\",\n          \"body\": \"**<sub><sub>![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)</sub></sub>  Preserve numeric-looking string document IDs**\\n\\nFor a composite target such as `orders:001`, this converts the document ID from the string `\\\"001\\\"` to the number `1`. Single-document indexing therefore targets a different ID than batch indexing, which preserves string IDs, and `remove-document` can delete numeric document `1` instead of string document `\\\"001\\\"`. Preserve the ID suffix as a string or carry explicit ID-type information in the input.\\n\\nUseful? React with 👍 / 👎.\"\n        }\n      ]\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6bNv6M\",\n      \"path\": \"searchfn/admin/src/domain-service.ts\",\n      \"isOutdated\": true,\n      \"line\": null,\n      \"comments\": [\n        {\n          \"author\": \"chatgpt-codex-connector\",\n          \"createdAt\": \"2026-08-21T16:01:33Z\",\n          \"updatedAt\": \"2026-08-21T16:01:33Z\",\n          \"outdated\": true,\n          \"url\": \"https://github.com/21nCo/super-functions/pull/116#discussion_r3831751947\",\n          \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Apply the declared index-list query parameters**\\n\\nWhen an installation has many configured indexes or the console supplies search/filter/pagination input, `listIndexes` ignores the entire input and always returns every index with `nextCursor: null`. This contradicts the operation's cursor-pagination declaration and makes the resource-list search UI return unrelated entries while bypassing the declared 200-item maximum; honor `limit`, `cursor`, and the advertised query fields before building the result.\\n\\nUseful? React with 👍 / 👎.\"\n        }\n      ]\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6bODiX\",\n      \"path\": \"uifn/core/scripts/build.mjs\",\n      \"isOutdated\": false,\n      \"line\": 47,\n      \"comments\": [\n        {\n          \"author\": \"cubic-dev-ai\",\n          \"createdAt\": \"2026-08-21T16:19:44Z\",\n          \"updatedAt\": \"2026-08-21T16:19:48Z\",\n          \"outdated\": false,\n          \"url\": \"https://github.com/21nCo/super-functions/pull/116#discussion_r3831870338\",\n          \"body\": \"<!-- cubic:v=1e8a9759-bd72-4e24-bd8c-217d1bba06d6 -->\\n<!-- cubic:review-run=7bb8304f-392d-4952-ab05-eaf35f279889 -->\\n<!-- metadata:{\\\"confidence\\\":10} -->\\nP1: When the build reaches `accordion`, it asks tsup to bundle nonexistent `createAccordionController`, so the build fails before producing any public primitive entrypoints. Add the missing controller exports or map catalog entries to verified source exports before bundling.\\n\\n<details>\\n<summary>Prompt for AI agents</summary>\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At uifn/core/scripts/build.mjs, line 24:\\n\\n<comment>When the build reaches `accordion`, it asks tsup to bundle nonexistent `createAccordionController`, so the build fails before producing any public primitive entrypoints. Add the missing controller exports or map catalog entries to verified source exports before bundling.</comment>\\n\\n<file context>\\n@@ -0,0 +1,89 @@\\n+        ? 'CreateHoverCardProps'\\n+        : `${primitive.name}Props`,\\n+      runtime: interactive\\n+        ? `create${primitive.name}Controller`\\n+        : `${primitive.name}Contract`,\\n+      secondaryType: interactive\\n</file context>\\n```\\n\\n</details>\"\n        }\n      ]\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6bODib\",\n      \"path\": \"superconsole/src/routes/audit/+page.ts\",\n      \"isOutdated\": true,\n      \"line\": null,\n      \"comments\": [\n        {\n          \"author\": \"cubic-dev-ai\",\n          \"createdAt\": \"2026-08-21T16:19:44Z\",\n          \"updatedAt\": \"2026-08-21T16:19:48Z\",\n          \"outdated\": true,\n          \"url\": \"https://github.com/21nCo/super-functions/pull/116#discussion_r3831870346\",\n          \"body\": \"<!-- cubic:v=f7c442d0-9cda-425a-b716-bbb0721f56ad -->\\n<!-- cubic:review-run=7bb8304f-392d-4952-ab05-eaf35f279889 -->\\n<!-- metadata:{\\\"confidence\\\":10} -->\\nP1: The audit endpoint returns raw `AdminAuditEvent` objects, but this loader forwards them as `AuditEventViewModel` without mapping. Audit rows therefore read undefined `occurredAt`/`actor`/`action`, render the object target as `[object Object]`, and show raw outcomes as `Unknown`; map each event to the UI view model and normalize its outcome and target.\\n\\n<details>\\n<summary>Prompt for AI agents</summary>\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At superconsole/src/routes/audit/+page.ts, line 12:\\n\\n<comment>The audit endpoint returns raw `AdminAuditEvent` objects, but this loader forwards them as `AuditEventViewModel` without mapping. Audit rows therefore read undefined `occurredAt`/`actor`/`action`, render the object target as `[object Object]`, and show raw outcomes as `Unknown`; map each event to the UI view model and normalize its outcome and target.</comment>\\n\\n<file context>\\n@@ -0,0 +1,23 @@\\n+    const value = url.searchParams.get(key);\\n+    if (value) query.set(key, value);\\n+  }\\n+  const result = await fetchAdmin<{ events: AuditEventViewModel[]; total?: number; nextCursor?: string }>(\\n+    fetch,\\n+    withAdminScope(`${ADMIN_API_PREFIX}/audit${query.size ? `?${query}` : ''}`, url.searchParams)\\n</file context>\\n```\\n\\n</details>\"\n        }\n      ]\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6bODii\",\n      \"path\": \"uifn/core/src/algorithms/id.ts\",\n      \"isOutdated\": false,\n      \"line\": 12,\n      \"comments\": [\n        {\n          \"author\": \"cubic-dev-ai\",\n          \"createdAt\": \"2026-08-21T16:19:45Z\",\n          \"updatedAt\": \"2026-08-21T16:19:48Z\",\n          \"outdated\": false,\n          \"url\": \"https://github.com/21nCo/super-functions/pull/116#discussion_r3831870356\",\n          \"body\": \"<!-- cubic:v=227ea698-ef2d-47bf-bd54-a3906ada78f2 -->\\n<!-- cubic:review-run=7bb8304f-392d-4952-ab05-eaf35f279889 -->\\n<!-- metadata:{\\\"confidence\\\":9} -->\\nP1: Distinct collection values can normalize to the same ID, and non-ASCII-only values can make part rendering throw. Encode dynamic segments reversibly or add a collision-resistant suffix instead of using this lossy slug as the unique ID segment.\\n\\n<details>\\n<summary>Prompt for AI agents</summary>\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At uifn/core/src/algorithms/id.ts, line 12:\\n\\n<comment>Distinct collection values can normalize to the same ID, and non-ASCII-only values can make part rendering throw. Encode dynamic segments reversibly or add a collision-resistant suffix instead of using this lossy slug as the unique ID segment.</comment>\\n\\n<file context>\\n@@ -0,0 +1,37 @@\\n+    .normalize('NFKD')\\n+    .trim()\\n+    .toLowerCase()\\n+    .replace(TOKEN_SANITIZER, '-')\\n+    .replace(REPEATED_DASHES, '-')\\n+    .replace(/^