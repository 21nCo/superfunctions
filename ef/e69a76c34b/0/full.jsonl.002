930f35bab2999aa40e9901a\",\"created_at\":\"2026-08-22T03:11:11Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3834931032\",\"id\":3834931032,\"in_reply_to_id\":null,\"line\":79,\"original_commit_id\":\"8d16f12d9a673cbed04f6c20cc9a06b0e770389e\",\"original_line\":71,\"path\":\"searchfn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T03:11:12Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=54bce44c-98c7-4857-9c5d-2a7ac5e709a8 --\\u003e\\n\\u003c!-- cubic:review-run=e23e6324-2c6c-4e6a-843e-4e4bd3612e24 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":4} --\\u003e\\nP3: Search indices are computed on `source.toLowerCase()` but then used to index the original `source`. `toLowerCase()` is not length-preserving (e.g. 'İ' becomes two code units), and a single such character misaligns every subsequent index between `lower` and `source`, yielding wrong region content and lineOffsets in the guard. Search for openings/closings on `source` (case-insensitively per tag) or validate the two buffers have equal length before mixing their indices.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At superconsole/scripts/verify-function-agnostic.mjs, line 39:\\n\\n\\u003ccomment\\u003eSearch indices are computed on `source.toLowerCase()` but then used to index the original `source`. `toLowerCase()` is not length-preserving (e.g. 'İ' becomes two code units), and a single such character misaligns every subsequent index between `lower` and `source`, yielding wrong region content and lineOffsets in the guard. Search for openings/closings on `source` (case-insensitively per tag) or validate the two buffers have equal length before mixing their indices.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -35,10 +35,30 @@ function embeddedFunctionPackage(identifier) {\\n-    lineOffset: source.slice(0, match.index).split('\\\\n').length - 1,\\n-  }));\\n+  const regions = [];\\n+  const lower = source.toLowerCase();\\n+  let cursor = 0;\\n+  while (cursor \\u003c source.length) {\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n✅ Addressed in [`8ad9b66`](https://github.com/21nCo/super-functions/commit/8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec)\",\"commit_id\":\"8d16f12d9a673cbed04f6c20cc9a06b0e770389e\",\"created_at\":\"2026-08-22T03:11:11Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3834931033\",\"id\":3834931033,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"8d16f12d9a673cbed04f6c20cc9a06b0e770389e\",\"original_line\":39,\"path\":\"superconsole/scripts/verify-function-agnostic.mjs\",\"updated_at\":\"2026-08-22T04:16:56Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=5b8d7834-da37-4eef-9014-0d4f00591960 --\\u003e\\n\\u003c!-- cubic:review-run=e23e6324-2c6c-4e6a-843e-4e4bd3612e24 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":8} --\\u003e\\nP3: This diff introduces a second copy of the route method/path parser. validator.ts `operationRoutePath` now implements the identical manual whitespace-splitting loop with the same verb allowlist, and two other consumers still parse routes differently with a regex (`routeMatches` in registry.ts line 234 and `route()` in openapi.ts line 71, both `trim().split(/\\\\s+/, 1)[0]`). Four places now derive `method`/`path` from a string route with three distinct implementations that must stay in sync; a future change to one (e.g. method normalization or path handling) can silently diverge the registry route, validation, matching, and OpenAPI generation. Extract the split-and-validate logic into a single shared helper in this package and use it from `routeOf`, `operationRoutePath`, `routeMatches`, and `route`.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At packages/admin/src/registry.ts, line 39:\\n\\n\\u003ccomment\\u003eThis diff introduces a second copy of the route method/path parser. validator.ts `operationRoutePath` now implements the identical manual whitespace-splitting loop with the same verb allowlist, and two other consumers still parse routes differently with a regex (`routeMatches` in registry.ts line 234 and `route()` in openapi.ts line 71, both `trim().split(/\\\\s+/, 1)[0]`). Four places now derive `method`/`path` from a string route with three distinct implementations that must stay in sync; a future change to one (e.g. method normalization or path handling) can silently diverge the registry route, validation, matching, and OpenAPI generation. Extract the split-and-validate logic into a single shared helper in this package and use it from `routeOf`, `operationRoutePath`, `routeMatches`, and `route`.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -34,15 +34,42 @@ function dependenciesOf(manifest: AdminCapabilityManifest): string[] {\\n-    return { method: match[1]!.toUpperCase(), path: match[2]! };\\n+    const route = operation.route.trim();\\n+    let boundary = 0;\\n+    while (boundary \\u003c route.length \\u0026\\u0026 !/\\\\s/.test(route[boundary]!)) boundary += 1;\\n+    const method = route.slice(0, boundary).toUpperCase();\\n+    const path = route.slice(boundary).trimStart();\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\",\"commit_id\":\"8d16f12d9a673cbed04f6c20cc9a06b0e770389e\",\"created_at\":\"2026-08-22T03:11:11Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3834931036\",\"id\":3834931036,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"8d16f12d9a673cbed04f6c20cc9a06b0e770389e\",\"original_line\":39,\"path\":\"packages/admin/src/registry.ts\",\"updated_at\":\"2026-08-22T03:11:12Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"**\\u003csub\\u003e\\u003csub\\u003e![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)\\u003c/sub\\u003e\\u003c/sub\\u003e  Filter provider installations by tenant**\\n\\nWhen two tenants use the same user or organization owner ID, this query filters only by `ownerKind` and `ownerId`, even though provider-installation records and the mapped identity both carry `tenantId`. The runtime storage applies exactly the supplied filters, so the list can expose another tenant's provider, scopes, status, and timestamps; include `mapped.tenantId` in the storage filter or apply the same tenant/owner predicate used by `assertInstallationOwner`.\\n\\nUseful? React with 👍 / 👎.\",\"commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"created_at\":\"2026-08-22T04:20:36Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835067767\",\"id\":3835067767,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"original_line\":229,\"path\":\"plugfn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T04:20:36Z\",\"user\":\"chatgpt-codex-connector[bot]\"}\n{\"body\":\"**\\u003csub\\u003e\\u003csub\\u003e![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)\\u003c/sub\\u003e\\u003c/sub\\u003e  Exclude cross-tenant sync jobs from list results**\\n\\nIn a multi-tenant deployment where owner IDs overlap, `listJobs` returns every job matching that owner without verifying the tenant of each job's `connectionId`. Unlike `getSyncJob`, which calls `ownedConnection` and rejects a connection from another tenant, this list path immediately projects all matches, exposing foreign job status, counters, and error text; tenant-scope the query or validate each job through its connection before returning it.\\n\\nUseful? React with 👍 / 👎.\",\"commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"created_at\":\"2026-08-22T04:20:36Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835067768\",\"id\":3835067768,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"original_line\":269,\"path\":\"plugfn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T04:20:36Z\",\"user\":\"chatgpt-codex-connector[bot]\"}\n{\"body\":\"Addressed in 8ad9b66 by requiring a real closing tag boundary and adding the bypass regression.\\n\\n\\u003c!-- PULLFROG_DIVIDER_DO_NOT_REMOVE_PLZ --\\u003e\\n\\u003csup\\u003e\\u003ca href=\\\"https://pullfrog.com\\\"\\u003e\\u003cpicture\\u003e\\u003csource media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://pullfrog.com/logos/frog-white-full-18px.png\\\"\\u003e\\u003cimg src=\\\"https://pullfrog.com/logos/frog-green-full-18px.png\\\" width=\\\"9px\\\" height=\\\"9px\\\" style=\\\"vertical-align: middle; \\\" alt=\\\"Pullfrog\\\"\\u003e\\u003c/picture\\u003e\\u003c/a\\u003e\\u0026nbsp;\\u0026nbsp;｜ [View workflow run](https://github.com/21nCo/super-functions/actions/runs/32551236919/job/96978227728) ｜ via [Pullfrog](https://pullfrog.com) ｜ Using `GPT Sol` ｜ [𝕏](https://x.com/pullfrogai)\\u003c/sup\\u003e\",\"commit_id\":\"8d16f12d9a673cbed04f6c20cc9a06b0e770389e\",\"created_at\":\"2026-08-22T04:24:05Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835074642\",\"id\":3835074642,\"in_reply_to_id\":3834909062,\"line\":null,\"original_commit_id\":\"8d16f12d9a673cbed04f6c20cc9a06b0e770389e\",\"original_line\":51,\"path\":\"superconsole/scripts/verify-function-agnostic.mjs\",\"updated_at\":\"2026-08-22T04:24:05Z\",\"user\":\"pullfrog[bot]\"}\n{\"body\":\"Addressed in 8ad9b66 by capping the aligned step index before calculating the endpoint.\\n\\n\\u003c!-- PULLFROG_DIVIDER_DO_NOT_REMOVE_PLZ --\\u003e\\n\\u003csup\\u003e\\u003ca href=\\\"https://pullfrog.com\\\"\\u003e\\u003cpicture\\u003e\\u003csource media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://pullfrog.com/logos/frog-white-full-18px.png\\\"\\u003e\\u003cimg src=\\\"https://pullfrog.com/logos/frog-green-full-18px.png\\\" width=\\\"9px\\\" height=\\\"9px\\\" style=\\\"vertical-align: middle; \\\" alt=\\\"Pullfrog\\\"\\u003e\\u003c/picture\\u003e\\u003c/a\\u003e\\u0026nbsp;\\u0026nbsp;｜ [View workflow run](https://github.com/21nCo/super-functions/actions/runs/32551236919/job/96978227728) ｜ via [Pullfrog](https://pullfrog.com) ｜ Using `GPT Sol` ｜ [𝕏](https://x.com/pullfrogai)\\u003c/sup\\u003e\",\"commit_id\":\"16a31f15e61f1ab95930f35bab2999aa40e9901a\",\"created_at\":\"2026-08-22T04:24:08Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835074704\",\"id\":3835074704,\"in_reply_to_id\":3834909065,\"line\":53,\"original_commit_id\":\"8d16f12d9a673cbed04f6c20cc9a06b0e770389e\",\"original_line\":40,\"path\":\"uifn/core/src/algorithms/range.ts\",\"updated_at\":\"2026-08-22T04:24:08Z\",\"user\":\"pullfrog[bot]\"}\n{\"body\":\"These newly applied filters and sorts operate on arbitrary keys, but the manifest advertises `status`, `createdAt`, `updatedAt`, and `name` for catalog records that do not contain those fields. A console-generated `status` filter therefore drops every valid product, plan, or price, while advertised sorts silently collapse to the `id` fallback.\\n\\n\\u003cdetails\\u003e\\u003csummary\\u003eTechnical details\\u003c/summary\\u003e\\n\\n````markdown\\n# BillFn list controls do not match their manifest\\n\\n## Affected sites\\n- `billfn/admin/src/domain-service.ts:67-78` — evaluates every requested field against the returned record without reconciling the capability contract.\\n- `billfn/admin/src/index.ts:56-92` — advertises product, plan, and price fields absent from their domain records.\\n- `billfn/admin/src/__tests__/admin.test.ts:148-156` — tests `productKey` and `id`, not the controls exposed by the manifest.\\n\\n## Required outcome\\n- Every advertised filter and sort field must exist with the documented semantics on its resource records.\\n- Cover manifest-generated filtering and sorting for the domain-backed catalog resources.\\n````\\n\\n\\u003c/details\\u003e\",\"commit_id\":\"16a31f15e61f1ab95930f35bab2999aa40e9901a\",\"created_at\":\"2026-08-22T04:26:08Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835078214\",\"id\":3835078214,\"in_reply_to_id\":null,\"line\":82,\"original_commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"original_line\":68,\"path\":\"billfn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T04:26:09Z\",\"user\":\"pullfrog[bot]\"}\n{\"body\":\"`decodeAdminCursor` is explicitly unsigned, so a caller can replace the same-scope offset with any nonnegative integer. Adding that value to the page size and forwarding it as the storage limit lets one admin request trigger an arbitrarily large database query.\\n\\n\\u003cdetails\\u003e\\u003csummary\\u003eTechnical details\\u003c/summary\\u003e\\n\\n````markdown\\n# Forged offsets create unbounded storage limits\\n\\n## Affected sites\\n- `plugfn/admin/src/domain-service.ts:263-270` — validates only that the decoded offset is a nonnegative integer, then includes it in the fetch limit.\\n- `packages/admin/src/pagination.ts:28-41` — documents that these cursor payloads have no integrity protection.\\n- `plugfn/core/src/storage/adapters/database.ts:657-666` — forwards the supplied limit directly to `findMany`.\\n\\n## Required outcome\\n- Cursor pagination must keep each storage request bounded independently of caller-controlled cursor contents.\\n- Preserve access to later pages without materializing every preceding row in one query.\\n````\\n\\n\\u003c/details\\u003e\",\"commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"created_at\":\"2026-08-22T04:26:08Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835078218\",\"id\":3835078218,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"original_line\":269,\"path\":\"plugfn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T04:26:09Z\",\"user\":\"pullfrog[bot]\"}\n{\"body\":\"The fixed folding table no longer preserves locale-specific expansion equivalences supported by the configured `Intl.Collator`. For example, German search collation treats `Ä` and `AE` as equivalent, but `startsWith('Äpfel', 'AE')` now returns false, regressing locale-aware typeahead and filtering.\\n\\n\\u003cdetails\\u003e\\u003csummary\\u003eTechnical details\\u003c/summary\\u003e\\n\\n````markdown\\n# Locale-aware substring matching regresses expansions\\n\\n## Affected sites\\n- `uifn/core/src/algorithms/locale.ts:13-28` — strips marks and applies a fixed replacement list before literal matching.\\n- `uifn/core/src/__tests__/phase-06-algorithms.test.ts:167-169` — covers only the explicitly mapped `ß` expansion.\\n\\n## Required outcome\\n- `startsWith` and `includes` must preserve the active locale's search-collation equivalences without returning to unbounded quadratic work.\\n- Cover at least one locale-dependent expansion not encoded in a global replacement table.\\n````\\n\\n\\u003c/details\\u003e\",\"commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"created_at\":\"2026-08-22T04:26:09Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835078219\",\"id\":3835078219,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"original_line\":25,\"path\":\"uifn/core/src/algorithms/locale.ts\",\"updated_at\":\"2026-08-22T04:26:09Z\",\"user\":\"pullfrog[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=f4f929e2-bdb0-429f-9086-f9a9ecc35bbc --\\u003e\\n\\u003c!-- cubic:review-run=e132b4ff-cab0-498f-ac59-f8230337c676 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":10} --\\u003e\\nP1: When decimal bounds make `(max - min) / step` round just below an integer, `maxIndex` rejects a valid endpoint index. For example, `{ min: 0.1, max: 0.3, step: 0.1 }` makes `alignRangeValue(max, definition)` return `0.2`, breaking End-key and 100% pointer behavior; normalize the bound difference using the range precision before flooring.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At uifn/core/src/algorithms/range.ts, line 43:\\n\\n\\u003ccomment\\u003eWhen decimal bounds make `(max - min) / step` round just below an integer, `maxIndex` rejects a valid endpoint index. For example, `{ min: 0.1, max: 0.3, step: 0.1 }` makes `alignRangeValue(max, definition)` return `0.2`, breaking End-key and 100% pointer behavior; normalize the bound difference using the range precision before flooring.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -36,7 +38,13 @@ export function alignRangeValue(value: number, definition: RangeDefinition): num\\n-  const aligned = min + Math.round((clampRangeValue(value, min, max) - min) / step) * step;\\n+  const clamped = clampRangeValue(value, min, max);\\n+  const rawIndex = (clamped - min) / step;\\n+  const maxIndex = Math.floor((max - min) / step);\\n+  let index = Math.round(rawIndex);\\n+  if (Number.isFinite(maxIndex)) index = Math.min(index, maxIndex);\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n```suggestion\\n  const maxIndex = Math.floor(roundRangeValue(max - min, precision) / step);\\n```\\n\\n✅ Addressed in [`e1f368a`](https://github.com/21nCo/super-functions/commit/e1f368ac354ce6fec024eca61b2c723c9f4d04ab)\",\"commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"created_at\":\"2026-08-22T04:32:38Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835088586\",\"id\":3835088586,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"original_line\":43,\"path\":\"uifn/core/src/algorithms/range.ts\",\"updated_at\":\"2026-08-22T06:02:14Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=d0e97b42-5841-4a8a-904e-7430258140ac --\\u003e\\n\\u003c!-- cubic:review-run=e132b4ff-cab0-498f-ac59-f8230337c676 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":8} --\\u003e\\nP1: Scope this query by tenant and connection ownership before projecting jobs. With only `ownerKind` and `ownerId`, overlapping owner IDs let `listSyncJobs` return another tenant's status, counters, and error text.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At plugfn/admin/src/domain-service.ts, line 268:\\n\\n\\u003ccomment\\u003eScope this query by tenant and connection ownership before projecting jobs. With only `ownerKind` and `ownerId`, overlapping owner IDs let `listSyncJobs` return another tenant's status, counters, and error text.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -260,7 +260,14 @@ export function createPlugFnDomainAdminService(options: PlugFnDomainAdminService\\n+      if (!Number.isInteger(offset) || (offset as number) \\u003c 0) throw new AdminError(\\\"invalid_argument\\\", \\\"The PlugFn cursor is invalid.\\\");\\n+      const pageLimit = normalizeAdminPageLimit(limit, { defaultLimit: 50, maxLimit: 100 });\\n+      const values = await options.plugfn.runtime.sync.listJobs(\\n+        { ownerKind: owner.kind, ownerId, ...requested },\\n+        (offset as number) + pageLimit + 1,\\n+      );\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n✅ Addressed in [`e1f368a`](https://github.com/21nCo/super-functions/commit/e1f368ac354ce6fec024eca61b2c723c9f4d04ab)\",\"commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"created_at\":\"2026-08-22T04:32:38Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835088590\",\"id\":3835088590,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"original_line\":268,\"path\":\"plugfn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T06:02:09Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=6f141757-e8a2-4d8f-a538-a065fefb2edc --\\u003e\\n\\u003c!-- cubic:review-run=e132b4ff-cab0-498f-ac59-f8230337c676 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":9} --\\u003e\\nP2: When a scope-valid cursor has a missing or `null` `position`, this property access throws before the invalid-offset check. Validate the decoded position before reading `offset` so malformed cursors return `invalid_argument` rather than an internal 500.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At billfn/admin/src/domain-service.ts, line 79:\\n\\n\\u003ccomment\\u003eWhen a scope-valid cursor has a missing or `null` `position`, this property access throws before the invalid-offset check. Validate the decoded position before reading `offset` so malformed cursors return `invalid_argument` rather than an internal 500.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -51,8 +54,35 @@ function asJson(value: object): JsonRecord {\\n+    }\\n+    return String(left.id ?? \\\"\\\").localeCompare(String(right.id ?? \\\"\\\"));\\n+  });\\n+  const decoded = input.cursor ? decodeAdminCursor\\u003c{ offset?: unknown }\\u003e(input.cursor, context.scope) : { offset: 0 };\\n+  const offset = decoded.offset ?? 0;\\n+  if (!Number.isInteger(offset) || (offset as number) \\u003c 0) throw new AdminError(\\\"invalid_argument\\\", \\\"The BillFn cursor is invalid.\\\");\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n```suggestion\\n  const decoded = input.cursor ? decodeAdminCursor\\u003cunknown\\u003e(input.cursor, context.scope) : { offset: 0 };\\n  const offset = decoded \\u0026\\u0026 typeof decoded === \\\"object\\\" \\u0026\\u0026 !Array.isArray(decoded)\\n    ? (decoded as { offset?: unknown }).offset ?? 0\\n    : undefined;\\n```\\n\\n✅ Addressed in [`e1f368a`](https://github.com/21nCo/super-functions/commit/e1f368ac354ce6fec024eca61b2c723c9f4d04ab)\",\"commit_id\":\"a422e0fa933ac6b328293a76c4b6167bb50e95c3\",\"created_at\":\"2026-08-22T04:32:38Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835088592\",\"id\":3835088592,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"original_line\":80,\"path\":\"billfn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T06:02:10Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=f0133d82-f4d3-4c82-aa61-f41c79019a37 --\\u003e\\n\\u003c!-- cubic:review-run=e132b4ff-cab0-498f-ac59-f8230337c676 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":9} --\\u003e\\nP2: When a caller supplies a syntactically valid cursor with a huge offset, this line requests that many rows from storage. Because cursor decoding only checks scope, an authorized caller can force oversized sync-job queries; bound the offset or use storage-level offset/keyset pagination.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At plugfn/admin/src/domain-service.ts, line 269:\\n\\n\\u003ccomment\\u003eWhen a caller supplies a syntactically valid cursor with a huge offset, this line requests that many rows from storage. Because cursor decoding only checks scope, an authorized caller can force oversized sync-job queries; bound the offset or use storage-level offset/keyset pagination.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -260,7 +260,14 @@ export function createPlugFnDomainAdminService(options: PlugFnDomainAdminService\\n+      const pageLimit = normalizeAdminPageLimit(limit, { defaultLimit: 50, maxLimit: 100 });\\n+      const values = await options.plugfn.runtime.sync.listJobs(\\n+        { ownerKind: owner.kind, ownerId, ...requested },\\n+        (offset as number) + pageLimit + 1,\\n+      );\\n       return page(values.map(syncView), input, context);\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n✅ Addressed in [`e1f368a`](https://github.com/21nCo/super-functions/commit/e1f368ac354ce6fec024eca61b2c723c9f4d04ab)\",\"commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"created_at\":\"2026-08-22T04:32:38Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835088594\",\"id\":3835088594,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"original_line\":269,\"path\":\"plugfn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T06:02:11Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=c01d9859-f4a1-4ad6-babd-3dd90bcbb46c --\\u003e\\n\\u003c!-- cubic:review-run=e132b4ff-cab0-498f-ac59-f8230337c676 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":9} --\\u003e\\nP2: When a document uses an allowed numeric ID such as `1.5`, `remove-document` sends only `\\\"1.5\\\"`, so `MemoryAdapter` leaves the numeric document searchable. Alias every finite number whose canonical string matches the target, or reject unsupported numeric IDs during indexing.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At searchfn/admin/src/domain-service.ts, line 105:\\n\\n\\u003ccomment\\u003eWhen a document uses an allowed numeric ID such as `1.5`, `remove-document` sends only `\\\"1.5\\\"`, so `MemoryAdapter` leaves the numeric document searchable. Alias every finite number whose canonical string matches the target, or reject unsupported numeric IDs during indexing.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -98,8 +98,13 @@ function splitDocumentId(value: string): { resource: string; id: string } {\\n+}\\n+\\n+function documentRemovalIds(id: string): Array\\u003cstring | number\\u003e {\\n+  if (!/^-?(?:0|[1-9]\\\\d*)$/.test(id)) return [id];\\n+  const numericId = Number(id);\\n+  return Number.isSafeInteger(numericId) ? [id, numericId] : [id];\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n```suggestion\\n  const numericId = Number(id);\\n  return Number.isFinite(numericId) \\u0026\\u0026 String(numericId) === id ? [id, numericId] : [id];\\n```\",\"commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"created_at\":\"2026-08-22T04:32:38Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835088595\",\"id\":3835088595,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"original_line\":107,\"path\":\"searchfn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T04:32:38Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=7abbc835-a8b8-465a-bf0e-8674c6da2f36 --\\u003e\\n\\u003c!-- cubic:review-run=e132b4ff-cab0-498f-ac59-f8230337c676 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":6} --\\u003e\\nP2: The new sort compares every field as a string via String(...).localeCompare(...), so numeric fields (planCount, price/usage amounts, numeric timestamps) sort lexicographically rather than numerically — 10 orders before 9. Compare both operands numerically when they are numbers, and fall back to string comparison only for non-numeric values.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At billfn/admin/src/domain-service.ts, line 74:\\n\\n\\u003ccomment\\u003eThe new sort compares every field as a string via String(...).localeCompare(...), so numeric fields (planCount, price/usage amounts, numeric timestamps) sort lexicographically rather than numerically — 10 orders before 9. Compare both operands numerically when they are numbers, and fall back to string comparison only for non-numeric values.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -51,8 +54,35 @@ function asJson(value: object): JsonRecord {\\n+  records.sort((left, right) =\\u003e {\\n+    for (const descriptor of sorts) {\\n+      if (!descriptor.field) continue;\\n+      const compared = String(left[descriptor.field] ?? \\\"\\\").localeCompare(String(right[descriptor.field] ?? \\\"\\\"));\\n+      if (compared !== 0) return compared * (descriptor.direction === \\\"desc\\\" ? -1 : 1);\\n+    }\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n```suggestion\\n      const leftValue = left[descriptor.field];\\n      const rightValue = right[descriptor.field];\\n      const compared =\\n        typeof leftValue === \\\"number\\\" \\u0026\\u0026 typeof rightValue === \\\"number\\\"\\n          ? leftValue - rightValue\\n          : String(leftValue ?? \\\"\\\").localeCompare(String(rightValue ?? \\\"\\\"));\\n```\\n\\n✅ Addressed in [`e1f368a`](https://github.com/21nCo/super-functions/commit/e1f368ac354ce6fec024eca61b2c723c9f4d04ab)\",\"commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"created_at\":\"2026-08-22T04:32:38Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835088596\",\"id\":3835088596,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"original_line\":74,\"path\":\"billfn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T06:02:08Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=1b4f296b-23bc-4b74-8851-4f76900ba174 --\\u003e\\n\\u003c!-- cubic:review-run=e132b4ff-cab0-498f-ac59-f8230337c676 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":6} --\\u003e\\nP2: The new searchKey-based `startsWith`/`includes` use fixed multi-character expansions (ß→ss, æ→ae, …) on top of a plain `.startsWith()`/`.includes()` substring test, so expansion coincidences now produce false matches that the collator-based matcher never did. Confirmed: `equals('ß','s')` is false (Intl.Collator 'de' search/base), but the new `includes('ß','s')` is true, and `includes('aß','as')` is true ('ass' contains 'as') whereas the old collator substring loop returned false. These methods now also diverge from collator-based `equals`. For an admin-console filter/autocomplete this can surface non-matching rows in results. If looser matching is intended, document it; otherwise restrict the expansion to word/query boundaries or keep collator semantics.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At uifn/core/src/algorithms/locale.ts, line 13:\\n\\n\\u003ccomment\\u003eThe new searchKey-based `startsWith`/`includes` use fixed multi-character expansions (ß→ss, æ→ae, …) on top of a plain `.startsWith()`/`.includes()` substring test, so expansion coincidences now produce false matches that the collator-based matcher never did. Confirmed: `equals('ß','s')` is false (Intl.Collator 'de' search/base), but the new `includes('ß','s')` is true, and `includes('aß','as')` is true ('ass' contains 'as') whereas the old collator substring loop returned false. These methods now also diverge from collator-based `equals`. For an admin-console filter/autocomplete this can surface non-matching rows in results. If looser matching is intended, document it; otherwise restrict the expansion to word/query boundaries or keep collator semantics.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -10,29 +10,22 @@ export interface LocaleMatcher {\\n export function createLocaleMatcher(locale = 'en'): LocaleMatcher {\\n   const collator = new Intl.Collator(locale, { usage: 'search', sensitivity: 'base', numeric: true });\\n   const normalize = (value: string) =\\u003e value.normalize('NFKD').toLocaleLowerCase(locale);\\n+  const searchKey = (value: string) =\\u003e normalize(value)\\n+    .replace(/\\\\p{M}/gu, '')\\n+    .replace(/ß/g, 'ss')\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n✅ Addressed in [`e1f368a`](https://github.com/21nCo/super-functions/commit/e1f368ac354ce6fec024eca61b2c723c9f4d04ab)\",\"commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"created_at\":\"2026-08-22T04:32:38Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835088598\",\"id\":3835088598,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"original_line\":13,\"path\":\"uifn/core/src/algorithms/locale.ts\",\"updated_at\":\"2026-08-22T06:02:13Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=75a14fbd-e5b1-483c-9c87-100439aa9c9a --\\u003e\\n\\u003c!-- cubic:review-run=e132b4ff-cab0-498f-ac59-f8230337c676 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":6} --\\u003e\\nP2: Removing `docs:123` now deletes BOTH the string-indexed \\\"123\\\" document and any unrelated document indexed with the numeric id 123. If an operator only indexed a numeric-looking string id, this silently removes an unrelated numeric-id document, and there is no way to target only one representation. Asymmetrically, `indexDocument` still stores only the string form while `batchIndex` can store the numeric form, so the dual-form removal is broader than necessary for the string-only case. Scope the numeric expansion so it only removes the numeric id when that exact document actually exists (or normalize ids at index time) rather than always removing both; otherwise the `removed: 1` count also underreports when two documents are deleted.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At searchfn/admin/src/domain-service.ts, line 209:\\n\\n\\u003ccomment\\u003eRemoving `docs:123` now deletes BOTH the string-indexed \\\"123\\\" document and any unrelated document indexed with the numeric id 123. If an operator only indexed a numeric-looking string id, this silently removes an unrelated numeric-id document, and there is no way to target only one representation. Asymmetrically, `indexDocument` still stores only the string form while `batchIndex` can store the numeric form, so the dual-form removal is broader than necessary for the string-only case. Scope the numeric expansion so it only removes the numeric id when that exact document actually exists (or normalize ids at index time) rather than always removing both; otherwise the `removed: 1` count also underreports when two documents are deleted.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -201,7 +206,7 @@ export function createSearchFnDomainAdminService(\\n       const target = splitDocumentId(string(input.id, \\\"id\\\"));\\n       if (!resources.includes(target.resource)) throw new AdminError(\\\"not_found\\\", \\\"SearchFn index was not found in the active scope.\\\");\\n-      await adapter.remove({ resource: target.resource, ids: [target.id], signal: context.signal });\\n+      await adapter.remove({ resource: target.resource, ids: documentRemovalIds(target.id), signal: context.signal });\\n       return accepted({ removed: 1, resource: target.resource });\\n     },\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n✅ Addressed in [`e1f368a`](https://github.com/21nCo/super-functions/commit/e1f368ac354ce6fec024eca61b2c723c9f4d04ab)\",\"commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"created_at\":\"2026-08-22T04:32:38Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835088600\",\"id\":3835088600,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"original_line\":209,\"path\":\"searchfn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T06:02:12Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=d37f08b0-fdf9-47e7-a2ba-9175b691b67a --\\u003e\\n\\u003c!-- cubic:review-run=e132b4ff-cab0-498f-ac59-f8230337c676 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":9} --\\u003e\\nP2: When the manifest advertises catalog fields absent from the records, this generic filter drops every record for a non-`undefined` value and the sorter falls back to `id`. Align the manifest with the record shape or map those fields before applying the controls.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At billfn/admin/src/domain-service.ts, line 68:\\n\\n\\u003ccomment\\u003eWhen the manifest advertises catalog fields absent from the records, this generic filter drops every record for a non-`undefined` value and the sorter falls back to `id`. Align the manifest with the record shape or map those fields before applying the controls.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -51,8 +54,35 @@ function asJson(value: object): JsonRecord {\\n+    records = records.filter((value) =\\u003e JSON.stringify(value).toLowerCase().includes(query));\\n+  }\\n+  if (input.filter) {\\n+    records = records.filter((value) =\\u003e Object.entries(input.filter!).every(([key, expected]) =\\u003e Object.is(value[key], expected)));\\n+  }\\n+  const sorts = input.sort ?? [];\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\",\"commit_id\":\"16a31f15e61f1ab95930f35bab2999aa40e9901a\",\"created_at\":\"2026-08-22T04:32:38Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835088601\",\"id\":3835088601,\"in_reply_to_id\":null,\"line\":82,\"original_commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"original_line\":68,\"path\":\"billfn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T04:32:38Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=8cf831ff-3348-4126-979b-04c56c25af52 --\\u003e\\n\\u003c!-- cubic:review-run=e132b4ff-cab0-498f-ac59-f8230337c676 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":7} --\\u003e\\nP3: This test claims to reject paths that \\\"address prototype properties\\\" but only exercises `constructor`. The validator guards `__proto__`, `prototype`, and `constructor` (presentationInputPathSchema), and `__proto__` is the actual prototype-pollution risk, so a regression in the other two guards would pass this test. Cover `__proto__` and `prototype` segments as well, as the test name promises.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At packages/admin/src/registry.test.ts, line 779:\\n\\n\\u003ccomment\\u003eThis test claims to reject paths that \\\"address prototype properties\\\" but only exercises `constructor`. The validator guards `__proto__`, `prototype`, and `constructor` (presentationInputPathSchema), and `__proto__` is the actual prototype-pollution risk, so a regression in the other two guards would pass this test. Cover `__proto__` and `prototype` segments as well, as the test name promises.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -754,4 +754,36 @@ describe(\\\"manifest validation\\\", () =\\u003e {\\n+        filterableFields: [\\\"value\\\"],\\n+        presentation: {\\n+          listOperationId: operation.id,\\n+          query: { filters: [{ field: \\\"value\\\", inputPath: \\\"constructor.value\\\" }] },\\n+        },\\n+      }],\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n✅ Addressed in [`e1f368a`](https://github.com/21nCo/super-functions/commit/e1f368ac354ce6fec024eca61b2c723c9f4d04ab)\",\"commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"created_at\":\"2026-08-22T04:32:38Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835088603\",\"id\":3835088603,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"original_line\":779,\"path\":\"packages/admin/src/registry.test.ts\",\"updated_at\":\"2026-08-22T06:02:15Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"**\\u003csub\\u003e\\u003csub\\u003e![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)\\u003c/sub\\u003e\\u003c/sub\\u003e  Prefix listed DataFn record IDs with their resource**\\n\\nWhen the DataFn record list returns a normal domain row such as `{ id: \\\"task-1\\\" }`, this forwards the raw ID even though `getRecord` and `mutate` require the composite target `tasks:task-1`. The Super Console derives detail links and row-action inputs from each returned `id`, so opening or mutating any listed record produces an invalid composite-ID error. Project each row with the selected resource prefix while preserving the underlying domain ID as needed.\\n\\nUseful? React with 👍 / 👎.\",\"commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"created_at\":\"2026-08-22T06:05:22Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835342080\",\"id\":3835342080,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"original_line\":222,\"path\":\"datafn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T06:05:23Z\",\"user\":\"chatgpt-codex-connector[bot]\"}\n{\"body\":\"**\\u003csub\\u003e\\u003csub\\u003e![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)\\u003c/sub\\u003e\\u003c/sub\\u003e  Route resource HEAD requests through their GET operation**\\n\\nFor `HEAD` on a module resource list or detail route, the registry lookup uses `HEAD`, but every read operation is registered as `GET`; the subsequent method check therefore returns 405. This conflicts with the module OPTIONS response, which advertises HEAD, and unlike the module root and shell endpoints this path never strips a GET response body. Match HEAD against the corresponding GET operation and return it through `headAware`.\\n\\nUseful? React with 👍 / 👎.\",\"commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"created_at\":\"2026-08-22T06:05:22Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835342084\",\"id\":3835342084,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"original_line\":1200,\"path\":\"superconsole/src/lib/server/super-console.ts\",\"updated_at\":\"2026-08-22T06:05:23Z\",\"user\":\"chatgpt-codex-connector[bot]\"}\n{\"body\":\"Addressed in e1f368a.\\n\\n\\u003c!-- PULLFROG_DIVIDER_DO_NOT_REMOVE_PLZ --\\u003e\\n\\u003csup\\u003e\\u003ca href=\\\"https://pullfrog.com\\\"\\u003e\\u003cpicture\\u003e\\u003csource media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://pullfrog.com/logos/frog-white-full-18px.png\\\"\\u003e\\u003cimg src=\\\"https://pullfrog.com/logos/frog-green-full-18px.png\\\" width=\\\"9px\\\" height=\\\"9px\\\" style=\\\"vertical-align: middle; \\\" alt=\\\"Pullfrog\\\"\\u003e\\u003c/picture\\u003e\\u003c/a\\u003e\\u0026nbsp;\\u0026nbsp;｜ [View workflow run](https://github.com/21nCo/super-functions/actions/runs/32555839931/job/96989690073) ｜ via [Pullfrog](https://pullfrog.com) ｜ Using `GPT Sol` ｜ [𝕏](https://x.com/pullfrogai)\\u003c/sup\\u003e\",\"commit_id\":\"16a31f15e61f1ab95930f35bab2999aa40e9901a\",\"created_at\":\"2026-08-22T06:06:30Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835345164\",\"id\":3835345164,\"in_reply_to_id\":3835078214,\"line\":82,\"original_commit_id\":\"8ad9b668d13ae8354920ab8d6e4ef6f1b01eeaec\",\"original_line\":68,\"path\":\"billfn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T06:06:30Z\",\"user\":\"pullfrog[bot]\"}\n{\"body\":\"This schema change is operationally required by the new `tenantId` list predicate, but the rollout guide still says no database migration is needed. Existing v6 databases lack the column and index, and adding them without backfilling leaves all pre-v7 jobs invisible to tenant-scoped administration.\\n\\n\\u003cdetails\\u003e\\u003csummary\\u003eTechnical details\\u003c/summary\\u003e\\n\\n````markdown\\n# PlugFn schema v7 needs a migration rollout\\n\\n## Affected sites\\n- `plugfn/core/src/schema.ts:228` — adds the persisted `tenant_id` field.\\n- `plugfn/core/src/schema.ts:243` — adds the owner/tenant index.\\n- `plugfn/admin/src/domain-service.ts:273` — immediately requires tenant equality when listing jobs.\\n- `superconsole/README.md:157-158` — states that no database or persisted-data migration is required.\\n\\n## Required outcome\\n- Provide DDL and a safe backfill or transition for existing sync jobs before enabling the tenant predicate.\\n- Update the deployment guidance to sequence the schema/data change before the admin adapter.\\n````\\n\\n\\u003c/details\\u003e\",\"commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"created_at\":\"2026-08-22T06:09:00Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835350201\",\"id\":3835350201,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"original_line\":228,\"path\":\"plugfn/core/src/schema.ts\",\"updated_at\":\"2026-08-22T06:09:01Z\",\"user\":\"pullfrog[bot]\"}\n{\"body\":\"Offset paging is now delegated to storage, but the query orders only by non-unique `createdAt`. Jobs created in the same timestamp can change relative order between page requests, so operators can skip or repeat jobs.\\n\\n\\u003cdetails\\u003e\\u003csummary\\u003eTechnical details\\u003c/summary\\u003e\\n\\n````markdown\\n# Sync-job pages lack a total order\\n\\n## Affected sites\\n- `plugfn/core/src/storage/adapters/database.ts:665-667` — applies offset under a `createdAt`-only order.\\n- `plugfn/admin/src/domain-service.ts:279-286` — builds cursors from that offset.\\n- `plugfn/admin/src/__tests__/admin.test.ts:162-181` — uses unique timestamps and does not exercise tied rows.\\n\\n## Required outcome\\n- Use a deterministic total ordering shared by the storage query and cursor semantics.\\n- Cover pagination across jobs with identical `createdAt` values.\\n\\n## Suggested approach\\n- Add a unique secondary order key such as `id`, or use a keyset cursor over the complete ordering tuple.\\n````\\n\\n\\u003c/details\\u003e\",\"commit_id\":\"16a31f15e61f1ab95930f35bab2999aa40e9901a\",\"created_at\":\"2026-08-22T06:09:00Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835350203\",\"id\":3835350203,\"in_reply_to_id\":null,\"line\":667,\"original_commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"original_line\":667,\"path\":\"plugfn/core/src/storage/adapters/database.ts\",\"updated_at\":\"2026-08-22T06:09:01Z\",\"user\":\"pullfrog[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=335276f1-5056-4e01-ad16-79cad0526da2 --\\u003e\\n\\u003c!-- cubic:review-run=c3096435-6aa1-4235-8388-39d72d0f9ba1 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":9} --\\u003e\\nP2: After upgrading existing data from schema version 6, historical sync jobs have a null `tenantId` and are excluded from `listSyncJobs` by the new tenant predicate. Backfill `tenant_id` from each job's connection during the migration, or provide an equivalent compatibility path before enforcing this filter.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At plugfn/core/src/schema.ts, line 228:\\n\\n\\u003ccomment\\u003eAfter upgrading existing data from schema version 6, historical sync jobs have a null `tenantId` and are excluded from `listSyncJobs` by the new tenant predicate. Backfill `tenant_id` from each job's connection during the migration, or provide an equivalent compatibility path before enforcing this filter.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -226,6 +225,7 @@ export function getSchema(options: PlugFnSchemaOptions = {}): { version: number;\\n           claimToken: { type: 'string', required: false, fieldName: 'claim_token', maxLength: 64 },\\n           ownerKind: { type: 'string', required: false, fieldName: 'owner_kind' },\\n           ownerId: { type: 'string', required: false, fieldName: 'owner_id' },\\n+          tenantId: { type: 'string', required: false, fieldName: 'tenant_id' },\\n           cursor: { type: 'string', required: false, fieldName: 'cursor' },\\n           checkpoint: { type: 'json', required: false, fieldName: 'checkpoint' },\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n✅ Addressed in [`9307965`](https://github.com/21nCo/super-functions/commit/93079657b6d79970339f92d9a8f47a085a7364c7)\",\"commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"created_at\":\"2026-08-22T06:09:40Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835351179\",\"id\":3835351179,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"original_line\":228,\"path\":\"plugfn/core/src/schema.ts\",\"updated_at\":\"2026-08-22T06:51:24Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=7eeaadf3-9b18-4dc4-a499-34ce02b44602 --\\u003e\\n\\u003c!-- cubic:review-run=c3096435-6aa1-4235-8388-39d72d0f9ba1 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":9} --\\u003e\\nP2: When a document ID begins with `string:`, this parser silently strips that part and targets a different ID. Only treat `string:` as the escape prefix for the documented `number:` case, or add an unambiguous escape scheme for arbitrary string IDs.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At searchfn/admin/src/domain-service.ts, line 114:\\n\\n\\u003ccomment\\u003eWhen a document ID begins with `string:`, this parser silently strips that part and targets a different ID. Only treat `string:` as the escape prefix for the documented `number:` case, or add an unambiguous escape scheme for arbitrary string IDs.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -93,18 +96,26 @@ function accepted(value: JsonRecord): AdminOperationResult\\u003cSearchFnMutationOutpu\\n+    }\\n+    return { resource, id: numericId };\\n+  }\\n+  const stringId = encodedId.startsWith(\\\"string:\\\") ? encodedId.slice(\\\"string:\\\".length) : encodedId;\\n+  if (stringId.length === 0) {\\n+    throw new AdminError(\\\"invalid_argument\\\", \\\"SearchFn document IDs must be non-empty.\\\");\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n✅ Addressed in [`9307965`](https://github.com/21nCo/super-functions/commit/93079657b6d79970339f92d9a8f47a085a7364c7)\",\"commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"created_at\":\"2026-08-22T06:09:40Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835351181\",\"id\":3835351181,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"original_line\":114,\"path\":\"searchfn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T06:51:46Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=48b8565a-ce48-4218-acef-fd892fce8a3d --\\u003e\\n\\u003c!-- cubic:review-run=c3096435-6aa1-4235-8388-39d72d0f9ba1 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":10} --\\u003e\\nP2: When a collation expansion or numeric representation differs by more than eight graphemes, `matchesAt` never compares the full equivalent span and silently returns a false negative. Use collation-aware span bounds that cover the supported representations, or explicitly handle this case instead of a fixed variance.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At uifn/core/src/algorithms/locale.ts, line 24:\\n\\n\\u003ccomment\\u003eWhen a collation expansion or numeric representation differs by more than eight graphemes, `matchesAt` never compares the full equivalent span and silently returns a false negative. Use collation-aware span bounds that cover the supported representations, or explicitly handle this case instead of a fixed variance.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -10,22 +10,53 @@ export interface LocaleMatcher {\\n+    ? [...segmenter.segment(value.normalize('NFC'))].map((part) =\\u003e part.segment)\\n+    : Array.from(value.normalize('NFC'));\\n+  const MAX_COLLATION_QUERY_SEGMENTS = 256;\\n+  const COLLATION_LENGTH_VARIANCE = 8;\\n+  const initial = (value: string): string | undefined =\\u003e normalize(value).replace(/\\\\p{M}/gu, '')[0];\\n+  const matchesAt = (valueSegments: readonly string[], query: string, queryLength: number, queryInitial: string | undefined, start: number): boolean =\\u003e {\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n✅ Addressed in [`9307965`](https://github.com/21nCo/super-functions/commit/93079657b6d79970339f92d9a8f47a085a7364c7)\",\"commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"created_at\":\"2026-08-22T06:09:40Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835351183\",\"id\":3835351183,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"original_line\":24,\"path\":\"uifn/core/src/algorithms/locale.ts\",\"updated_at\":\"2026-08-22T06:51:37Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=55f31b54-53ec-4a1a-a333-ee382b180e18 --\\u003e\\n\\u003c!-- cubic:review-run=c3096435-6aa1-4235-8388-39d72d0f9ba1 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":10} --\\u003e\\nP2: For locales whose base collation equates different ASCII initials, this guard rejects valid matches before `collator.compare` runs. Remove the initial-character rejection, or only use it after a collation-safe equivalence check.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At uifn/core/src/algorithms/locale.ts, line 27:\\n\\n\\u003ccomment\\u003eFor locales whose base collation equates different ASCII initials, this guard rejects valid matches before `collator.compare` runs. Remove the initial-character rejection, or only use it after a collation-safe equivalence check.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -10,22 +10,53 @@ export interface LocaleMatcher {\\n+  const COLLATION_LENGTH_VARIANCE = 8;\\n+  const initial = (value: string): string | undefined =\\u003e normalize(value).replace(/\\\\p{M}/gu, '')[0];\\n+  const matchesAt = (valueSegments: readonly string[], query: string, queryLength: number, queryInitial: string | undefined, start: number): boolean =\\u003e {\\n+    const valueInitial = normalize(valueSegments[start] ?? '').replace(/\\\\p{M}/gu, '')[0];\\n+    if (valueInitial !== queryInitial \\u0026\\u0026 /^[a-z]$/.test(valueInitial ?? '') \\u0026\\u0026 /^[a-z]$/.test(queryInitial ?? '')) {\\n+      return false;\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n✅ Addressed in [`9307965`](https://github.com/21nCo/super-functions/commit/93079657b6d79970339f92d9a8f47a085a7364c7)\",\"commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"created_at\":\"2026-08-22T06:09:40Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835351185\",\"id\":3835351185,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"original_line\":27,\"path\":\"uifn/core/src/algorithms/locale.ts\",\"updated_at\":\"2026-08-22T06:51:45Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=ef05b3d1-f67d-45bc-b36a-f71af867d36e --\\u003e\\n\\u003c!-- cubic:review-run=c3096435-6aa1-4235-8388-39d72d0f9ba1 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":9} --\\u003e\\nP2: When `max` is just below a step endpoint, this tolerance rounds `maxIndex` up even though `max` is not step-aligned. Compare the rounded span with the rounded candidate endpoint before snapping, so `End` and normalized values remain step-aligned.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At uifn/core/src/algorithms/range.ts, line 45:\\n\\n\\u003ccomment\\u003eWhen `max` is just below a step endpoint, this tolerance rounds `maxIndex` up even though `max` is not step-aligned. Compare the rounded span with the rounded candidate endpoint before snapping, so `End` and normalized values remain step-aligned.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -40,7 +40,11 @@ export function alignRangeValue(value: number, definition: RangeDefinition): num\\n-  const maxIndex = Math.floor((max - min) / step);\\n+  const rawMaxIndex = roundRangeValue(max - min, precision) / step;\\n+  const nearestMaxIndex = Math.round(rawMaxIndex);\\n+  const maxIndex = Math.abs(rawMaxIndex - nearestMaxIndex) \\u003c= Number.EPSILON * Math.max(1, Math.abs(rawMaxIndex)) * 8\\n+    ? nearestMaxIndex\\n+    : Math.floor(rawMaxIndex);\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n✅ Addressed in [`9307965`](https://github.com/21nCo/super-functions/commit/93079657b6d79970339f92d9a8f47a085a7364c7)\",\"commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"created_at\":\"2026-08-22T06:09:40Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835351186\",\"id\":3835351186,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"original_line\":45,\"path\":\"uifn/core/src/algorithms/range.ts\",\"updated_at\":\"2026-08-22T06:51:40Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=b2dd4bca-b048-433a-ae26-2a170bf678ca --\\u003e\\n\\u003c!-- cubic:review-run=c3096435-6aa1-4235-8388-39d72d0f9ba1 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":6} --\\u003e\\nP2: For values with no exact normalized substring match, the new collation fallback segments the whole value and, for each starting grapheme, tries up to queryLength±8 slice lengths with an array slice+join+`collator.compare` per attempt. This is an O(n) segmentation plus O(n·span) comparison scan per call — a regression from the previous single regex pass. I measured ~48–93ms to reject a single 50k-char non-matching value. Consider bounding the scan (e.g. limit value segments examined or bail out after a cap) so filtering large lists stays within the old single-pass cost when there is no match.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At uifn/core/src/algorithms/locale.ts, line 56:\\n\\n\\u003ccomment\\u003eFor values with no exact normalized substring match, the new collation fallback segments the whole value and, for each starting grapheme, tries up to queryLength±8 slice lengths with an array slice+join+`collator.compare` per attempt. This is an O(n) segmentation plus O(n·span) comparison scan per call — a regression from the previous single regex pass. I measured ~48–93ms to reject a single 50k-char non-matching value. Consider bounding the scan (e.g. limit value segments examined or bail out after a cap) so filtering large lists stays within the old single-pass cost when there is no match.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -10,22 +10,53 @@ export interface LocaleMatcher {\\n+      if (queryLength \\u003e MAX_COLLATION_QUERY_SEGMENTS) return false;\\n+      const valueSegments = segments(value);\\n+      const queryInitial = initial(query);\\n+      for (let start = 0; start \\u003c valueSegments.length; start += 1) {\\n+        if (matchesAt(valueSegments, query, queryLength, queryInitial, start)) return true;\\n+      }\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\",\"commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"created_at\":\"2026-08-22T06:09:40Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835351187\",\"id\":3835351187,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"original_line\":56,\"path\":\"uifn/core/src/algorithms/locale.ts\",\"updated_at\":\"2026-08-22T06:09:40Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=f7fad762-90ce-4279-976f-7a22e05a533c --\\u003e\\n\\u003c!-- cubic:review-run=c3096435-6aa1-4235-8388-39d72d0f9ba1 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":6} --\\u003e\\nP2: Tenant isolation in listSyncJobs is silently skipped when mapped.tenantId is undefined. `identity()` validates only `mapped.userId?.trim()`, so a mapper that omits tenantId passes, and `tenantId: mapped.tenantId` is dropped by `toWhereClauses` (it skips undefined values), returning that owner's sync jobs across all tenants. The get/mutation paths enforce the owner/tenant boundary on the fetched record, so the list path is the only one that weakens the boundary. Require a non-empty tenantId in `identity()` when tenant boundary is expected, or reject the query when it is missing.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At plugfn/admin/src/domain-service.ts, line 273:\\n\\n\\u003ccomment\\u003eTenant isolation in listSyncJobs is silently skipped when mapped.tenantId is undefined. `identity()` validates only `mapped.userId?.trim()`, so a mapper that omits tenantId passes, and `tenantId: mapped.tenantId` is dropped by `toWhereClauses` (it skips undefined values), returning that owner's sync jobs across all tenants. The get/mutation paths enforce the owner/tenant boundary on the fetched record, so the list path is the only one that weakens the boundary. Require a non-empty tenantId in `identity()` when tenant boundary is expected, or reject the query when it is missing.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -259,16 +260,32 @@ export function createPlugFnDomainAdminService(options: PlugFnDomainAdminService\\n+        {\\n+          ownerKind: owner.kind,\\n+          ownerId,\\n+          tenantId: mapped.tenantId,\\n+          provider: input.provider,\\n+          connectionId: input.connectionId,\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n✅ Addressed in [`9307965`](https://github.com/21nCo/super-functions/commit/93079657b6d79970339f92d9a8f47a085a7364c7)\",\"commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"created_at\":\"2026-08-22T06:09:40Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835351188\",\"id\":3835351188,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"original_line\":273,\"path\":\"plugfn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T06:51:38Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=6a957950-5144-4aa7-95d6-d64e1201c840 --\\u003e\\n\\u003c!-- cubic:review-run=c3096435-6aa1-4235-8388-39d72d0f9ba1 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":8} --\\u003e\\nP2: The `usage` resource metadata advertises `updatedAt` in both `displayFields` and `sortableFields`, but the usage rows returned by `listUsage`/`getUsage` come from `BillFnUsageResponseData.usage`, whose entries only have `resource`, `current`, and `limit` (no `updatedAt`). In Super Console this renders an empty column and makes sorting by `updatedAt` a no-op that falls back to id ordering. Use a field that exists on the usage entries, e.g. `current` or `limit`, or drop `updatedAt` from both lists.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At billfn/admin/src/index.ts, line 183:\\n\\n\\u003ccomment\\u003eThe `usage` resource metadata advertises `updatedAt` in both `displayFields` and `sortableFields`, but the usage rows returned by `listUsage`/`getUsage` come from `BillFnUsageResponseData.usage`, whose entries only have `resource`, `current`, and `limit` (no `updatedAt`). In Super Console this renders an empty column and makes sorting by `updatedAt` a no-op that falls back to id ordering. Use a field that exists on the usage entries, e.g. `current` or `limit`, or drop `updatedAt` from both lists.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -180,10 +180,10 @@ export const billFnAdminResources = [\\n-    searchableFields: [\\\"id\\\", \\\"name\\\", \\\"status\\\"],\\n-    filterableFields: [\\\"status\\\", \\\"createdAt\\\", \\\"updatedAt\\\"],\\n-    sortableFields: [\\\"createdAt\\\", \\\"updatedAt\\\", \\\"name\\\"],\\n+    displayFields: [\\\"id\\\", \\\"resource\\\", \\\"current\\\", \\\"updatedAt\\\"],\\n+    searchableFields: [\\\"id\\\", \\\"resource\\\"],\\n+    filterableFields: [\\\"resource\\\"],\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n```suggestion\\ndisplayFields: [\\\"id\\\", \\\"resource\\\", \\\"current\\\", \\\"limit\\\"],\\n```\\n\\n✅ Addressed in [`9307965`](https://github.com/21nCo/super-functions/commit/93079657b6d79970339f92d9a8f47a085a7364c7)\",\"commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"created_at\":\"2026-08-22T06:09:40Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835351191\",\"id\":3835351191,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"original_line\":183,\"path\":\"billfn/admin/src/index.ts\",\"updated_at\":\"2026-08-22T06:51:36Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=df717917-3f8e-4754-9c91-29f62a494553 --\\u003e\\n\\u003c!-- cubic:review-run=c3096435-6aa1-4235-8388-39d72d0f9ba1 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":8} --\\u003e\\nP3: The test named \\\"filters sync-job lists by tenant as well as owner\\\" never exercises the owner filter: both created jobs belong to userId \\\"user_1\\\" and differ only in tenantId, and the setup identity maps to user_1. The test only proves tenant filtering, so the \\\"as well as owner\\\" claim overstates coverage and would not catch a regression that drops the ownerId filter from listSyncJobs. Add a job owned by a different userId/ownerId and assert it is excluded, or rename the test to reflect that only tenant filtering is covered.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At plugfn/admin/src/__tests__/admin.test.ts, line 184:\\n\\n\\u003ccomment\\u003eThe test named \\\"filters sync-job lists by tenant as well as owner\\\" never exercises the owner filter: both created jobs belong to userId \\\"user_1\\\" and differ only in tenantId, and the setup identity maps to user_1. The test only proves tenant filtering, so the \\\"as well as owner\\\" claim overstates coverage and would not catch a regression that drops the ownerId filter from listSyncJobs. Add a job owned by a different userId/ownerId and assert it is excluded, or rename the test to reflect that only tenant filtering is covered.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -168,6 +174,26 @@ describe(\\\"@plugfn/admin\\\", () =\\u003e {\\n+    expect(listJobs).toHaveBeenLastCalledWith(expect.any(Object), 101, forgedOffset);\\n+  });\\n+\\n+  it(\\\"filters sync-job lists by tenant as well as owner\\\", async () =\\u003e {\\n+    const { adapter, runtime } = setup();\\n+    const owned = await runtime.runtime.sync.createJob({\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n✅ Addressed in [`9307965`](https://github.com/21nCo/super-functions/commit/93079657b6d79970339f92d9a8f47a085a7364c7)\",\"commit_id\":\"16a31f15e61f1ab95930f35bab2999aa40e9901a\",\"created_at\":\"2026-08-22T06:09:40Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835351194\",\"id\":3835351194,\"in_reply_to_id\":null,\"line\":281,\"original_commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"original_line\":184,\"path\":\"plugfn/admin/src/__tests__/admin.test.ts\",\"updated_at\":\"2026-08-22T06:51:42Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=1f1e4755-a5ff-42ed-872f-8b856c405bdc --\\u003e\\n\\u003c!-- cubic:review-run=c3096435-6aa1-4235-8388-39d72d0f9ba1 --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":9} --\\u003e\\nP3: The schema now returns version 7, but the package metadata still advertises version 6, so consumers discovering PlugFn through package metadata receive a stale schema version. Update `plugfn/core/package.json` to 7 with this schema bump.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At plugfn/core/src/schema.ts, line 10:\\n\\n\\u003ccomment\\u003eThe schema now returns version 7, but the package metadata still advertises version 6, so consumers discovering PlugFn through package metadata receive a stale schema version. Update `plugfn/core/package.json` to 7 with this schema bump.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -5,10 +5,9 @@ import {\\n-export const PLUGFN_SCHEMA_VERSION = 6;\\n+// Version 7 persists sync-job tenant identity so administrative list queries can\\n+// enforce the same tenant boundary as connection-scoped get and mutation paths.\\n+export const PLUGFN_SCHEMA_VERSION = 7;\\n \\n export interface PlugFnSchemaOptions {\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n✅ Addressed in [`9307965`](https://github.com/21nCo/super-functions/commit/93079657b6d79970339f92d9a8f47a085a7364c7)\",\"commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"created_at\":\"2026-08-22T06:09:40Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835351195\",\"id\":3835351195,\"in_reply_to_id\":null,\"line\":12,\"original_commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"original_line\":10,\"path\":\"plugfn/core/src/schema.ts\",\"updated_at\":\"2026-08-22T06:51:44Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"Addressed in 9307965 by removing the sync-job schema change and deriving tenant ownership from the associated connection.\\n\\n\\u003c!-- PULLFROG_DIVIDER_DO_NOT_REMOVE_PLZ --\\u003e\\n\\u003csup\\u003e\\u003ca href=\\\"https://pullfrog.com\\\"\\u003e\\u003cpicture\\u003e\\u003csource media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://pullfrog.com/logos/frog-white-full-18px.png\\\"\\u003e\\u003cimg src=\\\"https://pullfrog.com/logos/frog-green-full-18px.png\\\" width=\\\"9px\\\" height=\\\"9px\\\" style=\\\"vertical-align: middle; \\\" alt=\\\"Pullfrog\\\"\\u003e\\u003c/picture\\u003e\\u003c/a\\u003e\\u0026nbsp;\\u0026nbsp;｜ [View workflow run](https://github.com/21nCo/super-functions/actions/runs/32557933930/job/96994981904) ｜ via [Pullfrog](https://pullfrog.com) ｜ Using `GPT Sol` ｜ [𝕏](https://x.com/pullfrogai)\\u003c/sup\\u003e\",\"commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"created_at\":\"2026-08-22T06:53:06Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835441780\",\"id\":3835441780,\"in_reply_to_id\":3835350201,\"line\":null,\"original_commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"original_line\":228,\"path\":\"plugfn/core/src/schema.ts\",\"updated_at\":\"2026-08-22T06:53:06Z\",\"user\":\"pullfrog[bot]\"}\n{\"body\":\"Addressed in 9307965 by adding `id` as the deterministic secondary sort key and covering the storage query.\\n\\n\\u003c!-- PULLFROG_DIVIDER_DO_NOT_REMOVE_PLZ --\\u003e\\n\\u003csup\\u003e\\u003ca href=\\\"https://pullfrog.com\\\"\\u003e\\u003cpicture\\u003e\\u003csource media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://pullfrog.com/logos/frog-white-full-18px.png\\\"\\u003e\\u003cimg src=\\\"https://pullfrog.com/logos/frog-green-full-18px.png\\\" width=\\\"9px\\\" height=\\\"9px\\\" style=\\\"vertical-align: middle; \\\" alt=\\\"Pullfrog\\\"\\u003e\\u003c/picture\\u003e\\u003c/a\\u003e\\u0026nbsp;\\u0026nbsp;｜ [View workflow run](https://github.com/21nCo/super-functions/actions/runs/32557933930/job/96994981904) ｜ via [Pullfrog](https://pullfrog.com) ｜ Using `GPT Sol` ｜ [𝕏](https://x.com/pullfrogai)\\u003c/sup\\u003e\",\"commit_id\":\"16a31f15e61f1ab95930f35bab2999aa40e9901a\",\"created_at\":\"2026-08-22T06:53:14Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835442052\",\"id\":3835442052,\"in_reply_to_id\":3835350203,\"line\":667,\"original_commit_id\":\"e1f368ac354ce6fec024eca61b2c723c9f4d04ab\",\"original_line\":667,\"path\":\"plugfn/core/src/storage/adapters/database.ts\",\"updated_at\":\"2026-08-22T06:53:14Z\",\"user\":\"pullfrog[bot]\"}\n{\"body\":\"**\\u003csub\\u003e\\u003csub\\u003e![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)\\u003c/sub\\u003e\\u003c/sub\\u003e  Tenant-scope workflow ownership checks**\\n\\nWhen separate tenants map to the same `userId`, this predicate treats either tenant's workflow as owned because it ignores `mapped.tenantId`; `listWorkflows` likewise filters storage only by `userId`. Consequently the new admin surface can expose foreign workflow metadata and allows `getWorkflowStats`, enable, disable, or delete operations against the other tenant's workflow. Persist and validate a tenant identifier for workflows, or reject workflows whose tenant cannot be established.\\n\\nUseful? React with 👍 / 👎.\",\"commit_id\":\"e3800bea453a3e7e5f3db105e18501b25cc850db\",\"created_at\":\"2026-08-22T06:54:29Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835445394\",\"id\":3835445394,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"e3800bea453a3e7e5f3db105e18501b25cc850db\",\"original_line\":125,\"path\":\"plugfn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T06:54:29Z\",\"user\":\"chatgpt-codex-connector[bot]\"}\n{\"body\":\"**\\u003csub\\u003e\\u003csub\\u003e![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)\\u003c/sub\\u003e\\u003c/sub\\u003e  Reject tenant-unverifiable webhook receipts**\\n\\nFor a legacy receipt without `connectionId`, this fallback authorizes solely by `ownerKind` and `ownerId`, even though the active identity is tenant-scoped and the receipt carries no tenant field. If user or organization IDs overlap across tenants, knowing a foreign receipt ID lets an operator read its receipt metadata and list its delivery status and errors. Require a tenant-verifiable connection or other tenant-bound provenance instead of accepting the legacy owner match.\\n\\nUseful? React with 👍 / 👎.\",\"commit_id\":\"e3800bea453a3e7e5f3db105e18501b25cc850db\",\"created_at\":\"2026-08-22T06:54:29Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835445399\",\"id\":3835445399,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"e3800bea453a3e7e5f3db105e18501b25cc850db\",\"original_line\":199,\"path\":\"plugfn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T06:54:29Z\",\"user\":\"chatgpt-codex-connector[bot]\"}\n{\"body\":\"Tenant isolation now happens after paging owner-scoped jobs, and this loop has no scan budget. If a user has a large history in other tenants, one request can walk the entire history and execute one `connections.get()` lookup per rejected job before returning an empty or partial page.\\n\\n\\u003cdetails\\u003e\\u003csummary\\u003eTechnical details\\u003c/summary\\u003e\\n\\n````markdown\\n# Tenant filtering creates unbounded N+1 paging work\\n\\n## Affected sites\\n- `plugfn/admin/src/domain-service.ts:307-319` — repeatedly fetches owner-scoped pages until enough connection-authorized jobs are found.\\n- `plugfn/admin/src/domain-service.ts:108-120` — performs a separate connection lookup for every scanned job.\\n- `plugfn/core/src/core/connection-manager.ts:340-345` — each lookup reaches persisted connection storage.\\n\\n## Required outcome\\n- A sync-job list request must have a fixed upper bound on storage queries and scanned rows while preserving tenant isolation and a resumable cursor.\\n\\n## Suggested approach\\n- Apply a storage-level tenant-verifiable predicate, or return a continuation cursor after a bounded scan rather than exhausting all rejected rows in one request.\\n````\\n\\n\\u003c/details\\u003e\",\"commit_id\":\"93079657b6d79970339f92d9a8f47a085a7364c7\",\"created_at\":\"2026-08-22T06:54:58Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835446480\",\"id\":3835446480,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"93079657b6d79970339f92d9a8f47a085a7364c7\",\"original_line\":308,\"path\":\"plugfn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T06:54:59Z\",\"user\":\"pullfrog[bot]\"}\n{\"body\":\"`HEAD` is normalized for registry matching here, but `operationInput()` still branches on the original method and treats `HEAD` as body-bearing. A valid GET route with required query input, such as DataFn records, loses its query parameters and returns a validation error instead of GET-equivalent status and headers.\\n\\n\\u003cdetails\\u003e\\u003csummary\\u003eTechnical details\\u003c/summary\\u003e\\n\\n````markdown\\n# HEAD route normalization does not reach input extraction\\n\\n## Affected sites\\n- `superconsole/src/lib/server/super-console.ts:1197-1217` — matches the GET entry but passes the original HEAD request into input extraction.\\n- `superconsole/src/lib/server/super-console.ts:489-507` — parses query parameters only for GET and DELETE.\\n- `datafn/admin/src/index.ts:473-486` — the records GET route requires a query-supplied `filter` object.\\n\\n## Required outcome\\n- Resource HEAD requests must parse the same path and query input as their corresponding GET request before suppressing the response body.\\n````\\n\\n\\u003c/details\\u003e\",\"commit_id\":\"16a31f15e61f1ab95930f35bab2999aa40e9901a\",\"created_at\":\"2026-08-22T06:54:58Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835446486\",\"id\":3835446486,\"in_reply_to_id\":null,\"line\":1269,\"original_commit_id\":\"93079657b6d79970339f92d9a8f47a085a7364c7\",\"original_line\":1197,\"path\":\"superconsole/src/lib/server/super-console.ts\",\"updated_at\":\"2026-08-22T06:54:59Z\",\"user\":\"pullfrog[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=a238fafc-c82a-46ed-8916-a4de300b7b61 --\\u003e\\n\\u003c!-- cubic:review-run=293bf4ea-051a-4cb6-a17e-41f23ab3583f --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":9} --\\u003e\\nP2: When a DataFn resource has a `recordId` field, these projections replace that field with the row's own ID. The built-in `publicLink` resource has exactly this field, so admin list/get responses report the wrong target record; reserve the synthetic identity field or preserve user fields under a non-colliding name.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At datafn/admin/src/domain-service.ts, line 232:\\n\\n\\u003ccomment\\u003eWhen a DataFn resource has a `recordId` field, these projections replace that field with the row's own ID. The built-in `publicLink` resource has exactly this field, so admin list/get responses report the wrong target record; reserve the synthetic identity field or preserve user fields under a non-colliding name.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -219,7 +223,16 @@ export function createDataFnDomainAdminService\\u003cTContext\\u003e(\\n+            if (typeof recordId !== \\\"string\\\" \\u0026\\u0026 typeof recordId !== \\\"number\\\") {\\n+              throw new AdminError(\\\"dependency_unavailable\\\", \\\"DataFn returned a record without a usable id.\\\");\\n+            }\\n+            return { ...value, recordId, id: `${target}:${recordId}` };\\n+          }),\\n+          nextCursor,\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n✅ Addressed in [`21fbc39`](https://github.com/21nCo/super-functions/commit/21fbc394a2a628e7fb5933c0a418b6f0766154e4)\",\"commit_id\":\"e3800bea453a3e7e5f3db105e18501b25cc850db\",\"created_at\":\"2026-08-22T07:07:58Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835481669\",\"id\":3835481669,\"in_reply_to_id\":null,\"line\":null,\"original_commit_id\":\"e3800bea453a3e7e5f3db105e18501b25cc850db\",\"original_line\":232,\"path\":\"datafn/admin/src/domain-service.ts\",\"updated_at\":\"2026-08-22T07:34:05Z\",\"user\":\"cubic-dev-ai[bot]\"}\n{\"body\":\"\\u003c!-- cubic:v=cecd96d5-fea9-47e6-9ef9-343acdb10224 --\\u003e\\n\\u003c!-- cubic:review-run=293bf4ea-051a-4cb6-a17e-41f23ab3583f --\\u003e\\n\\u003c!-- metadata:{\\\"confidence\\\":8} --\\u003e\\nP2: HEAD requests are now routed to GET read operations (via routeMethod), but operationInput only treats request.method === 'GET' (or 'DELETE') as a query-parameter request. For a HEAD request it falls into the else branch and reads the empty body, so all query parameters are dropped and a HEAD to an operation that requires query params, or that should filter by them, dispatches with an empty input (returning 400 instead of 200, or executing unfiltered). Normalize HEAD in operationInput (e.g. treat 'HEAD' like 'GET') so HEAD mirrors GET.\\n\\n\\u003cdetails\\u003e\\n\\u003csummary\\u003ePrompt for AI agents\\u003c/summary\\u003e\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At superconsole/src/lib/server/super-console.ts, line 1197:\\n\\n\\u003ccomment\\u003eHEAD requests are now routed to GET read operations (via routeMethod), but operationInput only treats request.method === 'GET' (or 'DELETE') as a query-parameter request. For a HEAD request it falls into the else branch and reads the empty body, so all query parameters are dropped and a HEAD to an operation that requires query params, or that should filter by them, dispatches with an empty input (returning 400 instead of 200, or executing unfiltered). Normalize HEAD in operationInput (e.g. treat 'HEAD' like 'GET') so HEAD mirrors GET.\\u003c/comment\\u003e\\n\\n\\u003cfile context\\u003e\\n@@ -1194,9 +1194,10 @@ export class SuperConsole {\\n       ? `${this.registry.apiBasePath}/modules/${encodeURIComponent(moduleId)}/resources/${rest.join('/')}`\\n       : undefined;\\n-    let entry = this.registry.matchRoute(request.method, matchedPath);\\n+    const routeMethod = request.method === 'HEAD' ? 'GET' : request.method;\\n+    let entry = this.registry.matchRoute(routeMethod, matchedPath);\\n     if (!entry \\u0026\\u0026 resourceAliasPath) {\\n\\u003c/file context\\u003e\\n```\\n\\n\\u003c/details\\u003e\\n\\n✅ Addressed in [`21fbc39`](https://github.com/21nCo/super-functions/commit/21fbc394a2a628e7fb5933c0a418b6f0766154e4)\",\"commit_id\":\"16a31f15e61f1ab95930f35bab2999aa40e9901a\",\"created_at\":\"2026-08-22T07:07:58Z\",\"html_url\":\"https://github.com/21nCo/super-functions/pull/116#discussion_r3835481670\",\"id\":3835481670,\"in_reply_to_id\":null,\"line\":1269,\"original_commit_id\":\"e3800bea453a3e7e5f3db105e18501b25cc850db\",\"original_line\":1197,\"path\":\"superconsole/src/lib/server/super-console.