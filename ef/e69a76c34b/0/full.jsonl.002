vailable\");\n+    await expect(operator.deleteVariable(scope, variable.id)).resolves.toEqual(variable);\n+    expect(providerDeletes).toBe(2);\n     await expect(store.listVariables(scope)).resolves.toEqual([]);\n","move_path":null}},"status":"completed","stdout":"Success. Updated the following files:\nM /Users/serro/Documents/dev/n/superfunctions-dev/hostfn/cli/src/__tests__/operator.test.ts\n","stderr":""},"started_at_ms":1787470535202,"completed_at_ms":1787470535203}}
