jected into the authenticated session. A single-cookie fallback supports\\n    57\\t * sign-in bootstrap without inferring anything from HTTP-only session cookies.\\n    58\\t */\\n    59\\texport function operatorCsrfToken(\\n    60\\t  cookieHeader = readableCookies(),\\n    61\\t  cookieName = operatorCsrfCookieName\\n    62\\t): string | undefined {\\n    63\\t  if (!cookieHeader) return undefined;\\n    64\\t  const candidates: Array<{ name: string; value: string }> = [];\\n    65\\t  for (const part of cookieHeader.split(';')) {\\n    66\\t    const [rawName, ...rawValue] = part.trim().split('=');\\n    67\\t    if (cookieName ? rawName !== cookieName : !rawName.endsWith('.csrf')) continue;\\n    68\\t    const encoded = rawValue.join('=');\\n    69\\t    try {\\n    70\\t      candidates.push({ name: rawName, value: decodeURIComponent(encoded) });\\n    71\\t    } catch {\\n    72\\t      candidates.push({ name: rawName, value: encoded });\\n    73\\t    }\\n    74\\t  }\\n    75\\t  if (cookieName) return candidates[0]?.value;\\n    76\\t  return candidates.length === 1 ? candidates[0]?.value : undefined;\\n    77\\t}\\n    78\\t\\n    79\\t/** Same-origin console transport with provider-defined CSRF propagation for mutations. */\\n    80\\texport async function fetchConsole(\\n    81\\t  input: RequestInfo | URL,\\n    82\\t  init: RequestInit = {},\\n    83\\t  fetcher: AdminFetch = globalThis.fetch\\n    84\\t): Promise<Response> {\\n    85\\t  const headers = new Headers(init.headers);\\n    86\\t  const method = (init.method ?? 'GET').toUpperCase();\\n    87\\t  if (!SAFE_HTTP_METHODS.has(method) && !headers.has(operatorCsrfHeaderName)) {\\n    88\\t    const token = operatorCsrfToken();\\n    89\\t    if (token) headers.set(operatorCsrfHeaderName, token);\\n    90\\t  }\\n    91\\t  return fetcher(input, {\\n    92\\t    ...init,\\n    93\\t    method,\\n    94\\t    headers,\\n    95\\t    credentials: 'same-origin',\\n    96\\t  });\\n    97\\t}\\n    98\\t\\n    99\\texport type AdminApiResult<T> =\\n   100\\t  | {\\n   101\\t      ok: true;\\n   102\\t      data: T;\\n   103\\t      requestId?: string;\\n   104\\t      correlationId?: string;\\n   105\\t      auditId?: string;\\n   106\\t      page?: { nextCursor?: string | null; hasMore?: boolean };\\n   107\\t      warnings?: readonly string[];\\n   108\\t      meta?: Readonly<Record<string, unknown>>;\\n   109\\t    }\\n   110\\t  | { ok: false; error: AdminErrorViewModel };\\n   111\\t\\n   112\\texport function withAdminScope(path: string, scope?: URLSearchParams): string {\\n   113\\t  if (!scope) return path;\\n   114\\t  const url = new URL(path, 'http://superconsole.local');\\n   115\\t  const explicitBoundary = ADMIN_SCOPE_HIERARCHY.findIndex(({ aliases }) =>\\n   116\\t    aliases.some((alias) => url.searchParams.has(alias))\\n   117\\t  );\\n   118\\t  for (const [index, { key, aliases }] of ADMIN_SCOPE_HIERARCHY.entries()) {\\n   119\\t    if (aliases.some((alias) => url.searchParams.has(alias))) continue;\\n   120\\t    if (explicitBoundary >= 0 && index > explicitBoundary) continue;\\n   121\\t    const value = aliases.map((alias) => scope.get(alias)).find(Boolean);\\n   122\\t    if (value) url.searchParams.set(key, value);\\n   123\\t  }\\n   124\\t  if (explicitBoundary < 0) {\\n   125\\t    for (const key of ['namespace', 'region'] as const) {\\n   126\\t      if (url.searchParams.has(key)) continue;\\n   127\\t      const value = scope.get(key);\\n   128\\t      if (value) url.searchParams.set(key, value);\\n   129\\t    }\\n   130\\t  }\\n   131\\t  return `${url.pathname}${url.search}${url.hash}`;\\n   132\\t}\\n   133\\t\\n   134\\texport function scopedConsoleHref(path: string, current: URLSearchParams): string {\\n   135\\t  return withAdminScope(path, current);\\n   136\\t}\\n   137\\t\\n   138\\texport function switchAdminContextHref(\\n   139\\t  href: string,\\n   140\\t  level: 'organization' | 'workspace' | 'project' | 'environment',\\n   141\\t  value: string\\n   142\\t): string {\\n   143\\t  const url = new URL(href, 'http://superconsole.local');\\n   144\\t  const hierarchy = ['organization', 'workspace', 'project', 'environment'] as const;\\n   145\\t  if (level === 'organization') {\\n   146\\t    for (const alias of ADMIN_SCOPE_HIERARCHY[0].aliases) url.searchParams.delete(alias);\\n   147\\t    url.searchParams.set('installationId', value);\\n   148\\t  } else {\\n   149\\t    url.searchParams.set(`${level}Id`, value);\\n   150\\t    url.searchParams.delete(level);\\n   151\\t  }\\n   152\\t  for (const dependent of hierarchy.slice(hierarchy.indexOf(level) + 1)) {\\n   153\\t    url.searchParams.delete(`${dependent}Id`);\\n   154\\t    url.searchParams.delete(dependent);\\n   155\\t  }\\n   156\\t  url.searchParams.delete('namespace');\\n   157\\t  url.searchParams.delete('region');\\n   158\\t  return `${url.pathname}${url.search}${url.hash}`;\\n   159\\t}\\n   160\\t\\n   161\\t/** Accept only credential-free, same-origin destinations for console navigation. */\\n   162\\texport function safeConsoleNavigationHref(\\n   163\\t  href: string | undefined,\\n   164\\t  origin = 'http://superconsole.local'\\n   165\\t): string | undefined {\\n   166\\t  if (!href) return undefined;\\n   167\\t  let candidate: URL;\\n   168\\t  try {\\n   169\\t    candidate = new URL(href, origin);\\n   170\\t  } catch {\\n   171\\t    return undefined;\\n   172\\t  }\\n   173\\t  if (candidate.username || candidate.password) return undefined;\\n   174\\t  if (candidate.origin !== new URL(origin).origin) return undefined;\\n   175\\t  if (!['http:', 'https:'].includes(candidate.protocol)) return undefined;\\n   176\\t  if (!CONSOLE_NAVIGATION_PATH.test(candidate.pathname)) return undefined;\\n   177\\t  return `${candidate.pathname}${candidate.search}${candidate.hash}`;\\n   178\\t}\\n   179\\t\\n   180\\t/** Materialize declared route parameters without guessing resource identity names. */\\n\"}"}],