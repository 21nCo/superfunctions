ame, policy);\\n   353\\t    },\\n   354\\t\\n   355\\t    getSchema() {\\n   245\\t  }\\n   246\\t\\n   247\\t  async function getBoundArtifact(fileId: string, artifactId: string): Promise<FileArtifactRecord> {\\n   248\\t    const artifact = await db.findOne<FileArtifactRecord>({\\n   249\\t      model: 'fileArtifacts',\\n   250\\t      where: [{ field: 'artifactId', operator: 'eq', value: artifactId }],\\n   251\\t      namespace,\\n   252\\t    });\\n   253\\t\\n   254\\t    if (!artifact) {\\n   255\\t      throw errors.notFound('Artifact');\\n   256\\t    }\\n   257\\t\\n   258\\t    if (artifact.fileId !== fileId) {\\n   259\\t      throw errors.notFound('Artifact');\\n   260\\t    }\\n   261\\t\\n   262\\t    return artifact;\\n   263\\t  }\\n   264\\t\\n   265\\t  return {\\n   266\\t    isEnabled(): boolean {\\n   267\\t      return enabled && processors.length > 0;\\n   268\\t    },\\n   269\\t\\n   270\\t    async triggerProcessing(\\n   271\\t      input: {\\n   272\\t        fileId: string;\\n   273\\t        versionId: string;\\n   274\\t        storageKey: string;\\n   275\\t        mimeType: string;\\n   276\\t        size: number;\\n   277\\t        fileName: string;\\n   278\\t        tenantId?: string;\\n   279\\t      },\\n   280\\t      ctx: FileProviderContext\\n   281\\t    ): Promise<{ enqueued: boolean; jobId?: string }> {\\n   282\\t      if (!enabled || processors.length === 0) {\\n   283\\t        return { enqueued: false };\\n   284\\t      }\\n   285\\t\\n   286\\t      events.emit('processing.started' as any, {\\n   287\\t        type: 'processing.started',\\n   288\\t        timestamp: new Date().toISOString(),\\n   289\\t        requestId: ctx.requestId,\\n   290\\t        fileId: input.fileId,\\n   291\\t        versionId: input.versionId,\\n   292\\t      });\\n   293\\t\\n   294\\t      if (flowFn) {\\n   295\\t        const queue = flowFn.getQueue(QUEUE_NAME);\\n   296\\t        if (queue) {\\n   297\\t          try {\\n   298\\