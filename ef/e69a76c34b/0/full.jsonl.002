  expect(body.data.artifacts.map((artifact: any) => artifact.kind)).toEqual([\n   276\t      'pdf-preview-page-1-small',\n   277\t      'thumbnail-small',\n   278\t    ]);\n   279\t  });\n   280\t\n   281\t  it('exposes only authorization-safe processing methods from the public service facade', () => {\n   282\t    expect(fileFn.services.processing).not.toHaveProperty('listArtifacts');\n   283\t    expect(fileFn.services.processing).not.toHaveProperty('runProcessing');\n   284\t    expect(fileFn.services.processing).not.toHaveProperty('triggerProcessing');\n   285\t    expect(fileFn.services.processing).toHaveProperty('listArtifactsForFile');\n   286\t  });\n   287\t\n   288\t  it('TV-PROCESS-002: PDF preview artifact descriptors should stay on HTTP proxy routes', async () => {\n   289\t    const res = await fileFn.router.handle(\n   290\t      new Request('http://localhost/file_0002/artifacts/art_pdf_0001/download', { method: 'GET' }),\n   291\t    );\n   292\t    const body = await res!.json();\n   293\t\n   294\t    expect(body.ok).toBe(true);\n   295\t    expect(body.data.url).toMatch(/^\\/proxy\\/files\\/file_0002\\/artifacts\\/art_pdf_0001\\/download$/);\n   296\t    expect(body.data.url).not.toMatch(/^proxy:\\/\\//);\n   297\t  });\n   298\t\n   299\t  it('TV-PROCESS-002: PDF preview artifact proxy routes should stream image bytes', async () => {\n   300\t    const descriptorRes = await fileFn.router.handle(\n   301\t      new Request('http://localhost/file_0002/artifacts/art_pdf_0001/download', { method: 'GET' }),\n   302\t    );\n   303\t    const descriptorBody = await descriptorRes!.json();\n   304\t\n   305\t    const proxyRes = await fileFn.router.handle(\n   365\t          proxyStreamingDownload: true,\n   366\t        },\n   367\t      }),\n   368\t      policies: [{ name: 'user-avatar', contentTypes: ['image/png'], maxSizeBytes: 1024 * 1024 }],\n   369\t      auth: {\n   370\t        required: true,\n   371\t        resolveSession: async () => null,\n   372\t      },\n   373\t    });\n   374\t\n   375\t    const res = await authRequiredFileFn.router.handle(\n   376\t      new Request('http://localhost/file_0002/artifacts', { method: 'GET' }),\n   377\t    );\n   378\t    const body = await res!.json();\n   379\t\n   380\t    expect(res!.status).toBe(401);\n   381\t    expect(body.error.code).toBe('FILEFN_AUTH_REQUIRED');\n   382\t  });\n   383\t\n   384\t  it('TV-PROCESS-TRIGGER-001: triggerProcessing uses the stored current version when versionId is omitted', async () => {\n   385\t    const storage = createFakeStorageAdapter({\n   386\t      capabilities: {\n   387\t        signedUploadUrls: true,\n   388\t        signedDownloadUrls: false,\n   389\t        multipart: true,\n   390\t        proxyStreamingUpload: true,\n   391\t        proxyStreamingDownload: true,\n   392\t      },\n   393\t    });\n   394\t\n   395\t    const events: any[] = [];\n   396\t    const fileFnWithProcessing = createFileFn({\n   397\t      database: db,\n   398\t      storage,\n   399\t      policies: [{ name: 'user-avatar', contentTypes: ['image/png'], maxSizeBytes: 1024 * 1024 }],\n   400\t      auth: {\n   401\t        required: false,\n   402\t        resolveSession: async () => ({ principalId: 'user_123', tenantId: 'org_123' }),\n   403\t      },\n   404\t      processing: {\n   405\t        enabled: true,\n   406\t        processors: [{\n   407\t          name: 'test-processor',\n   408\t          supportedMimeTypes: ['image/png'],\n   409\t          process: async (input: any) => {\n   410\t            events.push(input);\n      checksumSha256Base64: null,\n      createdAt: \"2026-08-13T00:00:00.000Z\",\n    }));\n    const service = domain({ files: { getVersion } });\n    const result = await createFileFnAdminAdapter(service).execute(\n      \"filefn.versions.get\",\n      { fileId: \"file_1\", id: \"version_1\" },\n      context,\n    );\n\n    expect(result.data).toMatchObject({ item: { fileId: \"file_1\", versionId: \"version_1\" } });\n    expect((result.data as { item: object }).item).not.toHaveProperty(\"storageKey\");\n  });\n\n  it(\"preserves header-free provider download receipts and rejects provider header contracts\", async () => {\n    const getDownloadUrl = vi.fn(async () => ({\n      url: \"https://storage.example.test/signed-object?signature=opaque\",\n    }));\n    const registry = createAdminRegistry({\n      adapters: [createFileFnAdminAdapter(domain({ files: { getDownloadUrl } }))],\n      enabledModules: [\"filefn\"],\n    });\n    const result = await createAdminDispatcher({\n      registry,\n      audit: new MemoryAdminAuditSink(),\n    }).dispatch({\n      operationId: \"filefn.files.download\",\n      input: { id: \"file_1\" },\n      context,\n    });\n\n    expect(result).toMatchObject({\n      ok: true,\n      data: {\n        item: {\n          url: \"https://storage.example.test/signed-object?signature=opaque\",\n        },\n      },\n    });\n\n    const secretHeaderRegistry = createAdminRegistry({\n      adapters: [createFileFnAdminAdapter(domain({ files: { getDownloadUrl: async () => ({\n        url: \"https://storage.example.test/object\",\n        headers: { authorization: \"Bearer storage-token\" },\n      }) } }))],\n      enabledModules: [\"filefn\"],\n    });\n    await expect(createAdminDispatcher({\n      registry: secretHeaderRegistry,\n      audit: new MemoryAdminAuditSink(),\n    }).dispatch({\n      operationId: \"filefn.files.download\",\n      input: { id: \"file_1\" },\n      context,\n    })).resolves.toMatchObject({\n      ok: false,\n      error: {\n        code: \"dependency_unavailable\",\n        details: { unsupportedHeaders: [\"authorization\"] },\n      },\n    });\n\n    const encryptionHeaderRegistry = createAdminRegistry({\n      adapters: [createFileFnAdminAdapter(domain({ files: { getDownloadUrl: async () => ({\n        url: \"https://storage.example.test/object\",\n        headers: { \"x-goog-encryption-key\": \"base64-customer-key\" },\n      }) } }))],\n      enabledModules: [\"filefn\"],\n    });\n    await expect(createAdminDispatcher({\n      registry: encryptionHeaderRegistry,\n      audit: new MemoryAdminAuditSink(),\n    }).dispatch({\n      operationId: \"filefn.files.download\",\n      input: { id: \"file_1\" },\n      context,\n    })).resolves.toMatchObject({\n      ok: false,\n      error: {\n        code: \"dependency_unavailable\",\n        details: { unsupportedHeaders: [\"x-goog-encryption-key\"] },\n      },\n    });\n  });\n\n  it(\"pushes bounded child pagination into FileFn and binds cursors to the parent file\", async () => {\n    const versions = Array.from({ length: 3 }, (_, index) => ({\n      fileId: \"file_1\",\n      versionId: `version_${index + 1}`,\n      storageKey: `private/${index + 1}`,\n      mimeType: \"text/plain\",\n      size: index + 1,\n      checksumSha256Base64: null,\n      createdAt: `2026-08-15T00:00:0${index}.000Z`,\n    }));\n    const listVersions = vi.fn(async (_fileId, _domainContext, page) => ({\n      versions: versions.slice(page?.offset ?? 0, (page?.offset ?? 0) + (page?.limit ?? versions.length)),\n    }));\n    const service = domain({ files: { listVersions } });\n\n    const first = await service.listVersions({ fileId: \"file_1\", limit: 2 }, context);\n    expect(first.data.items).toHaveLength(2);\n    expect(first.data.nextCursor).toEqual(expect.any(String));\n    expect(listVersions).toHaveBeenCalledWith(\n      \"file_1\",\n      expect.any(Object),\n      { limit: 3, offset: 0 },\n    );\n\n    await expect(service.listVersions({ fileId: \"file_2\", limit: 2, cursor: first.data.nextCursor! }, context))\n      .rejects.toMatchObject({ code: \"invalid_argument\" });\n    const second = await service.listVersions({ fileId: \"file_1\", limit: 2, cursor: first.data.nextCursor! }, context);\n    expect(second.data).toMatchObject({ items: [{ versionId: \"version_3\" }], nextCursor: null });\n    expect(listVersions).toHaveBeenL