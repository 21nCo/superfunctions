d,\nsuperconsole/tests/server/super-console.test.ts:1064:        cancelActivation: async () => undefined,\nsuperconsole/tests/server/super-console.test.ts:1275:      confirmation: { issue: async () => ({ token: 'bound-token', expiresAt: new Date(Date.now() + 60_000).toISOString() }), prepareActivation: async () => undefined, cancelActivation: async () => undefined, activate: async () => undefined, revoke: async () => undefined, verify: async ({ token }) => token === 'bound-token' },\npackages/admin/src/types.ts:106:  mode: \"cursor\";\npackages/admin/src/types.ts:109:  cursorInput?: string;\napifn/admin/src/__tests__/admin.test.ts:57:      { limit: 1, cursor: first.data.nextCursor },\npackages/admin/src/pagination.ts:29: * Decodes the legacy encoded cursor after enforcing the embedded scope. This\npackages/admin/src/pagination.ts:30: * helper does not authenticate cursor integrity: production domain providers\npackages/admin/src/pagination.ts:31: * must issue opaque, signed cursor positions before exposing them.\npackages/admin/src/pagination.ts:33:export function decodeAdminCursor<T>(cursor: string, expectedScope: AdminScope): T {\npackages/admin/src/pagination.ts:35:    const payload = JSON.parse(fromBase64Url(cursor)) as AdminCursorPayload<T>;\npackages/admin/src/pagination.ts:41:    throw new AdminError(\"invalid_argument\", \"The pagination cursor is invalid for the active scope.\", { cause: error });\npackages/admin/src/test-fixtures.ts:39:      pagination: { mode: \"cursor\", defaultLimit: 50, maxLimit: 200 },\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a02e2d-cfe6-7e21-8f45-566081da5b6e","create_time":1787481277.304037}}}
