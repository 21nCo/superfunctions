rn {\\n+    adapters: registered,\\n+    enabledModules: DEV_ENABLED_ADMIN_MODULE_IDS,\\n+  };\\n+}\\n+\\n+export type DevSuperConsoleOptions = Omit<SuperConsoleOptions, \\\"adapters\\\" | \\\"enabledModules\\\"> & {\\n+  adapters: DevAdminAdapters;\\n+};\\n+\\n+/** Compose this from real function-owned adapters and deployment-owned infrastructure. */\\n+export function createDevSuperConsoleInstallation(options: DevSuperConsoleOptions): SuperConsole {\",\n            \"line\": 72,\n            \"originalLine\": 72\n          }\n        ]\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6bOE6r\",\n      \"isResolved\": false,\n      \"path\": \"superconsole/src/lib/server/transport.ts\",\n      \"line\": 25,\n      \"originalLine\": 25,\n      \"comments\": {\n        \"nodes\": [\n          {\n            \"id\": \"PRRC_kwDOP-e7KM7kZdNE\",\n            \"body\": \"<!-- cubic:v=05cd7d52-7765-4642-984e-06e0eeb18aec -->\\n<!-- cubic:review-run=7bb8304f-392d-4952-ab05-eaf35f279889 -->\\n<!-- metadata:{\\\"confidence\\\":9} -->\\nP2: When an installation sets `apiBasePath` to anything other than `/api/admin/v1`, the mounted transport cannot serve it: custom-path requests do not match these routes, while requests at the fixed path are rejected as outside the configured API. Constrain this option for the SvelteKit transport or mount/delegate routes using the configured base path.\\n\\n<details>\\n<summary>Prompt for AI agents</summary>\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At superconsole/src/lib/server/transport.ts, line 25:\\n\\n<comment>When an installation sets `apiBasePath` to anything other than `/api/admin/v1`, the mounted transport cannot serve it: custom-path requests do not match these routes, while requests at the fixed path are rejected as outside the configured API. Constrain this option for the SvelteKit transport or mount/delegate routes using the configured base path.</comment>\\n\\n<file context>\\n@@ -0,0 +1,26 @@\\n+      headers: { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store' },\\n+    });\\n+  }\\n+  return console.handle(request);\\n+}\\n</file context>\\n```\\n\\n</details>\",\n            \"author\": {\n              \"login\": \"cubic-dev-ai\"\n            },\n            \"createdAt\": \"2026-08-21T16:20:58Z\",\n            \"outdated\": false,\n            \"url\": \"https://github.com/21nCo/super-functions/pull/116#discussion_r3831878468\",\n            \"diffHunk\": \"@@ -0,0 +1,26 @@\\n+import { getSuperConsole, loadSuperConsoleInstallation } from './installation.js';\\n+\\n+export async function bootConfiguredSuperConsole(specifier?: string): Promise<void> {\\n+  if (getSuperConsole()) return;\\n+  if (!specifier?.trim()) return;\\n+  // Installation import and composition validation are startup-fatal by design.\\n+  await loadSuperConsoleInstallation(specifier);\\n+}\\n+\\n+export async function handleConfiguredSuperConsole(request: Request): Promise<Response> {\\n+  const console = getSuperConsole();\\n+  if (!console) {\\n+    return new Response(JSON.stringify({\\n+      ok: false,\\n+      error: {\\n+        code: 'SUPERCONSOLE_NOT_CONFIGURED',\\n+        message: 'Super Console has not been composed for this server process.',\\n+        status: 503,\\n+      },\\n+    }), {\\n+      status: 503,\\n+      headers: { 'content-type': 'application/json; charset=utf-8', 'cache-control': 'no-store' },\\n+    });\\n+  }\\n+  return console.handle(request);\",\n            \"line\": 25,\n            \"originalLine\": 25\n          }\n        ]\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6bOE79\",\n      \"isResolved\": false,\n      \"path\": \"superconsole/src/routes/search/+page.ts\",\n      \"line\": null,\n      \"originalLine\": 19,\n      \"comments\": {\n        \"nodes\": [\n          {\n            \"id\": \"PRRC_kwDOP-e7KM7kZdOs\",\n            \"body\": \"<!-- cubic:v=e36d65d8-51d5-4b6b-831d-12a035d0cc81 -->\\n<!-- cubic:review-run=7bb8304f-392d-4952-ab05-eaf35f279889 -->\\n<!-- metadata:{\\\"confidence\\\":9} -->\\nP2: When a query matches more than the server's default 25 results, this load renders only the first page and discards `nextCursor`, so operators cannot reach the remaining matches despite the displayed total. Propagate the cursor and add a follow-up pagination or load-more path.\\n\\n<details>\\n<summary>Prompt for AI agents</summary>\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At superconsole/src/routes/search/+page.ts, line 19:\\n\\n<comment>When a query matches more than the server's default 25 results, this load renders only the first page and discards `nextCursor`, so operators cannot reach the remaining matches despite the displayed total. Propagate the cursor and add a follow-up pagination or load-more path.</comment>\\n\\n<file context>\\n@@ -0,0 +1,32 @@\\n+  const query = url.searchParams.get('q')?.trim() ?? '';\\n+  depends(`superconsole:search:${query}`);\\n+  if (!query) return { query, results: [], total: 0 };\\n+  const result = await fetchAdmin<{ results: SearchResultViewModel[]; total?: number }>(\\n+    fetch,\\n+    withAdminScope(`${ADMIN_API_PREFIX}/search?q=${encodeURIComponent(query)}`, url.searchParams)\\n</file context>\\n```\\n\\n</details>\",\n            \"author\": {\n              \"login\": \"cubic-dev-ai\"\n            },\n            \"createdAt\": \"2026-08-21T16:20:58Z\",\n            \"outdated\": true,\n            \"url\": \"https://github.com/21nCo/super-functions/pull/116#discussion_r3831878572\",\n            \"diffHunk\": \"@@ -0,0 +1,32 @@\\n+import { ADMIN_API_PREFIX, fetchAdmin, safeConsoleNavigationHref, withAdminScope } from '$lib/components/admin-api';\\n+import type { PageLoad } from './$types';\\n+\\n+interface SearchResultViewModel {\\n+  id: string;\\n+  title: string;\\n+  description?: string;\\n+  moduleId: string;\\n+  resource?: string;\\n+  href: string;\\n+  status?: string;\\n+  updatedAt?: string;\\n+}\\n+\\n+export const load: PageLoad = async ({ fetch, url, depends }) => {\\n+  const query = url.searchParams.get('q')?.trim() ?? '';\\n+  depends(`superconsole:search:${query}`);\\n+  if (!query) return { query, results: [], total: 0 };\\n+  const result = await fetchAdmin<{ results: SearchResultViewModel[]; total?: number }>(\",\n            \"line\": null,\n            \"originalLine\": 19\n          }\n        ]\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6bV0Co\",\n      \"isResolved\": false,\n      \"path\": \"billfn/admin/src/domain-service.ts\",\n      \"line\": null,\n      \"originalLine\": 55,\n      \"comments\": {\n        \"nodes\": [\n          {\n            \"id\": \"PRRC_kwDOP-e7KM7kk_Je\",\n            \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Honor pagination in BillFn list operations**\\n\\nAll BillFn resource-list operations declare cursor pagination with a 200-item maximum and accept `cursor`, `limit`, `search`, `filter`, and `sort`, but this shared helper always returns every supplied item and `nextCursor: null`. For catalogs or usage collections containing more than the requested limit, the API bypasses its response bound and the console cannot advance through pages; apply the list inputs before constructing this envelope.\\n\\nUseful? React with 👍 / 👎.\",\n            \"author\": {\n              \"login\": \"chatgpt-codex-connector\"\n            },\n            \"createdAt\": \"2026-08-22T02:55:54Z\",\n            \"outdated\": true,\n            \"url\": \"https://github.com/21nCo/super-functions/pull/116#discussion_r3834901086\",\n            \"diffHunk\": \"@@ -0,0 +1,219 @@\\n+import type {\\n+  BillableSubject,\\n+  BillFnInstance,\\n+  BillFnPlanDefinition,\\n+  BillingProviderName,\\n+} from \\\"@billfn/core\\\";\\n+import {\\n+  AdminError,\\n+  type AdminOperationContext,\\n+  type AdminOperationResult,\\n+} from \\\"@superfunctions/admin\\\";\\n+import type { BillFnAdminService } from \\\"./index.js\\\";\\n+\\n+type JsonRecord = Record<string, unknown>;\\n+\\n+export interface BillFnDomainAdminServiceOptions {\\n+  billfn: BillFnInstance;\\n+  /** Resolves the billable subject only after Super Console scope authorization. */\\n+  subject(context: AdminOperationContext): BillableSubject | Promise<BillableSubject>;\\n+}\\n+\\n+function string(value: unknown, name: string): string {\\n+  if (typeof value !== \\\"string\\\" || value.length === 0) {\\n+    throw new AdminError(\\\"invalid_argument\\\", `${name} must be a non-empty string.`);\\n+  }\\n+  return value;\\n+}\\n+\\n+function optionalString(value: unknown, name: string): string | undefined {\\n+  return value === undefined ? undefined : string(value, name);\\n+}\\n+\\n+function unwrap<T>(value: { ok: true; data: T } | { ok: false; error: { code: string; message: string; status: number; retryable: boolean; details?: unknown } }): T {\\n+  if (value.ok) return value.data;\\n+  const code = value.error.status === 404\\n+    ? \\\"not_found\\\"\\n+    : value.error.status === 403\\n+      ? \\\"forbidden\\\"\\n+      : value.error.status === 409\\n+        ? \\\"conflict\\\"\\n+        : value.error.status >= 500\\n+          ? \\\"dependency_unavailable\\\"\\n+          : \\\"invalid_argument\\\";\\n+  throw new AdminError(code, value.error.message, {\\n+    details: value.error.details,\\n+    retryable: value.error.retryable,\\n+  });\\n+}\\n+\\n+function asJson(value: object): JsonRecord {\\n+  return { ...value };\\n+}\\n+\\n+function list(values: object[]): AdminOperationResult<JsonRecord> {\\n+  return { ok: true, data: { items: values.map(asJson), nextCursor: null } };\",\n            \"line\": null,\n            \"originalLine\": 55\n          }\n        ]\n      }\n    }\n  ]\n}\n"},"started_at_ms":1787743346858,"completed_at_ms":1787743348644}}
{"timestamp":"2026-08-26T11:22:29.729Z","ordinal":14547,"type":"event_msg","payload":{"type":"item_completed","thread_id":"01a024c5-b91b-72b3-ad56-490032d022a1","turn_id":"01a03dcd-d071-7262-a95f-6be5723606e1","item":{"type":"CommandExecution","id":"exec-9bfcada7-45ec-4ccf-8b94-fc1e0196a150","process_id":"94447","command":["/bin/zsh","-lc","GH_CONFIG_DIR=/Users/serro/.config/gh-other gh pr view 116 --repo 21nCo/super-functions --json reviews,comments,updatedAt,url | jq '{updatedAt,url,reviews:[.reviews[]|select((.body//\"\")!=\"\")|{author:.author.login,state,submittedAt,body}],comments:[.comments[]|{author:.author.login,createdAt,updatedAt,body,url}]}'"],"cwd":"file:///Users/serro/Documents/dev/n/superfunctions-dev","parsed_cmd":[{"type":"unknown","cmd":"GH_CONFIG_DIR=/Users/serro/.config/gh-other gh pr view 116 --repo 21nCo/super-functions --json reviews,comments,updatedAt,url | jq '{updatedAt,url,reviews:[.reviews[]|select((.body//\"\")!=\"\")|{author:.author.login,state,submittedAt,body}],comments:[.comments[]|{author:.author.login,createdAt,updatedAt,body,url}]}'"}],"source":"unified_exec_startup","status":"completed","stdout":"{\n  \"updatedAt\": \"2026-08-26T11:05:29Z\",\n  \"url\": \"https://github.com/21nCo/super-functions/pull/116\",\n  \"reviews\": [\n    {\n      \"author\": \"sourcery-ai\",\n      \"state\": \"COMMENTED\",\n      \"submittedAt\": \"2026-08-21T15:56:24Z\",\n      \"body\": \"Sorry, we are unable to review this pull request\\n\\nThe GitHub API does not allow us to fetch diffs exceeding 300 files, and this pull request has 1779\"\n    },\n    {\n      \"author\": \"chatgpt-codex-connector\",\n      \"state\": \"COMMENTED\",\n      \"submittedAt\": \"2026-08-21T16:01:32Z\",\n      \"body\": \"\\n### 💡 Codex Review\\n\\nHere are some automated review suggestions for this pull request.\\n\\n**Reviewed commit:** `d27cceb2b7`\\n    \\n\\n<details> <summary>ℹ️ About Codex in GitHub</summary>\\n<br/>\\n\\n[Your team has set up Codex to review pull requests in this repo](https://chatgpt.com/codex/cloud/settings/general). Reviews are triggered when you\\n- Open a pull request for review\\n- Mark a draft as ready\\n- Comment \\\"@codex review\\\".\\n\\nIf Codex has suggestions, it will comment; otherwise it will react with 👍.\\n\\n\\n\\n\\nCodex can also answer questions or update the PR. Try commenting \\\"@codex address that feedback\\\".\\n            \\n</details>\"\n    },\n    {\n      \"author\": \"pullfrog\",\n      \"state\": \"COMMENTED\",\n      \"submittedAt\": \"2026-08-21T16:08:48Z\",\n      \"body\": \"> [!CAUTION]\\n> Requesting changes for two authorization/isolation gaps and a failing Super Console typecheck. The configurable API base path also does not propagate to the bundled UI.\\n\\nVerification completed with the declared npm 10 toolchain: the dependency-aware Super Console build passed; admin (71), MCP core (23), and PlugFn admin (5) tests passed. Super Console reached 92/93 tests under Node 24, with the remaining test failing on an `AbortSignal` realm mismatch outside its declared Node `<23` range; its independent typecheck fails with the errors noted inline.\\n\\n<!-- PULLFROG_DIVIDER_DO_NOT_REMOVE_PLZ -->\\n<sup><a href=\\\"https://pullfrog.com\\\"><picture><source media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://pullfrog.com/logos/frog-white-full-18px.png\\\"><img src=\\\"https://pullfrog.com/logos/frog-green-full-18px.png\\\" width=\\\"9px\\\" height=\\\"9px\\\" style=\\\"vertical-align: middle; \\\" alt=\\\"Pullfrog\\\"></picture></a>&nbsp;&nbsp;｜ [Fix all ➔](https://pullfrog.com/trigger/21nCo/super-functions/116?action=fix&review_id=4995209775) ｜ [Fix 👍s ➔](https://pullfrog.com/trigger/21nCo/super-functions/116?action=fix-approved&review_id=4995209775) ｜ [View workflow run](https://github.com/21nCo/super-functions/actions/runs/32500308716/job/96828209807) ｜ Using `GPT Sol` ｜ [𝕏](https://x.com/pullfrogai)</sup>\"\n    },\n    {\n      \"author\": \"cubic-dev-ai\",\n      \"state\": \"COMMENTED\",\n      \"submittedAt\": \"2026-08-21T16:19:44Z\",\n      \"body\": \"<!-- cubic:review-summary:start -->\\n**40 issues found** across 1779 files\\n<!-- cubic:review-summary:end -->\\n\\n**Not reviewed** (too large): `uifn/components/fixtures/data-rich/data-table.fixture.json` (~60,040 lines), `uifn/components/fixtures/data-rich/command.fixture.json` (~5,037 lines) - if these are generated or fixture files, add them to ignored paths to exclude them from future reviews.\\n\\n<details>\\n<summary>Prompt for AI agents (unresolved issues)</summary>\\n\\n```text\\n\\nCheck if these issues are valid — if so, understand the root cause of each and fix them. If appropriate, use sub-agents to investigate and fix each issue separately.\\n\\n\\n<file name=\\\"uifn/core/scripts/build.mjs\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"uifn/core/scripts/build.mjs:24\\\">\\nP1: When the build reaches `accordion`, it asks tsup to bundle nonexistent `createAccordionController`, so the build fails before producing any public primitive entrypoints. Add the missing controller exports or map catalog entries to verified source exports before bundling.</violation>\\n</file>\\n\\n<file name=\\\"superconsole/src/routes/audit/+page.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"superconsole/src/routes/audit/+page.ts:12\\\">\\nP1: The audit endpoint returns raw `AdminAuditEvent` objects, but this loader forwards them as `AuditEventViewModel` without mapping. Audit rows therefore read undefined `occurredAt`/`actor`/`action`, render the object target as `[object Object]`, and show raw outcomes as `Unknown`; map each event to the UI view model and normalize its outcome and target.</violation>\\n</file>\\n\\n<file name=\\\"uifn/core/src/algorithms/id.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"uifn/core/src/algorithms/id.ts:12\\\">\\nP1: Distinct collection values can normalize to the same ID, and non-ASCII-only values can make part rendering throw. Encode dynamic segments reversibly or add a collision-resistant suffix instead of using this lossy slug as the unique ID segment.</violation>\\n</file>\\n\\n<file name=\\\"mcpfn/core/src/errors.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"mcpfn/core/src/errors.ts:16\\\">\\nP1: When error details contain a throwing `toJSON` or Proxy trap, `jsonSafe` returns a string for the entire response envelope. `errorResult` then emits that string as `structuredContent`, so the MCP response can be rejected as invalid and the stable error code/message are lost; serialize details independently or return a safe object envelope on failure.</violation>\\n</file>\\n\\n<file name=\\\"uifn/adapter-kit/src/refs.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"uifn/adapter-kit/src/refs.ts:55\\\">\\nP1: When a key is re-registered before the earlier registration cleans up, the earlier cleanup deletes the newer element. Make cleanup conditional on its registration token so an old component cannot unregister the current element.</violation>\\n\\n<violation number=\\\"2\\\" location=\\\"uifn/adapter-kit/src/refs.ts:66\\\">\\nP2: When `TElement` is a valid falsy value such as `''`, `require` throws even though `register` and `has` report it present. Check map membership instead of element truthiness.</violation>\\n</file>\\n\\n<file name=\\\"uifn/core/src/algorithms/selection.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"uifn/core/src/algorithms/selection.ts:26\\\">\\nP2: `Object.freeze` does not prevent `Set` mutations, so JavaScript consumers can change `selection.selectedKeys` in place despite the readonly immutable contract. Return a genuinely read-only set facade or use an immutable representation for `selectedKeys`.</violation>\\n\\n<violation number=\\\"2\\\" location=\\\"uifn/core/src/algorithms/selection.ts:50\\\">\\nP2: When `toKey` is not in the collection, this branch still computes a range with `indexOf(toKey) === -1` and returns a selection whose `currentKey` is missing, potentially clearing the current selection. Validate membership before range calculations and return the existing selection for an invalid target.</violation>\\n\\n<violation number=\\\"3\\\" location=\\\"uifn/core/src/algorithms/selection.ts:51\\\">\\nP2: When a collection uses numeric key `0` as the anchor, this truthiness check discards it and shift-selecting starts at `toKey`, selecting only the target instead of the full range. Check the anchor against `null` explicitly.</violation>\\n</file>\\n\\n<file name=\\\"uifn/core/src/algorithms/locale.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"uifn/core/src/algorithms/locale.ts:18\\\">\\nP2: When collation-equivalent text uses combining marks or expansions, `startsWith` and `includes` slice by code-point count and compare the wrong window. Match over collation-element boundaries or candidate string boundaries instead of using `normalizedQuery.length`.</violation>\\n</file>\\n\\n<file name=\\\"uifn/core/src/algorithms/color.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"uifn/core/src/algorithms/color.ts:23\\\">\\nP2: When a malformed numeric token reaches `parseUIFnColor`, the regex matches it and the parser stores `NaN` in the color, producing invalid serialized values. Use a strict CSS-number pattern and reject non-finite parsed channels before constructing the color.</violation>\\n</file>\\n\\n<file name=\\\"uifn/components/src/contracts.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"uifn/components/src/contracts.ts:12\\\">\\nP2: Checkbox indeterminate state is not representable with this contract: the type accepts `mixed` but rejects canonical `indeterminate`, while the recipe emits the value unchanged and the stylesheet targets `data-state=\\\"indeterminate\\\"`. Add the canonical `indeterminate` value and align this union with the catalog/core state names.</violation>\\n</file>\\n\\n<file name=\\\"uifn/core/src/algorithms/range.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"uifn/core/src/algorithms/range.ts:11\\\">\\nP2: When a range step uses scientific notation with a fractional mantissa, `decimals` undercounts its precision and `alignRangeValue` changes valid step values. Compute decimal precision from both the mantissa and exponent.</violation>\\n\\n<violation number=\\\"2\\\" location=\\\"uifn/core/src/algorithms/range.ts:22\\\">\\nP2: When `step` is `NaN` or `Infinity`, this guard accepts it and `alignRangeValue` publishes `NaN`. Reject non-finite steps before calculating the aligned value.</violation>\\n\\n<violation number=\\\"3\\\" location=\\\"uifn/core/src/algorithms/range.ts:30\\\">\\nP2: For valid ranges finer than twelve decimal places, the precision cap rounds aligned values to a different step. Preserve the definition's precision or reject unsupported precision explicitly before rounding.</violation>\\n\\n<violation number=\\\"4\\\" location=\\\"uifn/core/src/algorithms/range.ts:55\\\">\\nP2: When `max - min` is not divisible by `step`, End returns an unaligned maximum while normalization and percent conversion return the previous step. Apply one consistent endpoint policy or reject non-divisible range definitions.</violation>\\n</file>\\n\\n<file name=\\\"uifn/core/src/algorithms/async-list.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"uifn/core/src/algorithms/async-list.ts:31\\\">\\nP2: When a subscriber throws during the loading notification, `load()` rejects before invoking the loader and later subscribers are skipped. Isolate subscriber callbacks so one listener cannot abort list operations.</violation>\\n\\n<violation number=\\\"2\\\" location=\\\"uifn/core/src/algorithms/async-list.ts:54\\\">\\nP2: When `cancel()` is called without immediately starting another load, it aborts the request but leaves the list visibly `loading` forever. Publish a non-loading state when canceling the active request.</violation>\\n</file>\\n\\n<file name=\\\"superconsole/examples/dev-installation.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"superconsole/examples/dev-installation.ts:72\\\">\\nP1: When this module is loaded directly via `SUPERCONSOLE_INSTALLATION`, the installation loader invokes its similarly named factory without arguments, so startup throws before creating the console. Export a no-argument deployment wrapper, or rename this options-taking helper so it cannot be selected as the loader entry point.</violation>\\n</file>\\n\\n<file name=\\\"mcpfn/core/src/canonical.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"mcpfn/core/src/canonical.ts:11\\\">\\nP2: When manifest metadata or extensions contain a Date-like object with inherited `toJSON`, `canonicalize` hashes `{}` but JSON transport emits the object's JSON value. Preserve `toJSON` results or reject non-plain objects before hashing so locally created manifests remain valid after transport.</violation>\\n\\n<violation number=\\\"2\\\" location=\\\"mcpfn/core/src/canonical.ts:15\\\">\\nP2: For integer-like property names, `Object.fromEntries`/`JSON.stringify` undo the code-unit sort, so `canonicalJson` is not actually canonical in the ordering promised by `compareCodeUnits`. Serialize sorted entries directly or use a representation that prevents integer-key reordering.</violation>\\n</file>\\n\\n<file name=\\\"filefn/server/src/shares/service.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"filefn/server/src/shares/service.ts:296\\\">\\nP2: When two shares have the same millisecond `createdAt`, this single-key sort leaves offset pages nondeterministic and can duplicate or skip shares. Add a unique secondary ordering key such as `tokenHash`.</violation>\\n</file>\\n\\n<file name=\\\"uifn/adapter-kit/src/lifecycle.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"uifn/adapter-kit/src/lifecycle.ts:33\\\">\\nP2: When `run` is passed as a callback or destructured and its factory returns a cleanup, `this.add` throws because the method has no receiver. Use the closure-backed registration logic instead of relying on `this`.</violation>\\n\\n<violation number=\\\"2\\\" location=\\\"uifn/adapter-kit/src/lifecycle.ts:44\\\">\\nP2: When a registered cleanup throws, `cleanup()` skips every later cleanup and leaves the completed scope retaining its callbacks. Run all callbacks independently, clear the set regardless of failures, then rethrow an aggregated error.</violation>\\n</file>\\n\\n<file name=\\\"superconsole/src/lib/server/transport.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"superconsole/src/lib/server/transport.ts:25\\\">\\nP2: When an installation sets `apiBasePath` to anything other than `/api/admin/v1`, the mounted transport cannot serve it: custom-path requests do not match these routes, while requests at the fixed path are rejected as outside the configured API. Constrain this option for the SvelteKit transport or mount/delegate routes using the configured base path.</violation>\\n</file>\\n\\n<file name=\\\"filefn/server/src/authz/grants.service.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"filefn/server/src/authz/grants.service.ts:97\\\">\\nP2: When grants share a millisecond timestamp, offset-based admin pages can reorder tied rows and duplicate or skip grants. Add `permissionId` as a secondary sort key.</violation>\\n</file>\\n\\n<file name=\\\"uifn/components-svelte/package.json\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"uifn/components-svelte/package.json:13\\\">\\nP2: The `generate`, `generate:check`, and `prepack` scripts invoke `../../scripts/generate-uifn-components.mjs`, but that file does not exist anywhere in the repo (the `scripts/` directory has no such entry). Running `npm run generate` or `npm run generate:check` fails, and because `prepack` runs `npm run generate:check && npm run build`, `npm publish` aborts. Add the generation script or remove these scripts if the committed `src/generated` output is the intended source of truth.</violation>\\n</file>\\n\\n<file name=\\\"packages/admin/src/risk-review.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"packages/admin/src/risk-review.ts:15\\\">\\nP2: When an AuthFn session mutation is named `authfn.sessions.*`, the risk review omits it because the regex only matches `auth-session(s)`. Match the manifest's `sessions` resource so session credential-lifecycle mutations are included in the fail-closed report.</violation>\\n\\n<violation number=\\\"2\\\" location=\\\"packages/admin/src/risk-review.ts:16\\\">\\nP2: When a channel is connected or disconnected, `reviewAdminMutationRisks` emits no external-side-effect review because `EXTERNAL_ACTION` lacks those action suffixes. Add `connect` and `disconnect` and other manifest-declared side-effect actions to keep missing-confirmation checks fail-closed.</violation>\\n</file>\\n\\n<file name=\\\"superconsole/src/routes/mcp/+page.svelte\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"superconsole/src/routes/mcp/+page.svelte:34\\\">\\nP2: This clients panel can never show an authenticated caller with the current endpoint contract, so it misleadingly reports no active clients and promises activity that is never surfaced. Remove the panel until client tracking exists, or populate it from a real client/activity contract.</violation>\\n</file>\\n\\n<file name=\\\"uifn/components/src/pilots.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"uifn/components/src/pilots.ts:19\\\">\\nP2: When `component` is an unknown built-in property name, `getStyledPilotDemo` returns an inherited function or object instead of `undefined`. Check that the key is an own property before indexing the map.</violation>\\n</file>\\n\\n<file name=\\\"superconsole/src/lib/server/installation.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"superconsole/src/lib/server/installation.ts:40\\\">\\nP2: When `SUPERCONSOLE_INSTALLATION` uses a valid mixed-case file URL such as `FILE:///srv/app/installation.js`, this guard misses it and startup rejects the installation. Detect the `file` scheme case-insensitively before parsing.</violation>\\n</file>\\n\\n<file name=\\\"filefn/server/src/files/service.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"filefn/server/src/files/service.ts:852\\\">\\nP2: When multiple versions share the same `createdAt`, offset-based admin pages do not have a stable ordering and can skip or repeat versions across pages. Add a unique secondary sort key such as `versionId DESC` and cover equal-timestamp pagination with a test.</violation>\\n</file>\\n\\n<file name=\\\"filefn/server/src/processing/service.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"filefn/server/src/processing/service.ts:497\\\">\\nP2: When the admin artifact list spans pages, artifacts created in the same millisecond can move between pages because `listArtifacts` orders only by non-unique `createdAt`. Add a unique tie-breaker such as `artifactId` to the ordering.</violation>\\n</file>\\n\\n<file name=\\\"superconsole/src/lib/components/ResourceDetailPage.svelte\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"superconsole/src/lib/components/ResourceDetailPage.svelte:36\\\">\\nP2: When two detail fields have the same label, Svelte raises a duplicate-key error and the resource detail page fails to render. Key the loop with a unique field identity or index instead.</violation>\\n</file>\\n\\n<file name=\\\"superconsole/src/routes/search/+page.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"superconsole/src/routes/search/+page.ts:19\\\">\\nP2: When a query matches more than the server's default 25 results, this load renders only the first page and discards `nextCursor`, so operators cannot reach the remaining matches despite the displayed total. Propagate the cursor and add a follow-up pagination or load-more path.</violation>\\n</file>\\n\\n<file name=\\\"superconsole/src/routes/api/+page.svelte\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"superconsole/src/routes/api/+page.svelte:22\\\">\\nP2: When an unauthenticated operator opens `/api`, the page shows an error with “Retry” instead of a sign-in action. Handle status 401 separately and link to `/sign-in`, as the overview route does.</violation>\\n</file>\\n\\n<file name=\\\"uifn/adapter-kit/src/ssr.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"uifn/adapter-kit/src/ssr.ts:38\\\">\\nP2: When consumers destructure `runClient`, client calls throw because `this` is undefined. Use the local environment check or a closure instead of `this.assertClient`.</violation>\\n</file>\\n\\n<file name=\\\"packages/admin/scripts/verify-sdk-contracts.mjs\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"packages/admin/scripts/verify-sdk-contracts.mjs:41\\\">\\nP2: When the function admin builds have not run, this script silently verifies zero modules and exits successfully. Fail when no modules are reviewed, or require the build before scanning.</violation>\\n</file>\\n\\n<file name=\\\"superconsole/scripts/verify-function-agnostic.mjs\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"superconsole/scripts/verify-function-agnostic.mjs:97\\\">\\nP2: When a valid JavaScript source file is added under `src`, this verifier silently skips it, so concrete function dependencies can bypass the function-agnostic guard. Include `.js` files in the scanned extensions.</violation>\\n</file>\\n```\\n\\n</details>\\n\\n<sub>**Note:** This PR contains a large number of files. cubic selects up to 200 of the highest-priority eligible files for this review, so some files may not have been reviewed.<br /><br />[Re-trigger cubic](https://www.cubic.dev/action/re-review/pr/21nCo/super-functions/116/ai_pr_review_1787327791163_a1a350bd-38ed-428d-ad31-51af760b767a?returnTo=https%3A%2F%2Fgithub.com%2F21nCo%2Fsuper-functions%2Fpull%2F116)</sub>\\n\\n<!-- cubic:review-post:ai_pr_review_1787327791163_a1a350bd-38ed-428d-ad31-51af760b767a:d27cceb2b786bcb08c2be5445ece12146c1123c4:7bb8304f-392d-4952-ab05-eaf35f279889 -->\"\n    },\n    {\n      \"author\": \"cubic-dev-ai\",\n      \"state\": \"COMMENTED\",\n      \"submittedAt\": \"2026-08-21T16:20:57Z\",\n      \"body\": \"<!-- cubic:review-summary:start -->\\n**4 issues found** across 1779 files\\n<!-- cubic:review-summary:end -->\\n\\n**Not reviewed** (too large): `uifn/components/fixtures/data-rich/data-table.fixture.json` (~60,040 lines), `uifn/components/fixtures/data-rich/command.fixture.json` (~5,037 lines) - if these are generated or fixture files, add them to ignored paths to exclude them from future reviews.\\n\\n<details>\\n<summary>Prompt for AI agents (unresolved issues)</summary>\\n\\n```text\\n\\nCheck if these issues are valid — if so, understand the root cause of each and fix them. If appropriate, use sub-agents to investigate and fix each issue separately.\\n\\n\\n<file name=\\\"superconsole/examples/dev-installation.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"superconsole/examples/dev-installation.ts:72\\\">\\nP1: When this module is loaded directly via `SUPERCONSOLE_INSTALLATION`, the installation loader invokes its similarly named factory without arguments, so startup throws before creating the console. Export a no-argument deployment wrapper, or rename this options-taking helper so it cannot be selected as the loader entry point.</violation>\\n</file>\\n\\n<file name=\\\"superconsole/src/lib/server/transport.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"superconsole/src/lib/server/transport.ts:25\\\">\\nP2: When an installation sets `apiBasePath` to anything other than `/api/admin/v1`, the mounted transport cannot serve it: custom-path requests do not match these routes, while requests at the fixed path are rejected as outside the configured API. Constrain this option for the SvelteKit transport or mount/delegate routes using the configured base path.</violation>\\n</file>\\n\\n<file name=\\\"superconsole/src/routes/search/+page.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"superconsole/src/routes/search/+page.ts:19\\\">\\nP2: When a query matches more than the server's default 25 results, this load renders only the first page and discards `nextCursor`, so operators cannot reach the remaining matches despite the displayed total. Propagate the cursor and add a follow-up pagination or load-more path.</violation>\\n</file>\\n\\n<file name=\\\"uifn/core/scripts/build.mjs\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"uifn/core/scripts/build.mjs:24\\\">\\nP1: When the build reaches `accordion`, it asks tsup to bundle nonexistent `createAccordionController`, so the build fails before producing any public primitive entrypoints. Add the missing controller exports or map catalog entries to verified source exports before bundling.</violation>\\n</file>\\n```\\n\\n</details>\\n\\n<sub>**Note:** This PR contains a large number of files. cubic selects up to 200 of the highest-priority eligible files for this review, so some files may not have been reviewed.<br /><br />[Re-trigger cubic](https://www.cubic.dev/action/re-review/pr/21nCo/super-functions/116/ai_pr_review_1787327791163_a1a350bd-38ed-428d-ad31-51af760b767a?returnTo=https%3A%2F%2Fgithub.com%2F21nCo%2Fsuper-functions%2Fpull%2F116)</sub>\\n\\n<!-- cubic:review-post:ai_pr_review_1787327791163_a1a350bd-38ed-428d-ad31-51af760b767a:d27cceb2b786bcb08c2be5445ece12146c1123c4:7bb8304f-392d-4952-ab05-eaf35f279889 -->\"\n    },\n    {\n      \"author\": \"chatgpt-codex-connector\",\n      \"state\": \"COMMENTED\",\n      \"submittedAt\": \"2026-08-22T02:55:54Z\",\n      \"body\": \"\\n### 💡 Codex Review\\n\\nHere are some automated review suggestions for this pull request.\\n\\n**Reviewed commit:** `8d16f12d9a`\\n    \\n\\n<details> <summary>ℹ️ About Codex in GitHub</summary>\\n<br/>\\n\\n[Your team has set up Codex to review pull requests in this repo](https://chatgpt.com/codex/cloud/settings/general). Reviews are triggered when you\\n- Open a pull request for review\\n- Mark a draft as ready\\n- Comment \\\"@codex review\\\".\\n\\nIf Codex has suggestions, it will comment; otherwise it will react with 👍.\\n\\n\\n\\n\\nCodex can also answer questions or update the PR. Try commenting \\\"@codex address that feedback\\\".\\n            \\n</details>\"\n    },\n    {\n      \"author\": \"pullfrog\",\n      \"state\": \"COMMENTED\",\n      \"submittedAt\": \"2026-08-22T02:58:52Z\",\n      \"body\": \"> [!IMPORTANT]\\n> The review-fix commit leaves two correctness gaps in paths intended to enforce function-agnostic source boundaries and aligned range values.\\n\\n**Reviewed changes** since the prior Pullfrog review at `d27cceb`:\\n\\n- **Hardened Super Console boundaries** — constrained the API mount path, authorized safe-method mutations by classification, mapped audit/search output, and tightened input handling.\\n- **Strengthened adapter isolation and pagination** — added PlugFn tenant checks, stable FileFn ordering, SearchFn list controls, and string-preserving document IDs.\\n- **Corrected MCP contracts** — preserved stable error envelopes and added deterministic canonical JSON handling for integer-like keys and `toJSON` values.\\n- **Repaired UIFn compatibility behavior** — restored legacy primitive entrypoints and addressed lifecycle, selection, locale, color, ID, SSR, and range edge cases.\\n\\n<!--\\nPullfrog review metadata. These findings were written against 8d16f12;\\nif commits have landed on SFNS-2 since, treat every specific bug, file, or\\nline callout as POTENTIALLY STALE and re-diff before acting on it.\\n\\n- Mode: IncrementalReview (delta against prior pullfrog review)\\n- Files reviewed: 1782\\n- Commits reviewed: 2\\n- Base: dev (72aabce)\\n- Head: SFNS-2 (8d16f12)\\n- Reviewed commits:\\n  - 8d16f12 — fix: address PR review feedback\\n  - d27cceb — SFNS-2 port Super Console admin surfaces to dev\\n- Prior pullfrog review: d27cceb (https://github.com/21nCo/super-functions/pull/116#pullrequestreview-4995209775)\\n-->\\n\\n<!-- PULLFROG_DIVIDER_DO_NOT_REMOVE_PLZ -->\\n<sup><a href=\\\"https://pullfrog.com\\\"><picture><source media=\\\"(prefers-color-scheme: dark)\\\" srcset=\\\"https://pullfrog.com/logos/frog-white-full-18px.png\\\"><img src=\\\"https://pullfrog.com/logos/frog-green-full-18px.png\\\" width=\\\"9px\\\" height=\\\"9px\\\" style=\\\"vertical-align: middle; \\\" alt=\\\"Pullfrog\\\"></picture></a>&nbsp;&nbsp;｜ [Fix all ➔](https://pullfrog.com/trigger/21nCo/super-functions/116?action=fix&review_id=4998753777) ｜ [Fix 👍s ➔](https://pullfrog.com/trigger/21nCo/super-functions/116?action=fix-approved&review_id=4998753777) ｜ [View workflow run](https://github.com/21nCo/super-functions/actions/runs/32547360654/job/96968142055) ｜ Using `GPT Sol` ｜ [𝕏](https://x.com/pullfrogai)</sup>\"\n    },\n    {\n      \"author\": \"cubic-dev-ai\",\n      \"state\": \"COMMENTED\",\n      \"submittedAt\": \"2026-08-22T03:11:10Z\",\n      \"body\": \"<!-- cubic:review-summary:start -->\\n**3 issues found** across 52 files (changes from recent commits).\\n<!-- cubic:review-summary:end -->\\n\\n<details>\\n<summary>Prompt for AI agents (unresolved issues)</summary>\\n\\n```text\\n\\nCheck if these issues are valid — if so, understand the root cause of each and fix them. If appropriate, use sub-agents to investigate and fix each issue separately.\\n\\n\\n<file name=\\\"searchfn/admin/src/domain-service.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"searchfn/admin/src/domain-service.ts:71\\\">\\nP3: This service issues and accepts plain offset cursors that are not signed or authenticated; `decodeAdminCursor`'s own contract requires production providers to issue opaque, signed cursor positions. Any operator in scope can forge or alter an offset. This is only a data-exposure/page-skip risk (scope is still validated), but it diverges from the documented guidance to use signed cursors for production admin surfaces.</violation>\\n</file>\\n\\n<file name=\\\"packages/admin/src/registry.ts\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"packages/admin/src/registry.ts:39\\\">\\nP3: This diff introduces a second copy of the route method/path parser. validator.ts `operationRoutePath` now implements the identical manual whitespace-splitting loop with the same verb allowlist, and two other consumers still parse routes differently with a regex (`routeMatches` in registry.ts line 234 and `route()` in openapi.ts line 71, both `trim().split(/\\\\s+/, 1)[0]`). Four places now derive `method`/`path` from a string route with three distinct implementations that must stay in sync; a future change to one (e.g. method normalization or path handling) can silently diverge the registry route, validation, matching, and OpenAPI generation. Extract the split-and-validate logic into a single shared helper in this package and use it from `routeOf`, `operationRoutePath`, `routeMatches`, and `route`.</violation>\\n</file>\\n\\n<file name=\\\"uifn/core/scripts/build.mjs\\\">\\n\\n<violation number=\\\"1\\\" location=\\\"uifn/core/scripts/build.mjs:13\\\">\\nP2: The generated wildcard primitive entries now reintroduce removed `createX` APIs, contradicting the package’s breaking-no-shims contract. Remove these aliases, or update the migration manifest and compatibility contract to document their incompatible legacy behavior.</violation>\\n</file>\\n```\\n\\n</details>\\n\\n<sub>Reply with feedback, questions, or to request a fix.<br /><br />[Re-trigger cubic](https://www.cubic.dev/action/re-review/pr/21nCo/super-functions/116/ai_pr_review_1787367056771_267b63b5-9188-46fd-83de-8b2d5628a52a?returnTo=https%3A%2F%2Fgithub.com%2F21nCo%2Fsuper-functions%2Fpull%2F116)</sub>\\n\\n<!-- cubic:review-post:ai_pr_review_1787367056771_267b63b5-9188-46fd-83de-8b2d5628a52a:8d16f12d9a673cbed04f6c20cc9a06b0e770389e:e23e6324-2c6c-4e6a-843e-4e4bd3612e24 -->\"\n    },\n    {\n      \"author\": \"chatgpt-codex-connector\",\n      \"state\": \"COMMENTED\",\n      \"submittedAt\": \"2026-08-22T04:20:36Z\",\n      \"body\": \"\\n### 💡 Codex Review\\n\\nHere are some automated review suggestions for this pull request.\\n\\n**Reviewed commit:** `8ad9b668d1`\\n    \\n\\n<details> <summary>ℹ️ About Codex in GitHub</summary>\\n<br/>\\n\\n[Your team has set up Codex to review pull requests in this repo](https://chatgpt.com/codex/cloud/settings/general). Reviews are triggered when you\\n- Open a pull request for review\\n- Mark a draft as ready\\n- Comment \\\"@codex review\\\".\\n\\nIf Codex has suggestions, it will comment; otherwise it will react with 👍.\\n\\n\\n\\n\\nCodex can also answer questions or update the PR. Try commenting \\\"@codex address that feedback\\\".\\n            \\n</details>\"\n    },\n    {\n      \"author\": \"pullfrog\",\n      \"state\": \"COMMENTED\",\n      \"submittedAt\": \"2026-08-22T04:26:09Z\",\n      \"body\": \"> [!IMPORTANT]\\n> The latest fix commit introduces three correctness and resource-control regressions that should be addressed before merge.\\n\\n**Reviewed changes** since the prior Pullfrog review at `8d16f12`:\\n\\n- **Implemented domain list controls** — added BillFn filtering, search, sorting, and cursor pagination, and extended PlugFn sync-job pagination beyond the first hundred rows.\\n- **Centralized admin route handling** — extracted shared route parsing and rejected reserved prototype segments in presentation input paths.\\n- **Corrected transport edge cases** — aligned MCP `toJSON` canonicalization and removed both string and numeric forms of numeric-looking SearchFn document IDs.\\n- **Hardened runtime behavior** — fixed the prior Svelte scanner and range endpoint findings, registration cleanup races, reentrant async cancellation, locale-search performance, and legacy avatar subscriptions.\\n\\n<!--\\nPullfrog review metadata. These findings were written against 8ad9b66;\\nif commits have landed on SFNS-2 since, treat every specific bug, file, or\\nline callout as POTENTIALLY STALE and re-diff before acting on it.\\n\\n- Mode: IncrementalReview (delta against prior pullfrog review)\\n- Files reviewed: 1783\\n- Commits reviewed: 3\\