hment is in flight\", async () => {\nhostfn/cli/src/__tests__/operator.test.ts-290-    const store = new MemoryHostFnOperatorStore();\nhostfn/cli/src/__tests__/operator.test.ts-291-    const target: HostFnTarget = {\n--\nhostfn/cli/src/__tests__/operator.test.ts-299-    const executor: HostFnDeploymentExecutor = {\nhostfn/cli/src/__tests__/operator.test.ts-300-      deploy: async () => undefined, cancel: async () => undefined, rollback: async () => undefined,\nhostfn/cli/src/__tests__/operator.test.ts-301-      restart: async () => undefined, attachDomain: async () => providerGate, detachDoma…337 tokens truncated…__tests__/operator.test.ts-314-    expect(detachDomain).toHaveBeenCalledTimes(2);\nhostfn/cli/src/__tests__/operator.test.ts-315-    expect(detachDomain).toHaveBeenLastCalledWith(expect.objectContaining({ domain: expect.objectContaining({ id: pending!.id }) }));\nhostfn/cli/src/__tests__/operator.test.ts-316-  });\nhostfn/cli/src/__tests__/operator.test.ts-317-\nhostfn/cli/src/__tests__/operator.test.ts-318-  it(\"retains a retryable intent when deleted-domain compensation fails\", async () => {\nhostfn/cli/src/__tests__/operator.test.ts-319-    const store = new MemoryHostFnOperatorStore();\nhostfn/cli/src/__tests__/operator.test.ts-320-    const target: HostFnTarget = {\nhostfn/cli/src/__tests__/operator.test.ts-321-      id: \"target_1\", scope, name: \"API\", server: \"api.example.test\", runtime: \"nodejs\",\n--\nhostfn/cli/src/__tests__/operator.test.ts-332-    const executor: HostFnDeploymentExecutor = {\nhostfn/cli/src/__tests__/operator.test.ts-333-      deploy: async () => undefined, cancel: async () => undefined, rollback: async () => undefined,\nhostfn/cli/src/__tests__/operator.test.ts-334-      restart: async () => undefined, attachDomain: async () => providerGate, detachDomain,\nhostfn/cli/src/__tests__/operator.test.ts-335-      setVariable: async () => undefined, deleteVariable: async () => undefined,\nhostfn/cli/src/__tests__/operator.test