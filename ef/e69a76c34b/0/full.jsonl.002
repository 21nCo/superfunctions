  status?: string;\\n+  updatedAt?: string;\\n+}\\n+\\n+export const load: PageLoad = async ({ fetch, url, depends }) => {\\n+  const query = url.searchParams.get('q')?.trim() ?? '';\\n+  depends(`superconsole:search:${query}`);\\n+  if (!query) return { query, results: [], total: 0 };\\n+  const result = await fetchAdmin<{ results: SearchResultViewModel[]; total?: number }>(\",\n            \"line\": null,\n            \"originalLine\": 19\n          }\n        ]\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6bV0Co\",\n      \"isResolved\": false,\n      \"path\": \"billfn/admin/src/domain-service.ts\",\n      \"line\": null,\n      \"originalLine\": 55,\n      \"comments\": {\n        \"nodes\": [\n          {\n            \"id\": \"PRRC_kwDOP-e7KM7kk_Je\",\n            \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Honor pagination in BillFn list operations**\\n\\nAll BillFn resource-list operations declare cursor pagination with a 200-item maximum and accept `cursor`, `limit`, `search`, `filter`, and `sort`, but this shared helper always returns every supplied item and `nextCursor: null`. For catalogs or usage collections containing more than the requested limit, the API bypasses its response bound and the console cannot advance through pages; apply the list inputs before constructing this envelope.\\n\\nUseful? React with 👍 / 👎.\",\n            \"author\": {\n              \"login\": \"chatgpt-codex-connector\"\n            },\n            \"createdAt\": \"2026-08-22T02:55:54Z\",\n            \"outdated\": true,\n            \"url\": \"https://github.com/21nCo/super-functions/pull/116#discussion_r3834901086\",\n            \"diffHunk\": \"@@ -0,0 +1,219 @@\\n+import type {\\n+  BillableSubject,\\n+  BillFnInstance,\\n+  BillFnPlanDefinition,\\n+  BillingProviderName,\\n+} from \\\"@billfn/core\\\";\\n+import {\\n+  AdminError,\\n+  type AdminOperationContext,\\n+  type AdminOperationResult,\\n+} from \\\"@superfunctions/admin\\\";\\n+import type { BillFnAdminService } from \\\"./index.js\\\";\\n+\\n+type JsonRecord = Record<string, unknown>;\\n+\\n+export interface BillFnDomainAdminServiceOptions {\\n+  billfn: BillFnInstance;\\n+  /** Resolves the billable subject only after Super Console scope authorization. */\\n+  subject(context: AdminOperationContext): BillableSubject | Promise<BillableSubject>;\\n+}\\n+\\n+function string(value: unknown, name: string): string {\\n+  if (typeof value !== \\\"string\\\" || value.length === 0) {\\n+    throw new AdminError(\\\"invalid_argument\\\", `${name} must be a non-empty string.`);\\n+  }\\n+  return value;\\n+}\\n+\\n+function optionalString(value: unknown, name: string): string | undefined {\\n+  return value === undefined ? undefined : string(value, name);\\n+}\\n+\\n+function unwrap<T>(value: { ok: true; data: T } | { ok: false; error: { code: string; message: string; status: number; retryable: boolean; details?: unknown } }): T {\\n+  if (value.ok) return value.data;\\n+  const code = value.error.status === 404\\n+    ? \\\"not_found\\\"\\n+    : value.error.status === 403\\n+      ? \\\"forbidden\\\"\\n+      : value.error.status === 409\\n+        ? \\\"conflict\\\"\\n+        : value.error.status >= 500\\n+          ? \\\"dependency_unavailable\\\"\\n+          : \\\"invalid_argument\\\";\\n+  throw new AdminError(code, value.error.message, {\\n+    details: value.error.details,\\n+    retryable: value.error.retryable,\\n+  });\\n+}\\n+\\n+function asJson(value: object): JsonRecord {\\n+  return { ...value };\\n+}\\n+\\n+function list(values: object[]): AdminOperationResult<JsonRecord> {\\n+  return { ok: true, data: { items: values.map(asJson), nextCursor: null } };\",\n            \"line\": null,\n            \"originalLine\": 55\n          }\n        ]\n      }\n    }\n  ]\n}\n","stderr":"","aggregated_output":"{\n  \"pageInfo\": {\n    \"hasNextPage\": true,\n    \"endCursor\": \"REDACTED\"\n  },\n  \"total\": 100,\n  \"unresolved\": [\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6bNv6J\",\n      \"isResolved\": false,\n      \"path\": \"searchfn/admin/src/domain-service.ts\",\n      \"line\": null,\n      \"originalLine\": 56,\n      \"comments\": {\n        \"nodes\": [\n          {\n            \"id\": \"PRRC_kwDOP-e7KM7kY-UH\",\n            \"body\": \"**<sub><sub>![P1 Badge](https://img.shields.io/badge/P1-orange?style=flat)</sub></sub>  Preserve numeric-looking string document IDs**\\n\\nFor a composite target such as `orders:001`, this converts the document ID from the string `\\\"001\\\"` to the number `1`. Single-document indexing therefore targets a different ID than batch indexing, which preserves string IDs, and `remove-document` can delete numeric document `1` instead of string document `\\\"001\\\"`. Preserve the ID suffix as a string or carry explicit ID-type information in the input.\\n\\nUseful? React with 👍 / 👎.\",\n            \"author\": {\n              \"login\": \"chatgpt-codex-connector\"\n            },\n            \"createdAt\": \"2026-08-21T16:01:33Z\",\n            \"outdated\": true,\n            \"url\": \"https://github.com/21nCo/super-functions/pull/116#discussion_r3831751943\",\n            \"diffHunk\": \"@@ -0,0 +1,169 @@\\n+import type { SearchAdapter, SearchDocument } from \\\"@searchfn/adapter-contracts\\\";\\n+import {\\n+  AdminError,\\n+  type AdminOperationContext,\\n+  type AdminOperationResult,\\n+} from \\\"@superfunctions/admin\\\";\\n+import type {\\n+  SearchFnAdminRecord,\\n+  SearchFnAdminService,\\n+  SearchFnItemOutput,\\n+  SearchFnListOutput,\\n+  SearchFnMutationOutput,\\n+} from \\\"./types.js\\\";\\n+\\n+type JsonRecord = Record<string, unknown>;\\n+\\n+export interface SearchFnDomainAdminServiceOptions {\\n+  /** Must resolve an adapter already isolated to the active scope and optional namespace/region. */\\n+  adapter(context: AdminOperationContext): SearchAdapter | Promise<SearchAdapter>;\\n+  /** Returns the configured index names visible inside the same isolated adapter. */\\n+  resources(context: AdminOperationContext): readonly string[] | Promise<readonly string[]>;\\n+}\\n+\\n+function object(value: unknown, name: string): JsonRecord {\\n+  if (!value || typeof value !== \\\"object\\\" || Array.isArray(value)) {\\n+    throw new AdminError(\\\"invalid_argument\\\", `${name} must be an object.`);\\n+  }\\n+  return value as JsonRecord;\\n+}\\n+\\n+function string(value: unknown, name: string): string {\\n+  if (typeof value !== \\\"string\\\" || value.length === 0) {\\n+    throw new AdminError(\\\"invalid_argument\\\", `${name} must be a non-empty string.`);\\n+  }\\n+  return value;\\n+}\\n+\\n+function item(value: object): AdminOperationResult<SearchFnItemOutput> {\\n+  return { ok: true, data: { item: { ...value } } };\\n+}\\n+\\n+function list(values: object[]): AdminOperationResult<SearchFnListOutput> {\\n+  return { ok: true, data: { items: values.map((value) => ({ ...value })), nextCursor: null } };\\n+}\\n+\\n+function accepted(value: JsonRecord): AdminOperationResult<SearchFnMutationOutput> {\\n+  return { ok: true, data: { accepted: true, ...value } };\\n+}\\n+\\n+function splitDocumentId(value: string): { resource: string; id: string | number } {\\n+  const separator = value.indexOf(\\\":\\\");\\n+  if (separator <= 0 || separator === value.length - 1) {\\n+    throw new AdminError(\\\"invalid_argument\\\", \\\"SearchFn document targets use the form resource:id.\\\");\\n+  }\\n+  const id = value.slice(separator + 1);\\n+  return { resource: value.slice(0, separator), id: /^\\\\d+$/.test(id) ? Number(id) : id };\",\n            \"line\": null,\n            \"originalLine\": 56\n          }\n        ]\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6bNv6M\",\n      \"isResolved\": false,\n      \"path\": \"searchfn/admin/src/domain-service.ts\",\n      \"line\": null,\n      \"originalLine\": 110,\n      \"comments\": {\n        \"nodes\": [\n          {\n            \"id\": \"PRRC_kwDOP-e7KM7kY-UL\",\n            \"body\": \"**<sub><sub>![P2 Badge](https://img.shields.io/badge/P2-yellow?style=flat)</sub></sub>  Apply the declared index-list query parameters**\\n\\nWhen an installation has many configured indexes or the console supplies search/filter/pagination input, `listIndexes` ignores the entire input and always returns every index with `nextCursor: null`. This contradicts the operation's cursor-pagination declaration and makes the resource-list search UI return unrelated entries while bypassing the declared 200-item maximum; honor `limit`, `cursor`, and the advertised query fields before building the result.\\n\\nUseful? React with 👍 / 👎.\",\n            \"author\": {\n              \"login\": \"chatgpt-codex-connector\"\n            },\n            \"createdAt\": \"2026-08-21T16:01:33Z\",\n            \"outdated\": true,\n            \"url\": \"https://github.com/21nCo/super-functions/pull/116#discussion_r3831751947\",\n            \"diffHunk\": \"@@ -0,0 +1,169 @@\\n+import type { SearchAdapter, SearchDocument } from \\\"@searchfn/adapter-contracts\\\";\\n+import {\\n+  AdminError,\\n+  type AdminOperationContext,\\n+  type AdminOperationResult,\\n+} from \\\"@superfunctions/admin\\\";\\n+import type {\\n+  SearchFnAdminRecord,\\n+  SearchFnAdminService,\\n+  SearchFnItemOutput,\\n+  SearchFnListOutput,\\n+  SearchFnMutationOutput,\\n+} from \\\"./types.js\\\";\\n+\\n+type JsonRecord = Record<string, unknown>;\\n+\\n+export interface SearchFnDomainAdminServiceOptions {\\n+  /** Must resolve an adapter already isolated to the active scope and optional namespace/region. */\\n+  adapter(context: AdminOperationContext): SearchAdapter | Promise<SearchAdapter>;\\n+  /** Returns the configured index names visible inside the same isolated adapter. */\\n+  resources(context: AdminOperationContext): readonly string[] | Promise<readonly string[]>;\\n+}\\n+\\n+function object(value: unknown, name: string): JsonRecord {\\n+  if (!value || typeof value !== \\\"object\\\" || Array.isArray(value)) {\\n+    throw new AdminError(\\\"invalid_argument\\\", `${name} must be an object.`);\\n+  }\\n+  return value as JsonRecord;\\n+}\\n+\\n+function string(value: unknown, name: string): string {\\n+  if (typeof value !== \\\"string\\\" || value.length === 0) {\\n+    throw new AdminError(\\\"invalid_argument\\\", `${name} must be a non-empty string.`);\\n+  }\\n+  return value;\\n+}\\n+\\n+function item(value: object): AdminOperationResult<SearchFnItemOutput> {\\n+  return { ok: true, data: { item: { ...value } } };\\n+}\\n+\\n+function list(values: object[]): AdminOperationResult<SearchFnListOutput> {\\n+  return { ok: true, data: { items: values.map((value) => ({ ...value })), nextCursor: null } };\\n+}\\n+\\n+function accepted(value: JsonRecord): AdminOperationResult<SearchFnMutationOutput> {\\n+  return { ok: true, data: { accepted: true, ...value } };\\n+}\\n+\\n+function splitDocumentId(value: string): { resource: string; id: string | number } {\\n+  const separator = value.indexOf(\\\":\\\");\\n+  if (separator <= 0 || separator === value.length - 1) {\\n+    throw new AdminError(\\\"invalid_argument\\\", \\\"SearchFn document targets use the form resource:id.\\\");\\n+  }\\n+  const id = value.slice(separator + 1);\\n+  return { resource: value.slice(0, separator), id: /^\\\\d+$/.test(id) ? Number(id) : id };\\n+}\\n+\\n+function documents(value: unknown): SearchDocument[] {\\n+  if (!Array.isArray(value) || value.length === 0) {\\n+    throw new AdminError(\\\"invalid_argument\\\", \\\"payload.documents must be a non-empty array.\\\");\\n+  }\\n+  return value.map((entry, index) => {\\n+    const document = object(entry, `payload.documents[${index}]`);\\n+    const id = document.id;\\n+    if (typeof id !== \\\"string\\\" && typeof id !== \\\"number\\\") {\\n+      throw new AdminError(\\\"invalid_argument\\\", `payload.documents[${index}].id must be a string or number.`);\\n+    }\\n+    const fields = object(document.fields, `payload.documents[${index}].fields`);\\n+    if (Object.values(fields).some((field) => typeof field !== \\\"string\\\")) {\\n+      throw new AdminError(\\\"invalid_argument\\\", `payload.documents[${index}].fields values must be strings.`);\\n+    }\\n+    return { id, fields: fields as Record<string, string> };\\n+  });\\n+}\\n+\\n+/** Delegates to the configured SearchAdapter; no raw backend or cross-scope query is constructed here. */\\n+export function createSearchFnDomainAdminService(\\n+  options: SearchFnDomainAdminServiceOptions,\\n+): SearchFnAdminService {\\n+  const state = async (context: AdminOperationContext) => {\\n+    const adapter = await options.adapter(context);\\n+    const resources = [...await options.resources(context)];\\n+    return {\\n+      adapter,\\n+      resources,\\n+      adapterInfo: {\\n+        id: adapter.name,\\n+        name: adapter.name,\\n+        status: \\\"available\\\",\\n+        capabilities: adapter.capabilities ?? {},\\n+      } satisfies SearchFnAdminRecord,\\n+      indexInfo: resources.map((resource) => ({ id: resource, name: resource, status: \\\"available\\\" })),\\n+    };\\n+  };\\n+\\n+  return {\\n+    async listAdapters(_input, context) {\\n+      const { adapterInfo } = await state(context);\\n+      return list([adapterInfo]);\\n+    },\\n+    async getAdapter(input, context) {\\n+      const { adapter, adapterInfo } = await state(context);\\n+      if (string(input.id, \\\"id\\\") !== adapter.name) {\\n+        throw new AdminError(\\\"not_found\\\", \\\"SearchFn adapter was not found in the active scope.\\\");\\n+      }\\n+      return item(adapterInfo);\\n+    },\\n+    async listIndexes(_input, context) {\\n+      return list((await state(context)).indexInfo);\",\n            \"line\": null,\n            \"originalLine\": 110\n          }\n        ]\n      }\n    },\n    {\n      \"id\": \"PRRT_kwDOP-e7KM6bODiX\",\n      \"isResolved\": false,\n      \"path\": \"uifn/core/scripts/build.mjs\",\n      \"line\": 24,\n      \"originalLine\": 24,\n      \"comments\": {\n        \"nodes\": [\n          {\n            \"id\": \"PRRC_kwDOP-e7KM7kZbOC\",\n            \"body\": \"<!-- cubic:v=1e8a9759-bd72-4e24-bd8c-217d1bba06d6 -->\\n<!-- cubic:review-run=7bb8304f-392d-4952-ab05-eaf35f279889 -->\\n<!-- metadata:{\\\"confidence\\\":10} -->\\nP1: When the build reaches `accordion`, it asks tsup to bundle nonexistent `createAccordionController`, so the build fails before producing any public primitive entrypoints. Add the missing controller exports or map catalog entries to verified source exports before bundling.\\n\\n<details>\\n<summary>Prompt for AI agents</summary>\\n\\n```text\\nCheck if this issue is valid — if so, understand the root cause and fix it. At uifn/core/scripts/build.mjs, line 24:\\n\\n<comment>When the build reaches `accordion`, it asks tsup to bundle nonexistent `createAccordionController`, so the build fails before producing any public primitive entrypoints. Add the missing controller exports or map catalog entries to verified source exports before bundling.</comment>\\n\\n<file context>\\n@@ -0,0 +1,89 @@\\n+        ? 'CreateHoverCardProps'\\n+        : `${primitive.name}Props`,\\n+      runtime: interactive\\n+        ? `create${primitive.name}Controller`\\n+        : `${primitive.name}Contract`,\\n+      secondaryType: interactive\\n</file context>\\n```\\n\\n</details>\",\n            \"author\": {\n              \"login\": \"cubic-dev-ai\"\n            },\n            \"createdAt\": \"2026-08-21T16:19:44Z\",\n            \"outdated\": true,\n            \"url\": \"https://github.com/21nCo/super-functions/pull/116#discussion_r3831870338\",\n            \"diffHunk\": \"@@ -0,0 +1,89 @@\\n+#!/usr/bin/env node\\n+\\n+import { existsSync, mkdirSync, mkdtempSync, readFileSync, rmSync, statSync, writeFileSync } from 'node:fs';\\n+import { tmpdir } from 'node:os';\\n+import path from 'node:path';\\n+