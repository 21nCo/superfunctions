{"timestamp":"2026-08-23T16:26:14.856Z","ordinal":13744,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a02f71-afc8-7df3-899a-87603366e19b","call_id":"call_rWnzHmtKmSJBkXCJ9g8slKHC","output":[{"type":"input_text","text":"Script completed\nWall time 1.1 seconds\nOutput:\n"},{"type":"input_text","text":"    45\t    expect(manager.activeScopeId).toBe('parent');\n    46\t    expect(parent.paused).toBe(false);\n    47\t    manager.destroy();\n    48\t  });\n    49\t\n    50\t  it('derives nesting from the newest enabled scope across three levels', () => {\n    51\t    const manager = createUIFnFocusScopeManager(scopeFixture());\n    52\t    const parent = manager.register({ id: 'parent', container: {} as HTMLElement, deferInitialFocus: true });\n    53\t    const middle = manager.register({ id: 'middle', container: {} as HTMLElement, deferInitialFocus: true });\n    54\t    const child = manager.register({ id: 'child', container: {} as HTMLElement, deferInitialFocus: true, returnFocus: false });\n    55\t\n    56\t    expect(manager.activeScopeId).toBe('child');\n    57\t    middle.update({ enabled: false });\n    58\t    middle.update({ enabled: true });\n    59\t    expect(manager.activeScopeId).toBe('child');\n    60\t\n    61\t    child.update({ enabled: false });\n    62\t    expect(manager.activeScopeId).toBe('middle');\n    63\t    expect(parent.paused).toBe(true);\n    64\t    expect(middle.paused).toBe(false);\n    65\t    manager.destroy();\n    66\t  });\n    67\t\n    68\t  it('keeps an explicit pause after a nested scope is destroyed', () => {\n    69\t    const manager = createUIFnFocusScopeManager(scopeFixture());\n    70\t    const parent = manager.register({ id: 'parent', container: {} as HTMLElement, deferInitialFocus: true });\n    71\t    parent.pause();\n    72\t    const child = manager.register({ id: 'child', container: {} as HTMLElement, deferInitialFocus: true });\n    73\t\n    74\t    child.destroy();\n    75\t  