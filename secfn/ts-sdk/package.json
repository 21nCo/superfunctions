{
  "name": "secfn",
  "version": "0.0.2",
  "description": "Comprehensive self-hosted security platform for developers",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest --coverage",
    "lint": "eslint src/**/*.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "security",
    "secrets",
    "scanning",
    "rbac",
    "rate-limiting",
    "access-control",
    "vault",
    "monitoring",
    "self-hosted"
  ],
  "author": "21n",
  "license": "MIT",
  "dependencies": {
    "glob": "^11.0.0",
    "simple-git": "^3.27.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4",
    "fake-indexeddb": "^6.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "eslint": "^9.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0"
  },
  "peerDependencies": {
    "@superfunctions/db": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@superfunctions/db": {
      "optional": true
    }
  }
}