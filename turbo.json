{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    "scripts/**",
    "!scripts/promote.*",
    "!scripts/verify-public-boundary.*",
    "!scripts/public-boundary.allow.json",
    "!scripts/verify-owners.*",
    "!scripts/owners.*",
    "!scripts/workspaces.*",
    "!scripts/verify-package-lockfiles.*",
    "!scripts/resolve-release-tag.*",
    "!scripts/uifn-docs-cli-resolution.*",
    "!scripts/assert-release-owner.*",
    "!scripts/assert-release-ci.*",
    "!scripts/release-gate-workflows.*",
    "package.json",
    "tsconfig*.json",
    "vitest.config.*",
    "*/tsconfig*.json",
    "*/vitest.config.*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["build"]
    },
    "scan": {
      "dependsOn": ["build"],
      "outputs": ["scan-results/**", "reports/**"]
    },
    "package": {
      "dependsOn": ["build"],
      "outputs": ["artifacts/**", "packages/**"]
    },
    "clean": {
      "cache": false
    }
  },
  "globalEnv": ["CLOUDFLARE_DOCS_DEPLOY", "CLOUDFLARE_DOCS_PUBLIC_ORIGIN", "CLOUDFLARE_DOCS_ASSETS_ORIGIN"]
}
