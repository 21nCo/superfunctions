        "$TURBO_ROOT$/uifn/evidence/generated/phase-14/phase-14-public-vectors.json",
        "$TURBO_ROOT$/uifn/parity/src/trace.mjs",
        "$TURBO_ROOT$/uifn/parity/src/trace.d.mts"
      ]
    },
    "@uifn/solid#typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/uifn/catalog/generated/catalog.json",
        "$TURBO_ROOT$/uifn/evidence/generated/phase-13/phase-13-solid-compounds.json",
        "$TURBO_ROOT$/uifn/evidence/generated/phase-14/phase-14-public-vectors.json",
        "$TURBO_ROOT$/uifn/parity/src/trace.mjs",
        "$TURBO_ROOT$/uifn/parity/src/trace.d.mts"
      ]
    },
    "@uifn/solid#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/uifn/catalog/generated/catalog.json",
        "$TURBO_ROOT$/uifn/evidence/generated/phase-13/phase-13-solid-compounds.json",
        "$TURBO_ROOT$/uifn/evidence/generated/phase-14/phase-14-public-vectors.json",
        "$TURBO_ROOT$/uifn/parity/src/trace.mjs",
        "$TURBO_ROOT$/uifn/parity/src/trace.d.mts"
      ]
    },
    "@uifn/solid#lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/uifn/catalog/generated/catalog.json",
        "$TURBO_ROOT$/uifn/evidence/generated/phase-13/phase-13-solid-compounds.json",
        "$TURBO_ROOT$/uifn/evidence/generated/phase-14/phase-14-public-vectors.json",
        "$TURBO_ROOT$/uifn/parity/src/trace.mjs",
        "$TURBO_ROOT$/uifn/parity/src/trace.d.mts"
      ]
    },
    "@uifn/svelte#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/uifn/catalog/generated/catalog.json",
        "$TURBO_ROOT$/uifn/evidence/generated/phase-12/phase-12-svelte-compounds.json",
        "$TURBO_ROOT$/uifn/evidence/generated/phase-14/phase-14-public-vectors.json",
        "$TURBO_ROOT$/uifn/parity/src/trace.mjs",
        "$TURBO_ROOT$/uifn/parity/src/trace.d.mts"
      ]
    },
    "@uifn/svelte#typecheck": {
