{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    "scripts/**",
    "!scripts/promote.*",
    "!scripts/verify-public-boundary.*",
    "!scripts/public-boundary.allow.json",
    "!scripts/verify-owners.*",
    "!scripts/owners.*",
    "!scripts/workspaces.*",
    "!scripts/verify-package-lockfiles.*",
    "!scripts/resolve-release-tag.*",
    "!scripts/assert-bare-release.*",
    "!scripts/bare-cli-shim.*",
    "!scripts/uifn-docs-cli-resolution.*",
    "!scripts/assert-release-owner.*",
    "!scripts/assert-release-ci.*",
    "!scripts/release-gate-workflows.*",
    "!scripts/notify-next-sync-workflow.*",
    "!scripts/turbo-cache-merge.*",
    "!scripts/workflow-pins.test.mjs",
    "package.json",
    "tsconfig*.json",
    "vitest.config.*",
    "*/tsconfig*.json",
    "*/vitest.config.*"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "test:watch": {
      "cache": false,
      "persistent": true
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "deploy": {
      "dependsOn": ["build"]
    },
    "scan": {
      "dependsOn": ["build"],
      "outputs": ["scan-results/**", "reports/**"]
    },
    "package": {
      "dependsOn": ["build"],
      "outputs": ["artifacts/**", "packages/**"]
    },
    "clean": {
      "cache": false
    },
    "@devfn/cli#build": { "dependsOn": ["^build"], "cache": false },
    "@devfn/cli#typecheck": { "dependsOn": ["^build"], "cache": false },
    "@devfn/cli#test": { "dependsOn": ["^build"], "cache": false },
    "@devfn/cli#lint": { "dependsOn": ["^build"], "cache": false },
    "@devfn/compose#build": { "dependsOn": ["^build"], "cache": false },
    "@devfn/compose#typecheck": { "dependsOn": ["^build"], "cache": false },
    "@devfn/compose#test": { "dependsOn": ["^build"], "cache": false },
    "@devfn/compose#lint": { "dependsOn": ["^build"], "cache": false },
    "@devfn/config#build": { "dependsOn": ["^build"], "cache": false },
    "@devfn/config#typecheck": { "dependsOn": ["^build"], "cache": false },
    "@devfn/config#test": { "dependsOn": ["^build"], "cache": false },
    "@devfn/config#lint": { "dependsOn": ["^build"], "cache": false },
    "@devfn/core#build": { "dependsOn": ["^build"], "cache": false },
    "@devfn/core#typecheck": { "dependsOn": ["^build"], "cache": false },
    "@devfn/core#test": { "dependsOn": ["^build"], "cache": false },
    "@devfn/core#lint": { "dependsOn": ["^build"], "cache": false },
    "@devfn/docs#build": { "dependsOn": ["^build"], "cache": false },
    "@devfn/docs#typecheck": { "dependsOn": ["^build"], "cache": false },
    "@devfn/docs#test": { "dependsOn": ["^build"], "cache": false },
    "@devfn/docs#lint": { "dependsOn": ["^build"], "cache": false },
    "@devfn/ports#build": { "dependsOn": ["^build"], "cache": false },
    "@devfn/ports#typecheck": { "dependsOn": ["^build"], "cache": false },
    "@devfn/ports#test": { "dependsOn": ["^build"], "cache": false },
    "@devfn/ports#lint": { "dependsOn": ["^build"], "cache": false },
    "@devfn/processes#build": { "dependsOn": ["^build"], "cache": false },
    "@devfn/processes#typecheck": { "dependsOn": ["^build"], "cache": false },
    "@devfn/processes#test": { "dependsOn": ["^build"], "cache": false },
    "@devfn/processes#lint": { "dependsOn": ["^build"], "cache": false },
    "@devfn/proxy#build": { "dependsOn": ["^build"], "cache": false },
    "@devfn/proxy#typecheck": { "dependsOn": ["^build"], "cache": false },
    "@devfn/proxy#test": { "dependsOn": ["^build"], "cache": false },
    "@devfn/proxy#lint": { "dependsOn": ["^build"], "cache": false },
    "@devfn/testing#build": { "dependsOn": ["^build"], "cache": false },
    "@devfn/testing#typecheck": { "dependsOn": ["^build"], "cache": false },
    "@devfn/testing#test": { "dependsOn": ["^build"], "cache": false },
    "@devfn/testing#lint": { "dependsOn": ["^build"], "cache": false },
    "@uifn/core#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/uifn/catalog/generated/catalog.json"
      ]
    },
    "@uifn/core#typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/uifn/catalog/generated/catalog.json"
      ]
    },
    "@uifn/core#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/uifn/catalog/generated/catalog.json"
      ]
    },
    "@uifn/core#lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/uifn/catalog/generated/catalog.json"
      ]
    },
    "@uifn/react#build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/uifn/catalog/generated/catalog.json",
        "$TURBO_ROOT$/uifn/evidence/generated/phase-11/phase-11-react-compounds.json",
        "$TURBO_ROOT$/uifn/evidence/generated/phase-14/phase-14-public-vectors.json",
        "$TURBO_ROOT$/uifn/parity/src/trace.mjs",
        "$TURBO_ROOT$/uifn/parity/src/trace.d.mts"
      ]
    },
    "@uifn/react#typecheck": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/uifn/catalog/generated/catalog.json",
        "$TURBO_ROOT$/uifn/evidence/generated/phase-11/phase-11-react-compounds.json",
        "$TURBO_ROOT$/uifn/evidence/generated/phase-14/phase-14-public-vectors.json",
        "$TURBO_ROOT$/uifn/parity/src/trace.mjs",
        "$TURBO_ROOT$/uifn/parity/src/trace.d.mts"
      ]
    },
    "@uifn/react#test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/uifn/catalog/generated/catalog.json",
        "$TURBO_ROOT$/uifn/evidence/generated/phase-11/phase-11-react-compounds.json",
        "$TURBO_ROOT$/uifn/evidence/generated/phase-14/phase-14-public-vectors.json",
        "$TURBO_ROOT$/uifn/parity/src/trace.mjs",
        "$TURBO_ROOT$/uifn/parity/src/trace.d.mts"
      ]
    },
    "@uifn/react#lint": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/uifn/catalog/generated/catalog.json",
        "$TURBO_ROOT$/uifn/evidence/generated/phase-11/phase-11-react-compounds.json",
        "$TURBO_ROOT$/uifn/evidence/generated/phase-14/phase-14-public-vectors.json",
        "$TURBO_ROOT$/uifn/parity/src/trace.mjs",
        "$TURBO_ROOT$/uifn/parity/src/trace.d.mts"
