{
  "name": "@memoryfn/core",
  "version": "0.0.3",
  "description": "Self-hostable AI memory system for agents and applications",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./http": {
      "types": "./dist/http/index.d.ts",
      "default": "./dist/http/index.js"
    },
    "./mcp": {
      "types": "./dist/mcp/index.d.ts",
      "default": "./dist/mcp/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mcpfn/core": "file:../../mcpfn/core",
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@superfunctions/db": "0.1.4",
    "@superfunctions/http": "0.1.3",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.8",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.22.4",
    "openai": "^4.0.0"
  },
  "peerDependencies": {
    "@superfunctions/auth": "0.1.2",
    "@watchfn/core": "0.0.3",
    "secfn": "*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "memoryfn/typescript"
  },
  "publishConfig": {
    "access": "public"
  },
  "superfunctions": {
    "initFunction": "memoryFn",
    "schemaVersion": 1,
    "namespace": "memoryfn"
  }
}
