{
  "name": "@probefn/admin",
  "version": "0.1.0",
  "private": true,
  "description": "Private self-hosted Super Console administration capability for ProbeFn",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "probefn",
    "admin",
    "super-console",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "dependencies": {
    "@probefn/contracts": "*",
    "@probefn/core": "*",
    "@probefn/storage": "*",
    "@superfunctions/admin": "0.1.5"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
