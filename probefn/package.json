{
  "name": "probefn",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "probefn": "jiti apps/cli/src/index.ts",
    "test": "turbo run test",
    "test:vectors": "jiti scripts/test-vectors.ts",
