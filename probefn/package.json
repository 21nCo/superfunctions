    "spec:list": "find .conduct/specs -maxdepth 1 -type d | sort"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "jiti": "^2.4.2",
    "turbo": "^2.0.0",
    "typescript": "^5.8.0",
    "vitest": "^3.1.4",
    "zod": "^3.24.4"
  }
}
