{
  "name": "@probefn/workspace",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "probefn": "jiti apps/cli/src/index.ts",
    "test": "vitest run",
    "test:vectors": "jiti scripts/test-vectors.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test:browsers": "vitest run --config vitest.browsers.config.ts",
    "test:event-streaming": "jiti scripts/test-event-streaming.ts",
    "test:report-streaming": "jiti scripts/test-report-streaming.ts"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "jiti": "^2.4.2",
    "typescript": "^5.8.0",
    "vitest": "^3.1.4",
    "zod": "^3.24.4",
    "@probefn/cli": "*",
    "@probefn/analyzers": "*",
    "@probefn/browser-runner": "*",
    "@probefn/contracts": "*",
    "@probefn/core": "*",
    "@probefn/dev-server": "*",
    "@probefn/mcp-server": "*",
    "@probefn/session-reporter": "*",
    "@probefn/storage": "*",
    "@probefn/visual-baselines": "*"
