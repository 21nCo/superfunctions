{
  "name": "drawfn",
  "version": "0.0.1",
  "description": "Cross-framework drawing canvas library for brainstorming and simple sketching",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest watch"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "keywords": [
    "drawing",
    "canvas",
    "whiteboard",
    "sketch",
    "brainstorm"
  ],
  "author": "21n",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "drawfn/core"
  },
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "superfunctions": {
    "initFunction": "drawFn",
    "schemaVersion": 1,
    "namespace": "drawfn"
  },
  "dependencies": {
    "perfect-freehand": "^1.2.2"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "jsdom": "^24.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  }
}
