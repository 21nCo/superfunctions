{
  "name": "@drawfn/svelte",
  "version": "0.0.3",
  "description": "Svelte adapter for drawfn drawing canvas library",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Canvas.svelte": {
      "types": "./dist/components/Canvas.svelte.d.ts",
      "svelte": "./dist/components/Canvas.svelte",
      "default": "./dist/components/Canvas.svelte"
    },
    "./DrawfnCanvas.svelte": {
      "types": "./dist/components/DrawfnCanvas.svelte.d.ts",
      "svelte": "./dist/components/DrawfnCanvas.svelte",
      "default": "./dist/components/DrawfnCanvas.svelte"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && svelte-package -i src -o dist/components --tsconfig ./tsconfig.json",
    "build:watch": "tsup --watch",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "svelte-check --tsconfig ./tsconfig.lint.json",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.lint.json"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "keywords": [
    "drawing",
    "canvas",
    "whiteboard",
    "svelte",
    "action"
  ],
  "author": "21n",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "drawfn/drawfn-svelte"
  },
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "**/*.svelte"
  ],
  "dependencies": {
    "drawfn": "0.0.2"
  },
  "peerDependencies": {
    "svelte": "^5.57.2"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^4.0.4",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^20.0.0",
    "esbuild-svelte": "^0.9.4",
    "jsdom": "^24.0.0",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.3",
    "tsup": "^8.5.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.21",
    "vitest": "4.1.11"
  }
}
