{
  "name": "@drawfn/svelte",
  "version": "0.0.1",
  "description": "Svelte adapter for drawfn drawing canvas library",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./Canvas.svelte": {
      "svelte": "./src/Canvas.svelte",
      "default": "./src/Canvas.svelte"
    },
    "./DrawfnCanvas.svelte": {
      "svelte": "./src/DrawfnCanvas.svelte",
      "default": "./src/DrawfnCanvas.svelte"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "lint": "tsc --noEmit -p tsconfig.lint.json",
    "test": "vitest --config vitest.config.ts"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "keywords": [
    "drawing",
    "canvas",
    "whiteboard",
    "svelte",
    "action"
  ],
  "author": "21n",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "drawfn/drawfn-svelte"
  },
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "dependencies": {
    "drawfn": "*"
  },
  "peerDependencies": {
    "svelte": "^4.0.0 || ^5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^20.0.0",
    "esbuild-svelte": "^0.9.4",
    "jsdom": "^24.0.0",
    "svelte": "^4.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.3.0",
    "vite": "^5.4.21",
    "vitest": "^3.2.4"
  }
}
