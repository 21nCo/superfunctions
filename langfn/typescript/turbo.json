{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/langfn/COMPATIBILITY.md",
        "$TURBO_ROOT$/langfn/README.md",
        "$TURBO_ROOT$/langfn/RELEASE_GATE.md"
      ]
    },
    "test": {
      "dependsOn": ["^build", "@superfunctions/observability#build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/langfn/COMPATIBILITY.md",
        "$TURBO_ROOT$/langfn/README.md",
        "$TURBO_ROOT$/langfn/RELEASE_GATE.md"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/langfn/COMPATIBILITY.md",
        "$TURBO_ROOT$/langfn/README.md",
        "$TURBO_ROOT$/langfn/RELEASE_GATE.md"
      ]
    }
  }
}
