{
  "name": "@watchfn/core",
  "version": "0.0.3",
  "description": "Comprehensive self-hosted monitoring and observability platform",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./adapters/express": {
      "import": {
        "types": "./dist/adapters/express.d.mts",
        "default": "./dist/adapters/express.mjs"
      },
      "require": {
        "types": "./dist/adapters/express.d.ts",
        "default": "./dist/adapters/express.js"
      }
    },
    "./adapters/fastify": {
      "import": {
        "types": "./dist/adapters/fastify.d.mts",
        "default": "./dist/adapters/fastify.mjs"
      },
      "require": {
        "types": "./dist/adapters/fastify.d.ts",
        "default": "./dist/adapters/fastify.js"
      }
    },
    "./adapters/hono": {
      "import": {
        "types": "./dist/adapters/hono.d.mts",
        "default": "./dist/adapters/hono.mjs"
      },
      "require": {
        "types": "./dist/adapters/hono.d.ts",
        "default": "./dist/adapters/hono.js"
      }
    },
    "./adapters/next": {
      "import": {
        "types": "./dist/adapters/next.d.mts",
        "default": "./dist/adapters/next.mjs"
      },
      "require": {
        "types": "./dist/adapters/next.d.ts",
        "default": "./dist/adapters/next.js"
      }
    },
    "./adapters/sveltekit": {
      "import": {
        "types": "./dist/adapters/sveltekit.d.mts",
        "default": "./dist/adapters/sveltekit.mjs"
      },
      "require": {
        "types": "./dist/adapters/sveltekit.d.ts",
        "default": "./dist/adapters/sveltekit.js"
      }
    }
  },
  "scripts": {
    "build": "tsup && node scripts/bundle-declarations.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@superfunctions/db": "0.4.0",
    "@superfunctions/http": "0.3.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@superfunctions/http-express": "0.1.3",
    "@superfunctions/http-fastify": "0.1.2",
    "@superfunctions/http-hono": "0.1.2",
    "@superfunctions/http-next": "0.1.2",
    "@superfunctions/http-sveltekit": "0.1.2",
    "@sveltejs/kit": "^2.0.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "express": "^4.21.2",
    "fastify": "^5.2.0",
    "hono": "4.11.9",
    "next": "^15.0.0",
    "rollup": "^4.64.10",
    "rollup-plugin-dts": "^6.5.1",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "observability",
    "monitoring",
    "apm",
    "rum",
    "logging"
  ],
  "author": "21n",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "watchfn/typescript"
  },
  "publishConfig": {
    "access": "public"
  },
  "superfunctions": {
    "initFunction": "watchFn",
    "schemaVersion": 1,
    "namespace": "watchfn"
  },
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "@superfunctions/http-express": "0.1.3",
    "@superfunctions/http-fastify": "0.1.2",
    "@superfunctions/http-hono": "0.1.2",
    "@superfunctions/http-next": "0.1.2",
    "@superfunctions/http-sveltekit": "0.1.2",
    "@sveltejs/kit": "^1.0.0 || ^2.0.0",
    "express": "^4.0.0 || ^5.0.0",
    "fastify": "^4.0.0 || ^5.0.0",
    "hono": "^4.0.0",
    "next": ">=13.4.0"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "@sveltejs/kit": {
      "optional": true
    },
    "@superfunctions/http-express": {
      "optional": true
    },
    "@superfunctions/http-fastify": {
      "optional": true
    },
    "@superfunctions/http-hono": {
      "optional": true
    },
    "@superfunctions/http-next": {
      "optional": true
    },
    "@superfunctions/http-sveltekit": {
      "optional": true
    }
  }
}
