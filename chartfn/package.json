{
  "name": "chartfn",
  "version": "0.0.3",
  "description": "Charting library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "test:package": "npm run build && npm run build --workspace @chartfn/react && npm run build --workspace @chartfn/svelte && node scripts/packed-consumer.mjs"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "keywords": [],
  "author": "21n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "chartfn"
  },
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "superfunctions": {
    "initFunction": "chartFn",
    "schemaVersion": 1,
    "namespace": "chartfn"
  },
  "dependencies": {
    "chart.js": "^4.4.1",
    "echarts": "^6.1.0",
    "@carbon/charts": "1.27.21"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0",
    "vitest": "4.1.11"
  }
}
