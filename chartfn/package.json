{
  "name": "chartfn",
  "version": "0.0.2",
  "description": "Charting library",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:watch": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "echo 'lint not configured'",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "keywords": [],
  "author": "21n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "chartfn"
  },
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "superfunctions": {
    "initFunction": "chartFn",
    "schemaVersion": 1,
    "namespace": "chartfn"
  },
  "dependencies": {
    "@carbon/charts-react": "^1.27.2",
    "chart.js": "^4.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "echarts": "^5.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
