{
  "name": "@chartfn/svelte",
  "version": "0.0.2",
  "description": "Svelte bindings for chartfn",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "svelte": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "types": "./dist/index.d.ts",
      "svelte": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest --config vitest.config.mts",
    "lint": "echo 'lint not configured'"
  },
  "dependencies": {
    "chartfn": "0.0.2"
  },
  "peerDependencies": {
    "svelte": ">=5.0.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@testing-library/svelte": "^5.3.1",
    "esbuild-svelte": "^0.9.4",
    "jsdom": "^27.0.1",
    "svelte": "^5.46.1",
    "vite": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.2.4"
  },
  "keywords": [
    "svelte",
    "chart",
    "chartfn"
  ],
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "author": "21n",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "chartfn/svelte"
  },
  "publishConfig": {
    "access": "public"
  }
}
