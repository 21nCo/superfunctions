    "test:native": "vitest run tests/sqlite-http.test.ts"
  },
  "dependencies": {
    "@superfunctions/auth": "0.1.2",
    "@superfunctions/db": "0.4.0",
    "@superfunctions/http": "0.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/better-sqlite3": "^7.6.13",
    "better-sqlite3": "^12.5.0",
    "kysely": "^0.28.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
