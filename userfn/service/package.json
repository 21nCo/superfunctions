{
  "name": "@userfn/service",
  "version": "0.0.1",
  "description": "Tenant-scoped UserFn feedback HTTP and database service",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
