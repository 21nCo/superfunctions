{
  "name": "sendfn",
  "version": "0.0.1",
  "description": "Unified communications platform SDK for email and push notifications",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest",
    "lint": "tsc --noEmit",
    "release:verify": "npm run build && npm run lint && npm test -- --run"
  },
  "keywords": [
    "email",
    "push",
    "notifications",
    "ses",
    "fcm",
    "apns",
    "sdk"
  ],
  "author": "21n",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "sendfn/typescript"
  },
  "publishConfig": {
    "access": "public"
  },
  "overrides": {
    "fast-xml-parser": "^4.5.4"
  },
  "superfunctions": {
    "initFunction": "sendFn",
    "schemaVersion": 1,
    "namespace": "sendfn"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.400.0",
    "@superfunctions/db": "0.1.3",
    "@superfunctions/http": "0.1.2",
    "apns2": "^11.0.0",
    "firebase-admin": "^12.0.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
