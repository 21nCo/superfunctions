{
  "name": "@docsfn/svelte",
  "version": "0.0.1",
  "description": "Svelte components and helpers for docsfn",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "svelte": "src/index.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./src/index.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./ApiReferenceRenderer.svelte": {
      "types": "./dist/ApiReferenceRenderer.d.ts",
      "svelte": "./src/ApiReferenceRenderer.svelte",
      "import": "./dist/ApiReferenceRenderer.js",
      "require": "./dist/ApiReferenceRenderer.cjs"
    },
    "./Breadcrumbs.svelte": {
      "types": "./dist/Breadcrumbs.d.ts",
      "svelte": "./src/Breadcrumbs.svelte",
      "import": "./dist/Breadcrumbs.js",
      "require": "./dist/Breadcrumbs.cjs"
    },
    "./DocsContent.svelte": {
      "types": "./dist/DocsContent.d.ts",
      "svelte": "./src/DocsContent.svelte",
      "import": "./dist/DocsContent.js",
      "require": "./dist/DocsContent.cjs"
    },
    "./DocsLayout.svelte": {
      "types": "./dist/DocsLayout.d.ts",
      "svelte": "./src/DocsLayout.svelte",
      "import": "./dist/DocsLayout.js",
      "require": "./dist/DocsLayout.cjs"
    },
    "./DocsSearch.svelte": {
      "types": "./dist/DocsSearch.d.ts",
      "svelte": "./src/DocsSearch.svelte",
      "import": "./dist/DocsSearch.js",
      "require": "./dist/DocsSearch.cjs"
    },
    "./DocsSidebar.svelte": {
      "types": "./dist/DocsSidebar.d.ts",
      "svelte": "./src/DocsSidebar.svelte",
      "import": "./dist/DocsSidebar.js",
