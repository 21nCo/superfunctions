      "require": "./dist/Pagination.cjs"
    },
    "./SidebarGroup.svelte": {
      "types": "./dist/SidebarGroup.d.ts",
      "svelte": "./src/SidebarGroup.svelte",
      "import": "./dist/SidebarGroup.js",
      "require": "./dist/SidebarGroup.cjs"
    },
    "./TopBar.svelte": {
      "types": "./dist/TopBar.d.ts",
      "svelte": "./src/TopBar.svelte",
      "import": "./dist/TopBar.js",
      "require": "./dist/TopBar.cjs"
    },
    "./VersionSwitcher.svelte": {
      "types": "./dist/VersionSwitcher.d.ts",
      "svelte": "./src/VersionSwitcher.svelte",
      "import": "./dist/VersionSwitcher.js",
      "require": "./dist/VersionSwitcher.cjs"
    },
    "./theme.css": "./dist/theme.css",
    "./theme-base.css": "./dist/theme-base.css"
