    },
    "./DocsToc.svelte": {
      "types": "./dist/DocsToc.d.ts",
      "svelte": "./src/DocsToc.svelte",
      "import": "./dist/DocsToc.js",
      "require": "./dist/DocsToc.cjs"
    },
    "./EmbeddedPage.svelte": {
      "types": "./dist/EmbeddedPage.d.ts",
      "svelte": "./src/EmbeddedPage.svelte",
      "import": "./dist/EmbeddedPage.js",
      "require": "./dist/EmbeddedPage.cjs"
    },
    "./Pagination.svelte": {
      "types": "./dist/Pagination.d.ts",
      "svelte": "./src/Pagination.svelte",
