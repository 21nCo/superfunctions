cript\": \"^5.6.0\",\n    \"vitest\": \"^3.2.4\"\n  }\n}\n== datafn/cli ==\n{\n  \"name\": \"@datafn/cli\",\n  \"scripts\": {\n    \"build\": \"tsup\",\n    \"clean\": \"rm -rf dist\",\n    \"test\": \"npm run build && vitest run\",\n    \"test:watch\": \"vitest watch\"\n  },\n  \"dependencies\": {\n    \"@datafn/core\": \"0.0.4\",\n    \"@datafn/client\": \"0.0.4\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^20.0.0\",\n    \"tsup\": \"^8.0.0\",\n    \"typescript\": \"^5.0.0\",\n    \"vitest\": \"^1.0.0\"\n  }\n}\n== datafn/client ==\n{\n  \"name\": \"@datafn/client\",\n  \"scripts\": {\n    \"build\": \"tsup\",\n    \"test\": \"vitest run\",\n    \"test:watch\": \"vitest\",\n    \"typecheck\": \"tsc --noEmit\"\n  },\n  \"dependencies\": {\n    \"@datafn/core\": \"0.0.4\",\n    \"@superfunctions/http\": \"0.1.3\",\n    \"minisearch\": \"^7.1.0\"\n  },\n  \"devDependencies\": {\n    \"fake-indexeddb\": \"^5.0.0\",\n    \"tsup\": \"^8.0.0\",\n    \"typescript\": \"^5.3.0\",\n    \"vitest\": \"^1.0.0\"\n  }\n}\n== datafn/server ==\n{\n  \"name\": \"@datafn/server\",\n  \"scripts\": {\n    \"build\": \"tsup\",\n    \"build:watch\": \"tsup --watch\",\n    \"clean\": \"node -e \\\"require('fs').rmSync('dist', { recursive: true, force: true })\\\"\",\n    \"lint\": \"echo 'lint not configured'\",\n    \"lint:fix\": \"echo 'lint not configured'\",\n    \"test\": \"vitest run\",\n    \"test:watch\": \"vitest watch\",\n    \"typecheck\": \"tsc --noEmit\"\n  },\n  \"dependencies\": {\n    \"@datafn/core\": \"0.0.4\",\n    \"@superfunctions/db\": \"0.1.4\",\n    \"@superfunctions/http\": \"0.1.3\",\n    \"@superfunctions/observability\": \"0.0.1\"\n  },\n  \"devDependencies\": {\n    \"@types/better-sqlite3\": \"^7.6.13\",\n    \"@types/node\": \"^24.9.1\",\n    \"better-sqlite3\": \"^12.5.0\",\n    \"tsup\": \"^8.5.0\",\n    \"typescript\": \"^5.9.3\",\n    \"vitest\": \"^3.2.4\"\n  }\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-7