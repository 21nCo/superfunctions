  ) as { superfunctions?: { schemaVersion?: number } };\\n+\\n+    expect(packageMetadata.superfunctions?.schemaVersion).toBe(PLUGFN_SCHEMA_VERSION);\\n+  });\\n });\\n*** End Patch\";\ntext(await tools.apply_patch(patch));","internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787263374.182295}}}
