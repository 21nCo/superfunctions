{"timestamp":"2026-08-20T22:02:49.941Z","ordinal":24094,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a02132-c2d5-7c80-b5a6-792086854564","call_id":"call_ppXAQHHSODCbjeIXJNC9ZfTL","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"import { describe, expect, it } from 'vitest';\nimport { getSchema, PLUGFN_SCHEMA_VERSION } from '../src/schema.js';\n\ndescribe('PlugFn schema metadata', () => {\n  it('versions and exposes the webhook idempotency uniqueness constraint', () => {\n    const schema = getSchema();\n    const receipts = schema.schemas.find(\n      (table) => table.modelName === 'plugfn_webhook_receipts'\n    );\n\n    expect(PLUGFN_SCHEMA_VERSION).toBe(7);\n    expect(schema.version).toBe(7);\n    expect(receipts?.indexes).toContainEqual({\n      name: 'idx_plugfn_webhook_receipts_idempotency',\n      fields: ['provider', 'idempotencyKey'],\n      unique: true,\n    });\n\n    const connections = schema.schemas.find(\n      (table) => table.modelName === 'plugfn_connections'\n    );\n    const syncJobs = schema.schemas.find(\n      (table) => table.modelName === 'plugfn_sync_jobs'\n    );\n    expect(connections).toBeDefined();\n    expect(connections!.fields.claimToken).toBeUndefined();\n    expect(syncJobs).toBeDefined();\n    expect(syncJobs!.fields.claimToken).toMatchObject({\n      fieldName: 'claim_token',\n      maxLength: 64,\n    });\n    expect(syncJobs!.indexes).toContainEqual({\n      name: 'idx_plugfn_sync_jobs_claim_token',\n      fields: ['claimToken'],\n      unique: true,\n    });\n  });\n});\n{\n  \"compilerOptions\": {\n    \"target\": \"ES2022\",\n    \"module\": \"ESNext\",\n    \"lib\": [\"ES2022\"],\n    \"moduleResolution\": \"bundler\",\n    \"resolveJsonModule\": true,\n    \"allowJs\": false,\n    \"checkJs\": false,\n    \"outDir\": \"./dist\",\n    \"rootDir\": \"./src\",\n    \"declaration\": true,\n    \"declarationMap\": true,\n    \"sourceMap\": true,\n    \"strict\": true,\n    \"noUnusedLocals\": true,\n    \"noUnusedParameters\": true,\n    \"noImplicitReturns\": true,\n    \"noFallthroughCasesInSwitch\": true,\n    \"esModuleInterop\": true,\n    \"skipLibCheck\": true,\n    \"forceConsistentCasingInFileNames\": true,\n    \"isolatedModules\": true\n  },\n  \"include\": [\"src/**/*\"],\n  \"exclude\": [\"node_modules\", \"dist\", \"**/*.test.ts\", \"**/*.spec.ts\"]\n}\n{\n  \"name\": \"plugfn\",\n  \"version\": \"0.1.0\",\n  \"description\": \"Self-hosted integration platform for developers\",\n  \"type\": \"module\",\n  \"main\": \"dist/index.js\",\n  \"types\": \"dist/index.d.ts\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"default\": \"./dist/index.js\"\n    }\n  },\n  \"scripts\": {\n    \"build\": \"tsc\",\n    \"clean\": \"rm -rf dist\",\n    \"dev\": \"tsc --watch\",\n    \"test\": \"vitest run\",\n    \"test:ui\": \"vitest --ui\",\n    \"type-check\": \"tsc --noEmit\",\n    \"lint\": \"eslint src --ext .ts\",\n    \"format\": \"prettier --write \\\"src/**/*.ts\\\"\"\n  },\n  \"keywords\": [\n    \"integrations\",\n    \"oauth\",\n    \"webhooks\",\n    \"api\",\n    \"superfunctions\",\n    \"zapier\",\n    \"self-hosted\"\n  ],\n  \"author\": \"21n\",\n  \"license\": \"MIT\",\n  \"dependencies\": {\n    \"@superfunctions/oauth-core\": \"0.0.1\",\n    \"@superfunctions/oauth-flow\": \"0.0.1\",\n    \"@superfunctions/oauth-http\": \"0.0.1\",\n    \"@superfunctions/oauth-providers\": \"0.0.1\",\n    \"@superfunctions/oauth-storage\": \"0.0.1\",\n    \"@superfunctions/auth\": \"0.1.2\",\n    \"@superfunctions/envelope\": \"0.0.1\",\n    \"@superfunctions/errors\": \"0.0.1\",\n    \"@superfunctions/http\": \"0.1.3\",\n    \"@superfunctions/metrics\": \"0.0.1\",\n    \"@superfunctions/middleware\": \"0.1.0\",\n    \"@superfunctions/queue\": \"0.0.1\",\n    \"@superfunctions/webhooks\": \"0.0.1\",\n    \"@superfunctions/db\": \"0.1.4\",\n    \"zod\": \"^3.22.4\"\n  },\n  \"peerDependencies\": {\n    \"@superfunctions/db\": \"0.1.4\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^20.10.0\",\n    \"@typescript-eslint/eslint-plugin\": \"^6.13.0\",\n    \"@typescript-eslint/parser\": \"^6.13.0\",\n    \"eslint\": \"^8.54.0\",\n    \"prettier\": \"^3.1.0\",\n    \"typescript\": \"^5.3.2\",\n    \"vitest\": \"^1.0.4\"\n  },\n  \"files\": [\n    \"dist\",\n    \"README.md\",\n    \"LICENSE\"\n  ],\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/21nCo/super-functions.git\",\n    \"directory\": \"plugfn\"\n  },\n  \"publishConfig\": {\n    \"access\": \"public\"\n  },\n  \"superfunctions\": {\n    \"initFunction\": \"plugFn\",\n    \"schemaVersion\": 6,\n    \"namespace\": \"plugfn\"\n  }\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787263369.941404}}}
