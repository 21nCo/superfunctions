  path: \"relations.metadata\",\n   592\t        });\n   593\t      }\n   594\t      for (const field of r.metadata) {\n   595\t        if (typeof field !== \"object\" || field === null || Array.isArray(field)) {\n   596\t          return err(\"SCHEMA_INVALID\", \"Invalid schema: relation.metadata items must be objects\", {\n   597\t            path: \"relations.metadata\",\n   598\t          });\n   599\t        }\n   600\t        const metaField = field as Record<string, unknown>;\n   601\t        if (typeof metaField.name !== \"string\") {\n   602\t          return err(\"SCHEMA_INVALID\", \"Invalid schema: relation.metadata.name must be string\", {\n   603\t            path: \"relations.metadata.name\",\n   604\t          });\n   605\t        }\n   175\t    relations = schema.get(\"relations\", [])\n   176\t    for i, rel in enumerate(relations):\n   177\t        from_res = rel.get(\"from\")\n   178\t        to_res = rel.get(\"to\")\n   179\t        from_list = from_res if isinstance(from_res, list) else [from_res]\n   180\t        to_list = to_res if isinstance(to_res, list) else [to_res]\n   181\t        for fr in from_list:\n   182\t            if fr not in seen_names:\n   183\t                return {\"ok\": False, \"error\": {\"code\": \"SCHEMA_INVALID\", \"message\": f\"Relation references unknown resource '{fr}'\", \"details\": {\"path\": f\"$.relations[{i}].from\"}}}\n   184\t        for tr in to_list:\n   185\t            if tr not in seen_names:\n   186\t                return {\"ok\": False, \"error\": {\"code\": \"SCHEMA_INVALID\", \"message\": f\"Relation references unknown resource '{tr}'\", \"details\": {\"path\": f\"$.relations[{i}].to\"}}}\n   187\t\n   188\t    return {\"ok\": True, \"result\": schema}\n   189\t\n   190\t\n   191\tdef validate_record_types(record: Dict[str, Any], resource_name: str, schema_index: SchemaIndex) -> List[str]:\n   192\t    errors = []\n   193\t    field_schemas = schema_index.field_schemas.get(resource_name, {})\n   194\t    for key, value in record.items():\n   195\t        if key in field_schemas:\n   196\t            fschema = field_schemas[key]\n   197\t            ftype = fschema.get(\"type\")\n   198\t            if ftype is None:\n   199\t                continue  # No type specified, skip validation\n   200\t            nullable = fschema.get(\"nullable\", True)\n   201\t            if not validate_field_value(ftype, value, nullable):\n   202\t                expected = ftype\n   203\t                got = type(value).__name__\n   204\t                if value is None:\n   205\t                    got = \"null\"\n   206\t                errors.append(f\"Field '{key}' expects {expected}, got {got}\")\n   207\t    return errors\n   208\t\n   209\t\n   210\tdef validate_required_fields(record: Dict[str, Any], resource_name: str, schema_index: SchemaIndex) -> List[str]:\n   211\t    missing = []\n   212\t    required = schema_index.required_fields.get(resource_name, set())\n   213\t    defaults = schema_index.field_defaults.get(resource_name, {})\n   214\t    for fname in required:\n   215\t        if fname not in record and fname not in defaults:\n   216\t            missing.append(fname)\n   217\t    return missing\n   218\t\n   219\t\n   220\tdef apply_defaults(record: Dict[str, Any], resource_name: str, schema_index: SchemaIndex) -> Dict[str, Any]:\n   221\t    defaults = schema_index.field_defaults.get(resource_name, {})\n   222\t    for fname, default_val in defaults.items():\n   223\t        if fname not in record:\n   224\t            record[fname] = default_val\n   225\t    return record\n   226\t\n   227\t\n   228\tdef _count_filter_keys(filters: Any, depth: int = 0) -> int:\n   229\t    if not isinstance(filters, dict):\n   230\t        return 0\n   231\t    count = sum(1 for key in filters if not key.startswith(\"$\"))\n   232\t    nested_counts = [count]\n   233\t    for key, value in filters.items():\n   234\t        if key in (\"$and\", \"$or\"):\n   235\t  