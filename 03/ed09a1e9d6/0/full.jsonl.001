wait localDb.internal.findOne(\\n+      \\\"__datafn_permission_directory_outbox\\\",\\n+      [{ field: \\\"id\\\", op: \\\"eq\\\", value: taskId }],\\n+    );\\n+    const claimedLease = new Date(Date.now() + 60 * 1000).toISOString();\\n+\\n+    try {\\n+      const explicitDrain = drainPermissionDirectorySync(\\n+        localDb,\\n+        taskId,\\n+        runtime,\\n+      );\\n+      await deleteStarted;\\n+      await expect(localDb.internal.update(\\n+        \\\"__datafn_permission_directory_outbox\\\",\\n+        [\\n+          { field: \\\"id\\\", op: \\\"eq\\\", value: taskId },\\n+          {\\n+            field: \\\"next_attempt_at\\\",\\n+            op: \\\"eq\\\",\\n+            value: initialTask!.next_attempt_at,\\n+          },\\n+        ],\\n+        { next_attempt_at: claimedLease },\\n+      )).resolves.toBe(1);\\n+      releaseDelete();\\n+\\n+      await expect(explicitDrain).resolves.toBe(false);\\n+      await expect(localDb.internal.findOne(\\n+        \\\"__datafn_permission_directory_outbox\\\",\\n+        [{ field: \\\"id\\\", op: \\\"eq\\\", value: taskId }],\\n+      )).resolves.toMatchObject({ next_attempt_at: claimedLease });\\n+    } finally {\\n+      releaseDelete();\\n+    }\\n+  });\\n \\n   it(\\\"prequeues sequential transact shares before committing their grants\\\", async () => {\\n*** Update File: /Users/serro/Documents/dev/n/worktrees/superfunctions/review-followup-next-2026-08-20/datafn/server/src/execution/mutation/__tests__/share-spv2.test.ts\\n@@\\n   it(\\\"does not invalidate a push unshare when repair persistence is unavailable\\\", async () => {\\n@@\\n     }\\n   });\\n+\\n+  it(\\\"keeps a directory grant when non-transactional push rejects unsharing the creator\\\", async () => {\\n+    const localDb = memoryAdapter();\\n+    await localDb.initialize();\\n+    (localDb.capabilities.transactions as { supported: boolean }).supported = false;\\n+    const directory = createMemoryIndexedDirectoryStore();\\n+    const localServer = await createDatafnServer({\\n+      allowUnknownResources: true,\\n+      schema,\\n+      database: localDb,\\n+      plugins: [datafnMultiRegionPlugin({ regionId: \\\"region:test\\\", directory })],\\n+      namespaceProvider: {\\n+        getNamespace: () => namespace,\\n+        getActorId: () => \\\"user:owner\\\",\\n+      },\\n+    });\\n+    const request = async (path: string, payload: Record<string, unknown>) => {\\n+      const response = await localServer.router.handle(new Request(\\n+        `http://localhost/datafn/${path}`,\\n+        {\\n+          method: \\\"POST\\\",\\n+          headers: { \\\"content-type\\\": \\\"application/json\\\" },\\n+          body: JSON.stringify(payload),\\n+        },\\n+      ));\\n+      return response.json() as Promise<any>;\\n+    };\\n+\\n+    try {\\n+      await request(\\\"mutation\\\", {\\n+        resource: \\\"notes\\\",\\n+        version: 1,\\n+        operation: \\\"insert\\\",\\n+        clientId: \\\"push-invalid-unshare\\\",\\n+        mutationId: \\\"push-invalid-unshare-insert\\\",\\n+        id: \\\"note:push-invalid-unshare\\\",\\n+        record: { title: \\\"Push invalid unshare\\\" },\\n+      });\\n+      await request(\\\"mutation\\\", {\\n+        resource: \\\"notes\\\",\\n+        version: 1,\\n+        operation: \\\"share\\\",\\n+        clientId: \\\"push-invalid-unshare\\\",\\n+        mutationId: \\\"push-invalid-unshare-share\\\",\\n+        id: \\\"note:push-invalid-unshare\\\",\\n+        shareWith: { principalId: \\\"user:owner\\\", level: \\\"viewer\\\" },\\n+      });\\n+\\n+      const result = await request(\\\"push\\\", {\\n+        clientId: \\\"push-invalid-unshare\\\",\\n+        mutations: [{\\n+          resource: \\\"notes\\\",\\n+          version: 1,\\n+          operation: \\\"unshare\\\",\\n+          clientId: \\\"push-invalid-unshare\\\",\\n+          mutationId: \\\"push-invalid-unshare-unshare\\\",\\n+          id: \\\"note:push-invalid-unshare\\\",\\n+          shareWith: { principalId: \\\"user:owner\\\" },\\n+        }],\\n+      });\\n+\\n+      expect(result.result.ok).toBe(false);\\n+      const indexed = await directory.query({\\n+        index: \\\"datafn.permission.principalResource\\\",\\n+        value: \\\"user:owner#notes\\\",\\n+      });\\n+      expect(indexed.records).toHaveLength(1);\\n+      await expect(localDb.internal.findMany(\\n+        \\\"__datafn_permission_directory_outbox\\\",\\n+        [],\\n+      )).resolves.toEqual([]);\\n+    } finally {\\n+      await localServer.close();\\n+    }\\n+  });\\n \\n   it(\\\"durably restores a push unshare when its transaction rolls back\\\", async () => {\\n*** Update File: /Users/serro/Documents/dev/n/worktrees/superfunctions/review-followup-next-2026-08-20/datafn/server/src/execution/mutation/__tests__/share-spv2.test.ts\\n@@\\n   it(\\\"does not enter an outer unshare transaction when repair persistence is unavailable\\\", async () => {\\n@@\\n     }\\n   });\\n+\\n+  it(\\\"settles a prequeued transact task when unsharing the creator is rejected\\\", async () => {\\n+    const localDb = memoryAdapter();\\n+    await localDb.initialize();\\n+    const directory = createMemoryIndexedDirectoryStore();\\n+    const localServer = await createDatafnServer({\\n+      allowUnknownResources: true,\\n+      schema,\\n+      database: localDb,\\n+      plugins: [datafnMultiRegionPlugin({ regionId: \\\"region:test\\\", directory })],\\n+      namespaceProvider: {\\n+        getNamespace: () => namespace,\\n+        getActorId: () => \\\"user:owner\\\",\\n+      },\\n+    });\\n+    const request = async (path: string, payload: Record<string, unknown>) => {\\n+      const response = await localServer.router.handle(new Request(\\n+        `http://localhost/datafn/${path}`,\\n+        {\\n+          method: \\\"POST\\\",\\n+          headers: { \\\"content-type\\\": \\\"application/json\\\" },\\n+          body: JSON.stringify(payload),\\n+        },\\n+      ));\\n+      return response.json() as Promise<any>;\\n+    };\\n+\\n+    try {\\n+      await request(\\\"mutation\\\", {\\n+        resource: \\\"notes\\\",\\n+        version: 1,\\n+        operation: \\\"insert\\\",\\n+        clientId: \\\"transact-invalid-unshare\\\",\\n+        mutationId: \\\"transact-invalid-unshare-insert\\\",\\n+        id: \\\"note:transact-invalid-unshare\\\",\\n+        record: { title: \\\"Transact invalid unshare\\\" },\\n+      });\\n+      await request(\\\"mutation\\\", {\\n+        resource: \\\"notes\\\",\\n+        version: 1,\\n+        operation: \\\"share\\\",\\n+        clientId: \\\"transact-invalid-unshare\\\",\\n+        mutationId: \\\"transact-invalid-unshare-share\\\",\\n+        id: \\\"note:transact-invalid-unshare\\\",\\n+        shareWith: { principalId: \\\"user:owner\\\", level: \\\"viewer\\\" },\\n+      });\\n+\\n+      const result = await request(\\\"transact\\\", {\\n+        atomic: true,\\n+        steps: [{\\n+          mutation: {\\n+            resource: \\\"notes\\\",\\n+            version: 1,\\n+            operation: \\\"unshare\\\",\\n+            clientId: \\\"transact-invalid-unshare\\\",\\n+            mutationId: \\\"transact-invalid-unshare-unshare\\\",\\n+            id: \\\"note:transact-invalid-unshare\\\",\\n+            shareWith: { principalId: \\\"user:owner\\\" },\\n+          },\\n+        }],\\n+      });\\n+\\n+      expect(result.result.ok).toBe(false);\\n+      const indexed = await directory.query({\\n+        index: \\\"datafn.permission.principalResource\\\",\\n+        value: \\\"user:owner#notes\\\",\\n+      });\\n+      expect(indexed.records).toHaveLength(1);\\n+      await expect(localDb.internal.findMany(\\n+        \\\"__datafn_permission_directory_outbox\\\",\\n+        [],\\n+      )).resolves.toEqual([]);\\n+    } finally {\\n+      await localServer.close();\\n+    }\\n+  });\\n \\n   it(\\\"does not publish a share from an outer transaction that rolls back\\\", async () => {\\n*** Update File: /Users/serro/Documents/dev/n/worktrees/superfunctions/review-followup-next-2026-08-20/datafn/client/src/sync/__tests__/engine.test.ts\\n@@\\n   it(\\\"sanitizes stale changelog record fields against the current schema before push\\\", async () => {\\n@@\\n     expect(await storage.changelogList()).toEqual([]);\\n   });\\n+\\n+  it(\\\"preserves a legacy FK when the preferred relation alias is empty\\\", async () => {\\n+    const storage = new MemoryStorageAdapter([\\\"goal\\\"]);\\n+    await storage.changelogAppend({\\n+      clientId: \\\"client:1\\\",\\n+      mutationId: \\\"mut:legacy-fk\\\",\\n+      timestampMs: 1,\\n+      mutation: {\\n+        resource: \\\"goal\\\",\\n+        version: 1,\\n+        operation: \\\"insert\\\",\\n+        id: \\\"goal:legacy-fk\\\",\\n+        record: {\\n+          id: \\\"goal:legacy-fk\\\",\\n+          type: \\\"INDEFINITE\\\",\\n+          status: \\\"NOT_STARTED\\\",\\n+          legacyParentId: \\\"goal:parent\\\",\\n+        },\\n+        clientId: \\\"client:1\\\",\\n+        mutationId: \\\"mut:legacy-fk\\\",\\n+      },\\n+    });\\n+    const push = vi.fn().mockResolvedValue({\\n+      ok: true,\\n+      result: {\\n+        ok: true,\\n+        applied: [\\\"mut:legacy-fk\\\"],\\n+        cursor: \\\"1\\\",\\n+        cursorBefore: \\\"0\\\",\\n+      },\\n+    });\\n+    const remote: any = {\\n+      push,\\n+      pull: vi.fn(),\\n+      clone: vi.fn(),\\n+      query: vi.fn(),\\n+      mutation: vi.fn(),\\n+      transact: vi.fn(),\\n+      seed: vi.fn(),\\n+      reconcile: vi.fn(),\\n+    };\\n+    const legacyAliasSchema = {\\n+      ...schema,\\n+      relations: [{\\n+        ...schema.relations[0],\\n+        fkField: \\\"\\\",\\n+        foreignKey: \\\"legacyParentId\\\",\\n+      }],\\n+    };\\n+    const engine = new SyncEngine(\\n+      storage,\\n+      remote,\\n+      new EventBus(),\\n+      \\\"client:1\\\",\\n+      legacyAliasSchema,\\n+      { pushMaxRetries: 0 },\\n+    );\\n+\\n+    await engine.processPush();\\n+\\n+    expect(push.mock.calls[0][0].mutations[0].record.legacyParentId)\\n+      .toBe(\\\"goal:parent\\\");\\n+  });\\n \\n   it(\\\"sanitizes stale relation metadata against the current schema before push\\\", async () => {\\n*** End Patch\";\nconst r=await tools.apply_patch(patch);\ntext(r);\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787261672.809455}}}
