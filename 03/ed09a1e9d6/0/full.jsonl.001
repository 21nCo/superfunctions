v=%s\\\\nremote_base=%s\\\\nthread_base=%s\\\\nthreads=%s unresolved=%s\\\\npr_state=%s\\\\n' \\\"$local_head\\\" \\\"$pr_head\\\" \\\"$thread_head\\\" \\\"$origin_dev\\\" \\\"$remote_base\\\" \\\"$thread_base\\\" \\\"$total\\\" \\\"$unresolved\\\" \\\"$pr_state\\\"\\ntest \\\"$local_head\\\" = \\\"$expected_head\\\"\\ntest \\\"$pr_head\\\" = \\\"$expected_head\\\"\\ntest \\\"$thread_head\\\" = \\\"$expected_head\\\"\\ntest \\\"$remote_base\\\" = \\\"$expected_base\\\"\\ntest \\\"$thread_base\\\" = \\\"$expected_base\\\"\\ntest \\\"$pr_state\\\" = 'OPEN'\\ntest \\\"$unresolved\\\" = '0'\\ngit merge-base --is-ancestor \\\"$origin_dev\\\" \\\"$local_head\\\"\\necho 'guard=passed'\\nGH_CONFIG_DIR=/Users/serro/.config/gh-other gh pr merge 46 --repo 21nCo/super-functions.next --merge --match-head-commit \\\"$expected_head\\\"\",\"workdir\":\"/Users/serro/Documents/dev/n/worktrees/superfunctions/review-followup-next-2026-08-20\",\"yield_time_ms\":30000,\"max_output_tokens\":30000});\ntext(r.output);\nif (r.session_id) text(`SESSION_ID=${r.session_id}`);\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787267854.488818}}}
