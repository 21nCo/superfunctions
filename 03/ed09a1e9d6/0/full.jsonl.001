{"timestamp":"2026-08-20T21:07:27.064Z","ordinal":23137,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a02100-0ed8-7353-93d6-bc64125cbe8c","call_id":"call_fVBrZp0LRiHElvUm2cRTh3ie","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"#!/usr/bin/env node\n\nimport { execFileSync } from \"node:child_process\";\nimport { existsSync, mkdirSync, readFileSync } from \"node:fs\";\nimport path from \"node:path\";\n\nconst repoRoot = process.cwd();\nconst outputDir = path.join(repoRoot, \".tmp\", \"jscpd\", \"langfn\");\nconst reportFile = path.join(outputDir, \"jscpd-report.json\");\nconst threshold = Number(process.env.LANGFN_DUPLICATION_THRESHOLD ?? \"5\");\n\nmkdirSync(outputDir, { recursive: true });\n\ntry {\n  execFileSync(\n    process.platform === \"win32\" ? \"npx.cmd\" : \"npx\",\n    [\n      \"jscpd\",\n      \"langfn\",\n      \"--min-lines\",\n      \"10\",\n      \"--min-tokens\",\n      \"50\",\n      \"--reporters\",\n      \"console,json\",\n      \"--output\",\n      outputDir\n    ],\n    { stdio: \"inherit\", cwd: repoRoot }\n  );\n} catch (error) {\n  console.error(\"duplication scan command failed\");\n  process.exit(error.status || 1);\n}\n\ntry {\n  execFileSync(\n    process.platform === \"win32\" ? \"rg.exe\" : \"rg\",\n    [\"-n\", \"@superfunctions/|superfunctions\\\\.\", \"langfn/typescript\", \"langfn/python\"],\n    { stdio: \"inherit\", cwd: repoRoot }\n  );\n} catch (error) {\n  console.error(\"shared superfunctions usage guard failed\");\n  process.exit(error.status || 1);\n}\n\nif (!existsSync(reportFile)) {\n  console.error(`missing duplication report at ${reportFile}`);\n  process.exit(1);\n}\n\nconst report = JSON.parse(readFileSync(reportFile, \"utf8\"));\nconst statistics = report.statistics || {};\nconst total = statistics.total || {};\nconst payload = {\n  ok: true,\n  threshold,\n  thresholdExceeded: Number(total.percentage ?? 0) > threshold,\n  scannedFiles: total.sources ?? 0,\n  duplicatedLines: total.duplicatedLines ?? 0,\n  duplicatedPercentage: total.percentage ?? 0\n};\n\nif (payload.thresholdExceeded) {\n  console.error(\n    `langfn duplication threshold exceeded: ${payload.duplicatedPercentage}% > ${payload.threshold}%`\n  );\n  process.exit(1);\n}\n\nconsole.log(JSON.stringify(payload));\nname: audit-fix-o4u9k2m7-guardrails\n\non:\n  pull_request:\n  push:\n    branches:\n      - main\n\njobs:\n  guardrails:\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v4\n      - uses: actions/setup-node@v4\n        with:\n          node-version: \"20\"\n          cache: \"npm\"\n      - run: npm ci\n      - run: npm run check:duplication\n      - run: npm -w docs run build\n      - run: npm -w docs run check:coverage\n      - run: npm -w docs run check:snippets\n      - run: npm -w docs run check:links\n      - run: npm run gate:audit-fix-o4u9k2m7\n      - run: npx turbo run build --filter=docs --filter=@superfunctions/oauth-flow\n{\n  \"check:duplication\": \"node scripts/check-duplication.mjs\"\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787260047.064315}}}
