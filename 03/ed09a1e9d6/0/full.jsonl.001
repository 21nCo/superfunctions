yncEngine(\n+      storage,\n+      remote,\n+      new EventBus(),\n+      \"client:1\",\n+      legacyAliasSchema,\n+      { pushMaxRetries: 0 },\n+    );\n+\n+    await engine.processPush();\n+\n+    expect(push.mock.calls[0][0].mutations[0].record.legacyParentId)\n+      .toBe(\"goal:parent\");\n+  });\n \n   it(\"sanitizes stale relation metadata against the current schema before push\", async () => {\n*** End Patch`;\nconst r=await tools.apply_patch(patch); text(r);\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787261749.481775}}}
