\n+          field,\\n+          envelope: value,\\n+          aad: aadFor(resource, id, field),\\n+        });\\n+      }\\n     }\\n \\n     const envelope = await provider.encrypt({\\n       resource,\\n       id,\\n       field,\\n-      plaintext: encodeFieldValue(value),\\n+      plaintext,\\n       aad: aadFor(resource, id, field),\\n     });\\n-    providerEnvelopes.add(envelope);\\n+    providerEncryptedEnvelopes.set(envelope, {\\n+      provider,\\n+      keyRef: envelope.keyRef,\\n+    });\\n     encrypted[field] = envelope;\\n*** Update File: /Users/serro/Documents/dev/n/worktrees/superfunctions/review-followup-next-2026-08-20/datafn/client/__tests__/e2ee.test.ts\\n@@\\n   it(\\\"does not reuse an envelope across provider key contexts\\\", async () => {\\n     const firstProvider = createProvider();\\n+    const decrypt = vi.spyOn(firstProvider, \\\"decrypt\\\");\\n     const first = (await encryptMutationPayloadForE2ee(\\n@@\\n     expect(encrypt).toHaveBeenCalledOnce();\\n+    expect(decrypt).toHaveBeenCalledOnce();\\n     expect(reencrypted.record.notes).not.toBe(first.record.notes);\\n     expect((reencrypted.record.notes as { keyRef: string }).keyRef).toBe(\\\"next-key\\\");\\n+\\n+    const decrypted = await decryptCloneResultForE2ee(\\n+      schema,\\n+      { enabled: true, provider: nextProvider },\\n+      { ok: true, data: { task: [reencrypted.record] }, cursors: {}, next: {} },\\n+    );\\n+    expect(decrypted.data.task?.[0]?.notes).toBe(\\\"secret\\\");\\n   });\\n*** End Patch\";\ntext(await tools.apply_patch(patch));","internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787265554.855522}}}
