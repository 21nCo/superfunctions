{"timestamp":"2026-08-20T21:36:37.023Z","ordinal":23661,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0211a-c29f-7b53-9721-198672814b42","call_id":"call_iPjbwyFkyg68Ysd91aJ4FCLu","output":[{"type":"input_text","text":"Script completed\nWall time 0.3 seconds\nOutput:\n"},{"type":"input_text","text":" M datafn/client/src/sync/__tests__/engine.test.ts\n M datafn/client/src/sync/engine.ts\n M datafn/server/__tests__/public-links-plugin.test.ts\n M datafn/server/src/execution/mutation/__tests__/share-spv2.test.ts\n M datafn/server/src/execution/mutation/permission-directory-outbox.ts\n M datafn/server/src/execution/query/__tests__/shared-with-me.test.ts\n M datafn/server/src/plugins/public-links.ts\n M datafn/server/src/routes/query.ts\n M datafn/server/src/validation/__tests__/schema-capabilities.test.ts\n M datafn/server/src/validation/schema.ts\n M plugfn/core/src/schema.ts\n M plugfn/core/tests/schema.test.ts\n M plugfn/examples/example-01/backend/src/db/generated/plugfn-schema.ts\n datafn/client/src/sync/__tests__/engine.test.ts    |  63 ++++++\n datafn/client/src/sync/engine.ts                   |   2 +-\n .../server/__tests__/public-links-plugin.test.ts   |  77 ++++++++\n .../mutation/__tests__/share-spv2.test.ts          | 219 +++++++++++++++++++++\n .../mutation/permission-directory-outbox.ts        |  14 +-\n .../query/__tests__/shared-with-me.test.ts         |  61 +++++-\n datafn/server/src/plugins/public-links.ts          |  18 +-\n datafn/server/src/routes/query.ts                  |   1 +\n .../__tests__/schema-capabilities.test.ts          |  27 +++\n datafn/server/src/validation/schema.ts             |   6 +-\n plugfn/core/src/schema.ts                          |   8 +-\n plugfn/core/tests/schema.test.ts                   |   4 +-\n .../backend/src/db/generated/plugfn-schema.ts      |   4 +-\n 13 files changed, 491 insertions(+), 13 deletions(-)\ndiff --git a/datafn/client/src/sync/engine.ts b/datafn/client/src/sync/engine.ts\nindex b03b3e57..dda4b0fe 100644\n--- a/datafn/client/src/sync/engine.ts\n+++ b/datafn/client/src/sync/engine.ts\n@@ -137,7 +137,7 @@ function buildWritableRecordFieldsByResource(\n     for (const fromResource of fromResources) {\n       const fields = fieldsByResource.get(fromResource);\n       if (!fields) continue;\n-      const fkField = relation.fkField ?? relation.foreignKey;\n+      const fkField = relation.fkField || relation.foreignKey;\n       if (typeof fkField === \"string\" && fkField.length > 0) {\n         fields.add(fkField);\n       }\ndiff --git a/datafn/server/src/execution/mutation/permission-directory-outbox.ts b/datafn/server/src/execution/mutation/permission-directory-outbox.ts\nindex 92664ed5..720ee6fe 100644\n--- a/datafn/server/src/execution/mutation/permission-directory-outbox.ts\n+++ b/datafn/server/src/execution/mutation/permission-directory-outbox.ts\n@@ -327,6 +327,16 @@ export async function drainPermissionDirectorySync(\n     return false;\n   }\n   if (String(task.region_id) !== runtime.regionId) return false;\n+  const settlementWhere = options.expectedNextAttemptAt\n+    ? taskWhere\n+    : [\n+        { field: \"id\", op: \"eq\" as const, value: taskId },\n+        {\n+          field: \"next_attempt_at\",\n+          op: \"eq\" as const,\n+          value: task.next_attempt_at,\n+        },\n+      ];\n \n   try {\n     const mutation = JSON.parse(String(task.mutation)) as PermissionDirectorySyncMutation;\n@@ -336,7 +346,7 @@ export async function drainPermissionDirectorySync(\n       String(task.namespace),\n       runtime,\n     );\n-    const deleted = await db.internal.delete(OUTBOX_TABLE, taskWhere);\n+    const deleted = await db.internal.delete(OUTBOX_TABLE, settlementWhere);\n     if (deleted > 0) detachPrecommitLeaseHeartbeat(taskId);\n     // A live owner may renew after a stale drainer claimed the row. The\n     // conditional delete fences that race: reconciliation is idempotent, and\n@@ -345,7 +355,7 @@ export async function drainPermissionDirectorySync(\n   } catch (error) {\n     const attempts = Number(task.attempts ?? 0) + 1;\n     const retryDelaySeconds = Math.min(15 * (2 ** Math.min(attempts - 1, 5)), 300);\n-    await db.internal.update(OUTBOX_TABLE, taskWhere, {\n+    await db.internal.update(OUTBOX_TABLE, settlementWhere, {\n       attempts,\n       last_error: String(error),\n       next_attempt_at: new Date(Date.now() + retryDelaySeconds * 1000).toISOString(),\ndiff --git a/datafn/server/src/plugins/public-links.ts b/datafn/server/src/plugins/public-links.ts\nindex 16a32ed0..4737f66b 100644\n--- a/datafn/server/src/plugins/public-links.ts\n+++ b/datafn/server/src/plugins/public-links.ts\n@@ -620,7 +620,10 @@ async function createDatafnPublicLink(input: {\n     level: validation.level,\n     tokenHash: await hashPublicLinkToken(token),\n     expiresAt: validation.expiresAt,\n-    revokedAt: null,\n+    // Keep the credential fail-closed until its permission grant succeeds.\n+    // If later cleanup of a failed share is unavailable, the durable row can\n+    // remain for recovery without becoming an authorizing credential.\n+    revokedAt: now,\n     __ns: input.namespace,\n     ...(input.resourceRegion ? { resourceRegion: input.resourceRegion } : {}),\n     createdAt: now,\n@@ -790,6 +793,19 @@ async function createDatafnPublicLink(input: {\n     }\n     throw new DatafnPublicLinkInputError(shareResult.message, shareResult.path);\n   }\n+  const activatedAt = Date.now();\n+  await input.database.update({\n+    model: input.modelName,\n+    where: [{ field: \"id\", operator: \"eq\", value: id }],\n+    data: {\n+      revokedAt: null,\n+      updatedAt: activatedAt,\n+      updatedBy: input.actorId,\n+    },\n+    namespace: input.namespace,\n+  });\n+  record.revokedAt = null;\n+  record.updatedAt = activatedAt;\n   if (permissionDirectoryRuntime) {\n     await settlePermissionDirectoryTask();\n   } else {\ndiff --git a/datafn/server/src/routes/query.ts b/datafn/server/src/routes/query.ts\nindex ddf83517..9ac7627f 100644\n--- a/datafn/server/src/routes/query.ts\n+++ b/datafn/server/src/routes/query.ts\n@@ -215,6 +215,7 @@ export function createQueryHandler(\n     grantedBy: row.grantedBy ?? row.granted_by,\n     grantedAt: row.grantedAt ?? row.granted_at,\n     revokedAt: row.revokedAt ?? row.revoked_at,\n+    resourceRegion: row.resourceRegion ?? row.resource_region,\n   });\n \n   const resolveActorPrincipals = async (\ndiff --git a/datafn/server/src/validation/schema.ts b/datafn/server/src/validation/schema.ts\nindex 7efccf8d..c21e350b 100644\n--- a/datafn/server/src/validation/schema.ts\n+++ b/datafn/server/src/validation/schema.ts\n@@ -119,7 +119,11 @@ export function buildSchemaIndex(schema: DatafnSchema): SchemaIndex {\n       if (rel.type === \"many-one\") {\n         const fromResources = Array.isArray(rel.from) ? rel.from : [rel.from];\n         for (const fromRes of fromResources) {\n-          const fkField = (rel as any).fkField || (rel as any).foreignKey || `${rel.relation}Id`;\n+          const targetResource = Array.isArray(rel.to) ? rel.to[0] : rel.to;\n+          const fkField =\n+            (rel as any).fkField ||\n+            (rel as any).foreignKey ||\n+            `${rel.relation ?? targetResource}Id`;\n           fieldsByResource.get(fromRes)?.add(fkField);\n           writableFieldsByResource.get(fromRes)?.add(fkField);\n         }\ndiff --git a/plugfn/core/src/schema.ts b/plugfn/core/src/schema.ts\nindex 5a13db39..94c30bbf 100644\n--- a/plugfn/core/src/schema.ts\n+++ b/plugfn/core/src/schema.ts\n@@ -5,10 +5,10 @@ import {\n } from '@superfunctions/oauth-storage';\n import { DEFAULT_PLUGFN_STORAGE_MODELS, resolvePlugFnStorageModels, type PlugFnStorageModelMapping } from './storage/adapters/database.js';\n \n-// Version 6 adds job-scoped claim tokens to sync jobs. Any legacy claim token on a\n-// connection represented a different ownership domain, so migration must not copy it;\n-// stale running jobs are reclaimed and assigned a fresh job-scoped token by the worker.\n-export const PLUGFN_SCHEMA_VERSION = 6;\n+// Version 7 constrains job-scoped claim tokens to their runtime length and adds\n+// uniqueness. Legacy application-generated tokens include the unique job id,\n+// so valid version-6 rows are already distinct before the index is created.\n+export const PLUGFN_SCHEMA_VERSION = 7;\n \n export interface PlugFnSchemaOptions {\n   namespace?: string;\ndiff --git a/plugfn/examples/example-01/backend/src/db/generated/plugfn-schema.ts b/plugfn/examples/example-01/backend/src/db/generated/plugfn-schema.ts\nindex d1f34949..137524b4 100644\n--- a/plugfn/examples/example-01/backend/src/db/generated/plugfn-schema.ts\n+++ b/plugfn/examples/example-01/backend/src/db/generated/plugfn-schema.ts\n@@ -261,6 +261,7 @@ export const plugfn_sync_jobs = pgTable(\n   'plugfn_sync_jobs',\n   {\n   checkpoint: json('checkpoint'),\n+  claimToken: text('claim_token'),\n   connectionId: text('connection_id').notNull(),\n   createdAt: timestamp('created_at', { withTimezone: true }).notNull(),\n   cursor: text('cursor'),\n@@ -279,6 +280,7 @@ export const plugfn_sync_jobs = pgTable(\n   updatedAt: timestamp('updated_at', { withTimezone: true }).notNull(),\n   },\n   (table) => ({\n+    idx_plugfn_sync_jobs_claim_token: uniqueIndex('idx_plugfn_sync_jobs_claim_token').on(table.claimToken),\n     idx_plugfn_sync_jobs_connection_resource: index('idx_plugfn_sync_jobs_connection_resource').on(table.connectionId, table.resource),\n     idx_plugfn_sync_jobs_provider: index('idx_plugfn_sync_jobs_provider').on(table.provider),\n     idx_plugfn_sync_jobs_status: index('idx_plugfn_sync_jobs_status').on(table.status)\n@@ -339,4 +341,4 @@ export const plugfn_secret_refs = pgTable(\n     idx_plugfn_secret_refs_provider_owner: index('idx_plugfn_secret_refs_provider_owner').on(table.provider, table.ownerKind, table.ownerId),\n     idx_plugfn_secret_refs_purpose: index('idx_plugfn_secret_refs_purpose').on(table.purpose)\n   })\n-);\n+);\n\\ No newline at end of file\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787261797.02369}}}
