ase: ownershipLosingDb,\n      spv2Migration: {\n        readMode: \"dual\",\n        writeMode: \"dual\",\n        warnOnLegacyApi: true,\n      },\n      plugins: [datafnMultiRegionPlugin({ regionId: \"region:test\", directory })],\n      namespaceProvider: {\n        getNamespace: () => namespace,\n        getActorId: () => \"user:owner\",\n      },\n    });\n    const localMutation = async (payload: Record<string, unknown>) => {\n      const response = await localServer.router.handle(new Request(\n        \"http://localhost/datafn/mutation\",\n        {\n          method: \"POST\",\n          headers: { \"content-type\": \"application/json\" },\n\n RUN  v3.2.4 /Users/serro/Documents/dev/n/worktrees/superfunctions/review-followup-dev-2026-08-20/datafn/server\n\nstdout | src/execution/mutation/__tests__/share-spv2.test.ts > share SPV2 mutation semantics > does not publish a failed nontransactional dual-write share\n[INFO] request {\"timestamp\":\"2026-08-20T19:59:23.078Z\",\"endpoint\":\"/datafn/mutation\",\"clientId\":\"direct-failed-share\",\"mutationId\":\"direct-failed-share-insert\",\"resource\":\"notes\",\"operation\":\"insert\",\"duration_ms\":2}\n\nstderr | src/execution/mutation/__tests__/share-spv2.test.ts > share SPV2 mutation semantics > does not publish a failed nontransactional dual-write share\n[ERROR] Unexpected mutation error {\"error\":\"Error: legacy mirror unavailable\",\"operation\":\"share\",\"resource\":\"notes\"}\n\nstdout | src/execution/mutation/__tests__/share-spv2.test.ts > share SPV2 mutation semantics > does not publish a failed nontransactional dual-write share\n[INFO] request {\"timestamp\":\"2026-08-20T19:59:23.080Z\",\"endpoint\":\"/datafn/mutation\",\"clientId\":\"direct-failed-share\",\"mutationId\":\"direct-failed-share-share\",\"resource\":\"notes\",\"operation\":\"share\",\"duration_ms\":2}\n\n ↓ src/execution/mutation/__tests__/share-spv2.test.ts > share SPV2 mutation semantics > canonicalizes legacy userId to principalId in