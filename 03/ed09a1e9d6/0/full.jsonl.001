{"timestamp":"2026-08-20T22:51:20.669Z","ordinal":24793,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0215f-2cdd-7a13-9634-feeac708e104","call_id":"call_Vlu5xHBk7cMl5LDs8PzIn9gn","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"     1\timport { describe, expect, it, vi } from \"vitest\";\n     2\timport { time, type DatafnSchema } from \"@datafn/core\";\n     3\timport { executeQuery } from \"../query.js\";\n     4\timport { MemoryStorageAdapter } from \"../adapters/memoryStorage.js\";\n     5\timport type { DatafnRemoteAdapter } from \"../client.js\";\n     6\t\n     7\tconst schema: DatafnSchema = {\n     8\t  resources: [\n     9\t    {\n    10\t      name: \"tasks\",\n    11\t      version: 1,\n    12\t      fields: [{ name: \"title\", type: \"string\", required: false }],\n    13\t    },\n    14\t    {\n    15\t      name: \"notes\",\n    16\t      version: 1,\n    17\t      fields: [{ name: \"body\", type: \"string\", required: false }],\n    18\t    },\n    19\t  ],\n    20\t  relations: [],\n    21\t};\n    22\t\n    23\tdescribe(\"Query routing\", () => {\n    24\t  it(\"executes batch queries locally when all resources are hydrated\", async () => {\n    25\t    const storage = new MemoryStorageAdapter([\"tasks\", \"notes\"]);\n    26\t    await storage.upsertRecord(\"tasks\", { id: \"task:1\", title: \"Plan\" });\n    27\t    await storage.upsertRecord(\"notes\", { id: \"note:1\", body: \"Draft\" });\n    28\t    await storage.setHydrationState(\"tasks\", \"hydrating\");\n    29\t    await storage.setHydrationState(\"tasks\", \"ready\");\n    30\t    await storage.setHydrationState(\"notes\", \"hydrating\");\n    31\t    await storage.setHydrationState(\"notes\", \"ready\");\n    32\t\n    33\t    const remote: DatafnRemoteAdapter = {\n    34\t      query: vi.fn().mockResolvedValue({ ok: true, result: [] }),\n    35\t      mutation: vi.fn(),\n    36\t      transact: vi.fn(),\n    37\t      seed: vi.fn(),\n    38\t      clone: vi.fn(),\n    39\t      pull: vi.fn(),\n    40\t      push: vi.fn(),\n    41\t      reconcile: vi.fn(),\n    42\t    };\n    43\t\n    44\t    const result = await executeQuery(\n    45\t      remote,\n    46\t      [\n    47\t        { resource: \"tasks\", select: [\"id\", \"title\"] },\n    48\t        { resource: \"notes\", select: [\"id\", \"body\"] },\n    49\t      ],\n    50\t      storage,\n    51\t      [],\n    52\t      schema,\n    53\t    );\n    54\t\n    55\t    expect(remote.query).not.toHaveBeenCalled();\n    56\t    expect(result).toEqual([\n    57\t      { data: [{ id: \"task:1\", title: \"Plan\" }], nextCursor: null },\n    58\t      { data: [{ id: \"note:1\", body: \"Draft\" }], nextCursor: null },\n    59\t    ]);\n    60\t  });\n    61\t\n    62\t  it(\"falls back to remote batch queries when a resource is not hydrated\", async () => {\n    63\t    const storage = new MemoryStorageAdapter([\"tasks\", \"notes\"]);\n    64\t    await storage.setHydrationState(\"tasks\", \"hydrating\");\n    65\t    await storage.setHydrationState(\"tasks\", \"ready\");\n    66\t\n    67\t    const remote: DatafnRemoteAdapter = {\n    68\t      query: vi.fn().mockResolvedValue({\n    69\t        ok: true,\n    70\t        result: [{ data: [{ id: \"task:remote\" }] }, { data: [{ id: \"note:remote\" }] }],\n    71\t      }),\n    72\t      mutation: vi.fn(),\n    73\t      transact: vi.fn(),\n    74\t      seed: vi.fn(),\n    75\t      clone: vi.fn(),\n    76\t      pull: vi.fn(),\n    77\t      push: vi.fn(),\n    78\t      reconcile: vi.fn(),\n    79\t    };\n    80\t\n    81\t    const result = await executeQuery(\n    82\t      remote,\n    83\t      [\n    84\t        { resource: \"tasks\", select: [\"id\"] },\n    85\t        { resource: \"notes\", select: [\"id\"] },\n    86\t      ],\n    87\t      storage,\n    88\t      [],\n    89\t      schema,\n    90\t    );\n    91\t\n    92\t    expect(remote.query).toHaveBeenCalledTimes(1);\n    93\t    expect(result).toEqual([\n    94\t      { data: [{ id: \"task:remote\" }] },\n    95\t      { data: [{ id: \"note:remote\" }] },\n    96\t    ]);\n    97\t  });\n    98\t\n    99\t  it(\"re-sorts and re-limits local overlays while preserving the remote envelope\", async () => {\n   100\t    const storage = new MemoryStorageAdapter([\"tasks\"]);\n   101\t    await storage.upsertRecord(\"tasks\", { id: \"task:local-a\", title: \"Alpha\" });\n   102\t    await storage.upsertRecord(\"tasks\", { id: \"task:local-b\", title: \"Bravo\" });\n   103\t    await storage.setHydrationState(\"tasks\", \"hydrating\");\n   104\t\n   105\t    const remote: DatafnRemoteAdapter = {\n   106\t      query: vi.fn().mockResolvedValue({\n   107\t        ok: true,\n   108\t        result: {\n   109\t          data: [{ id: \"task:remote-z\", title: \"Zulu\" }],\n   110\t          nextCursor: \"next-page\",\n   111\t          count: 20,\n   112\t        },\n   113\t      }),\n   114\t      mutation: vi.fn(),\n   115\t      transact: vi.fn(),\n   116\t      seed: vi.fn(),\n   117\t      clone: vi.fn(),\n   118\t      pull: vi.fn(),\n   119\t      push: vi.fn(),\n   120\t      reconcile: vi.fn(),\n   121\t    };\n   122\t\n   123\t    const result = await executeQuery(\n   124\t      remote,\n   125\t      { resource: \"tasks\", select: [\"id\", \"title\"], sort: [\"title:asc\"], limit: 2 },\n   126\t      storage,\n   127\t      [],\n   128\t      schema,\n   129\t    );\n   130\t\n   131\t    expect(result).toEqual({\n   132\t      data: [\n   133\t        { id: \"task:local-a\", title: \"Alpha\" },\n   134\t        { id: \"task:local-b\", title: \"Bravo\" },\n   135\t      ],\n   136\t      nextCursor: \"next-page\",\n   137\t      count: 20,\n   138\t    });\n   139\t  });\n   140\t\n   141\t  it(\"does not overlay local rows onto offset or cursor pages\", async () => {\n   142\t    const storage = new MemoryStorageAdapter([\"tasks\"]);\n   143\t    await storage.upsertRecord(\"tasks\", { id: \"task:local\", title: \"Local\" });\n   144\t    await storage.setHydrationState(\"tasks\", \"hydrating\");\n   145\t    const remoteResult = {\n   146\t      data: [{ id: \"task:remote-page\", title: \"Remote page\" }],\n   147\t      nextCursor: \"next-page\",\n   148\t    };\n   149\t    const remote: DatafnRemoteAdapter = {\n   150\t      query: vi.fn().mockResolvedValue({ ok: true, result: remoteResult }),\n   151\t      mutation: vi.fn(),\n   152\t      transact: vi.fn(),\n   153\t      seed: vi.fn(),\n   154\t      clone: vi.fn(),\n   155\t      pull: vi.fn(),\n   156\t      push: vi.fn(),\n   157\t      reconcile: vi.fn(),\n   158\t    };\n   159\t\n   160\t    await expect(executeQuery(\n   161\t      remote,\n   162\t      { resource: \"tasks\", offset: 10, limit: 10 },\n   163\t      storage,\n   164\t      [],\n   165\t      schema,\n   166\t    )).resolves.toEqual(remoteResult);\n   167\t    await expect(executeQuery(\n   168\t      remote,\n   169\t      { resource: \"tasks\", sort: [\"id:asc\"], cursor: { after: { id: \"task:10\" } } },\n   170\t      storage,\n   171\t      [],\n   172\t      schema,\n   173\t    )).resolves.toEqual(remoteResult);\n   174\t  });\n   175\t\n   176\t  it(\"preserves local overlays for zero offsets and no-op cursors\", async () => {\n   177\t    const storage = new MemoryStorageAdapter([\"tasks\"]);\n   178\t    await storage.upsertRecord(\"tasks\", { id: \"task:local\", title: \"Local\" });\n   179\t    await storage.setHydrationState(\"tasks\", \"hydrating\");\n   180\t    const remote: DatafnRemoteAdapter = {\n   181\t      query: vi.fn().mockResolvedValue({\n   182\t        ok: true,\n   183\t        result: { data: [{ id: \"task:remote\", title: \"Remote\" }] },\n   184\t      }),\n   185\t      mutation: vi.fn(),\n   186\t      transact: vi.fn(),\n   187\t      seed: vi.fn(),\n   188\t      clone: vi.fn(),\n   189\t      pull: vi.fn(),\n   190\t      push: vi.fn(),\n   191\t      reconcile: vi.fn(),\n   192\t    };\n   193\t    const expected = {\n   194\t      data: [\n   195\t        { id: \"task:remote\", title: \"Remote\" },\n   196\t        { id: \"task:local\", title: \"Local\" },\n   197\t      ],\n   198\t    };\n   199\t\n   200\t    await expect(executeQuery(\n   201\t      remote,\n   202\t      { resource: \"tasks\", offset: 0 },\n   203\t      storage,\n   204\t      [],\n   205\t      schema,\n   206\t    )).resolves.toEqual(expected);\n   207\t    await expect(executeQuery(\n   208\t      remote,\n   209\t      { resource: \"tasks\", cursor: null } as any,\n   210\t      storage,\n   211\t      [],\n   212\t      schema,\n   213\t    )).resolves.toEqual(expected);\n   214\t    await expect(executeQuery(\n   215\t      remote,\n   216\t      { resource: \"tasks\", cursor: {} },\n   217\t      storage,\n   218\t      [],\n   219\t      schema,\n   220\t    )).resolves.toEqual(expected);\n   221\t  });\n   222\t\n   223\t  it(\"masks remotely stale rows changed by pending local mutations\", async () => {\n   224\t    const storage = new MemoryStorageAdapter([\"tasks\"]);\n   225\t    await storage.upsertRecord(\"tasks\", { id: \"task:changed\", title: \"Done\" });\n   226\t    await storage.changelogAppend({\n   227\t      clientId: \"client:1\",\n   228\t      mutationId: \"mutation:changed\",\n   229\t      timestampMs: 1,\n   230\t      mutation: {\n   231\t        operation: \"merge\",\n   232\t        resource: \"tasks\",\n   233\t        id: \"task:changed\",\n   234\t        record: { title: \"Done\" },\n   235\t      },\n   236\t    });\n   237\t    await storage.changelogAppend({\n   238\t      clientId: \"client:1\",\n   239\t      mutationId: \"mutation:deleted\",\n   240\t      timestampMs: 2,\n   241\t      mutation: {\n   242\t        operation: \"delete\",\n   243\t        resource: \"tasks\",\n   244\t        id: \"task:deleted\",\n   245\t      },\n     1\timport type { DatafnTemporalClause } from \"./temporal.js\";\n     2\timport type { SortInputTerm } from \"./sort.js\";\n     3\t\n     4\texport type DfqlSort = SortInputTerm[];\n     5\t\n     6\texport type DfqlCursor = {\n     7\t  after?: Record<string, unknown>;\n     8\t  before?: Record<string, unknown>;\n     9\t};\n    10\t\n    11\texport type DfqlQuery = {\n    12\t  resource: string;\n    13\t  version: number;\n    14\t  relation?: string;\n    15\t  id?: string;\n    16\t  select?: string[];\n    17\t  omit?: string[];\n    18\t  filters?: Record<string, unknown>;\n    19\t  search?: Record<string, unknown>;\n    20\t  sort?: DfqlSort;\n    21\t  limit?: number;\n    22\t  offset?: number;\n    23\t  cursor?: DfqlCursor;\n    24\t  count?: boolean;\n    25\t  groupBy?: string[];\n    26\t  aggregations?: Record<string, unknown>;\n    27\t  having?: Record<string, unknown>;\n    28\t  metadata?: Record<string, unknown>;\n    29\t  temporal?: DatafnTemporalClause | readonly DatafnTemporalClause[];\n    30\t  // QRY-001: AbortSignal for cancellable queries\n    31\t  signal?: AbortSignal;\n    32\t};\n    33\t\n    34\texport type DfqlQueryFragment = Omit<DfqlQuery, \"resource\" | \"version\">;\n    35\t\n    36\texport type DfqlMutation = {\n    37\t  resource: string;\n    38\t  version: number;\n    39\t  operation: string;\n    40\t  id?: string | string[];\n    41\t  record?: object;\n    42\t  records?: Array<Record<string, unknown>>;\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787266280.66965}}}
