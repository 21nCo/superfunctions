createdAt\": \"2026-08-20T22:36:11Z\"\n          }\n        ]\n      }\n    }\n  ]\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787265529.916391}}}
