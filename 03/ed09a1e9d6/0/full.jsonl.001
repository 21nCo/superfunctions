{"timestamp":"2026-08-20T22:03:25.009Z","ordinal":24118,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a02133-4bd1-7c30-a911-47cd84474e92","call_id":"call_mEmzGO8p8jlPPr25PvnKYm3h","output":[{"type":"input_text","text":"Script completed\nWall time 0.3 seconds\nOutput:\n"},{"type":"input_text","text":" M plugfn/core/package.json\n M plugfn/core/src/schema.ts\n M plugfn/core/tests/schema.test.ts\n plugfn/core/package.json         |  2 +-\n plugfn/core/src/schema.ts        |  8 ++++----\n plugfn/core/tests/schema.test.ts | 11 ++++++++++-\n 3 files changed, 15 insertions(+), 6 deletions(-)\ndiff --git a/plugfn/core/package.json b/plugfn/core/package.json\nindex 6cbcadf8..d60894ea 100644\n--- a/plugfn/core/package.json\n+++ b/plugfn/core/package.json\n@@ -76,7 +76,7 @@\n   },\n   \"superfunctions\": {\n     \"initFunction\": \"plugFn\",\n-    \"schemaVersion\": 6,\n+    \"schemaVersion\": 7,\n     \"namespace\": \"plugfn\"\n   }\n }\ndiff --git a/plugfn/core/src/schema.ts b/plugfn/core/src/schema.ts\nindex 94c30bbf..cc4c1441 100644\n--- a/plugfn/core/src/schema.ts\n+++ b/plugfn/core/src/schema.ts\n@@ -5,9 +5,9 @@ import {\n } from '@superfunctions/oauth-storage';\n import { DEFAULT_PLUGFN_STORAGE_MODELS, resolvePlugFnStorageModels, type PlugFnStorageModelMapping } from './storage/adapters/database.js';\n \n-// Version 7 constrains job-scoped claim tokens to their runtime length and adds\n-// uniqueness. Legacy application-generated tokens include the unique job id,\n-// so valid version-6 rows are already distinct before the index is created.\n+// Version 7 constrains job-scoped claim tokens to MySQL's portable full-column\n+// index width and adds uniqueness. The wider bound preserves legacy version-6\n+// worker/job/timestamp tokens while current tokens remain fixed at 54 chars.\n export const PLUGFN_SCHEMA_VERSION = 7;\n \n export interface PlugFnSchemaOptions {\n@@ -223,7 +223,7 @@ export function getSchema(options: PlugFnSchemaOptions = {}): { version: number;\n           resource: { type: 'string', required: true, fieldName: 'resource' },\n           mode: { type: 'string', required: true, fieldName: 'mode' },\n           status: { type: 'string', required: true, fieldName: 'status' },\n-          claimToken: { type: 'string', required: false, fieldName: 'claim_token', maxLength: 64 },\n+          claimToken: { type: 'string', required: false, fieldName: 'claim_token', maxLength: 768 },\n           ownerKind: { type: 'string', required: false, fieldName: 'owner_kind' },\n           ownerId: { type: 'string', required: false, fieldName: 'owner_id' },\n           cursor: { type: 'string', required: false, fieldName: 'cursor' },\ndiff --git a/plugfn/core/tests/schema.test.ts b/plugfn/core/tests/schema.test.ts\nindex 5f89afaf..238d86e6 100644\n--- a/plugfn/core/tests/schema.test.ts\n+++ b/plugfn/core/tests/schema.test.ts\n@@ -1,3 +1,4 @@\n+import { readFileSync } from 'node:fs';\n import { describe, expect, it } from 'vitest';\n import { getSchema, PLUGFN_SCHEMA_VERSION } from '../src/schema.js';\n \n@@ -27,7 +28,7 @@ describe('PlugFn schema metadata', () => {\n     expect(syncJobs).toBeDefined();\n     expect(syncJobs!.fields.claimToken).toMatchObject({\n       fieldName: 'claim_token',\n-      maxLength: 64,\n+      maxLength: 768,\n     });\n     expect(syncJobs!.indexes).toContainEqual({\n       name: 'idx_plugfn_sync_jobs_claim_token',\n@@ -35,4 +36,12 @@ describe('PlugFn schema metadata', () => {\n       unique: true,\n     });\n   });\n+\n+  it('keeps package discovery metadata aligned with the runtime schema', () => {\n+    const packageMetadata = JSON.parse(\n+      readFileSync(new URL('../package.json', import.meta.url), 'utf8')\n+    ) as { superfunctions?: { schemaVersion?: number } };\n+\n+    expect(packageMetadata.superfunctions?.schemaVersion).toBe(PLUGFN_SCHEMA_VERSION);\n+  });\n });\ndist_diff_exit=0\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70