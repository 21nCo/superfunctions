atafnTableQueryFragment<TRecord = Record<string, unknown>> =\ndatafn/client/src/tables/table.ts:141:export type DatafnRelationQueryFragment =\ndatafn/client/src/tables/table.ts:187:export type DatafnQueryResult<TRecord, Q> =\ndatafn/client/src/tables/table.ts:254:interface ClientWithQuery {\ndatafn/client/src/tables/table.ts:325:        limit: 1,\ndatafn/client/src/client.ts:28:import type { DatafnTable, DatafnTableQueryFragment } from \"./tables/table.js\";\ndatafn/client/src/client.ts:522:  limit?: number;\n     1\timport pytest\n     2\tfrom datafn.validation import (\n     3\t    SchemaIndex, validate_schema, validate_record_types,\n     4\t    validate_required_fields, apply_defaults,\n     5\t    validate_query_limits, validate_mutation_limits,\n     6\t    validate_id_length, validate_record_keys,\n     7\t)\n     8\tfrom datafn.envelope import classify_error, DatafnError, CONFLICT, NOT_FOUND, INTERNAL\n     9\tfrom datafn.server import create_datafn_server\n    10\t\n    11\t\n    12\t# --- Helpers ---\n    13\t\n    14\tdef make_schema(resources=None, relations=None):\n    15\t    return {\n    16\t        \"resources\": resources or [\n    17\t            {\"name\": \"tasks\", \"version\": 1, \"fields\": [\n    18\t                {\"name\": \"title\", \"type\": \"string\", \"required\": True},\n    19\t                {\"name\": \"status\", \"type\": \"string\", \"default\": \"pending\"},\n    20\t                {\"name\": \"priority\", \"type\": \"number\"},\n    21\t                {\"name\": \"done\", \"type\": \"boolean\"},\n    22\t                {\"name\": \"dueDate\", \"type\": \"date\"},\n    23\t                {\"name\": \"metadata\", \"type\": \"object\"},\n    24\t                {\"name\": \"tags\", \"type\": \"array\"},\n    25\t                {\"name\": \"config\", \"type\": \"json\"},\n    26\t                {\"name\": \"readonlyField\", \"type\": \"string\", \"readonly\": True},\n    27\t            ]}\n    28\t        ],\n    29\t        \"relations\": relations or [],\n    30\t    }\n    31\t\n    32\t\n    33\t# --- Schema Validation (VAL-001) ---\n    34\t\n    35\tclass TestValidateSchema:\n    36\t    # TV-VAL-001\n    37\t    def test_valid_schema(self):\n    38\t        result = validate_schema(make_schema())\n    39\t        assert result[\"ok\"] is True\n    40\t\n    41\t    # TV-VAL-002\n    42\t    def test_duplicate_resource(self):\n    43\t        schema = {\n    44\t            \"resources\": [\n    45\t                {\"name\": \"tasks\", \"version\": 1, \"fields\": []},\n    46\t                {\"name\": \"tasks\", \"version\": 1, \"fields\": []},\n    47\t            ],\n    48\t            \"relations\": [],\n    49\t        }\n    50\t        result = validate_schema(schema)\n    51\t        assert result[\"ok\"] is False\n    52\t        assert result[\"error\"][\"code\"] == \"SCHEMA_INVALID\"\n    53\t\n    54\t    def test_missing_resources(self):\n    55\t        result = validate_schema({})\n    56\t        assert result[\"ok\"] is False\n    57\t\n    58\t    def test_empty_resources(self):\n    59\t        result = validate_schema({\"resources\": []})\n    60\t        assert result[\"ok\"] is False\n    61\t\n    62\t    def test_too_many_resources(self):\n    63\t        resources = [{\"name\": f\"r{i}\", \"fields\": []} for i in range(101)]\n    64\t        result = validate_schema({\"resources\": resources})\n    65\t        assert result[\"ok\"] is False\n    66\t        assert \"maximum is 100\" in result[\"error\"][\"message\"]\n    67\t\n    68\t    def test_duplicate_field_names(self):\n    69\t        schema = {\n    70\t            \"resources\": [\n    71\t                {\"name\": \"tasks\", \"fields\": [\n    72\t                    {\"name\": \"title\"},\n    73\t                    {\"name\": \"title\"},\n    74\t                ]}\n    75\t            ],\n    76\t            \"relations\": [],\n    77\t        }\n    78\t        result = validate_schema(schema)\n    79\t        assert result[\"ok\"] is False\n    80\t        assert \"Duplicate field\" in result[\"error\"][\"message\"]\n    81\t\n    82\t    def test_too_many_fields(self):\n    83\t        fields = [{\"name\": f\"f{i}\"} for i in range(201)]\n    84\t        schema = {\"resources\": [{\"name\": \"tasks\", \"fields\": fields}], \"relations\": []}\n    85\t        result = validate_schema(schema)\n    86\t        assert result[\"ok\"] is False\n    87\t\n    88\t    def test_invalid_relation_reference(self):\n    89\t        schema = {\n    90\t            \"resources\": [{\"name\": \"tasks\", \"fields\": []}],\n    91\t            \"relations\": [{\"from\": \"tasks\", \"to\": \"nonexistent\", \"type\": \"many-one\", \"relation\": \"parent\"}],\n    92\t        }\n    93\t        result = validate_schema(schema)\n    94\t        assert result[\"ok\"] is False\n    95\t        assert \"nonexistent\" in result[\"error\"][\"message\"]\n    96\t\n    97\t    def test_server_raises_on_invalid_schema(self):\n    98\t        from tests.mock_db import MockAdapter\n    99\t        with pytest.raises(DatafnError) as exc_info:\n   100\t            create_datafn_server({\"schema\": {}, \"db\": MockAdapter()})\n   101\t        assert exc_info.value.code == \"SCHEMA_INVALID\"\n   102\t\n   103\t\n   104\t# --- FK Field Injection (VAL-002) ---\n   105\t\n   106\tclass TestFKInjection:\n   107\t    # TV-VAL-003\n   108\t    def test_fk_field_injected(self):\n   109\t        schema = {\n   110\t            \"resources\": [\n   111\t                {\"name\": \"tasks\", \"fields\": [{\"name\": \"title\", \"type\": \"string\"}]},\n   112\t                {\"name\": \"projects\", \"fields\": [{\"name\": \"name\", \"type\": \"string\"}]},\n   113\t            ],\n   114\t            \"relations\": [\n   115\t                {\"from\": \"tasks\", \"to\": \"projects\", \"type\": \"many-one\", \"relation\": \"project\"},\n"}],"internal_chat_message_metadata_passthrough"