auth\": \"0.1.2\",\n    \"@superfunctions/envelope\": \"0.0.1\",\n    \"@superfunctions/errors\": \"0.0.1\",\n    \"@superfunctions/http\": \"0.1.3\",\n    \"@superfunctions/metrics\": \"0.0.1\",\n    \"@superfunctions/middleware\": \"0.1.0\",\n    \"@superfunctions/queue\": \"0.0.1\",\n    \"@superfunctions/webhooks\": \"0.0.1\",\n    \"@superfunctions/db\": \"0.1.4\",\n    \"zod\": \"^3.22.4\"\n  },\n  \"devDependencies\": {\n    \"@types/node\": \"^20.10.0\",\n    \"@typescript-eslint/eslint-plugin\": \"^6.13.0\",\n    \"@typescript-eslint/parser\": \"^6.13.0\",\n    \"eslint\": \"^8.54.0\",\n    \"prettier\": \"^3.1.0\",\n    \"typescript\": \"^5.3.2\",\n    \"vitest\": \"^1.0.4\"\n  }\n}\ndatafn/swift-bridge\n{\n  \"name\": \"@datafn/swift-bridge\",\n  \"scripts\": {\n    \"build\": \"tsc -p tsconfig.build.json\",\n    \"test\": \"vitest run\",\n    \"typecheck\": \"tsc --noEmit\"\n  },\n  \"dependencies\": {\n    \"@datafn/client\": \"0.0.3\",\n    \"@datafn/core\": \"0.0.3\"\n  },\n  \"devDependencies\": {\n    \"typescript\": \"^5.9.3\",\n    \"vitest\": \"^3.2.4\"\n  }\n}\nsearchfn/datafn-provider\n{\n  \"name\": \"@searchfn/datafn-provider\",\n  \"scripts\": {\n    \"build\": \"tsup\",\n    \"build:watch\": \"tsup --watch\",\n    \"clean\": \"node -e \\\"require('fs').rmSync('dist', { recursive: true, force: true })\\\"\",\n    \"test\": \"vitest run\",\n    \"test:watch\": \"vitest watch\",\n    \"typecheck\": \"tsc --noEmit\"\n  },\n  \"dependencies\": {\n    \"@searchfn/adapter-contracts\": \"file:../adapter-contracts\",\n    \"@superfunctions/observability\": \"0.0.1\"\n  },\n  \"devDependencies\": {\n    \"@datafn/core\": \"*\",\n    \"@types/node\": \"^24.9.1\",\n    \"tsup\": \"^8.5.0\",\n    \"typescript\": \"^5.9.3\",\n    \"vitest\": \"^3.2.4\"\n  }\n}\nauthfn/examples/account-settings/server\n{\n  \"name\": \"@authfn/examples-account-settings-server\",\n  \"scripts\": {\n    \"build:deps\": \"npm --prefix ../../../../ run build -- --filter=@authfn/examples-shared... --filter=@superfunctions/cli...\",\n    \"dev\": \"npm run build:deps && tsx watch src/index.ts\",\n    \"build\": \"tsc\",\n    \"start\": \"node dist/index.js\",\n    \"start:test\": \"npm run build:deps && npm run build && npm run start\",\n    \"db:generate\": \"npm run build:deps && superfunctions generate-schema --config ./superfunctions.config.mjs --library authfn --adapter drizzle --output ./src/db/generated --force\",\n    \"db:push\": \"drizzle-kit push --config drizzle.config.ts\"\n  },\n  \"dependencies\": {\n    \"@authfn/api-keys\": \"*\",\n    \"authfn\": \"*\",\n    \"@authfn/examples-shared\": \"*\",\n    \"@authfn/password\": \"*\",\n    \"@authfn/two-factor\": \"*\",\n    \"@superfunctions/db\": \"*\",\n    \"@superfunctions/http-express\": \"*\",\n    \"dotenv\": \"^17.2.2\",\n    \"drizzle-orm\": \"^0.45.1\",\n    \"express\": \"^4.21.2\",\n    \"postgres\": \"^3.4.8\"\n  },\n  \"devDependencies\": {\n    \"@superfunctions/cli\": \"*\",\n    \"@types/express\": \"^4.17.21\",\n    \"@types/node\": \"^22.0.0\",\n    \"drizzle-kit\": \"^0.31.8\",\n    \"tsx\": \"^4.20.6\",\n    \"typescript\": \"^5.6.0\"\n  }\n}\ndatafn/swift/Package.swift\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787259447.109159}}}
