{"timestamp":"2026-08-20T22:39:14.286Z","ordinal":24619,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a02154-176e-7a92-ab29-00010fd89416","call_id":"call_wGV4gOuJZth9C00INdVtgGQw","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"1bbfcb06 fix: address second-wave review findings\n authfn/core/src/__tests__/rate-limit.test.ts       |  27 +-\n authfn/core/src/core/rate-limit.ts                 |  54 ++--\n .../examples/account-settings/server/src/index.ts  |   2 +-\n datafn/client/__tests__/e2ee.test.ts               |  31 ++\n datafn/client/__tests__/storage-mem.test.ts        |  18 ++\n datafn/client/src/adapters/indexedDbStorage.ts     |   3 +-\n datafn/client/src/adapters/memoryStorage.ts        |  12 +-\n datafn/client/src/e2ee.ts                          |  24 +-\n datafn/client/src/mutate.ts                        |   6 +-\n datafn/client/src/offline/mutate.ts                |  22 +-\n datafn/client/src/storage.ts                       |   3 +-\n datafn/core/__tests__/public-links.test.ts         |   3 +-\n datafn/core/__tests__/relation-endpoints.test.ts   |  19 ++\n datafn/core/__tests__/relation-fks.test.ts         |  15 +-\n datafn/core/src/relation-endpoints.ts              |   7 +-\n datafn/core/src/relation-fks.ts                    |   2 +-\n datafn/core/src/types.ts                           |   2 +\n .../server/__tests__/scalability-critical.test.ts  |  51 ++++\n datafn/server/src/execution/internal-tables.ts     |   2 +\n .../mutation/__tests__/share-spv2.test.ts          | 337 ++++++++++++++++++++-\n datafn/server/src/execution/mutation/execute.ts    |  15 +-\n .../mutation/permission-directory-outbox.ts        |  19 +-\n datafn/server/src/execution/mutation/share.ts      |  18 ++\n datafn/server/src/execution/query/aggregate.ts     |   3 +-\n datafn/server/src/execution/query/filters.ts       |   4 +-\n datafn/server/src/execution/query/select.ts        |   2 +-\n datafn/server/src/execution/sync/push.ts           |  43 ++-\n datafn/server/src/execution/sync/reconcile.ts      |   6 +-\n datafn/server/src/execution/transact.ts            |  16 +-\n datafn/server/src/plugins/multi-region.test.ts     |  44 +++\n datafn/server/src/plugins/multi-region.ts          |  21 +-\n datafn/server/src/plugins/public-links.ts          |  77 ++++-\n datafn/server/src/routes/query.ts                  |   6 +-\n datafn/server/src/server.ts                        |  28 +-\n .../src/validation/__tests__/validation.test.ts    |  30 ++\n datafn/server/src/validation/query.ts              |  11 +\n .../src/__tests__/schema-index-migrations.test.ts  |  63 ++++\n packages/cli/src/commands/generate-schema.ts       |   1 +\n packages/cli/src/utils/generators.ts               |  32 ++\n packages/cli/src/utils/schema-diff.ts              |  41 ++-\n packages/observability/src/index.test.ts           |  23 ++\n packages/observability/src/index.ts                |  22 +-\n searchfn/datafn-provider/__tests__/factory.test.ts |  29 ++\n 43 files changed, 1073 insertions(+), 121 deletions(-)\ncommit 1bbfcb069c666829dac4f8200b86522720968fed\nAuthor:     Aravind Samala <samalaaravind02@gmail.com>\nAuthorDate: Thu Aug 20 18:07:11 2026 +0530\nCommit:     Aravind Samala <samalaaravind02@gmail.com>\nCommitDate: Thu Aug 20 18:07:11 2026 +0530\n\n    fix: address second-wave review findings\n\ndiff --git a/datafn/client/__tests__/e2ee.test.ts b/datafn/client/__tests__/e2ee.test.ts\nindex e8f64d1b..4438c1e1 100644\n--- a/datafn/client/__tests__/e2ee.test.ts\n+++ b/datafn/client/__tests__/e2ee.test.ts\n@@ -154,6 +154,37 @@ describe(\"DataFn E2EE client transforms\", () => {\n     expect(decrypted.data.task?.[0]?.notes).toEqual(collidingValue);\n   });\n \n+  it(\"does not reuse an envelope across provider key contexts\", async () => {\n+    const firstProvider = createProvider();\n+    const first = (await encryptMutationPayloadForE2ee(\n+      schema,\n+      { enabled: true, provider: firstProvider },\n+      {\n+        operation: \"insert\",\n+        resource: \"task\",\n+        id: \"task:rekey\",\n+        record: { id: \"task:rekey\", notes: \"secret\" },\n+      },\n+    )) as { record: Record<string, unknown> };\n+    const nextProvider = createProvider();\n+    nextProvider.keyRef = \"next-key\";\n+    const encrypt = vi.spyOn(nextProvider, \"encrypt\");\n+\n+    const reencrypted = (await encryptMutationPayloadForE2ee(\n+      schema,\n+      { enabled: true, provider: nextProvider },\n+      {\n+        operation: \"merge\",\n+        resource: \"task\",\n+        id: \"task:rekey\",\n+        record: { id: \"task:rekey\", notes: first.record.notes },\n+      },\n+    )) as { record: Record<string, unknown> };\n+\n+    expect(encrypt).toHaveBeenCalledOnce();\n+    expect(reencrypted.record.notes).not.toBe(first.record.notes);\n+  });\n+\n   it(\"blocks direct remote query and search while allowing plaintext KV query\", () => {\n     const e2ee = { enabled: true, provider: createProvider() };\n \ndiff --git a/datafn/client/src/e2ee.ts b/datafn/client/src/e2ee.ts\nindex 0fefa6a7..a1db2011 100644\n--- a/datafn/client/src/e2ee.ts\n+++ b/datafn/client/src/e2ee.ts\n@@ -42,7 +42,24 @@ export type DatafnE2eeConfig = {\n \n const textEncoder = new TextEncoder();\n const textDecoder = new TextDecoder();\n-const providerEncryptedEnvelopes = new WeakSet<object>();\n+const providerEncryptedEnvelopes = new WeakMap<\n+  DatafnE2eeProvider,\n+  Map<string, WeakSet<object>>\n+>();\n+\n+function encryptedEnvelopesFor(provider: DatafnE2eeProvider): WeakSet<object> {\n+  let byKey = providerEncryptedEnvelopes.get(provider);\n+  if (!byKey) {\n+    byKey = new Map();\n+    providerEncryptedEnvelopes.set(provider, byKey);\n+  }\n+  let envelopes = byKey.get(provider.keyRef);\n+  if (!envelopes) {\n+    envelopes = new WeakSet();\n+    byKey.set(provider.keyRef, envelopes);\n+  }\n+  return envelopes;\n+}\n \n type RecordMutationOperation = \"insert\" | \"merge\" | \"replace\";\n \n@@ -144,6 +161,7 @@ async function encryptRecordFields(\n   }\n \n   const provider = assertE2eeProvider(e2ee, \"e2ee.provider\");\n+  const providerEnvelopes = encryptedEnvelopesFor(provider);\n   const plaintextFields = resolvePlaintextFields(schema, resource, e2ee);\n   const encrypted: Record<string, unknown> = {};\n \n@@ -154,7 +172,7 @@ async function encryptRecordFields(\n     }\n     if (\n       isDatafnE2eeEnvelope(value) &&\n-      providerEncryptedEnvelopes.has(value as object)\n+      providerEnvelopes.has(value as object)\n     ) {\n       encrypted[field] = value;\n       continue;\n@@ -167,7 +185,7 @@ async function encryptRecordFields(\n       plaintext: encodeFieldValue(value),\n       aad: aadFor(resource, id, field),\n     });\n-    providerEncryptedEnvelopes.add(envelope);\n+    providerEnvelopes.add(envelope);\n     encrypted[field] = envelope;\n   }\n \ncommit 171fe50facb827c48c0f7d39029fe62f526d44dd\nAuthor:     Aravind Samala <samalaaravind02@gmail.com>\nAuthorDate: Thu Aug 20 17:22:57 2026 +0530\nCommit:     Aravind Samala <samalaaravind02@gmail.com>\nCommitDate: Thu Aug 20 17:22:57 2026 +0530\n\n    fix: backport reviewed runtime safeguards\n\ndiff --git a/datafn/client/__tests__/e2ee.test.ts b/datafn/client/__tests__/e2ee.test.ts\nindex 4cb4b291..e8f64d1b 100644\n--- a/datafn/client/__tests__/e2ee.test.ts\n+++ b/datafn/client/__tests__/e2ee.test.ts\n@@ -124,6 +124,36 @@ describe(\"DataFn E2EE client transforms\", () => {\n     expect(decrypted.data.task?.[0]).toEqual(record);\n   });\n \n+  it(\"encrypts user data that merely resembles an E2EE envelope\", async () => {\n+    const collidingValue = {\n+      __datafnE2ee: 1 as const,\n+      alg: \"AES-GCM\",\n+      keyRef: \"user-controlled\",\n+      iv: \"not-provider-output\",\n+      data: \"not-ciphertext\",\n+    };\n+\n+    const encrypted = (await encryptMutationPayloadForE2ee(\n+      schema,\n+      { enabled: true, provider: createProvider() },\n+      {\n+        operation: \"insert\",\n+        resource: \"task\",\n+        id: \"task:collision\",\n+        record: { id: \"task:collision\", notes: collidingValue },\n+      },\n+    )) as { record: Record<string, unknown> };\n+\n+    expect(encrypted.record.notes).not.toBe(collidingValue);\n+    expect(isDatafnE2eeEnvelope(encrypted.record.notes)).toBe(true);\n+    const decrypted = await decryptCloneResultForE2ee(\n+      schema,\n+      { enabled: true, provider: createProvider() },\n+      { ok: true, data: { task: [encrypted.record] }, cursors: {}, next: {} },\n+    );\n+    expect(decrypted.data.task?.[0]?.notes).toEqual(collidingValue);\n+  });\n+\n   it(\"blocks direct remote query and search while allowing plaintext KV query\", () => {\n     const e2ee = { enabled: true, provider: createProvider() };\n \ndiff --git a/datafn/client/src/e2ee.ts b/datafn/client/src/e2ee.ts\nindex 028a45ca..0fefa6a7 100644\n--- a/datafn/client/src/e2ee.ts\n+++ b/datafn/client/src/e2ee.ts\n@@ -42,6 +42,7 @@ export type DatafnE2eeConfig = {\n \n const textEncoder = new TextEncoder();\n const textDecoder = new TextDecoder();\n+const providerEncryptedEnvelopes = new WeakSet<object>();\n \n type RecordMutationOperation = \"insert\" | \"merge\" | \"replace\";\n \n@@ -151,18 +152,23 @@ async function encryptRecordFields(\n       encrypted[field] = value;\n       continue;\n     }\n-    if (isDatafnE2eeEnvelope(value)) {\n+    if (\n+      isDatafnE2eeEnvelope(value) &&\n+      providerEncryptedEnvelopes.has(value as object)\n+    ) {\n       encrypted[field] = value;\n       continue;\n     }\n \n-    encrypted[field] = await provider.encrypt({\n+    const envelope = await provider.encrypt({\n       resource,\n       id,\n       field,\n       plaintext: encodeFieldValue(value),\n       aad: aadFor(resource, id, field),\n     });\n+    providerEncryptedEnvelopes.add(envelope);\n+    encrypted[field] = envelope;\n   }\n \n   return encrypted;\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787265554.2861}}}
