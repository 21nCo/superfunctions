              continue;\n              }\n              if (\n                typeof candidate.principalId === \"string\" &&\n                typeof candidate.parentPrincipalId === \"string\"\n              ) {\n                edges.push({\n                  principalId: candidate.principalId,\n                  parentPrincipalId: candidate.parentPrincipalId,\n                });\n              }\n            }\n          }\n          return edges;\n        },\n      },\n    });\n    return result.effectivePrincipals;\n  };\n\n  const resolveSharedWithMeNamespaceAccess = async (\n    resource: string,\n    namespace: string,\n    actorId: string | undefined,\n    metadata?: QueryEnvelopeMetadata,\n  ): Promise<Map<string, { scope: boolean; recordIds: Set<string> }>> => {\n    const access = new Map<string, { scope: boolean; recordIds: Set<string> }>();\n    if (!db || !actorId) {\n      return access;\n    }\n\n    const namespaceFilterSet =\n      Array.isArray(metadata?.namespaceFilter) && metadata.namespaceFilter.length > 0\n        ? new Set(metadata.namespaceFilter.filter((value) => typeof value === \"string\"))\n        : undefined;\n\n    const principals = await resolveActorPrincipals(namespace, actorId);\n    const readPermissionRows = async (\n      principalId: string,\n    ): Promise<Record<string, unknown>[]> => {\n      const directoryRows = await queryDatafnPermissionGrants({\n        principalId,\n        resourceType: resource,\n      }, multiRegionRuntime);\n      const rows: Record<string, unknown>[] = directoryRows\n        .filter((grant) => grant.resourceRegion === multiRegionRuntime?.regionId)\n        .map((grant) => ({\n          id: grant.id,\n          resourceType: grant.resourceType,\n          resourceNs: grant.resourceNs,\n          resourceId: grant.resourceId,\n          principalId: grant.principalId,\n          level: grant.level,\n          grantKind: grant.grantKind,\n          sourceRef: grant.sourceRef,\n          grantedBy: grant.grantedBy,\n          grantedAt: grant.grantedAt,\n          revokedAt: grant.revokedAt,\n          resourceRegion: grant.resourceRegion,\n        }));\n      if (rows.length > 0) {\n        return rows;\ndatafn/server/__tests__/server.test.ts:64:  it(\"rejects different permission directories configured for the same region\", async () => {\ndatafn/server/__tests__/server.test.ts:69:      resourceRegion: \"region:shared\",\ndatafn/server/__tests__/server.test.ts:132:      resourceRegion: \"region:good\",\ndatafn/server/__tests__/public-links-plugin.test.ts:295:      resourceRegion: runtime.regionId,\ndatafn/server/__tests__/public-links-plugin.test.ts:381:      resourceRegion: \"region:public-links\",\ndatafn/server/__tests__/public-links-plugin.test.ts:454:      resourceRegion: runtime.regionId,\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787261482.798146}}}
