{"timestamp":"2026-08-20T22:14:58.514Z","ordinal":24275,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0213d-e0d2-74c3-ad0f-4dbc93b1f66f","call_id":"call_ybPfWclKmKDJwufpFfREKyK5","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"import type {\n  DatafnBridgeEventEnvelope as ClientDatafnBridgeEventEnvelope,\n  DatafnNativeHandshakeRequest,\n  DatafnNativeHandshakeResult,\n  DatafnNativeSyncController,\n} from \"@datafn/client\";\nimport type { DatafnEnvelope } from \"@datafn/core\";\nimport {\n  DATAFN_BRIDGE_PROTOCOL,\n  beginBridgeCapabilityNegotiation,\n  completeBridgeCapabilityNegotiation,\n  createBridgeError,\n  nextBridgeRequestId,\n  requestBridgeMethod,\n  type DatafnBridgeBus,\n  type NativeBridgeMarker,\n} from \"./protocol.js\";\n\nfunction validateRequiredString(\n  value: string | undefined,\n  path: string,\n  message: string,\n) {\n  if (typeof value === \"string\" && value.trim().length > 0) {\n    return null;\n  }\n  return createBridgeError(\"DFQL_INVALID\", message, { path });\n}\n\nfunction validateHandshakePayload(\n  payload: DatafnNativeHandshakeRequest,\n) {\n  return (\n    validateRequiredString(payload.schemaHash, \"payload.schemaHash\", \"schemaHash is required\") ??\n    validateRequiredString(payload.namespace, \"payload.namespace\", \"namespace is required\") ??\n    validateRequiredString(payload.clientId, \"payload.clientId\", \"clientId is required\")\n  );\n}\n\nexport function createNativeSyncController(\n  bus: DatafnBridgeBus,\n): DatafnNativeSyncController & NativeBridgeMarker {\n  return {\n    __datafnNativeBacked: true,\n    async handshake(\n      payload: DatafnNativeHandshakeRequest,\n    ): Promise<DatafnEnvelope<DatafnNativeHandshakeResult>> {\n      const validationError = validateHandshakePayload(payload);\n      if (validationError) {\n        return { ok: false, error: validationError };\n      }\n\n      // Capabilities belong to one successful handshake. Clear any prior\n      // negotiation before contacting a host that may have restarted or been\n      // replaced with an older bridge implementation.\n      const negotiationGeneration = beginBridgeCapabilityNegotiation(bus);\n      const response = await bus.request({\n        protocol: DATAFN_BRIDGE_PROTOCOL,\n        id: nextBridgeRequestId(),\n        method: \"handshake\",\n        payload,\n      });\n\n      if (!response.ok) {\n        return { ok: false, error: response.error };\n      }\n\n      completeBridgeCapabilityNegotiation(\n        bus,\n        negotiationGeneration,\n        (response.result as Partial<DatafnNativeHandshakeResult> | undefined)\n          ?.capabilities,\n      );\n\n      return {\n        ok: true,\n        result: response.result as DatafnNativeHandshakeResult,\n      };\n    },\n    start() {\n      return requestBridgeMethod<void>(bus, \"sync.start\");\n    },\n    stop() {\n      return requestBridgeMethod<void>(bus, \"sync.stop\");\n    },\n    pullNow() {\n      return requestBridgeMethod<void>(bus, \"sync.pullNow\");\n    },\n    cloneNow() {\n      return requestBridgeMethod<void>(bus, \"sync.cloneNow\");\n    },\n    reconcileNow() {\n      return requestBridgeMethod<void>(bus, \"sync.reconcileNow\");\n    },\n    schedulePush() {\n      return requestBridgeMethod<void>(bus, \"sync.schedulePush\");\n    },\n    onEvent(handler: (event: ClientDatafnBridgeEventEnvelope) => void) {\n      return bus.subscribe((event) => handler(event));\n    },\n  };\n}\nrg: datafn/swift-bridge/tests: No such file or directory (os error 2)\ndatafn/swift-bridge/src/nativeStorage.ts:19:    capabilities: {\ndatafn/swift-bridge/src/nativeStorage.ts:20:      get atomicMergeIfMissing() {\ndatafn/swift-bridge/src/protocol.ts:8:  \"storage.atomicMergeIfMissing\" as const;\ndatafn/swift-bridge/src/protocol.ts:12:  capabilities: ReadonlySet<string>;\ndatafn/swift-bridge/src/protocol.ts:24:  negotiatedCapabilities.set(bus, { generation, capabilities: new Set() });\ndatafn/swift-bridge/src/protocol.ts:31:  capabilities: unknown,\ndatafn/swift-bridge/src/protocol.ts:38:      capabilities: new Set(\ndatafn/swift-bridge/src/protocol.ts:39:        Array.isArray(capabilities)\ndatafn/swift-bridge/src/protocol.ts:40:          ? capabilities.filter((capability): capability is string =>\ndatafn/swift-bridge/src/protocol.ts:41:              typeof capability === \"string\"\ndatafn/swift-bridge/src/protocol.ts:51:  capability: string,\ndatafn/swift-bridge/src/protocol.ts:53:  return negotiatedCapabilities.get(bus)?.capabilities.has(capability) === true;\ndatafn/swift-bridge/src/protocol.ts:57:  \"handshake\",\ndatafn/swift-bridge/src/index.ts:17:export { createNativeSyncController } from \"./nativeSyncController.js\";\ndatafn/swift-bridge/src/nativeSyncController.ts:5:  DatafnNativeSyncController,\ndatafn/swift-bridge/src/nativeSyncController.ts:40:export function createNativeSyncController(\ndatafn/swift-bridge/src/nativeSyncController.ts:42:): DatafnNativeSyncController & NativeBridgeMarker {\ndatafn/swift-bridge/src/nativeSyncController.ts:45:    async handshake(\ndatafn/swift-bridge/src/nativeSyncController.ts:53:      // Capabilities belong to one successful handshake. Clear any prior\ndatafn/swift-bridge/src/nativeSyncController.ts:60:        method: \"handshake\",\ndatafn/swift-bridge/src/nativeSyncController.ts:72:          ?.capabilities,\n{\n  \"name\": \"@datafn/swift-bridge\",\n  \"version\": \"0.0.1\",\n  \"type\": \"module\",\n  \"description\": \"WKWebView bridge primitives for native-backed DataFn clients\",\n  \"main\": \"./dist/index.js\",\n  \"module\": \"./dist/index.js\",\n  \"types\": \"./dist/index.d.ts\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"import\": \"./dist/index.js\"\n    }\n  },\n  \"scripts\": {\n    \"build\": \"tsc -p tsconfig.build.json\",\n    \"test\": \"vitest run\",\n    \"typecheck\": \"tsc 