hema.test.ts:308:  it(\"accepts identity metadata for many-many relation metadata fields\", () => {\ndatafn/core/__tests__/schema.test.ts:314:      relations: [\ndatafn/core/__tests__/schema.test.ts:319:          relation: \"tags\",\ndatafn/core/__tests__/schema.test.ts:328:      expect(result.result.relations?.[0].identityMetadata).toEqual([\"linkType\"]);\ndatafn/core/__tests__/schema.test.ts:332:  it(\"rejects identity metadata that is not declared as relation metadata\", () => {\ndatafn/core/__tests__/schema.test.ts:338:      relations: [\ndatafn/core/__tests__/schema.test.ts:343:          relation: \"tags\",\ndatafn/core/__tests__/schema.test.ts:353:      expect(result.error.details.path).toBe(\"relations.identityMetadata.linkType\");\ndatafn/core/__tests__/schema.test.ts:357:  it(\"accepts relation integrity and delete policy declarations\", () => {\ndatafn/core/__tests__/schema.test.ts:359:      relationIntegrity: \"database\",\ndatafn/core/__tests__/schema.test.ts:364:      relations: [\ndatafn/core/__tests__/schema.test.ts:369:          relation: \"tags\",\ndatafn/core/__tests__/schema.test.ts:378:      expect(result.result.relationIntegrity).toBe(\"database\");\ndatafn/core/__tests__/schema.test.ts:379:      expect(result.result.relations?.[0].integrity).toBe(\"database\");\ndatafn/core/__tests__/schema.test.ts:380:      expect(result.result.relations?.[0].onDelete).toEqual({\ndatafn/core/__tests__/schema.test.ts:387:  it(\"rejects removed hybrid relation integrity mode\", () => {\ndatafn/core/__tests__/schema.test.ts:389:      relationIntegrity: \"hybrid\",\ndatafn/core/__tests__/schema.test.ts:401:        \"Invalid schema: relationIntegrity must be one of application, database\",\ndatafn/core/__tests__/schema.test.ts:406:  it(\"rejects invalid relation delete policy declarations\", () => {\ndatafn/core/__tests__/schema.test.ts:412:      relations: [\ndatafn/core/__tests__/schema.test.ts:417:          relation: \"tags\",\ndatafn/core/__tests__/schema.test.ts:426:      expect(result.error.details.path).toBe(\"relations.onDelete.from\");\ndatafn/core/__tests__/schema.test.ts:430:  it(\"rejects relation.from array that contains an unknown resource\", () => {\ndatafn/core/__tests__/schema.test.ts:433:      relations: [\ndatafn/core/__tests__/schema.test.ts:434:        { type: \"many-many\", from: [\"task\", \"ghost\"], to: \"task\", relation: \"rel\" },\ndatafn/core/__tests__/schema.test.ts:441:      expect(result.error.details.path).toBe(\"relations.from\");\ndatafn/core/__tests__/schema.test.ts:451:      relations: [{ type: \"one-many\", from: \"task\", to: \"missing\" }],\ndatafn/core/__tests__/schema.test.ts:487:  it(\"rejects invalid relation endpoint shapes\", () => {\ndatafn/core/__tests__/schema.test.ts:490:      relations: [{ from: 123, to: \"task\", type: \"one-many\" }],\ndatafn/core/__tests__/schema.test.ts:495:  it(\"returns normalized relation capabilities\", () => {\ndatafn/core/__tests__/schema.test.ts:501:      relations: [\ndatafn/core/__tests__/schema.test.ts:506:          relation: \"tags\",\ndatafn/core/__tests__/schema.test.ts:514:      expect(result.result.relations?.[0]?.capabilities).toEqual([\"timestamps\", \"audit\"]);\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787267088.93178}}}
