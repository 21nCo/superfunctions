{"timestamp":"2026-08-20T22:51:17.896Z","ordinal":24789,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0215f-2208-74e0-8585-7a4b1b53ffd7","call_id":"call_XYKoZqKyKOiwZlla3jyHVFul","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"   200\t}\n   201\t\n   202\tfunction resolveEmptyQueryResult(query: unknown): Record<string, unknown> | undefined {\n   203\t  if (!isPlainRecord(query)) return undefined;\n   204\t  if (!hasImpossibleEmptyInFilter(query.filters)) return undefined;\n   205\t  if (query.groupBy || hasTemporalGrouping(query)) {\n   206\t    return { groups: [], nextCursor: null };\n   207\t  }\n   208\t  return {\n   209\t    data: [],\n   210\t    nextCursor: null,\n   211\t    ...(query.count === true ? { count: 0 } : {}),\n   212\t  };\n   213\t}\n   214\t\n   215\tfunction mergeQueryDataById(\n   216\t  remoteResult: unknown,\n   217\t  localResult: unknown,\n   218\t  query: Record<string, unknown>,\n   219\t  pendingLocalIds: ReadonlySet<string>,\n   220\t): unknown {\n   221\t  const remoteEnvelope =\n   222\t    remoteResult && typeof remoteResult === \"object\" && !Array.isArray(remoteResult)\n   223\t      ? (remoteResult as Record<string, unknown>)\n   224\t      : null;\n   225\t  const localEnvelope =\n   226\t    localResult && typeof localResult === \"object\" && !Array.isArray(localResult)\n   227\t      ? (localResult as Record<string, unknown>)\n   228\t      : null;\n   229\t  const remoteData = Array.isArray(remoteEnvelope?.data)\n   230\t    ? remoteEnvelope.data\n   231\t    : Array.isArray(remoteResult)\n   232\t      ? remoteResult\n   233\t      : null;\n   234\t  const localData = Array.isArray(localEnvelope?.data)\n   235\t    ? localEnvelope.data\n   236\t    : Array.isArray(localResult)\n   237\t      ? localResult\n   238\t      : null;\n   239\t\n   240\t  if (!remoteData || !localData || (localData.length === 0 && pendingLocalIds.size === 0)) {\n   241\t    return remoteResult;\n   242\t  }\n   243\t\n   244\t  const localById = new Map<string, unknown>();\n   245\t  const localWithoutId: unknown[] = [];\n   400\t  );\n   401\t}\n   402\t\n   403\t/**\n   404\t * Execute a query (single or batch) via the remote adapter or local storage.\n   405\t *\n   406\t * When storage is configured and table hydration state is 'ready', queries execute locally.\n   407\t * Otherwise, queries execute via the remote adapter.\n   408\t *\n   409\t * @param remote - Remote adapter for server queries\n   410\t * @param q - Query or array of queries\n   411\t * @param storage - Optional storage adapter for local-first execution\n   412\t * @param plugins - Optional plugins for hook execution\n   413\t * @returns Query result(s)\n   414\t */\n   415\texport async function executeQuery<T = unknown>(\n   416\t  remote: DatafnRemoteAdapter,\n   417\t  q: unknown | unknown[],\n   418\t  storage?: DatafnStorageAdapter,\n   419\t  plugins: DatafnPlugin[] = [],\n   420\t  schema?: DatafnSchema,\n   421\t  schemaIndex?: SchemaIndex,\n   422\t  nativeRemoteMode?: DatafnNativeRemoteMode,\n   423\t  temporal?: DatafnTemporalConfig,\n   424\t  e2ee?: DatafnE2eeConfig,\n   425\t): Promise<T | T[]> {\n   426\t  // Run beforeQuery hooks (fail-closed)\n   427\t  const transformedQuery = schema\n   428\t    ? await runBeforeQuery(plugins, schema, q)\n   429\t    : q;\n   430\t  const metadataNormalizedQuery = Array.isArray(transformedQuery)\n   431\t    ? transformedQuery.map((entry) =>\n   432\t        typeof entry === \"object\" && entry !== null\n   433\t          ? normalizeQueryMetadata(entry as Record<string, unknown>)\n   434\t          : entry,\n   435\t      )\n   436\t    : typeof transformedQuery === \"object\" && transformedQuery !== null\n   437\t      ? normalizeQueryMetadata(transformedQuery as Record<string, unknown>)\n   438\t      : transformedQuery;\n   439\t  const normalizedQuery = metadataNormalizedQuery;\n   440\t  const runRemoteQuery = async (): Promise<unknown> => {\n   441\t    assertRemoteQueryAllowedForE2ee(e2ee, normalizedQuery);\n   442\t    return remote.query(normalizedQuery);\n   443\t  };\n   444\t\n   445\t  const emptyResult = resolveEmptyQueryResult(normalizedQuery);\n   446\t  if (emptyResult) {\n   447\t    return schema\n   448\t      ? (runAfterQuery(plugins, schema, normalizedQuery, emptyResult) as Promise<T>)\n   449\t      : (emptyResult as T);\n   450\t  }\n   451\t\n   452\t  // If no storage is configured, always use remote execution.\n   453\t  if (!storage) {\n   454\t    const response = await runRemoteQuery();\n   455\t    let result = unwrapRemoteSuccess<T | T[]>(response);\n   456\t\n   457\t    if (schema && Array.isArray(normalizedQuery)) {\n   458\t      // REL-013: Apply inbound date codec per-query for batch queries (no-storage path)\n   459\t      if (Array.isArray(result)) {\n   460\t        result = (result as any[]).map((queryResult, i) => {\n   461\t          const query = (normalizedQuery as any[])[i] as Record<string, unknown>;\n   462\t          const resource = query?.resource as string;\n   463\t          if (resource) {\n   464\t            return parseQueryResultDates(schema, resource, queryResult);\n   465\t          }\n   466\t          return queryResult;\n   467\t        }) as any;\n   468\t      }\n   469\t    } else if (schema && !Array.isArray(normalizedQuery)) {\n   470\t      // Apply inbound date codec (CODEC-001)\n   471\t      const query = normalizedQuery as Record<string, unknown>;\n   472\t      const resource = query.resource as string;\n   473\t      if (resource) {\n   474\t        result = parseQueryResultDates(schema, resource, result) as T | T[];\n   475\t      }\n   476\t    }\n   477\t\n   478\t    // Run afterQuery hooks (fail-open)\n   479\t    return schema\n   480\t      ? (runAfterQuery(plugins, schema, normalizedQuery, result) as Promise<\n   481\t          T | T[]\n   482\t        >)\n   483\t      : result;\n   484\t  }\n   485\t\n   486\t  if (Array.isArray(normalizedQuery)) {\n   487\t    const emptyResults = normalizedQuery.map(resolveEmptyQueryResult);\n   488\t    if (emptyResults.every(Boolean)) {\n   489\t      return schema\n   490\t        ? (runAfterQuery(plugins, schema, normalizedQuery, emptyResults) as Promise<T[]>)\n   491\t        : (emptyResults as T[]);\n   492\t    }\n   493\t\n   494\t    if (nativeRemoteMode === \"icloud\" && schema) {\n   495\t      const remoteOnlyResource = normalizedQuery\n   496\t        .map((entry) => {\n   497\t          if (!entry || typeof entry !== \"object\" || Array.isArray(entry)) {\n   498\t            return undefined;\n   499\t          }\n   500\t          const resource = (entry as { resource?: unknown }).resource;\n   501\t          return typeof resource === \"string\" ? resource : undefined;\n   502\t        })\n   503\t        .find((name) =>\n   504\t          name &&\n   505\t          schema.resources.some(\n   506\t            (resourceDef) =>\n   507\t              resourceDef.name === name && resourceDef.isRemoteOnly,\n   508\t          ),\n   509\t        );\n   510\t\n   511\t      if (remoteOnlyResource) {\n   512\t        throw createClientError(\n   513\t          \"DFQL_UNSUPPORTED\",\n   514\t          \"Remote-only resource is unsupported in icloud mode\",\n   515\t          { path: \"query.resource\", resource: remoteOnlyResource },\n   516\t        );\n   517\t      }\n   518\t    }\n   519\t\n   520\t    if (schema && nativeRemoteMode !== \"icloud\") {\n   521\t      const localResult = await executeLocalBatchQuery(\n   522\t        storage,\n   523\t        schema,\n   524\t        normalizedQuery,\n   525\t        schemaIndex,\n   526\t        temporal,\n   527\t      );\n   528\t\n   529\t      if (localResult) {\n   530\t        return runAfterQuery(\n   531\t          plugins,\n   532\t          schema,\n   533\t          normalizedQuery,\n   534\t          localResult,\n   535\t        ) as Promise<T[]>;\n   536\t      }\n   537\t    }\n   538\t\n   539\t    const response = await runRemoteQuery();\n   540\t    let result = unwrapRemoteSuccess<T | T[]>(response);\n   541\t\n   542\t    // REL-013: Apply inbound date codec per-query in batch path\n   543\t    if (schema && Array.isArray(result)) {\n   544\t      result = (result as any[]).map((queryResult, i) => {\n   545\t        const query = (normalizedQuery as any[])[i] as Record<string, unknown>;\n   546\t        const resource = query?.resource as string;\n   547\t        if (resource) {\n   548\t          return parseQueryResultDates(schema, resource, queryResult);\n   549\t        }\n   550\t        return queryResult;\n   551\t      }) as any;\n   552\t    }\n   553\t\n   554\t    return schema\n   555\t      ? (runAfterQuery(plugins, schema, normalizedQuery, result) as Promise<\n   556\t          T | T[]\n   557\t        >)\n   558\t      : result;\n   559\t  }\n   560\t\n   561\t  // Single query: check hydration state for local-first routing\n   562\t  const query = normalizedQuery as Record<string, unknown>;\n   563\t  const resource = query.resource as string;\n   564\t\n   565\t  if (resource) {\n   566\t    // Check if table is remote-only\n   567\t    const resourceDef = schema?.resources.find((r) => r.name === resource);\n   568\t    if (resourceDef?.isRemoteOnly) {\n   569\t      if (nativeRemoteMode === \"icloud\") {\n   570\t        throw createClientError(\n   571\t          \"DFQL_UNSUPPORTED\",\n   572\t          \"Remote-only resource is unsupported in icloud mode\",\n   573\t          { path: \"query.resource\", resource },\n   574\t        );\n   575\t      }\n   576\t\n   577\t      // Force remote execution for remote-only tables (SYNC-003)\n   578\t      const response = await runRemoteQuery();\n   579\t      let result = unwrapRemoteSuccess<T>(response);\n   580\t      \n   581\t      // Apply inbound date codec (CODEC-001)\n   582\t      if (schema) {\n   583\t        result = parseQueryResultDates(schema, resource, result) as T;\n   584\t      }\n   585\t      \n   586\t      return schema\n   587\t        ? (runAfterQuery(\n   588\t            plugins,\n   589\t            schema,\n   590\t            normalizedQuery,\n   591\t            result,\n   592\t          ) as Promise<T>)\n   593\t        : result;\n   594\t    }\n   595\t\n   596\t    const hydrationState = await storage.getHydrationState(resource);\n   597\t\n   598\t    // Local-first: execute against storage when table is ready\n   599\t    if (hydrationState === \"ready\" && schema) {\n   600\t      const localQuery = injectLocalCapabilityAutoFilters(query, schema);\n   601\t      let result = (await executeLocalQuery(\n   602\t        storage,\n   603\t        schema,\n   604\t        localQuery,\n   605\t        schemaIndex,\n   606\t        temporal,\n   607\t      )) as T;\n   608\t      \n   609\t      // Apply inbound date codec for local query results (CODEC-001)\n   610\t      result = parseQueryResultDates(schema, resource, result) as T;\n   611\t      \n   612\t      return schema\n   613\t        ? (runAfterQuery(plugins, schema, query, result) as Promise<T>)\n   614\t        : result;\n   615\t    }\n   616\t    \n   617\t    // If table is hydrating, route to remote when available (SYNC-002, TV-SYNC-002N)\n   618\t    // In local-only mode (no remote), we'd use local even if hydrating\n   619\t    // But since storage is present and we're here, we have a remote, so use it\n   620\t    if (hydrationState === \"hydrating\") {\n   621\t      const response = await runRemoteQuery();\n   622\t      let result = unwrapRemoteSuccess<T>(response);\n   623\t      \n   624\t      // Apply inbound date codec (CODEC-001)\n   625\t      if (schema) {\n   626\t        result = parseQueryResultDates(schema, resource, result) as T;\n   627\t        result = (await overlayLocalQueryResult(\n   628\t          storage,\n   629\t          schema,\n   630\t          query,\n   631\t          result,\n   632\t          schemaIndex,\n   633\t          temporal,\n   634\t        )) as T;\n   635\t      }\n   636\t      \n   637\t      return schema\n   638\t        ? (runAfterQuery(plugins, schema, normalizedQuery, result) as Promise<T>)\n   639\t        : result;\n   640\t    }\n   641\t  }\n   642\t\n   643\t  // Remote execution for: notStarted or missing resource\n   644\t  const response = await runRemoteQuery();\n   645\t  let result = unwrapRemoteSuccess<T>(response);\n   646\t  \n   647\t  // Apply inbound date codec (CODEC-001)\n   648\t  if (schema && !Array.isArray(normalizedQuery)) {\n   649\t    const query = normalizedQuery as Record<string, unknown>;\n   650\t    const resource = query.resource as string;\n   651\t    if (resource) {\n   652\t      result = parseQueryResultDates(schema, resource, result) as T;\n   653\t    }\n   654\t  }\n   655\t  \ndatafn/client/src/__tests__/http-transport.test.ts:64:    await transport.pull({ cursor: null });\ndatafn/client/src/storage.ts:102:  setCursor(resource: string, cursor: string | null): Promise<void>;\ndatafn/client/src/storage.ts:113:  changelogList(options?: { limit?: number }): Promise<DatafnChangelogEntry[]>;\ndatafn/client/src/sync/__tests__/engine.test.ts:94:          cursor: \"1\",\ndatafn/client/src/sync/__tests__/engine.test.ts:169:              cursor: string;\ndatafn/client/src/sync/__tests__/engine.test.ts:187:            cursor: \"2\",\ndatafn/client/src/sync/__tests__/engine.test.ts:239:          cursor: \"1\",\ndatafn/client/src/sync/__tests__/engine.test.ts:309:        cursor: \"2\",\ndatafn/client/src/sync/__tests__/engine.test.ts:383:        cursor: \"0\",\ndatafn/client/src/sync/__tests__/engine.test.ts:470:        cursor: \"1\",\ndatafn/client/src/sync/__tests__/engine.test.ts:546:        cursor: \"1\",\ndatafn/client/src/sync/__tests__/engine.test.ts:629:        cursor: \"1\",\ndatafn/client/src/sync/__tests__/engine.test.ts: