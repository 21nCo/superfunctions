pacted: any[] = [];\\n     const omittedMutationIds = new Set<string>();\\n     const replacingDeleteIdsByMutationId = new Map<string, Set<string>>();\\n+    const supersedingWriteIdsByMutationId = new Map<string, Set<string>>();\\n     for (const [index, mutation] of mutations.entries()) {\\n       if (\\n         mutation &&\\n@@ -1101,9 +1104,11 @@ export class SyncEngine {\\n         isRecordMutationOperation(mutation.operation)\\n       ) {\\n         const key = `${mutation.resource}\\\\u0000${mutation.id}`;\\n-        const laterDeleteIds = (replacingDeletesByKey.get(key) ?? [])\\n-          .filter((candidate) => candidate.index > index)\\n-          .map((candidate) => candidate.mutationId);\\n+        const laterDeletes = (replacingDeletesByKey.get(key) ?? [])\\n+          .filter((candidate) => candidate.index > index);\\n+        const laterDeleteIds = laterDeletes.map(\\n+          (candidate) => candidate.mutationId,\\n+        );\\n         if (laterDeleteIds.length > 0) {\\n           if (!existingByKey.has(key)) {\\n             const existing = await this.storage.getRecord(mutation.resource, mutation.id);\\n@@ -1116,6 +1121,21 @@ export class SyncEngine {\\n                 mutation.mutationId,\\n                 new Set(laterDeleteIds),\\n               );\\n+              const firstDeleteIndex = laterDeletes[0].index;\\n+              const supersedingWriteIds = mutations\\n+                .slice(firstDeleteIndex + 1)\\n+                .filter((candidate) =>\\n+                  candidate &&\\n+                  candidate.resource === mutation.resource &&\\n+                  candidate.id === mutation.id &&\\n+                  isRecordMutationOperation(candidate.operation) &&\\n+                  typeof candidate.mutationId === \\\"string\\\"\\n+                )\\n+                .map((candidate) => candidate.mutationId as string);\\n+              supersedingWriteIdsByMutationId.set(\\n+                mutation.mutationId,\\n+                new Set(supersedingWriteIds),\\n+              );\\n             }\\n             continue;\\n           }\\n@@ -1128,6 +1148,7 @@ export class SyncEngine {\\n       mutations: compacted,\\n       omittedMutationIds,\\n       replacingDeleteIdsByMutationId,\\n+      supersedingWriteIdsByMutationId,\\n     };\\n   }\\n \\n@@ -1587,9 +1608,19 @@ export class SyncEngine {\\n         compacted.omittedMutationIds.size > 0\\n       ) {\\n         const initiallyApplied = new Set(pushResult.applied ?? []);\\n+        const preservedByAppliedSuccessor = new Set(\\n+          [...compacted.supersedingWriteIdsByMutationId.entries()]\\n+            .filter(([, writeMutationIds]) =>\\n+              [...writeMutationIds].some(\\n+                (writeMutationId) => initiallyApplied.has(writeMutationId),\\n+              )\\n+            )\\n+            .map(([mutationId]) => mutationId),\\n+        );\\n         const replayableOmittedMutationIds = new Set(\\n           [...compacted.replacingDeleteIdsByMutationId.entries()]\\n-            .filter(([, deleteMutationIds]) =>\\n+            .filter(([mutationId, deleteMutationIds]) =>\\n+              !preservedByAppliedSuccessor.has(mutationId) &&\\n               [...deleteMutationIds].every(\\n                 (deleteMutationId) => !initiallyApplied.has(deleteMutationId),\\n               )\\n@@ -1597,9 +1628,10 @@ export class SyncEngine {\\n             .map(([mutationId]) => mutationId),\\n         );\\n         if (replayableOmittedMutationIds.size > 0) {\\n-          // Replay only writes whose own replacing delete failed. Replaying a\\n-          // write after its delete succeeded can resurrect the record because\\n-          // the server correctly deduplicates the already-applied delete.\\n+          // Replay only writes whose own replacing delete failed and whose\\n+          // post-delete successor has not already applied. Replaying a prefix\\n+          // ahead of an applied successor would let the successor deduplicate\\n+          // instead of restoring the client's intended final state.\\n           mutations = sanitizedMutations.filter((mutation) => {\\n             const candidate = mutation as { mutationId?: unknown };\\n             const mutationId = typeof candidate.mutationId === \\\"string\\\"\\n@@ -1625,10 +1657,14 @@ export class SyncEngine {\\n         );\\n         const acknowledgedOmittedMutationIds = new Set(\\n           [...compacted.replacingDeleteIdsByMutationId.entries()]\\n-            .filter(([, deleteMutationIds]) =>\\n+            .filter(([mutationId, deleteMutationIds]) =>\\n               [...deleteMutationIds].some((deleteMutationId) =>\\n-                appliedAcrossAttempts.has(deleteMutationId)\\n-              )\\n+                appliedAcrossAttempts.has(deleteMutationId),\\n+              ) ||\\n+              [...(compacted.supersedingWriteIdsByMutationId.get(mutationId) ?? [])]\\n+                .some((writeMutationId) =>\\n+                  appliedAcrossAttempts.has(writeMutationId),\\n+                )\\n             )\\n             .map(([mutationId]) => mutationId),\\n         );\\ndiff --git a/datafn/server/src/plugins/public-links.ts b/datafn/server/src/plugins/public-links.ts\\nindex 4737f66b..cd47a308 100644\\n--- a/datafn/server/src/plugins/public-links.ts\\n+++ b/datafn/server/src/plugins/public-links.ts\\n@@ -794,16 +794,68 @@ async function createDatafnPublicLink(input: {\\n     throw new DatafnPublicLinkInputError(shareResult.message, shareResult.path);\\n   }\\n   const activatedAt = Date.now();\\n-  await input.database.update({\\n-    model: input.modelName,\\n-    where: [{ field: \\\"id\\\", operator: \\\"eq\\\", value: id }],\\n-    data: {\\n-      revokedAt: null,\\n-      updatedAt: activatedAt,\\n-      updatedBy: input.actorId,\\n-    },\\n-    namespace: input.namespace,\\n-  });\\n+  try {\\n+    await input.database.update({\\n+      model: input.modelName,\\n+      where: [{ field: \\\"id\\\", operator: \\\"eq\\\", value: id }],\\n+      data: {\\n+        revokedAt: null,\\n+        updatedAt: activatedAt,\\n+        updatedBy: input.actorId,\\n+      },\\n+      namespace: input.namespace,\\n+    });\\n+  } catch (activationError) {\\n+    const compensationSnapshot = {\\n+      ...permissionSnapshot,\\n+      compensationExpectedCanonical: shareResult.permissionRecord,\\n+    };\\n+    let compensationError: unknown;\\n+    try {\\n+      await rollbackDatafnPermissionGrantAfterFailedShare(\\n+        input.database,\\n+        permissionMutation,\\n+        input.namespace,\\n+        permissionDirectoryRuntime,\\n+        compensationSnapshot,\\n+      );\\n+    } catch (cleanupError) {\\n+      compensationError = cleanupError;\\n+    }\\n+    if (compensationError && permissionDirectoryTaskId) {\\n+      try {\\n+        await deferFailedShareCompensation(\\n+          input.database,\\n+          permissionDirectoryTaskId,\\n+          permissionMutation,\\n+          compensationSnapshot,\\n+          compensationError,\\n+          input.namespace,\\n+          permissionDirectoryRuntime!.regionId,\\n+        );\\n+      } catch (schedulingError) {\\n+        const combined = new Error(\\n+          `Public-link activation compensation failed and could not be made durable: ${String(schedulingError)}`,\\n+        );\\n+        (combined as Error & { causes?: unknown[] }).causes = [\\n+          compensationError,\\n+          schedulingError,\\n+        ];\\n+        compensationError = combined;\\n+      }\\n+    }\\n+    if (!compensationError) {\\n+      await settlePermissionDirectoryTask();\\n+    }\\n+    if (compensationError) {\\n+      const cleanupFailure = new Error(\\n+        `Public-link activation failed and permission compensation was incomplete: ${String(compensationError)}`,\\n+      );\\n+      (cleanupFailure as Error & { cause?: unknown }).cause = activationError;\\n+      throw cleanupFailure;\\n+    }\\n+    throw activationError;\\n+  }\\n   record.revokedAt = null;\\n   record.updatedAt = activatedAt;\\n   if (permissionDirectoryRuntime) {\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"0dc428\",\"wall_time_seconds\":0.000002084,\"exit_code\":0,\"original_token_count\":1547,\"output\":\"diff --git a/datafn/client/src/sync/__tests__/engine.test.ts b/datafn/client/src/sync/__tests__/engine.test.ts\\nindex 599c6313..bf655d03 100644\\n--- a/datafn/client/src/sync/__tests__/engine.test.ts\\n+++ b/datafn/client/src/sync/__tests__/engine.test.ts\\n@@ -422,6 +422,77 @@ describe(\\\"SyncEngine push\\\", () => {\\n     expect(await storage.changelogList()).toEqual([]);\\n   });\\n \\n+  it(\\\"preserves an applied post-delete insert when the compacted delete fails\\\", async () => {\\n+    const storage = new MemoryStorageAdapter([\\\"goal\\\"]);\\n+    const mutations = [\\n+      {\\n+        resource: \\\"goal\\\", version: 1, operation: \\\"merge\\\",\\n+        id: \\\"goal:recreated\\\", record: { label: \\\"stale prefix\\\" },\\n+        clientId: \\\"client:1\\\", mutationId: \\\"mut:prefix-merge\\\",\\n+      },\\n+      {\\n+        resource: \\\"goal\\\", version: 1, operation: \\\"delete\\\",\\n+        id: \\\"goal:recreated\\\", clientId: \\\"client:1\\\",\\n+        mutationId: \\\"mut:missing-delete\\\",\\n+      },\\n+      {\\n+        resource: \\\"goal\\\", version: 1, operation: \\\"insert\\\",\\n+        id: \\\"goal:recreated\\\",\\n+        record: {\\n+          label: \\\"recreated\\\",\\n+          type: \\\"INDEFINITE\\\",\\n+          status: \\\"NOT_STARTED\\\",\\n+        },\\n+        clientId: \\\"client:1\\\", mutationId: \\\"mut:recreate-insert\\\",\\n+      },\\n+    ];\\n+    for (const [index, mutation] of mutations.entries()) {\\n+      await storage.changelogAppend({\\n+        clientId: \\\"client:1\\\",\\n+        mutationId: mutation.mutationId,\\n+        timestampMs: index + 1,\\n+        mutation,\\n+      });\\n+    }\\n+    const push = vi.fn().mockResolvedValue({\\n+      ok: false,\\n+      error: { code: \\\"NOT_FOUND\\\", message: \\\"Delete target missing\\\" },\\n+      result: {\\n+        ok: false,\\n+        applied: [\\\"mut:recreate-insert\\\"],\\n+        errors: [{\\n+          mutationId: \\\"mut:missing-delete\\\",\\n+          code: \\\"NOT_FOUND\\\",\\n+          message: \\\"Delete target missing\\\",\\n+          path: \\\"mutations[mut:missing-delete]\\\",\\n+          retryable: false,\\n+        }],\\n+        cursor: \\\"1\\\",\\n+        cursorBefore: \\\"0\\\",\\n+      },\\n+    });\\n+    const remote: any = {\\n+      push,\\n+      pull: vi.fn(), clone: vi.fn(), query: vi.fn(), mutation: vi.fn(),\\n+      transact: vi.fn(), seed: vi.fn(), reconcile: vi.fn(),\\n+    };\\n+    const engine = new SyncEngine(\\n+      storage,\\n+      remote,\\n+      new EventBus(),\\n+      \\\"client:1\\\",\\n+      schema,\\n+      { pushMaxRetries: 0 },\\n+    );\\n+\\n+    await engine.processPush();\\n+\\n+    expect(push).toHaveBeenCalledTimes(1);\\n+    expect(push.mock.calls[0][0].mutations.map((item: any) => item.mutationId))\\n+      .toEqual([\\\"mut:missing-delete\\\", \\\"mut:recreate-insert\\\"]);\\n+    expect(await storage.changelogList()).toEqual([]);\\n+  });\\n+\\n   it(\\\"does not replay a compacted write after its replacing delete applied\\\", async () => {\\n     const storage = new MemoryStorageAdapter([\\\"goal\\\"]);\\n     for (const [seq, mutation] of [\\ndiff --git a/datafn/server/__tests__/public-links-plugin.test.ts b/datafn/server/__tests__/public-links-plugin.test.ts\\nindex f9e0b448..ba61af7c 100644\\n--- a/datafn/server/__tests__/public-links-plugin.test.ts\\n+++ b/datafn/server/__tests__/public-links-plugin.test.ts\\n@@ -515,6 +515,88 @@ describe(\\\"DataFn public-links plugin\\\", () => {\\n     }\\n   });\\n \\n+  it(\\\"compensates the grant and settles directory work when activation fails\\\", async () => {\\n+    const db = memoryAdapter();\\n+    await db.initialize();\\n+    const directory = createMemoryIndexedDirectoryStore();\\n+    const runtime = { regionId: \\\"region:activation-failure\\\", directory };\\n+    const publicLinks = createDatafnPublicLinksPlugin<{ actorId: string }>({\\n+      authenticateOwner: (request) => {\\n+        const actorId = request.headers.get(\\\"x-owner-actor\\\");\\n+        return actorId ? { actorId } : null;\\n+      },\\n+      getOwnerActorId: (session) => session.actorId,\\n+      getOwnerNamespace: (actorId) => `user:${actorId}`,\\n+      directory,\\n+      resourceRegion: runtime.regionId,\\n+    });\\n+    const server = await createDatafnServer<TestContext>({\\n+      schema,\\n+      database: db,\\n+      allowUnknownResources: false,\\n+      publicLinks,\\n+      namespaceProvider: {\\n+        getNamespace: () => \\\"user:owner\\\",\\n+        getActorId: () => \\\"owner\\\",\\n+      },\\n+    });\\n+    try {\\n+      const inserted = await post(server, \\\"/datafn/mutation\\\", {\\n+        resource: \\\"linkTag\\\",\\n+        version: 1,\\n+        operation: \\\"insert\\\",\\n+        id: \\\"tag:activation-failure\\\",\\n+        clientId: \\\"public-link-activation\\\",\\n+        mutationId: \\\"public-link-activation-insert\\\",\\n+        record: { id: \\\"tag:activation-failure\\\", label: \\\"Activation failure\\\" },\\n+      }, ownerHeaders());\\n+      expect(inserted.status).toBe(200);\\n+\\n+      const originalUpdate = db.update.bind(db);\\n+      db.update = async (input) => {\\n+        if (\\n+          input.model === \\\"publicLink\\\" &&\\n+          input.data.revokedAt === null\\n+        ) {\\n+          throw new Error(\\\"public-link activation unavailable\\\");\\n+        }\\n+        return originalUpdate(input);\\n+      };\\n+\\n+      const created = await post(server, \\\"/datafn/public-links\\\", {\\n+        resource: \\\"linkTag\\\",\\n+        recordId: \\\"tag:activation-failure\\\",\\n+        scope: \\\"record\\\",\\n+        level: \\\"viewer\\\",\\n+      }, ownerHeaders());\\n+\\n+      expect(created.status).toBeGreaterThanOrEqual(500);\\n+      const failedLinks = await db.findMany({\\n+        model: \\\"publicLink\\\",\\n+        where: [],\\n+        namespace: \\\"user:owner\\\",\\n+      });\\n+      expect(failedLinks).toHaveLength(1);\\n+      expect(failedLinks[0].revokedAt).toEqual(expect.any(Number));\\n+      await expect(db.findMany({\\n+        model: \\\"__datafn_permissions_global\\\",\\n+        where: [],\\n+        namespace: \\\"user:owner\\\",\\n+      })).resolves.toEqual([]);\\n+      await expect(db.internal.findMany(\\n+        \\\"__datafn_permission_directory_outbox\\\",\\n+        [],\\n+      )).resolves.toEqual([]);\\n+      const indexed = await directory.query({\\n+        index: \\\"datafn.permission.principalResource\\\",\\n+        value: `${String(failedLinks[0].principalId)}#linkTag`,\\n+      });\\n+      expect(indexed.records).toEqual([]);\\n+    } finally {\\n+      await server.close();\\n+    }\\n+  });\\n+\\n   it(\\\"durably retries failed share compensation\\\", async () => {\\n     const db = memoryAdapter();\\n     await db.initialize();\\n\"}"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787262738.972288}}}
