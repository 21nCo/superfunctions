{"timestamp":"2026-08-20T21:31:40.390Z","ordinal":23520,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a02116-3be6-7f03-8289-669dfca62baa","call_id":"call_R48BSpSUVHfiXMc0lOZXzT0e","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"datafn/server/src/validation/__tests__/validation.test.ts:47:  relations: [\ndatafn/server/src/validation/__tests__/validation.test.ts:52:      relation: \"goal\",\ndatafn/server/src/validation/__tests__/validation.test.ts:54:      fkField: \"goalId\",\ndatafn/server/src/validation/__tests__/validation.test.ts:60:      relation: \"tags\",\ndatafn/server/src/validation/__tests__/validation.test.ts:351:    it(\"TV-VALID-RELATION-001: unknown relation in select returns DFQL_UNKNOWN_RELATION\", async () => {\ndatafn/server/src/validation/__tests__/validation.test.ts:366:          select: [\"id\", \"unknown_relation.*\"],\ndatafn/server/src/validation/__tests__/validation.test.ts:379:    it(\"accepts valid relation in select\", async () => {\ndatafn/server/src/validation/__tests__/validation.test.ts:505:    it(\"unknown relation in mutation returns DFQL_UNKNOWN_RELATION\", async () => {\ndatafn/server/src/validation/__tests__/validation.test.ts:522:          relations: {\ndatafn/server/src/validation/__tests__/validation.test.ts:523:            unknown_relation: { $ref: \"item:1\" },\ndatafn/server/src/validation/__tests__/validation.test.ts:534:      expect(body.error.message).toContain(\"unknown_relation\");\ndatafn/server/src/validation/__tests__/validation.test.ts:537:    it(\"unknown metadata key in relation mutation returns DFQL_UNKNOWN_FIELD\", async () => {\ndatafn/server/src/validation/__tests__/validation.test.ts:554:          relations: {\ndatafn/server/src/validation/__tests__/validation.test.ts:569:    it(\"accepts valid metadata key in relation mutation\", async () => {\ndatafn/server/src/validation/__tests__/validation.test.ts:572:      // Seed target record for relation validation (relate checks existence)\ndatafn/server/src/validation/__tests__/validation.test.ts:595:          relations: {\nimport { describe, expect, it } from \"vitest\";\nimport { buildSchemaIndex } from \"../schema.js\";\n\ndescribe(\"server validation schema index capability fields\", () => {\n  it(\"includes capability-injected fields when present on the validated schema\", () => {\n    const schema = {\n      resources: [\n        {\n          name: \"todos\",\n          version: 1,\n          fields: [\n            { name: \"text\", type: \"string\" as const, required: true },\n            { name: \"createdAt\", type: \"date\" as const, required: false, readonly: true },\n            { name: \"updatedAt\", type: \"date\" as const, required: false, readonly: true },\n            { name: \"trashedAt\", type: \"date\" as const, required: false, readonly: true },\n            { name: \"trashedBy\", type: \"string\" as const, required: false, readonly: true },\n          ],\n        },\n      ],\n    };\n\n    const index = buildSchemaIndex(schema);\n    const fields = index.fieldsByResource.get(\"todos\");\n    const writable = index.writableFieldsByResource.get(\"todos\");\n\n    expect(fields?.has(\"createdAt\")).toBe(true);\n    expect(fields?.has(\"updatedAt\")).toBe(true);\n    expect(fields?.has(\"trashedAt\")).toBe(true);\n    expect(fields?.has(\"trashedBy\")).toBe(true);\n    expect(fields?.has(\"text\")).toBe(true);\n\n    expect(writable?.has(\"createdAt\")).toBe(false);\n    expect(writable?.has(\"updatedAt\")).toBe(false);\n    expect(writable?.has(\"trashedAt\")).toBe(false);\n    expect(writable?.has(\"trashedBy\")).toBe(false);\n    expect(writable?.has(\"text\")).toBe(true);\n  });\n});\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787261500.39086}}}
