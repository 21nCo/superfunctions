/types/runtime.ts-84-export interface PlugFnWebhookDelivery {\\nplugfn/core/src/types/runtime.ts-85-  id: string;\\nplugfn/core/src/types/runtime.ts-86-  receiptId: string;\\nplugfn/core/src/types/runtime.ts-87-  sinkId?: string;\\nplugfn/core/src/types/runtime.ts-88-  handlerName?: string;\\nplugfn/core/src/types/runtime.ts-89-  status: 'pending' | 'running' | 'success' | 'failed' | 'dead-lettered';\\nplugfn/core/src/types/runtime.ts:90:  claimToken?: string;\\nplugfn/core/src/types/runtime.ts-91-  attempts: number;\\nplugfn/core/src/types/runtime.ts-92-  nextAttemptAt?: Date;\\nplugfn/core/src/types/runtime.ts-93-  error?: string;\\nplugfn/core/src/types/runtime.ts-94-  metadata?: Record<string, unknown>;\\nplugfn/core/src/types/runtime.ts-95-  createdAt: Date;\\nplugfn/core/src/types/runtime.ts-96-  updatedAt: Date;\\nplugfn/core/src/types/runtime.ts-97-}\\nplugfn/core/src/types/runtime.ts-98-\\nplugfn/core/src/types/runtime.ts-99-export interface PlugFnSyncJob {\\nplugfn/core/src/types/runtime.ts-100-  id: string;\\nplugfn/core/src/types/runtime.ts-101-  provider: string;\\nplugfn/core/src/types/runtime.ts-102-  connectionId: string;\\nplugfn/core/src/types/runtime.ts-103-  resource: string;\\nplugfn/core/src/types/runtime.ts-104-  mode: 'full' | 'incremental';\\nplugfn/core/src/types/runtime.ts-105-  status: 'queued' | 'running' | 'completed' | 'failed' | 'cancelled';\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"65c698\",\"wall_time_seconds\":0.000002583,\"exit_code\":0,\"original_token_count\":1797,\"output\":\"diff --git a/datafn/server/__tests__/public-links-plugin.test.ts b/datafn/server/__tests__/public-links-plugin.test.ts\\nindex ad494078..f9e0b448 100644\\n--- a/datafn/server/__tests__/public-links-plugin.test.ts\\n+++ b/datafn/server/__tests__/public-links-plugin.test.ts\\n@@ -438,6 +438,83 @@ describe(\\\"DataFn public-links plugin\\\", () => {\\n     }\\n   });\\n \\n+  it(\\\"keeps a failed public-link credential revoked when row cleanup fails\\\", async () => {\\n+    const db = memoryAdapter();\\n+    await db.initialize();\\n+    const directory = createMemoryIndexedDirectoryStore();\\n+    const publicLinks = createDatafnPublicLinksPlugin<{ actorId: string }>({\\n+      authenticateOwner: (request) => {\\n+        const actorId = request.headers.get(\\\"x-owner-actor\\\");\\n+        return actorId ? { actorId } : null;\\n+      },\\n+      getOwnerActorId: (session) => session.actorId,\\n+      getOwnerNamespace: (actorId) => `user:${actorId}`,\\n+      directory,\\n+      resourceRegion: \\\"region:public-links\\\",\\n+    });\\n+    const server = await createDatafnServer<TestContext>({\\n+      schema,\\n+      database: db,\\n+      allowUnknownResources: false,\\n+      publicLinks,\\n+      namespaceProvider: {\\n+        getNamespace: () => \\\"user:owner\\\",\\n+        getActorId: () => \\\"owner\\\",\\n+      },\\n+    });\\n+    try {\\n+      const inserted = await post(server, \\\"/datafn/mutation\\\", {\\n+        resource: \\\"linkTag\\\",\\n+        version: 1,\\n+        operation: \\\"insert\\\",\\n+        id: \\\"tag:failed-link-cleanup\\\",\\n+        clientId: \\\"public-link-cleanup\\\",\\n+        mutationId: \\\"public-link-cleanup-insert\\\",\\n+        record: { id: \\\"tag:failed-link-cleanup\\\", label: \\\"Failed cleanup\\\" },\\n+      }, ownerHeaders());\\n+      expect(inserted.status).toBe(200);\\n+\\n+      const originalCreate = db.create.bind(db);\\n+      db.create = async (input) => {\\n+        const result = await originalCreate(input);\\n+        if (input.model === \\\"__datafn_permissions_global\\\") {\\n+          throw new Error(\\\"post-permission write failure\\\");\\n+        }\\n+        return result;\\n+      };\\n+      const originalDelete = db.delete.bind(db);\\n+      db.delete = async (input) => {\\n+        if (input.model === \\\"publicLink\\\") {\\n+          throw new Error(\\\"public-link cleanup unavailable\\\");\\n+        }\\n+        return originalDelete(input);\\n+      };\\n+\\n+      const created = await post(server, \\\"/datafn/public-links\\\", {\\n+        resource: \\\"linkTag\\\",\\n+        recordId: \\\"tag:failed-link-cleanup\\\",\\n+        scope: \\\"record\\\",\\n+        level: \\\"viewer\\\",\\n+      }, ownerHeaders());\\n+\\n+      expect(created.status).toBeGreaterThanOrEqual(500);\\n+      const failedLinks = await db.findMany({\\n+        model: \\\"publicLink\\\",\\n+        where: [],\\n+        namespace: \\\"user:owner\\\",\\n+      });\\n+      expect(failedLinks).toHaveLength(1);\\n+      expect(failedLinks[0].revokedAt).toEqual(expect.any(Number));\\n+      await expect(db.findMany({\\n+        model: \\\"__datafn_permissions_global\\\",\\n+        where: [],\\n+        namespace: \\\"user:owner\\\",\\n+      })).resolves.toEqual([]);\\n+    } finally {\\n+      await server.close();\\n+    }\\n+  });\\n+\\n   it(\\\"durably retries failed share compensation\\\", async () => {\\n     const db = memoryAdapter();\\n     await db.initialize();\\ndiff --git a/datafn/server/src/execution/query/__tests__/shared-with-me.test.ts b/datafn/server/src/execution/query/__tests__/shared-with-me.test.ts\\nindex 9a7c2060..f93a4686 100644\\n--- a/datafn/server/src/execution/query/__tests__/shared-with-me.test.ts\\n+++ b/datafn/server/src/execution/query/__tests__/shared-with-me.test.ts\\n@@ -1,7 +1,11 @@\\n import { afterEach, beforeEach, describe, expect, it } from \\\"vitest\\\";\\n-import { memoryAdapter } from \\\"@superfunctions/db/adapters\\\";\\n+import {\\n+  createMemoryIndexedDirectoryStore,\\n+  memoryAdapter,\\n+} from \\\"@superfunctions/db/adapters\\\";\\n import { createDatafnServer } from \\\"../../../server.js\\\";\\n import type { DatafnSchema } from \\\"../../../core-types.js\\\";\\n+import { datafnMultiRegionPlugin } from \\\"../../../plugins/multi-region.js\\\";\\n \\n const schema = {\\n   resources: [\\n@@ -194,6 +198,61 @@ describe(\\\"shared-with-me query mode and permission inspection\\\", () => {\\n     expect(namespaceOnly.body.result.data).toEqual([]);\\n   });\\n \\n+  it(\\\"rejects snake-case fallback grants assigned to another region\\\", async () => {\\n+    await server.close();\\n+    server = await createDatafnServer({\\n+      allowUnknownResources: true,\\n+      schema,\\n+      database: db,\\n+      plugins: [datafnMultiRegionPlugin({\\n+        regionId: \\\"region:local\\\",\\n+        directory: createMemoryIndexedDirectoryStore(),\\n+      })],\\n+      namespaceProvider: {\\n+        getNamespace: () => namespace,\\n+        getActorId: () => actorId as any,\\n+      },\\n+    });\\n+    await db.create({\\n+      model: \\\"collections\\\",\\n+      data: {\\n+        id: \\\"col_foreign_region\\\",\\n+        title: \\\"Foreign region\\\",\\n+        createdBy: \\\"alice\\\",\\n+        __ns: \\\"user:foreign\\\",\\n+      },\\n+      namespace: \\\"user:foreign\\\",\\n+    });\\n+    await db.internal.create(\\\"__datafn_permissions_global\\\", {\\n+      id: \\\"foreign-region-grant\\\",\\n+      resource_type: \\\"collections\\\",\\n+      resource_ns: \\\"user:foreign\\\",\\n+      resource_id: \\\"col_foreign_region\\\",\\n+      principal_id: \\\"user:bob\\\",\\n+      level: \\\"viewer\\\",\\n+      grant_kind: \\\"record\\\",\\n+      source_ref: null,\\n+      granted_by: \\\"user:alice\\\",\\n+      granted_at: 20,\\n+      revoked_at: null,\\n+      resource_region: \\\"region:foreign\\\",\\n+      __ns: \\\"user:foreign\\\",\\n+    });\\n+\\n+    const result = await query({\\n+      resource: \\\"collections\\\",\\n+      version: 1,\\n+      operation: \\\"find\\\",\\n+      metadata: {\\n+        accessMode: \\\"sharedWithMe\\\",\\n+        namespaceFilter: [\\\"user:foreign\\\"],\\n+      },\\n+    });\\n+\\n+    expect(result.res.status).toBe(200);\\n+    expect(result.body.result.data).toEqual([]);\\n+  });\\n+\\n   it(\\\"rejects invalid accessMode values\\\", async () => {\