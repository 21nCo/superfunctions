ync/__tests__/engine.test.ts\\n@@ -1022,6 +1022,69 @@ describe(\\\"SyncEngine push\\\", () => {\\n     expect(await storage.changelogList()).toEqual([]);\\n   });\\n \\n+  it(\\\"preserves a legacy FK when the preferred relation alias is empty\\\", async () => {\\n+    const storage = new MemoryStorageAdapter([\\\"goal\\\"]);\\n+    await storage.changelogAppend({\\n+      clientId: \\\"client:1\\\",\\n+      mutationId: \\\"mut:legacy-fk\\\",\\n+      timestampMs: 1,\\n+      mutation: {\\n+        resource: \\\"goal\\\",\\n+        version: 1,\\n+        operation: \\\"insert\\\",\\n+        id: \\\"goal:legacy-fk\\\",\\n+        record: {\\n+          id: \\\"goal:legacy-fk\\\",\\n+          type: \\\"INDEFINITE\\\",\\n+          status: \\\"NOT_STARTED\\\",\\n+          legacyParentId: \\\"goal:parent\\\",\\n+        },\\n+        clientId: \\\"client:1\\\",\\n+        mutationId: \\\"mut:legacy-fk\\\",\\n+      },\\n+    });\\n+    const push = vi.fn().mockResolvedValue({\\n+      ok: true,\\n+      result: {\\n+        ok: true,\\n+        applied: [\\\"mut:legacy-fk\\\"],\\n+        cursor: \\\"1\\\",\\n+        cursorBefore: \\\"0\\\",\\n+      },\\n+    });\\n+    const remote: any = {\\n+      push,\\n+      pull: vi.fn(),\\n+      clone: vi.fn(),\\n+      query: vi.fn(),\\n+      mutation: vi.fn(),\\n+      transact: vi.fn(),\\n+      seed: vi.fn(),\\n+      reconcile: vi.fn(),\\n+    };\\n+    const legacyAliasSchema = {\\n+      ...schema,\\n+      relations: [{\\n+        ...schema.relations[0],\\n+        fkField: \\\"\\\",\\n+        foreignKey: \\\"legacyParentId\\\",\\n+      }],\\n+    };\\n+    const engine = new SyncEngine(\\n+      storage,\\n+      remote,\\n+      new EventBus(),\\n+      \\\"client:1\\\",\\n+      legacyAliasSchema,\\n+      { pushMaxRetries: 0 },\\n+    );\\n+\\n+    await engine.processPush();\\n+\\n+    expect(push.mock.calls[0][0].mutations[0].record.legacyParentId)\\n+      .toBe(\\\"goal:parent\\\");\\n+  });\\n+\\n   