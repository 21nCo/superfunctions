{"timestamp":"2026-08-20T22:38:58.811Z","ordinal":24609,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_077ca705e7ea3749016a878200f1e881918e60853b3d46939e","status":"completed","call_id":"call_uNvTKtn8WyzYelABwOfUeSwY","name":"exec","input":"const r = await tools.exec_command({\n  cmd: \"sed -n '1,225p' datafn/client/__tests__/e2ee.test.ts && rg -n \\\"createProvider\\\\(\\\" datafn/client/__tests__/e2ee.test.ts && git log --oneline --all -- datafn/client/src/e2ee.ts | head -20 && git blame -L 43,193 datafn/client/src/e2ee.ts | head -180\",\n  workdir: \"/Users/serro/Documents/dev/n/worktrees/superfunctions/review-followup-next-2026-08-20\",\n  yield_time_ms: 10000,\n  max_output_tokens: 30000\n});\ntext(r.output);","internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787265535.368047}}}
{"timestamp":"2026-08-20T22:38:58.991Z","ordinal":24610,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a02153-dbaf-7e41-844b-e2c3d5676e59","call_id":"call_uNvTKtn8WyzYelABwOfUeSwY","output":[{"type":"input_text","text":"Script completed\nWall time 0.2 seconds\nOutput:\n"},{"type":"input_text","text":"import { afterEach, describe, expect, it, vi } from \"vitest\";\nimport {\n  KV_RESOURCE_NAME,\n  isDatafnE2eeEnvelope,\n  type DatafnSchema,\n} from \"@datafn/core\";\nimport {\n  assertRemoteQueryAllowedForE2ee,\n  assertRemoteSearchAllowedForE2ee,\n  decryptCloneResultForE2ee,\n  encryptMutationPayloadForE2ee,\n  prepareTransactPayloadForE2ee,\n  type DatafnE2eeProvider,\n} from \"../src/e2ee.js\";\nimport { createDatafnClient } from \"../src/client.js\";\nimport { DefaultHttpTransport } from \"../src/transport/http.js\";\n\nconst schema: DatafnSchema = {\n  capabilities: [\"timestamps\", \"audit\", \"trash\"],\n  resources: [\n    {\n      name: \"project\",\n      version: 1,\n      fields: [{ name: \"name\", type: \"string\", required: true }],\n    },\n    {\n      name: \"task\",\n      version: 1,\n      fields: [\n        { name: \"title\", type: \"string\", required: true },\n        { name: \"notes\", type: \"string\", required: false, nullable: true },\n        { name: \"projectId\", type: \"string\", required: false, nullable: true },\n        { name: \"parentId\", type: \"string\", required: false, nullable: true },\n        { name: \"parentPath\", type: \"string\", required: false, nullable: true },\n      ],\n    },\n  ],\n  relations: [\n    { from: \"project\", to: \"task\", type: \"one-many\" },\n    { from: \"task\", to: \"task\", type: \"htree\" },\n  ],\n};\n\nfunction createProvider(keyRef = \"test-key\"): DatafnE2eeProvider {\n  return {\n    keyRef,\n    async encrypt({ plaintext, resource, id, field, aad }) {\n      return {\n        __datafnE2ee: 1,\n        alg: \"AES-GCM\",\n        keyRef,\n        iv: `${resource}:${id}:${field}`,\n        data: JSON.stringify({\n          plaintext: [...plaintext],\n          aad: [...aad],\n        }),\n      };\n    },\n    async decrypt({ envelope }) {\n      const parsed = JSON.parse(envelope.data) as { plaintext: number[] };\n      return new Uint8Array(parsed.plaintext);\n    },\n  };\n}\n\ndescribe(\"DataFn E2EE client transforms\", () => {\n  afterEach(() => {\n    vi.restoreAllMocks();\n  });\n\n  it(\"encrypts data fields while leaving capability and relationship fields plain\", async () => {\n    const record = {\n      id: \"task:1\",\n      title: \"Ship E2EE\",\n      notes: \"Local clone stays searchable\",\n      projectId: \"project:1\",\n      parentId: \"task:0\",\n      parentPath: \"task:0\",\n      createdAt: 1710000000000,\n      createdBy: \"user:1\",\n      updatedAt: 1710000000001,\n      updatedBy: \"user:1\",\n      trashedAt: null,\n      trashedBy: null,\n    };\n\n    const encrypted = (await encryptMutationPayloadForE2ee(\n      schema,\n      { enabled: true, provider: createProvider() },\n      {\n        operation: \"insert\",\n        resource: \"task\",\n        id: \"task:1\",\n        record,\n      },\n    )) as { record: Record<string, unknown> };\n\n    expect(isDatafnE2eeEnvelope(encrypted.record.title)).toBe(true);\n    expect(isDatafnE2eeEnvelope(encrypted.record.notes)).toBe(true);\n    expect(encrypted.record.id).toBe(\"task:1\");\n    expect(encrypted.record.projectId).toBe(\"project:1\");\n    expect(encrypted.record.parentId).toBe(\"task:0\");\n    expect(encrypted.record.parentPath).toBe(\"task:0\");\n    expect(encrypted.record.createdAt).toBe(1710000000000);\n    expect(encrypted.record.createdBy).toBe(\"user:1\");\n    expect(encrypted.record.updatedAt).toBe(1710000000001);\n    expect(encrypted.record.updatedBy).toBe(\"user:1\");\n    expect(encrypted.record.trashedAt).toBeNull();\n    expect(encrypted.record.trashedBy).toBeNull();\n\n    const decrypted = await decryptCloneResultForE2ee(\n      schema,\n      { enabled: true, provider: createProvider() },\n      {\n        ok: true,\n        data: {\n          task: [encrypted.record],\n        },\n        cursors: {},\n        next: {},\n      },\n    );\n\n    expect(decrypted.data.task?.[0]).toEqual(record);\n  });\n\n  it(\"encrypts user data that merely resembles an E2EE envelope\", async () => {\n    const collidingValue = {\n      __datafnE2ee: 1 as const,\n      alg: \"AES-GCM\",\n      keyRef: \"user-controlled\",\n      iv: \"not-provider-output\",\n      data: \"not-ciphertext\",\n    };\n\n    const encrypted = (await encryptMutationPayloadForE2ee(\n      schema,\n      { enabled: true, provider: createProvider() },\n      {\n        operation: \"insert\",\n        resource: \"task\",\n        id: \"task:collision\",\n        record: { id: \"task:collision\", notes: collidingValue },\n      },\n    )) as { record: Record<string, unknown> };\n\n    expect(encrypted.record.notes).not.toBe(collidingValue);\n    expect(isDatafnE2eeEnvelope(encrypted.record.notes)).toBe(true);\n    const decrypted = await decryptCloneResultForE2ee(\n      schema,\n      { enabled: true, provider: createProvider() },\n      { ok: true, data: { task: [encrypted.record] }, cursors: {}, next: {} },\n    );\n    expect(decrypted.data.task?.[0]?.notes).toEqual(collidingValue);\n  });\n\n  it(\"does not reuse an envelope across provider key contexts\", async () => {\n    const firstProvider = createProvider();\n    const first = (await encryptMutationPayloadForE2ee(\n      schema,\n      { enabled: true, provider: firstProvider },\n      {\n        operation: \"insert\",\n        resource: \"task\",\n        id: \"task:rekey\",\n        record: { id: \"task:rekey\", notes: \"secret\" },\n      },\n    )) as { record: Record<string, unknown> };\n    const nextProvider = createProvider(\"next-key\");\n    const encrypt = vi.spyOn(nextProvider, \"encrypt\");\n\n    const reencrypted = (await encryptMutationPayloadForE2ee(\n      schema,\n      { enabled: true, provider: nextProvider },\n      {\n        operation: \"merge\",\n        resource: \"task\",\n        id: \"task:rekey\",\n        record: { id: \"task:rekey\", notes: first.record.notes },\n      },\n    )) as { record: Record<string, unknown> };\n\n    expect(encrypt).toHaveBeenCalledOnce();\n    expect(reencrypted.record.notes).not.toBe(first.record.notes);\n    expect((reencrypted.record.notes as { keyRef: string }).keyRef).toBe(\"next-key\");\n  });\n\n  it(\"blocks direct remote query and search while allowing plaintext KV query\", () => {\n    const e2ee = { enabled: true, provider: createProvider() };\n\n    expect(() =>\n      assertRemoteQueryAllowedForE2ee(e2ee, { resource: \"task\" }),\n    ).toThrow(\"Direct server query is unavailable\");\n    expect(() => assertRemoteSearchAllowedForE2ee(e2ee)).toThrow(\n      \"Direct server search is unavailable\",\n    );\n    expect(() =>\n      assertRemoteQueryAllowedForE2ee(e2ee, { resource: KV_RESOURCE_NAME }),\n    ).not.toThrow();\n  });\n\n  it(\"encrypts transaction mutation steps before remote transport\", async () => {\n    const prepared = await prepareTransactPayloadForE2ee(\n      schema,\n      { enabled: true, provider: createProvider() },\n      {\n        transactionId: \"tx:e2ee\",\n        atomic: true,\n        steps: [\n          {\n            mutation: {\n              operation: \"insert\",\n              resource: \"task\",\n              id: \"task:1\",\n              record: {\n                id: \"task:1\",\n                title: \"Encrypted in transit\",\n                projectId: \"project:1\",\n              },\n            },\n          },\n        ],\n      },\n    ) as { steps: Array<{ mutation: { record: Record<string, unknown> } }> };\n\n44:function createProvider(keyRef = \"test-key\"): DatafnE2eeProvider {\n89:      { enabled: true, provider: createProvider() },\n113:      { enabled: true, provider: createProvider() },\n138:      { enabled: true, provider: createProvider() },\n151:      { enabled: true, provider: createProvider() },\n158:    const firstProvider = createProvider();\n169:    const nextProvider = createProvider(\"next-key\");\n189:    const e2ee = { enabled: true, provider: createProvider() };\n205:      { enabled: true, provider: createProvider() },\n233:      { enabled: true, provider: createProvider() },\n250:      e2ee: { enabled: true, provider: createProvider() },\n275:      e2ee: { enabled: true, provider: createProvider() },\n1bbfcb06 fix: address second-wave review findings\n171fe50f fix: backport reviewed runtime safeguards\n3758e87c fix: address next reconciliation review findings\n6ebdd174 fix(runtime): preserve distributed consistency contracts\n5f3e3e92 fix(storage): preserve upgrade and authorization state\n66072364 feat(datafn): integrate temporal relations and sync updates\n5e867bf9 snapshot: preserve local dev integration stack\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  43) const textEncoder = new TextEncoder();\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  44) const textDecoder = new TextDecoder();\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530  45) const providerEncryptedEnvelopes = new WeakMap<\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530  46)   DatafnE2eeProvider,\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530  47)   Map<string, WeakSet<object>>\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530  48) >();\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530  49) \n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530  50) function encryptedEnvelopesFor(provider: DatafnE2eeProvider): WeakSet<object> {\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530  51)   let byKey = providerEncryptedEnvelopes.get(provider);\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530  52)   if (!byKey) {\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530  53)     byKey = new Map();\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530  54)     providerEncryptedEnvelopes.set(provider, byKey);\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530  55)   }\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530  56)   let envelopes = byKey.get(provider.keyRef);\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530  57)   if (!envelopes) {\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530  58)     envelopes = new WeakSet();\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530  59)     byKey.set(provider.keyRef, envelopes);\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530  60)   }\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530  61)   return envelopes;\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530  62) }\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  63) \n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  64) type RecordMutationOperation = \"insert\" | \"merge\" | \"replace\";\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  65) \n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  66) function isRecordMutationOperation(operation: unknown): operation is RecordMutationOperation {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  67)   return operation === \"insert\" || operation === \"merge\" || operation === \"replace\";\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  68) }\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  69) \n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  70) function isRecordObject(value: unknown): value is Record<string, unknown> {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  71)   return typeof value === \"object\" && value !== null && !Array.isArray(value);\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  72) }\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  73) \n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  74) function isE2eeEnabled(e2ee: DatafnE2eeConfig | undefined): boolean {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  75)   return e2ee?.enabled === true;\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  76) }\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  77) \n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  78) export function isE2eePlaintextResource(resource: string | undefined): boolean {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  79)   return resource === KV_RESOURCE_NAME;\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  80) }\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  81) \n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  82) export function assertE2eeProvider(\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  83)   e2ee: DatafnE2eeConfig | undefined,\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  84)   path: string,\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  85) ): DatafnE2eeProvider {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  86)   const provider = e2ee?.provider;\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  87)   if (!isE2eeEnabled(e2ee) || provider) {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  88)     return provider as DatafnE2eeProvider;\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  89)   }\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  90)   throw createClientError(\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  91)     \"DFQL_INVALID\",\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  92)     \"E2EE is locked. Unlock with the password before syncing encrypted data.\",\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  93)     { path },\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  94)   );\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  95) }\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  96) \n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  97) function resolvePlaintextFields(\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  98)   schema: DatafnSchema,\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530  99)   resourceName: string,\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 100)   e2ee: DatafnE2eeConfig | undefined,\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 101) ): Set<string> {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 102)   const fields = new Set<string>([\"id\"]);\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 103)   const resource = schema.resources.find((entry) => entry.name === resourceName);\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 104)   if (!resource) return fields;\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 105) \n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 106)   const resolvedCapabilities = resolveCapabilities(\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 107)     schema.capabilities as any,\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 108)     resource.capabilities as any,\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 109)   );\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 110)   for (const field of getCapabilityFields(resolvedCapabilities)) {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 111)     fields.add(field.name);\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 112)   }\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 113) \n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 114)   for (const relationField of getRelationFkFieldsForResource(schema, resourceName)) {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 115)     fields.add(relationField.field);\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 116)     if (relationField.resourceField) {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 117)       fields.add(relationField.resourceField);\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 118)     }\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 119)   }\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 120) \n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 121)   for (const relation of schema.relations ?? []) {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 122)     const toResources = Array.isArray(relation.to) ? relation.to : [relation.to];\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 123)     if (relation.type === \"htree\" && toResources.includes(resourceName)) {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 124)       fields.add(relation.pathField || \"parentPath\");\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 125)     }\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 126)   }\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 127) \n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 128)   const additionalFields =\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 129)     typeof e2ee?.plaintextFields === \"function\"\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 130)       ? e2ee.plaintextFields({ schema, resource: resourceName })\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 131)       : e2ee?.plaintextFields;\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 132)   for (const field of additionalFields ?? []) {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 133)     fields.add(field);\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 134)   }\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 135) \n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 136)   return fields;\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 137) }\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 138) \n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 139) function aadFor(resource: string, id: string, field: string): Uint8Array {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 140)   return textEncoder.encode(`datafn-e2ee:v1:${resource}:${id}:${field}`);\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 141) }\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 142) \n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 143) function encodeFieldValue(value: unknown): Uint8Array {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 144)   return textEncoder.encode(JSON.stringify({ value }));\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 145) }\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 146) \n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 147) function decodeFieldValue(bytes: Uint8Array): unknown {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 148)   const parsed = JSON.parse(textDecoder.decode(bytes)) as { value?: unknown };\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 149)   return parsed.value;\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 150) }\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 151) \n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 152) async function encryptRecordFields(\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 153)   schema: DatafnSchema,\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 154)   e2ee: DatafnE2eeConfig | undefined,\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 155)   resource: string,\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 156)   id: string,\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 157)   record: Record<string, unknown>,\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 158) ): Promise<Record<string, unknown>> {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 159)   if (!isE2eeEnabled(e2ee) || isE2eePlaintextResource(resource)) {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 160)     return record;\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 161)   }\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 162) \n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 163)   const provider = assertE2eeProvider(e2ee, \"e2ee.provider\");\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530 164)   const providerEnvelopes = encryptedEnvelopesFor(provider);\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 165)   const plaintextFields = resolvePlaintextFields(schema, resource, e2ee);\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 166)   const encrypted: Record<string, unknown> = {};\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 167) \n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 168)   for (const [field, value] of Object.entries(record)) {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 169)     if (value === undefined || plaintextFields.has(field)) {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 170)       encrypted[field] = value;\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 171)       continue;\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 172)     }\n171fe50fa (Aravind Samala 2026-08-20 17:22:57 +0530 173)     if (\n171fe50fa (Aravind Samala 2026-08-20 17:22:57 +0530 174)       isDatafnE2eeEnvelope(value) &&\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530 175)       providerEnvelopes.has(value as object)\n171fe50fa (Aravind Samala 2026-08-20 17:22:57 +0530 176)     ) {\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 177)       encrypted[field] = value;\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 178)       continue;\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 179)     }\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 180) \n171fe50fa (Aravind Samala 2026-08-20 17:22:57 +0530 181)     const envelope = await provider.encrypt({\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 182)       resource,\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 183)       id,\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 184)       field,\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 185)       plaintext: encodeFieldValue(value),\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 186)       aad: aadFor(resource, id, field),\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 187)     });\n1bbfcb069 (Aravind Samala 2026-08-20 18:07:11 +0530 188)     providerEnvelopes.add(envelope);\n171fe50fa (Aravind Samala 2026-08-20 17:22:57 +0530 189)     encrypted[field] = envelope;\n66072364d (Aravind Samala 2026-08-19 19:15:20 +0530 190)   }\n