t.ts:293:        cursors: {\ndatafn/client/__tests__/ws-reconnect.test.ts:318:      result: { ok: true, data: {}, cursors: {} },\ndatafn/client/__tests__/ws-reconnect.test.ts:322:      result: { ok: true, records: {}, cursors: {} },\n   250\t        path: \"resources\",\n   251\t      });\n   252\t    }\n   253\t\n   254\t    const r = resource as Record<string, unknown>;\n   255\t\n   256\t    // Validate name\n   257\t    if (typeof r.name !== \"string\") {\n   258\t      return err(\n   259\t        \"SCHEMA_INVALID\",\n   260\t        \"Invalid schema: resource.name must be string\",\n   261\t        { path: \"resources\" }\n   262\t      );\n   263\t    }\n   264\t\n   265\t    // Check for duplicate resource names\n   266\t    if (resourceNames.has(r.name)) {\n   267\t      return err(\n   268\t        \"SCHEMA_INVALID\",\n   269\t        `Invalid schema: duplicate resource name: ${r.name}`,\n   270\t        { path: \"resources\" }\n   271\t      );\n   272\t    }\n   273\t    resourceNames.add(r.name);\n   274\t\n   275\t    let effectiveIdPrefix = `${r.name}:`;\n   276\t    if (r.idPrefix !== undefined) {\n   277\t      if (typeof r.idPrefix !== \"string\") {\n   278\t        return err(\n   279\t          \"SCHEMA_INVALID\",\n   280\t          \"Invalid schema: resource.idPrefix must be string\",\n   281\t          { path: `resources.${r.name}.idPrefix` },\n   282\t        );\n   283\t      }\n   284\t      if (r.idPrefix.length === 0) {\n   285\t        return err(\n   286\t          \"SCHEMA_INVALID\",\n   287\t          \"Invalid schema: resource.idPrefix must not be empty\",\n   288\t          { path: `resources.${r.name}.idPrefix` },\n   289\t        );\n   290\t      }\n   291\t      effectiveIdPrefix = r.idPrefix;\n   292\t    }\n   293\t    const normalizedIdPrefix = effectiveIdPrefix.endsWith(\":\")\n   294\t      ? effectiveIdPrefix.slice(0, -1)\n   295\t      : effectiveIdPrefix;\n   296\t    if (normalizedIdPrefix.length === 0) {\n   297\t      return err(\n   298\t        \"SCHEMA_INVALID\",\n   299\t        \"Invalid schema: resource.idPrefix must not normalize to empty\",\n   300\t        { path: `resources.${r.name}.idPrefix` },\n   301\t      );\n   302\t    }\n   303\t    const conflictingResource = normalizedIdPrefixes.get(normalizedIdPrefix);\n   304\t    if (conflictingResource !== undefined) {\n   305\t      return err(\n   306\t        \"SCHEMA_INVALID\",\n   307\t        `Invalid schema: resource idPrefix \"${effectiveIdPrefix}\" conflicts with resource \"${conflictingResource}\" after normalization`,\n   308\t        { path: `resources.${r.name}.idPrefix` },\n   309\t      );\n   310\t    }\n   311\t    normalizedIdPrefixes.set(normalizedIdPrefix, r.name);\n   312\t\n   313\t    // Validate version\n   314\t    if (typeof r.version !== \"number\" || !Number.isInteger(r.version)) {\n   315\t      return err(\n   316\t        \"SCHEMA_INVALID\",\n   317\t        \"Invalid schema: resource.version must be integer\",\n   318\t        { path: \"resources\" }\n   319\t      );\n   320\t    }\n   321\t\n   322\t    // Validate fields\n   323\t    if (!Array.isArray(r.fields)) {\n   324\t      return err(\n   325\t        \"SCHEMA_INVALID\",\n   326\t        \"Invalid schema: resource.fields must be array\",\n   327\t        { path: \"resources\" }\n   328\t      );\n   329\t    }\n   330\t\ndatafn/core/src/schema.ts:276:    if (r.idPrefix !== undefined) {\ndatafn/core/src/schema.ts:277:      if (typeof r.idPrefix !== \"string\") {\ndatafn/core/src/schema.ts:280:          \"Invalid schema: resource.idPrefix must be string\",\ndatafn/core/src/schema.ts:281:          { path: `resources.${r.name}.idPrefix` },\ndatafn/core/src/schema.ts:284:      if (r.idPrefix.length === 0) {\ndatafn/core/src/schema.ts:287:          \"Invalid schema: resource.idPrefix must not be empty\",\ndatafn/core/src/schema.ts:288:          { path: `resources.${r.name}.idPrefix` },\ndatafn/core/src/schema.ts:291:      effectiveIdPrefix = r.idPrefix;\ndatafn/core/src/schema.ts:299:        \"Invalid schema: resource.idPrefix must not normalize to empty\",\ndatafn/core/src/schema.ts:300:        { path: `resources.${r.name}.idPrefix` },\ndatafn/core/src/schema.ts:307:        `Invalid schema: resource idPrefix \"${effectiveIdPrefix}\" conflicts with resource \"${conflictingResource}\" after normalization`,\ndatafn/core/src/schema.ts:308:        { path: `resources.${r.name}.idPrefix` },\ndatafn/python/datafn/validation.py:276:def validate_fields(index: SchemaIndex, resource_name: str, field_names: List[str], path_prefix: str = \"$\") -> Optional[DatafnError]:\ndatafn/python/datafn/validation.py:281:            details={\"path\": path_prefix}\ndatafn/python/datafn/validation.py:304:                    details={\"path\": f\"{path_prefix}[{i}]\"}\ndatafn/python/datafn/validation.py:310:                details={\"path\": f\"{path_prefix}[{i}]\"}\ndatafn/python/tests/test_filters.py:149:    def test_already_prefixed(self):\ndatafn/core/__tests__/kv.test.ts:24:      idPrefix: \"kv\",\ndatafn/core/__tests__/kv.test.ts:41:      idPrefix: \"custom-kv\",\ndatafn/core/__tests__/kv.test.ts:85:      idPrefix: \"kv\",\ndatafn/core/__tests__/kv.test.ts:115:      idPrefix: \"kv\",\ndatafn/python/tests/test_query_enhanced.py:371:    async def test_filter_with_non_prefixed_ops(self):\ndatafn/core/__tests__/relation-endpoints.test.ts:7:      { name: \"documents\", idPrefix: \"doc\" },\ndatafn/core/__tests__/relation-endpoints.test.ts:8:      { name: \"operations\", idPrefix: \"op_\" },\ndatafn/core/__tests__/relation-endpoints.test.ts:9:      { name: \"notes\", idPrefix: \"note:\" },\ndatafn/core/__tests__/relation-endpoints.test.ts:13:  it(\"resolves polymorphic endpoints using schema idPrefix values\", () => {\ndatafn/core/__tests__/relation-endpoints.test.ts:25:  it(\"prefers the longest matching custom prefix\", () => {\ndatafn/core/__tests__/relation-endpoints.test.ts:28:        { name: \"short\", idPrefix: \"ite