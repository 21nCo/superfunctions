{"timestamp":"2026-08-20T22:52:27.816Z","ordinal":24828,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a02160-3328-78d0-9c78-c68c9fa5aa74","call_id":"call_q9sqZTUwR1Q9vSejytY7zMFi","output":[{"type":"input_text","text":"Script completed\nWall time 0.4 seconds\nOutput:\n"},{"type":"input_text","text":" M datafn/client/__tests__/query.test.ts\n M datafn/client/src/__tests__/query-routing.test.ts\n M datafn/client/src/query.ts\n M datafn/python/datafn/validation.py\n M datafn/python/tests/test_validation_enhanced.py\ndiff --git a/datafn/client/__tests__/query.test.ts b/datafn/client/__tests__/query.test.ts\nindex 5eaa120b..d083cceb 100644\n--- a/datafn/client/__tests__/query.test.ts\n+++ b/datafn/client/__tests__/query.test.ts\n@@ -164,7 +164,7 @@ describe(\"@datafn/client query\", () => {\n     expect(result).toEqual({ data: [{ id: \"task:1\" }], nextCursor: null });\n   });\n \n-  it(\"treats offset zero as the first page and overlays pending local rows\", async () => {\n+  it(\"preserves a limited first page so its remote cursor cannot skip rows\", async () => {\n     vi.spyOn(DefaultHttpTransport.prototype, \"query\").mockResolvedValue({\n       ok: true,\n       result: {\n@@ -192,7 +192,7 @@ describe(\"@datafn/client query\", () => {\n       limit: 2,\n     });\n \n-    expect(result.data.map((record) => record.id)).toEqual([\"task:0\", \"task:1\"]);\n+    expect(result.data.map((record) => record.id)).toEqual([\"task:1\", \"task:2\"]);\n   });\n });\n \ndiff --git a/datafn/client/src/__tests__/query-routing.test.ts b/datafn/client/src/__tests__/query-routing.test.ts\nindex 8963e862..0e7cea67 100644\n--- a/datafn/client/src/__tests__/query-routing.test.ts\n+++ b/datafn/client/src/__tests__/query-routing.test.ts\n@@ -96,7 +96,7 @@ describe(\"Query routing\", () => {\n     ]);\n   });\n \n-  it(\"re-sorts and re-limits local overlays while preserving the remote envelope\", async () => {\n+  it(\"re-sorts unbounded local overlays while preserving the remote envelope\", async () => {\n     const storage = new MemoryStorageAdapter([\"tasks\"]);\n     await storage.upsertRecord(\"tasks\", { id: \"task:local-a\", title: \"Alpha\" });\n     await storage.upsertRecord(\"tasks\", { id: \"task:local-b\", title: \"Bravo\" });\n@@ -122,7 +122,7 @@ describe(\"Query routing\", () => {\n \n     const result = await executeQuery(\n       remote,\n-      { resource: \"tasks\", select: [\"id\", \"title\"], sort: [\"title:asc\"], limit: 2 },\n+      { resource: \"tasks\", select: [\"id\", \"title\"], sort: [\"title:asc\"] },\n       storage,\n       [],\n       schema,\n@@ -132,13 +132,14 @@ describe(\"Query routing\", () => {\n       data: [\n         { id: \"task:local-a\", title: \"Alpha\" },\n         { id: \"task:local-b\", title: \"Bravo\" },\n+        { id: \"task:remote-z\", title: \"Zulu\" },\n       ],\n       nextCursor: \"next-page\",\n       count: 20,\n     });\n   });\n \n-  it(\"does not overlay local rows onto offset or cursor pages\", async () => {\n+  it(\"does not overlay local rows onto limited, offset, or cursor pages\", async () => {\n     const storage = new MemoryStorageAdapter([\"tasks\"]);\n     await storage.upsertRecord(\"tasks\", { id: \"task:local\", title: \"Local\" });\n     await storage.setHydrationState(\"tasks\", \"hydrating\");\n@@ -157,6 +158,13 @@ describe(\"Query routing\", () => {\n       reconcile: vi.fn(),\n     };\n \n+    await expect(executeQuery(\n+      remote,\n+      { resource: \"tasks\", sort: [\"id:asc\"], limit: 1 },\n+      storage,\n+      [],\n+      schema,\n+    )).resolves.toEqual(remoteResult);\n     await expect(executeQuery(\n       remote,\n       { resource: \"tasks\", offset: 10, limit: 10 },\ndiff --git a/datafn/client/src/query.ts b/datafn/client/src/query.ts\nindex c07642d9..864e0956 100644\n--- a/datafn/client/src/query.ts\n+++ b/datafn/client/src/query.ts\n@@ -307,6 +307,7 @@ async function overlayLocalQueryResult(\n     ((cursor as Record<string, unknown>).after != null ||\n       (cursor as Record<string, unknown>).before != null);\n   if (\n+    typeof query.limit === \"number\" ||\n     (typeof query.offset === \"number\" && query.offset > 0) ||\n     hasActiveCursor\n   ) {\ndiff --git a/datafn/python/datafn/validation.py b/datafn/python/datafn/validation.py\nindex b8b0c310..2f40142f 100644\n--- a/datafn/python/datafn/validation.py\n+++ b/datafn/python/datafn/validation.py\n@@ -131,6 +131,7 @@ def validate_schema(schema: Dict[str, Any]) -> Dict[str, Any]:\n         return {\"ok\": False, \"error\": {\"code\": \"SCHEMA_INVALID\", \"message\": f\"Too many resources ({len(resources)}), maximum is 100\", \"details\": {\"path\": \"$.resources\"}}}\n \n     seen_names = set()\n+    normalized_id_prefixes = {}\n     for i, resource in enumerate(resources):\n         rname = resource.get(\"name\")\n         if not rname:\n@@ -140,6 +141,23 @@ def validate_schema(schema: Dict[str, Any]) -> Dict[str, Any]:\n             return {\"ok\": False, \"error\": {\"code\": \"SCHEMA_INVALID\", \"message\": f\"Duplicate resource name: {rname}\", \"details\": {\"path\": f\"$.resources[{i}]\"}}}\n         seen_names.add(rname)\n \n+        effective_id_prefix = f\"{rname}:\"\n+        if \"idPrefix\" in resource:\n+            id_prefix = resource[\"idPrefix\"]\n+            if not isinstance(id_prefix, str):\n+                return {\"ok\": False, \"error\": {\"code\": \"SCHEMA_INVALID\", \"message\": \"Resource idPrefix must be a string\", \"details\": {\"path\": f\"$.resources[{i}].idPrefix\"}}}\n+            if len(id_prefix) == 0:\n+                return {\"ok\": False, \"error\": {\"code\": \"SCHEMA_INVALID\", \"message\": \"Resource idPrefix must not be empty\", \"details\": {\"path\": f\"$.resources[{i}].idPrefix\"}}}\n+            effective_id_prefix = id_prefix\n+\n+        normalized_id_prefix = effective_id_prefix[:-1] if effective_id_prefix.endswith(\":\") else effective_id_prefix\n+        if len(normalized_id_prefix) == 0:\n+            return {\"ok\": False, \"error\": {\"code\": \"SCHEMA_INVALID\", \"message\": \"Resource idPrefix must not normalize to empty\", \"details\": {\"path\": f\"$.resources[{i}].idPrefix\"}}}\n+        conflicting_resource = normalized_id_prefixes.get(normalized_id_prefix)\n+        if conflicting_resource is not None:\n+            return {\"ok\": False, \"error\": {\"code\": \"SCHEMA_INVALID\", \"message\": f\"Resource idPrefix '{effective_id_prefix}' conflicts with resource '{conflicting_resource}' after normalization\", \"details\": {\"path\": f\"$.resources[{i}].idPrefix\"}}}\n+        normalized_id_prefixes[normalized_id_prefix] = rname\n+\n         res_fields = resource.get(\"fields\", [])\n         if len(res_fields) > 200:\n             return {\"ok\": False, \"error\": {\"code\": \"SCHEMA_INVALID\", \"message\": f\"Resource '{rname}' has too many fields ({len(res_fields)}), maximum is 200\", \"details\": {\"path\": f\"$.resources[{i}].fields\"}}}\ndiff --git a/datafn/python/tests/test_validation_enhanced.py b/datafn/python/tests/test_validation_enhanced.py\nindex 9056b4d0..99faa598 100644\n--- a/datafn/python/tests/test_validation_enhanced.py\n+++ b/datafn/python/tests/test_validation_enhanced.py\n@@ -51,6 +51,43 @@ class TestValidateSchema:\n         assert result[\"ok\"] is False\n         assert result[\"error\"][\"code\"] == \"SCHEMA_INVALID\"\n \n+    def test_id_prefix_collision_after_trailing_colon_normalization(self):\n+        schema = {\n+            \"resources\": [\n+                {\"name\": \"projects\", \"version\": 1, \"idPrefix\": \"project:\", \"fields\": []},\n+                {\"name\": \"projectAliases\", \"version\": 1, \"idPrefix\": \"project\", \"fields\": []},\n+            ],\n+            \"relations\": [],\n+        }\n+        result = validate_schema(schema)\n+        assert result[\"ok\"] is False\n+        assert \"conflicts\" in result[\"error\"][\"message\"]\n+        assert result[\"error\"][\"details\"][\"path\"] == \"$.resources[1].idPrefix\"\n+\n+    def test_implicit_id_prefix_participates_in_collision_checks(self):\n+        schema = {\n+            \"resources\": [\n+                {\"name\": \"documents\", \"version\": 1, \"fields\": []},\n+                {\"name\": \"documentAliases\", \"version\": 1, \"idPrefix\": \"documents:\", \"fields\": []},\n+            ],\n+            \"relations\": [],\n+        }\n+        result = validate_schema(schema)\n+        assert result[\"ok\"] is False\n+        assert \"documents\" in result[\"error\"][\"message\"]\n+\n+    @pytest.mark.parametrize(\"id_prefix\", [\"\", \":\"])\n+    def test_empty_id_prefixes_are_rejected(self, id_prefix):\n+        result = validate_schema({\n+            \"resources\": [\n+                {\"name\": \"documents\", \"version\": 1, \"idPrefix\": id_prefix, \"fields\": []},\n+            ],\n+            \"relations\": [],\n+        })\n+        assert result[\"ok\"] is False\n+        assert \"empty\" in result[\"error\"][\"message\"]\n+        assert result[\"error\"][\"details\"][\"path\"] == \"$.resources[0].idPrefix\"\n+\n     def test_missing_resources(self):\n         result = validate_schema({})\n         assert result[\"ok\"] is False\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787266347.816147}}}
