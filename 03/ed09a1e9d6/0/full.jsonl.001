",\"conclusion\":\"success\",\"name\":\"Perform CodeQL Analysis\",\"number\":6,\"startedAt\":\"2026-08-20T19:27:54Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-08-20T19:28:26Z\",\"conclusion\":\"success\",\"name\":\"Post Perform CodeQL Analysis\",\"number\":9,\"startedAt\":\"2026-08-20T19:28:25Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-08-20T19:28:26Z\",\"conclusion\":\"success\",\"name\":\"Post Initialize CodeQL\",\"number\":10,\"startedAt\":\"2026-08-20T19:28:26Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-08-20T19:28:26Z\",\"conclusion\":\"success\",\"name\":\"Post Setup proxy for registries\",\"number\":11,\"startedAt\":\"2026-08-20T19:28:26Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-08-20T19:28:27Z\",\"conclusion\":\"success\",\"name\":\"Post Checkout repository\",\"number\":12,\"startedAt\":\"2026-08-20T19:28:26Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-08-20T19:28:27Z\",\"conclusion\":\"success\",\"name\":\"Complete job\",\"number\":13,\"startedAt\":\"2026-08-20T19:28:27Z\",\"status\":\"completed\"}],\"url\":\"https://github.com/21nCo/super-functions/actions/runs/32408771353/job/96554034608\"},{\"completedAt\":\"2026-08-20T19:30:25Z\",\"conclusion\":\"success\",\"databaseId\":96554034741,\"name\":\"Analyze (javascript-typescript)\",\"startedAt\":\"2026-08-20T19:27:38Z\",\"status\":\"completed\",\"steps\":[{\"completedAt\":\"2026-08-20T19:27:40Z\",\"conclusion\":\"success\",\"name\":\"Set up job\",\"number\":1,\"startedAt\":\"2026-08-20T19:27:39Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-08-20T19:27:42Z\",\"conclusion\":\"success\",\"name\":\"Checkout repository\",\"number\":2,\"startedAt\":\"2026-08-20T19:27:40Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-08-20T19:27:42Z\",\"conclusion\":\"success\",\"name\":\"Setup proxy for registries\",\"number\":3,\"startedAt\":\"2026-08-20T19:27:42Z\",\"status\":\"completed\"},{\"completedAt\":\"2026-08-20T19:27:54Z\",\"conclusion\":\"success\",\"name\":\"