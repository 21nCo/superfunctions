gionId } : {}),\n   668\t      };\n   669\t\n   670\t  try {\n   671\t    if (existingPermission) {\n   672\t      await db.update({\n   673\t        model: permissionsTable,\n   674\t        where: [{ field: \"id\", operator: \"eq\", value: permissionRecord.id }],\n   675\t        data: {\n   676\t          resourceType: permissionRecord.resourceType,\n   677\t          resourceNs: permissionRecord.resourceNs,\n   678\t          resourceId: permissionRecord.resourceId,\n   679\t          principalId: permissionRecord.principalId,\n   680\t          level: permissionRecord.level,\n   681\t          grantKind: permissionRecord.grantKind,\n   682\t          sourceRef: permissionRecord.sourceRef,\n   683\t          grantedBy: permissionRecord.grantedBy,\n   684\t          grantedAt: permissionRecord.grantedAt,\n   685\t          revokedAt: permissionRecord.revokedAt,\n   686\t          ...(multiRegionRuntime ? { resourceRegion: permissionRecord.resourceRegion } : {}),\n   687\t        },\n   688\t        namespace,\n   689\t      });\n   690\t    } else {\n   691\t      await db.create({\n   692\t        model: permissionsTable,\n   693\t        data: permissionRecord,\n   694\t        namespace,\n   695\t      });\n   696\t    }\n   697\t\n   698\t    const mirrorLevel =\n   699\t      requestedLevel === \"viewer\" ||\n   700\t      requestedLevel === \"editor\" ||\n   701\t      requestedLevel === \"owner\"\n   702\t        ? requestedLevel\n   703\t        : null;\n   704\t    if (mirrorLevel) {\n   705\t      await mirrorGrantToLegacyV1({\n   706\t        db,\n   707\t        namespace,\n   708\t        resource: mutation.resource,\n   709\t        resourceId,\n   710\t        principalId: sharePrincipalId,\n   711\t        level: mirrorLevel,\n   712\t        grantedBy: actorId ?? \"system\",\n   713\t        grantedAt: now,\n   714\t      });\n   715\t    }\n   716\t  } catch (error) {\n   717\t    const failure = attachFailedSharePermissionRecord(error, permissi