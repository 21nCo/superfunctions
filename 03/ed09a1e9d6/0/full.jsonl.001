mment>When a relation contains an empty `fkField` and a valid legacy `foreignKey`, this selects the empty value instead of falling back, so push sanitization removes the actual foreign-key field. Use a truthiness fallback consistent with the other relation consumers.</comment>\\n\\n<file context>\\n@@ -137,8 +137,9 @@ function buildWritableRecordFieldsByResource(\\n       if (!fields) continue;\\n-      if (typeof relation.fkField === \\\"string\\\" && relation.fkField.length > 0) {\\n-        fields.add(relation.fkField);\\n+      const fkField = relation.fkField ?? relation.foreignKey;\\n+      if (typeof fkField === \\\"string\\\" && fkField.length > 0) {\\n+        fields.add(fkField);\\n</file context>\\n```\\n\\n</details>\\n\\n```suggestion\\n      const fkField = relation.fkField || relation.foreignKey;\\n```\",\n        \"url\": \"https://github.com/21nCo/super-functions.next/pull/46#discussion_r3825497631\",\n        \"createdAt\": \"2026-08-20T21:29:13Z\"\n      }\n    ]\n  }\n]\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787261440.609693}}}
