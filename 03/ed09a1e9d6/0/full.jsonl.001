enqueuePermissionDirectorySync(\\n</file context>\\n```\\n\\n</details>\",\n            \"url\": \"https://github.com/21nCo/super-functions/pull/115#discussion_r3824878200\",\n            \"createdAt\": \"2026-08-20T19:54:31Z\"\n          }\n        ]\n      }\n    }\n  ]\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787256055.218544}}}
