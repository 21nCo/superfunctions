elds: ['claimToken'], unique: true }\\\\n         ]\\\\n       },\\\\n</file context>\\\\n```\\\\n\\\\n</details>\\\",\\n        \\\"url\\\": \\\"https://github.com/21nCo/super-functions.next/pull/46#discussion_r3825497616\\\",\\n        \\\"createdAt\\\": \\\"2026-08-20T21:29:12Z\\\"\\n      }\\n    },\\n    {\\n      \\\"id\\\": \\\"PRRT_kwDOQ4ERBM6a9x0X\\\",\\n      \\\"path\\\": \\\"plugfn/core/src/schema.ts\\\",\\n      \\\"line\\\": 243,\\n      \\\"comment\\\": {\\n        \\\"author\\\": {\\n          \\\"login\\\": \\\"cubic-dev-ai\\\"\\n        },\\n        \\\"body\\\": \\\"<!-- cubic:v=5096e46a-d61c-44ea-b83d-fddeedcdfb0e -->\\\\n<!-- cubic:review-run=3775059c-56d5-4810-9e66-69dd9a699541 -->\\\\n<!-- metadata:{\\\\\\\"confidence\\\\\\\":8} -->\\\\nP2: When upgrading a database containing duplicate legacy claim tokens, this index creation fails before stale jobs can receive fresh tokens. Add a v5→v6 cleanup or deduplication step before creating the unique index.\\\\n\\\\n<details>\\\\n<summary>Prompt for AI agents</summary>\\\\n\\\\n```text\\\\nCheck if this issue is valid — if so, understand the root cause and fix it. At plugfn/core/src/schema.ts, line 243:\\\\n\\\\n<comment>When upgrading a database containing duplicate legacy claim tokens, this index creation fails before stale jobs can receive fresh tokens. Add a v5→v6 cleanup or deduplication step before creating the unique index.</comment>\\\\n\\\\n<file context>\\\\n@@ -236,7 +239,8 @@ export function getSchema(options: PlugFnSchemaOptions = {}): { version: number;\\\\n           { name: 'idx_plugfn_sync_jobs_status', fields: ['status'] },\\\\n-          { name: 'idx_plugfn_sync_jobs_provider', fields: ['provider'] }\\\\n+          { name: 'idx_plugfn_sync_jobs_provider', fields: ['provider'] },\\\\n+          { name: 'idx_plugfn_sync_jobs_claim_token', fields: ['claimToken'], unique: true }\\\\n         ]\\\\n       },\\\\n</file context>\\\\n```\\\\n\\\\n</details>\\\",\\n        \\\"url\\\": \\\"https://github.com/21nCo/super-functions.next/pull/46#discussion_r3825497619\\\",\\n        \\\"createdAt\\\": \\\"2026-08-20T21:29:13Z\\\"\\n      }\\n    },\\n    {\\n      \\\"id\\\": \\\"PRRT_kwDOQ4ERBM6a9x0a\\\",\\n      \\\"path\\\": \\\"datafn/client/src/sync/engine.ts\\\",\\n      \\\"line\\\": null,\\n      \\\"comment\\\": {\\n        \\\"author\\\": {\\n          \\\"login\\\": \\\"cubic-dev-ai\\\"\\n        },\\n        \\\"body\\\": \\\"<!-- cubic:v=cf717434-36f3-4fe2-81e6-c36e69a62ca3 -->\\\\n<!-- cubic:review-run=3775059c-56d5-4810-9e66-69dd9a699541 -->\\\\n<!-- metadata:{\\\\\\\"confidence\\\\\\\":7} -->\\\\nP2: When a relation contains an empty `fkField` and a valid legacy `foreignKey`, this selects the empty value instead of falling back, so push sanitization removes the actual foreign-key field. Use a truthiness fallback consistent with the other relation consumers.\\\\n\\\\n<details>\\\\n<summary>Prompt for AI agents</summary>\\\\n\\\\n```text\\\\nCheck if this issue is valid — if so, understand the root cause and fix it. At datafn/client/src/sync/engine.ts, line 140:\\\\n\\\\n<comment>When a relation contains an empty `fkField` and a valid legacy `foreignKey`, this selects the empty value instead of falling back, so push sanitization removes the actual foreign-key field. Use a truthiness fallback consistent with the other relation consumers.</comment>\\\\n\\\\n<file context>\\\\n@@ -137,8 +137,9 @@ function buildWritableRecordFieldsByResource(\\\\n       if (!fields) continue;\\\\n-      if (typeof relation.fkField === \\\\\\\"string\\\\\\\" && relation.fkField.length > 0) {\\\\n-        fields.add(relation.fkField);\\\\n+      const fkField = relation.fkField ?? relation.foreignKey;\\\\n+      if (typeof fkField === \\\\\\\"string\\\\\\\" && fkField.length > 0) {\\\\n+        fields.add(fkField);\\\\n</file context>\\\\n```\\\\n\\\\n</details>\\\\n\\\\n```suggestion\\\\n      const fkField = relation.fkField || relation.foreignKey;\\\\n```\\\"