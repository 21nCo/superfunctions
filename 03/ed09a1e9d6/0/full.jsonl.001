\");\\npackages/cli/src/__tests__/schema-index-migrations.test.ts:646:      .toContain(\\\"plugfn_events_occurred_at_idx ON plugfn_events (occurred_at(191))\\\");\\npackages/cli/src/__tests__/schema-index-migrations.test.ts:734:      \\\"CREATE INDEX plugfn_sync_jobs_claim_token_idx ON plugfn_sync_jobs (claim_token(191))\\\";\\npackages/cli/src/__tests__/schema-index-migrations.test.ts:1378:    expect(down).not.toContain(\\\"legacy_body(191)\\\");\\npackages/cli/src/__tests__/schema-index-migrations.test.ts:1434:    expect(down).not.toContain(\\\"legacy_location(191)\\\");\\npackages/cli/src/utils/introspection.ts:196:        CHARACTER_MAXIMUM_LENGTH as character_maximum_length,\\npackages/cli/src/utils/generators.ts:13:  MYSQL_MAX_SAFE_INDEXED_VARCHAR_LENGTH,\\npackages/cli/src/utils/generators.ts:506:            indexedKeyBytes += 191 * 4;\\npackages/cli/src/utils/generators.ts:514:          indexedKeyBytes += 191 * 4;\\npackages/cli/src/utils/generators.ts:526:          indexedKeyBytes += 191 * 4;\\npackages/cli/src/utils/generators.ts:528:          if (length > MYSQL_MAX_SAFE_INDEXED_VARCHAR_LENGTH) {\\npackages/cli/src/utils/generators.ts:530:              `Cannot generate MySQL index ${index.name} on ${column}: maxLength ${length} exceeds the utf8mb4 full-column index limit ${MYSQL_MAX_SAFE_INDEXED_VARCHAR_LENGTH}`,\\npackages/cli/src/utils/generators.ts:537:        indexedKeyBytes += 191 * 4;\\npackages/cli/src/utils/generators.ts:556:    if (indexedKeyBytes > MYSQL_MAX_SAFE_INDEXED_VARCHAR_LENGTH * 4) {\\npackages/cli/src/utils/generators.ts:558:        `Cannot generate MySQL index ${index.name}: encoded key size ${indexedKeyBytes} bytes exceeds the 3072-byte InnoDB limit`,\\npackages/cli/src/utils/generators.ts:576:    return mysqlTextColumns.has(column) ? `${column}(191)` : column;\\n\"}"},{"type":"input_text","text":"{\"chunk_id\":\"7be621\",\"wall_time_seconds\":0.000001875,\"exit_code\":0,\"original_token_count\":1414,\"output\":\"  async getSyncJob(id: string): Promise<PlugFnSyncJob | null> {\\n    return this.database.findOne<PlugFnSyncJob>({\\n      model: this.models.syncJobs,\\n      where: [{ field: 'id', operator: 'eq', value: id }],\\n    });\\n  }\\n\\n  async listSyncJobs(\\n    filters: Record<string, unknown> = {},\\n    limit = 100\\n  ): Promise<PlugFnSyncJob[]> {\\n    return this.database.findMany<PlugFnSyncJob>({\\n      model: this.models.syncJobs,\\n      where: toWhereClauses(filters),\\n      orderBy: [{ field: 'createdAt', direction: 'desc' }],\\n      limit,\\n    });\\n  }\\n\\n  async claimQueuedSyncJobs(\\n    limit: number,\\n    workerId: string,\\n    leaseMs = SYNC_JOB_LEASE_MS\\n  ): Promise<PlugFnSyncJob[]> {\\n    const claimedAt = new Date();\\n    const staleBefore = new Date(claimedAt.getTime() - leaseMs);\\n    const [queued, abandoned] = await Promise.all([\\n      this.database.findMany<PlugFnSyncJob>({\\n        model: this.models.syncJobs,\\n        where: [{ field: 'status', operator: 'eq', value: 'queued' }],\\n        orderBy: [{ field: 'createdAt', direction: 'asc' }],\\n        limit,\\n      }),\\n      this.database.findMany<PlugFnSyncJob>({\\n        model: this.models.syncJobs,\\n        where: [\\n          { field: 'status', operator: 'eq', value: 'running' },\\n          { field: 'updatedAt', operator: 'lte', value: staleBefore },\\n        ],\\n        orderBy: [{ field: 'createdAt', direction: 'asc' }],\\n        limit,\\n      }),\\n    ]);\\n    const candidates = [...queued, ...abandoned]\\n      .sort((left, right) => toTime(left.createdAt) - toTime(right.createdAt))\\n      .slice(0, limit);\\n    const claimed: PlugFnSyncJob[] = [];\\n\\n    for (const job of candidates) {\\n      try {\\n        const where: WhereClause[] = [\\n          { field: 'id', operator: 'eq', value: job.id },\\n          { field: 'status', operator: 'eq', value: job.status },\\n        ];\\n        if (job.status === 'running') {\\n          where.push({ field: 'updatedAt', operator: 'lte', value: staleBefore });\\n        }\\n        const claimToken = `claim_${randomBytes(24).toString('hex')}`;\\n        const updated = await this.database.update<PlugFnSyncJob>({\\n          model: this.models.syncJobs,\\n          where,\\n          data: cloneRecord({\\n            status: 'running',\\n            claimToken,\\n            metadata: claimMetadata(job.metadata, workerId, claimedAt),\\n            updatedAt: claimedAt,\\n          }),\\n        });\\n        if (updated?.status === 'running') {\\n          claimed.push(updated);\\n        }\\n      } catch {\\n        // Another worker claimed or updated the job first.\\n      }\\n    }\\n\\n    return claimed;\\n  }\\n\\n  async updateSyncJob(id: string, updates: Partial<PlugFnSyncJob>): Promise<PlugFnSyncJob> {\\n    return this.database.update<PlugFnSyncJob>({\\n      model: this.models.syncJobs,\\n      where: [{ field: 'id', operator: 'eq', value: id }],\\n      data: cloneRecord(updates),\\n    });\\n  }\\n    return this.database.findOne<PlugFnSyncJob>({\\n      model: this.models.syncJobs,\\n      where: [{ field: 'id', operator: 'eq', value: id }],\\n    });\\n  }\\n\\n  async listSyncJobs(\\n    filters: Record<string, unknown> = {},\\n    limit = 100\\n  ): Promise<PlugFnSyncJob[]> {\\n    return this.database.findMany<PlugFnSyncJob>({\\n      model: this.models.syncJobs,\\n      where: toWhereClauses(filters),\\n      orderBy: [{ field: 'createdAt', direction: 'desc' }],\\n      limit,\\n    });\\n  }\\n\\n  async claimQueuedSyncJobs(\\n    limit: number,\\n    workerId: string,\\n    leaseMs = SYNC_JOB_LEASE_MS\\n  ): Promise<PlugFnSyncJob[]> {\\n    const claimedAt = new Date();\\n    const staleBefore = new Date(claimedAt.getTime() - leaseMs);\\n    const [queued, abandoned] = await Promise.all([\\n      this.database.findMany<PlugFnSyncJob>({\\n        model: this.models.syncJobs,\\n        where: [{ field: 'status', operator: 'eq', value: 'queued' }],\\n        orderBy: [{ field: 'createdAt', direction: 'asc' }],\\n        limit,\\n      }),\\n      this.database.findMany<PlugFnSyncJob>({\\n        model: this.models.syncJobs,\\n        where: [\\n          { field: 'status', operator: 'eq', value: 'running' },\\n          { field: 'updatedAt', operator: 'lte', value: staleBefore },\\n        ],\\n        orderBy: [{ field: 'createdAt', direction: 'asc' }],\\n        limit,\\n      }),\\n    ]);\\n    const candidates = [...queued, ...abandoned]\\n      .sort((left, right) => toTime(left.createdAt) - toTime(right.createdAt))\\n      .slice(0, limit);\\n    const claimed: PlugFnSyncJob[] = [];\\n\\n    for (const job of candidates) {\\n      try {\\n        const where: WhereClause[] = [\\n          { field: 'id', operator: 'eq', value: job.id },\\n          { field: 'status', operator: 'eq', value: job.status },\\n        ];\\n        if (job.status === 'running') {\\n          where.push({ field: 'updatedAt', operator: 'lte', value: staleBefore });\\n        }\\n        const claimToken = `${workerId}:${job.id}:${claimedAt.getTime()}`;\\n        const updated = await this.database.update<PlugFnSyncJob>({\\n          model: this.models.syncJobs,\\n          where,\\n          data: cloneRecord({\\n            status: 'running',\\n            claimToken,\\n            metadata: claimMetadata(job.metadata, workerId, claimedAt),\\n            updatedAt: claimedAt,\\n          }),\\n        });\\n        if (updated?.status === 'running') {\\n          claimed.push(updated);\\n        }\\n      } catch {\\n        // Another worker claimed or updated the job first.\\n      }\\n    }\\n\\n    return claimed;\\n  }\\n\\n  async updateSyncJob(id: string, updates: Partial<PlugFnSyncJob>): Promise<PlugFnSyncJob> {\\n    return this.database.update<PlugFnSyncJob>({\\n      model: this.models.syncJobs,\\n      where: [{ field: 'id', operator: 'eq', value: id }],\\n      data: cloneRecord(updates),\\n    });\\n  }\\n\\n\"}"},{"type":"input_te