ource.provider.decrypt({\n+          resource,\n+          id,\n+          field,\n+          envelope: value,\n+          aad: aadFor(resource, id, field),\n+        });\n+      }\n     }\n \n     const envelope = await provider.encrypt({\n       resource,\n       id,\n       field,\n-      plaintext: encodeFieldValue(value),\n+      plaintext,\n       aad: aadFor(resource, id, field),\n     });\n-    providerEnvelopes.add(envelope);\n+    providerEncryptedEnvelopes.set(envelope, {\n+      provider,\n+      keyRef: envelope.keyRef,\n+    });\n     encrypted[field] = envelope;\n   }\n \ndist_diff_exit=0\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787265598.14313}}}
