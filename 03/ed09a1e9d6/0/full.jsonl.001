{"timestamp":"2026-08-20T22:38:54.004Z","ordinal":24606,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a02153-c834-7773-9e61-4849d0bf8a52","call_id":"call_CfrAdKkCtkjoYf4EZsbvl6SL","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"     1\timport {\n     2\t  getCapabilityFields,\n     3\t  getRelationFkFieldsForResource,\n     4\t  isDatafnE2eeEnvelope,\n     5\t  KV_RESOURCE_NAME,\n     6\t  resolveCapabilities,\n     7\t  type DatafnE2eeCipherEnvelope,\n     8\t  type DatafnSchema,\n     9\t} from \"@datafn/core\";\n    10\timport { createClientError } from \"./errors.js\";\n    11\timport type {\n    12\t  CloneResult,\n    13\t  PullResult,\n    14\t  PullResultCanonical,\n    15\t} from \"./sync/apply.js\";\n    16\t\n    17\texport type DatafnE2eeProvider = {\n    18\t  keyRef: string;\n    19\t  encrypt(input: {\n    20\t    resource: string;\n    21\t    id: string;\n    22\t    field: string;\n    23\t    plaintext: Uint8Array;\n    24\t    aad: Uint8Array;\n    25\t  }): Promise<DatafnE2eeCipherEnvelope>;\n    26\t  decrypt(input: {\n    27\t    resource: string;\n    28\t    id: string;\n    29\t    field: string;\n    30\t    envelope: DatafnE2eeCipherEnvelope;\n    31\t    aad: Uint8Array;\n    32\t  }): Promise<Uint8Array>;\n    33\t};\n    34\t\n    35\texport type DatafnE2eeConfig = {\n    36\t  enabled?: boolean;\n    37\t  provider?: DatafnE2eeProvider;\n    38\t  plaintextFields?:\n    39\t    | readonly string[]\n    40\t    | ((input: { schema: DatafnSchema; resource: string }) => readonly string[]);\n    41\t};\n    42\t\n    43\tconst textEncoder = new TextEncoder();\n    44\tconst textDecoder = new TextDecoder();\n    45\tconst providerEncryptedEnvelopes = new WeakMap<\n    46\t  DatafnE2eeProvider,\n    47\t  Map<string, WeakSet<object>>\n    48\t>();\n    49\t\n    50\tfunction encryptedEnvelopesFor(provider: DatafnE2eeProvider): WeakSet<object> {\n    51\t  let byKey = providerEncryptedEnvelopes.get(provider);\n    52\t  if (!byKey) {\n    53\t    byKey = new Map();\n    54\t    providerEncryptedEnvelopes.set(provider, byKey);\n    55\t  }\n    56\t  let envelopes = byKey.get(provider.keyRef);\n    57\t  if (!envelopes) {\n    58\t    envelopes = new WeakSet();\n    59\t    byKey.set(provider.keyRef, envelopes);\n    60\t  }\n    61\t  return envelopes;\n    62\t}\n    63\t\n    64\ttype RecordMutationOperation = \"insert\" | \"merge\" | \"replace\";\n    65\t\n    66\tfunction isRecordMutationOperation(operation: unknown): operation is RecordMutationOperation {\n    67\t  return operation === \"insert\" || operation === \"merge\" || operation === \"replace\";\n    68\t}\n    69\t\n    70\tfunction isRecordObject(value: unknown): value is Record<string, unknown> {\n    71\t  return typeof value === \"object\" && value !== null && !Array.isArray(value);\n    72\t}\n    73\t\n    74\tfunction isE2eeEnabled(e2ee: DatafnE2eeConfig | undefined): boolean {\n    75\t  return e2ee?.enabled === true;\n    76\t}\n    77\t\n    78\texport function isE2eePlaintextResource(resource: string | undefined): boolean {\n    79\t  return resource === KV_RESOURCE_NAME;\n    80\t}\n    81\t\n    82\texport function assertE2eeProvider(\n    83\t  e2ee: DatafnE2eeConfig | undefined,\n    84\t  path: string,\n    85\t): DatafnE2eeProvider {\n    86\t  const provider = e2ee?.provider;\n    87\t  if (!isE2eeEnabled(e2ee) || provider) {\n    88\t    return provider as DatafnE2eeProvider;\n    89\t  }\n    90\t  throw createClientError(\n    91\t    \"DFQL_INVALID\",\n    92\t    \"E2EE is locked. Unlock with the password before syncing encrypted data.\",\n    93\t    { path },\n    94\t  );\n    95\t}\n    96\t\n    97\tfunction resolvePlaintextFields(\n    98\t  schema: DatafnSchema,\n    99\t  resourceName: string,\n   100\t  e2ee: DatafnE2eeConfig | undefined,\n   101\t): Set<string> {\n   102\t  const fields = new Set<string>([\"id\"]);\n   103\t  const resource = schema.resources.find((entry) => entry.name === resourceName);\n   104\t  if (!resource) return fields;\n   105\t\n   106\t  const resolvedCapabilities = resolveCapabilities(\n   107\t    schema.capabilities as any,\n   108\t    resource.capabilities as any,\n   109\t  );\n   110\t  for (const field of getCapabilityFields(resolvedCapabilities)) {\n   111\t    fields.add(field.name);\n   112\t  }\n   113\t\n   114\t  for (const relationField of getRelationFkFieldsForResource(schema, resourceName)) {\n   115\t    fields.add(relationField.field);\n   116\t    if (relationField.resourceField) {\n   117\t      fields.add(relationField.resourceField);\n   118\t    }\n   119\t  }\n   120\t\n   121\t  for (const relation of schema.relations ?? []) {\n   122\t    const toResources = Array.isArray(relation.to) ? relation.to : [relation.to];\n   123\t    if (relation.type === \"htree\" && toResources.includes(resourceName)) {\n   124\t      fields.add(relation.pathField || \"parentPath\");\n   125\t    }\n   126\t  }\n   127\t\n   128\t  const additionalFields =\n   129\t    typeof e2ee?.plaintextFields === \"function\"\n   130\t      ? e2ee.plaintextFields({ schema, resource: resourceName })\n   131\t      : e2ee?.plaintextFields;\n   132\t  for (const field of additionalFields ?? []) {\n   133\t    fields.add(field);\n   134\t  }\n   135\t\n   136\t  return fields;\n   137\t}\n   138\t\n   139\tfunction aadFor(resource: string, id: string, field: string): Uint8Array {\n   140\t  return textEncoder.encode(`datafn-e2ee:v1:${resource}:${id}:${field}`);\n   141\t}\n   142\t\n   143\tfunction encodeFieldValue(value: unknown): Uint8Array {\n   144\t  return textEncoder.encode(JSON.stringify({ value }));\n   145\t}\n   146\t\n   147\tfunction decodeFieldValue(bytes: Uint8Array): unknown {\n   148\t  const parsed = JSON.parse(textDecoder.decode(bytes)) as { value?: unknown };\n   149\t  return parsed.value;\n   150\t}\n   151\t\n   152\tasync function encryptRecordFields(\n   153\t  schema: DatafnSchema,\n   154\t  e2ee: DatafnE2eeConfig | undefined,\n   155\t  resource: string,\n   156\t  id: string,\n   157\t  record: Record<string, unknown>,\n   158\t): Promise<Record<string, unknown>> {\n   159\t  if (!isE2eeEnabled(e2ee) || isE2eePlaintextResource(resource)) {\n   160\t    return record;\n   161\t  }\n   162\t\n   163\t  const provider = assertE2eeProvider(e2ee, \"e2ee.provider\");\n   164\t  const providerEnvelopes = encryptedEnvelopesFor(provider);\n   165\t  const plaintextFields = resolvePlaintextFields(schema, resource, e2ee);\n   166\t  const encrypted: Record<string, unknown> = {};\n   167\t\n   168\t  for (const [field, value] of Object.entries(record)) {\n   169\t    if (value === undefined || plaintextFields.has(field)) {\n   170\t      encrypted[field] = value;\n   171\t      continue;\n   172\t    }\n   173\t    if (\n   174\t      isDatafnE2eeEnvelope(value) &&\n   175\t      providerEnvelopes.has(value as object)\n   176\t    ) {\n   177\t      encrypted[field] = value;\n   178\t      continue;\n   179\t    }\n   180\t\n   181\t    const envelope = await provider.encrypt({\n   182\t      resource,\n   183\t      id,\n   184\t      field,\n   185\t      plaintext: encodeFieldValue(value),\n   186\t      aad: aadFor(resource, id, field),\n   187\t    });\n   188\t    providerEnvelopes.add(envelope);\n   189\t    encrypted[field] = envelope;\n   190\t  }\n   191\t\n   192\t  return encrypted;\n   193\t}\n   194\t\n   195\tasync function decryptRecordFields(\n   196\t  schema: DatafnSchema,\n   197\t  e2ee: DatafnE2eeConfig | undefined,\n   198\t  resource: string,\n   199\t  record: Record<string, unknown>,\n   200\t): Promise<Record<string, unknown>> {\n   201\t  if (!isE2eeEnabled(e2ee) || isE2eePlaintextResource(resource)) {\n   202\t    return record;\n   203\t  }\n   204\t\n   205\t  const id = typeof record.id === \"string\" ? record.id : \"\";\n   206\t  const decrypted: Record<string, unknown> = {};\n   207\t\n   208\t  for (const [field, value] of Object.entries(record)) {\n   209\t    if (!isDatafnE2eeEnvelope(value)) {\n   210\t      decrypted[field] = value;\n   211\t      continue;\n   212\t    }\n   213\t\n   214\t    const provider = assertE2eeProvider(e2ee, `data.${resource}.${id}.${field}`);\n   215\t    const plaintext = await provider.decrypt({\n   216\t      resource,\n   217\t      id,\n   218\t      field,\n   219\t      envelope: value,\n   220\t      aad: aadFor(resource, id, field),\n   221\t    });\n   222\t    decrypted[field] = decodeFieldValue(plaintext);\n   223\t  }\n   224\t\n   225\t  return decrypted;\n   226\t}\n   227\t\n   228\texport async function encryptMutationForE2ee(\n   229\t  schema: DatafnSchema,\n   230\t  e2ee: DatafnE2eeConfig | undefined,\n   231\t  mutation: unknown,\n   232\t): Promise<unknown> {\n   233\t  if (!isE2eeEnabled(e2ee)) return mutation;\n   234\t  if (!isRecordObject(mutation)) return mutation;\n   235\t  if (!isRecordMutationOperation(mutation.operation)) return mutation;\n   236\t  if (typeof mutation.resource !== \"string\" || typeof mutation.id !== \"string\") return mutation;\n   237\t  if (!isRecordObject(mutation.record)) return mutation;\n   238\t\n   239\t  return {\n   240\t    ...mutation,\n   241\t    record: await encryptRecordFields(\n   242\t      schema,\n   243\t      e2ee,\n   244\t      mutation.resource,\n   245\t      mutation.id,\n   246\t      mutation.record,\n   247\t    ),\n   248\t  };\n   249\t}\n   250\t\n   251\texport async function encryptMutationPayloadForE2ee(\n   252\t  schema: DatafnSchema,\n   253\t  e2ee: DatafnE2eeConfig | undefined,\n   254\t  payload: unknown,\n   255\t): Promise<unknown> {\n   256\t  if (!isE2eeEnabled(e2ee)) return payload;\n   257\t  if (Array.isArray(payload)) {\n   258\t    return Promise.all(payload.map((entry) => encryptMutationForE2ee(schema, e2ee, entry)));\n   259\t  }\n   260\t  return encryptMutationForE2ee(schema, e2ee, payload);\n   261\t}\n   262\t\n   263\texport async function encryptPushPayloadForE2ee(\n   264\t  schema: DatafnSchema,\n   265\t  e2ee: DatafnE2eeConfig | undefined,\n   266\t  payload: unknown,\n   267\t): Promise<unknown> {\n   268\t  if (!isE2eeEnabled(e2ee)) return payload;\n   269\t  if (!isRecordObject(payload) || !Array.isArray(payload.mutations)) return payload;\n   270\t  return {\n   271\t    ...payload,\n   272\t    mutations: await Promise.all(\n   273\t      payload.mutations.map((entry) => encryptMutationForE2ee(schema, e2ee, entry)),\n   274\t    ),\n   275\t  };\n   276\t}\n   277\t\n   278\texport async function prepareTransactPayloadForE2ee(\n   279\t  schema: DatafnSchema,\n   280\t  e2ee: DatafnE2eeConfig | undefined,\ndatafn/client/src/sync.ts:26:} from \"./e2ee.js\";\ndatafn/client/src/sync.ts:61:  e2ee?: DatafnE2eeConfig,\ndatafn/client/src/sync.ts:102:          ? await encryptPushPayloadForE2ee(schema, e2ee, transformedPayload)\ndatafn/client/src/sync.ts:110:          ? (await decryptCloneResultForE2ee(schema, e2ee, result as CloneResult) as T)\ndatafn/client/src/sync.ts:112:            ? (await decryptPullResultForE2ee(schema, e2ee, result as PullResult) as T)\ndatafn/client/src/e2ee.ts:74:function isE2eeEnabled(e2ee: DatafnE2eeConfig | undefined): boolean {\ndatafn/client/src/e2ee.ts:75:  return e2ee?.enabled === true;\ndatafn/client/src/e2ee.ts:83:  e2ee: DatafnE2eeConfig | undefined,\ndatafn/client/src/e2ee.ts:86:  const provider = e2ee?.provider;\ndatafn/client/src/e2ee.ts:87:  if (!isE2eeEnabled(e2ee) || provider) {\ndatafn/client/src/e2ee.ts:92:    \"E2EE is locked. Unlock with the password before syncing encrypted data.\",\ndatafn/client/src/e2ee.ts:100:  e2ee: DatafnE2eeConfig | undefined,\ndatafn/client/src/e2ee.ts:129:    typeof e2ee?.plaintextFields === \"function\"\ndatafn/client/src/e2ee.ts:130:      ? e2ee.plaintextFields({ schema, resource: resourceName })\ndatafn/client/src/e2ee.ts:131:      : e2ee?.plaintextField