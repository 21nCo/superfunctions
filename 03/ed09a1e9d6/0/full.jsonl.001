{"timestamp":"2026-08-20T22:51:13.568Z","ordinal":24784,"type":"response_item","payload":{"type":"custom_tool_call","id":"ctc_077ca705e7ea3749016a8784df3c788191ae64feb1f37a21ca","status":"completed","call_id":"call_jQLpVtFZS5AWysL91jEWrsTF","name":"exec","input":"const r = await tools.exec_command({\"cmd\":\"nl -ba datafn/client/__tests__/query.test.ts | sed -n '1,235p'\\nrg -n \\\"def test_.*schema|validate_schema\\\\(\\\" datafn/python/tests --glob '*.py'\\nls datafn/python/tests | sed -n '1,160p'\\nnl -ba datafn/core/__tests__/schema.test.ts | sed -n '1,155p'\\nsed -n '1,115p' datafn/python/datafn/validation.py\\ncat datafn/python/pyproject.toml | sed -n '1,180p'\\ncat datafn/client/package.json\",\"workdir\":\"/Users/serro/Documents/dev/n/worktrees/superfunctions/review-followup-next-2026-08-20\",\"yield_time_ms\":10000,\"max_output_tokens\":30000});\ntext(r.output);\n","internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787266270.554111}}}
{"timestamp":"2026-08-20T22:51:13.673Z","ordinal":24785,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a0215f-1189-7232-803e-d604b856134d","call_id":"call_jQLpVtFZS5AWysL91jEWrsTF","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"     1\t/**\n     2\t * Query Tests - Phase 02\n     3\t * Tests TV-QUERY-001, TV-QUERY-002 from TEST_VECTORS.md\n     4\t */\n     5\t\n     6\timport { describe, it, expect, vi, beforeEach } from \"vitest\";\n     7\timport { createDatafnClient } from \"../src/client.js\";\n     8\timport { DefaultHttpTransport } from \"../src/transport/http.js\";\n     9\timport { MemoryStorageAdapter } from \"../src/adapters/memoryStorage.js\";\n    10\timport type { DatafnClientError } from \"../src/errors.js\";\n    11\t\n    12\t// Default schema for testing\n    13\tconst defaultSchema = {\n    14\t  resources: [\n    15\t    {\n    16\t      name: \"task\",\n    17\t      version: 1,\n    18\t      fields: [{ name: \"title\", type: \"string\" as const, required: true }],\n    19\t    },\n    20\t    {\n    21\t      name: \"goal\",\n    22\t      version: 1,\n    23\t      fields: [{ name: \"label\", type: \"string\" as const, required: true }],\n    24\t    },\n    25\t  ],\n    26\t} as const;\n    27\t\n    28\tdescribe(\"@datafn/client query\", () => {\n    29\t  beforeEach(() => {\n    30\t    vi.restoreAllMocks();\n    31\t  });\n    32\t\n    33\t  it(\"TV-QUERY-001: DatafnTable.query merges resource/version and ignores overrides\", async () => {\n    34\t    const remoteCalls: Array<{ method: string; arg: unknown }> = [];\n    35\t\n    36\t    vi.spyOn(DefaultHttpTransport.prototype, \"query\").mockImplementation(\n    37\t      async (q: unknown) => {\n    38\t        remoteCalls.push({ method: \"query\", arg: q });\n    39\t        return { ok: true, result: { data: [], nextCursor: null } };\n    40\t      },\n    41\t    );\n    42\t\n    43\t    const client = createDatafnClient({\n    44\t      schema: defaultSchema,\n    45\t      sync: { remote: \"http://example.com\" },\n    46\t      getTimestamp: () => 0,\n    47\t    });\n    48\t\n    49\t    // Call table.query with resource/version overrides (should be ignored)\n    50\t    const table = client.task;\n    51\t    const result = await table.query({\n    52\t      resource: \"goal\", // Should be ignored\n    53\t      version: 999, // Should be ignored\n    54\t      select: [\"id\"],\n    55\t    });\n    56\t\n    57\t    // Verify the remote was called with correct merged query\n    58\t    expect(remoteCalls).toHaveLength(1);\n    59\t    expect(remoteCalls[0].method).toBe(\"query\");\n    60\t    expect(remoteCalls[0].arg).toEqual({\n    61\t      resource: \"task\", // From table, not from query fragment\n    62\t      version: 1, // From table, not from query fragment\n    63\t      select: [\"id\"],\n    64\t    });\n    65\t\n    66\t    // Verify result is unwrapped correctly\n    67\t    expect(result).toEqual({ data: [], nextCursor: null });\n    68\t  });\n    69\t\n    70\t  it(\"DatafnTable.relation.query merges resource/version and relation anchor\", async () => {\n    71\t    const remoteCalls: Array<{ method: string; arg: unknown }> = [];\n    72\t\n    73\t    vi.spyOn(DefaultHttpTransport.prototype, \"query\").mockImplementation(\n    74\t      async (q: unknown) => {\n    75\t        remoteCalls.push({ method: \"query\", arg: q });\n    76\t        return { ok: true, result: { data: [], nextCursor: null } };\n    77\t      },\n    78\t    );\n    79\t\n    80\t    const client = createDatafnClient({\n    81\t      schema: defaultSchema,\n    82\t      sync: { remote: \"http://example.com\" },\n    83\t      getTimestamp: () => 0,\n    84\t    });\n    85\t\n    86\t    const result = await client.task.relation(\"backlinks\").query(\"task:1\", {\n    87\t      resource: \"goal\",\n    88\t      version: 999,\n    89\t      relation: \"ignored\",\n    90\t      id: \"task:other\",\n    91\t      select: [\"#\"],\n    92\t    });\n    93\t\n    94\t    expect(remoteCalls).toHaveLength(1);\n    95\t    expect(remoteCalls[0].arg).toEqual({\n    96\t      resource: \"task\",\n    97\t      version: 1,\n    98\t      relation: \"backlinks\",\n    99\t      id: \"task:1\",\n   100\t      select: [\"#\"],\n   101\t    });\n   102\t    expect(result).toEqual({ data: [], nextCursor: null });\n   103\t  });\n   104\t\n   105\t  it(\"TV-QUERY-002: Remote ok:false errors become thrown DatafnClientError\", async () => {\n   106\t    vi.spyOn(DefaultHttpTransport.prototype, \"query\").mockResolvedValue({\n   107\t      ok: false,\n   108\t      error: {\n   109\t        code: \"DFQL_INVALID\",\n   110\t        message: \"Invalid DFQL: resource must be string\",\n   111\t        details: { path: \"resource\" },\n   112\t      },\n   113\t    });\n   114\t\n   115\t    const client = createDatafnClient({\n   116\t      schema: defaultSchema,\n   117\t      sync: { remote: \"http://example.com\" },\n   118\t      getTimestamp: () => 0,\n   119\t    });\n   120\t\n   121\t    const table = client.task;\n   122\t\n   123\t    // Should throw when remote returns ok:false\n   124\t    await expect(async () => {\n   125\t      await table.query({ select: [\"id\"] });\n   126\t    }).rejects.toThrow();\n   127\t\n   128\t    try {\n   129\t      await table.query({ select: [\"id\"] });\n   130\t    } catch (error) {\n   131\t      const err = error as DatafnClientError;\n   132\t      expect(err.code).toBe(\"DFQL_INVALID\");\n   133\t      expect(err.message).toBe(\"Invalid DFQL: resource must be string\");\n   134\t      expect(err.details).toEqual({ path: \"resource\" });\n   135\t    }\n   136\t  });\n   137\t\n   138\t  it(\"client.query delegates to remote and unwraps\", async () => {\n   139\t    const querySpy = vi\n   140\t      .spyOn(DefaultHttpTransport.prototype, \"query\")\n   141\t      .mockResolvedValue({\n   142\t        ok: true,\n   143\t        result: { data: [{ id: \"task:1\" }], nextCursor: null },\n   144\t      });\n   145\t\n   146\t    const client = createDatafnClient({\n   147\t      schema: defaultSchema,\n   148\t      sync: { remote: \"http://example.com\" },\n   149\t      getTimestamp: () => 0,\n   150\t    });\n   151\t\n   152\t    const result = await client.query({\n   153\t      resource: \"task\",\n   154\t      version: 1,\n   155\t      select: [\"id\"],\n   156\t    });\n   157\t\n   158\t    expect(querySpy).toHaveBeenCalledWith({\n   159\t      resource: \"task\",\n   160\t      version: 1,\n   161\t      select: [\"id\"],\n   162\t    });\n   163\t\n   164\t    expect(result).toEqual({ data: [{ id: \"task:1\" }], nextCursor: null });\n   165\t  });\n   166\t\n   167\t  it(\"treats offset zero as the first page and overlays pending local rows\", async () => {\n   168\t    vi.spyOn(DefaultHttpTransport.prototype, \"query\").mockResolvedValue({\n   169\t      ok: true,\n   170\t      result: {\n   171\t        data: [\n   172\t          { id: \"task:1\", title: \"Remote one\" },\n   173\t          { id: \"task:2\", title: \"Remote two\" },\n   174\t        ],\n   175\t        nextCursor: null,\n   176\t      },\n   177\t    });\n   178\t    const storage = new MemoryStorageAdapter([\"task\", \"goal\"]);\n   179\t    await storage.upsertRecord(\"task\", { id: \"task:0\", title: \"Local pending\" });\n   180\t    await storage.setHydrationState(\"task\", \"hydrating\");\n   181\t    const client = createDatafnClient({\n   182\t      schema: defaultSchema,\n   183\t      sync: { remote: \"http://example.com\" },\n   184\t      storage,\n   185\t      clientId: \"query-pagination\",\n   186\t      getTimestamp: () => 0,\n   187\t    });\n   188\t\n   189\t    const result = await client.task.query({\n   190\t      sort: [\"id:asc\"],\n   191\t      offset: 0,\n   192\t      limit: 2,\n   193\t    });\n   194\t\n   195\t    expect(result.data.map((record) => record.id)).toEqual([\"task:0\", \"task:1\"]);\n   196\t  });\n   197\t});\n   198\t\n   199\t/**\n   200\t * Date Codec Tests (CODEC-001)\n   201\t * Tests TV-CODEC-001 and TV-CODEC-001N\n   202\t */\n   203\tdescribe(\"@datafn/client date codec (CODEC-001)\", () => {\n   204\t  beforeEach(() => {\n   205\t    vi.restoreAllMocks();\n   206\t  });\n   207\t\n   208\t  it(\"TV-CODEC-001: Query result parses ISO date strings to Date objects\", async () => {\n   209\t    const schemaWithDate = {\n   210\t      resources: [\n   211\t        {\n   212\t          name: \"task\",\n   213\t          version: 1,\n   214\t          fields: [\n   215\t            { name: \"title\", type: \"string\" as const, required: true },\n   216\t            { name: \"date\", type: \"date\" as const, required: false },\n   217\t          ],\n   218\t        },\n   219\t      ],\n   220\t    } as const;\n   221\t\n   222\t    // Mock remote to return ISO string\n   223\t    vi.spyOn(DefaultHttpTransport.prototype, \"query\").mockImplementation(\n   224\t      async () => {\n   225\t        return {\n   226\t          ok: true,\n   227\t          result: {\n   228\t            data: [\n   229\t              { id: \"task:1\", title: \"Test\", date: \"2026-02-06T00:00:00.000Z\" },\n   230\t            ],\n   231\t            nextCursor: null,\n   232\t          },\n   233\t        };\n   234\t      },\n   235\t    );\ndatafn/python/tests/test_integration.py:80:    def test_missing_schema_raises(self):\ndatafn/python/tests/test_server.py:39:# def test_tv_py_002_invalid_schema_rejection():\ndatafn/python/tests/test_validation_enhanced.py:37:    def test_valid_schema(self):\ndatafn/python/tests/test_validation_enhanced.py:38:        result = validate_schema(make_schema())\ndatafn/python/tests/test_validation_enhanced.py:50:        result = validate_schema(schema)\ndatafn/python/tests/test_validation_enhanced.py:55:        result = validate_schema({})\ndatafn/python/tests/test_validation_enhanced.py:59:        result = validate_schema({\"resources\": []})\ndatafn/python/tests/test_validation_enhanced.py:64:        result = validate_schema({\"resources\": resources})\ndatafn/python/tests/test_validation_enhanced.py:78:        result = validate_schema(schema)\ndatafn/python/tests/test_validation_enhanced.py:85:        result = validate_schema(schema)\ndatafn/python/tests/test_validation_enhanced.py:93:        result = validate_schema(schema)\ndatafn/python/tests/test_validation_enhanced.py:97:    def test_server_raises_on_invalid_schema(self):\ndatafn/python/tests/test_validation_enhanced.py:163:    def test_fk_schema_has_correct_type(self):\ndatafn/python/tests/test_validation_enhanced.py:352:    def test_field_schemas_stored(self):\n__init__.py\nmock_db.py\ntest_authz.py\ntest_change_tracking_limit.py\ntest_filters.py\ntest_hooks.py\ntest_integration.py\ntest_logger.py\ntest_mutation.py\ntest_mutation_enhanced.py\ntest_parity.py\ntest_query.py\ntest_query_enhanced.py\ntest_server.py\ntest_spv2_parity.py\ntest_sync.py\ntest_sync_batch.py\ntest_sync_enhanced.py\ntest_transact.py\ntest_transact_enhanced.py\ntest_utils.py\ntest_validation_enhanced.py\n     1\t/**\n     2\t * Schema validation tests\n     3\t * Tests TV-SCHEMA-001, TV-SCHEMA-002, TV-NS-004, TV-NS-005, TV-NS-006 from TEST_VECTORS.md\n     4\t */\n     5\t\n     6\timport { describe, it, expect } from \"vitest\";\n     7\timport { validateSchema, isNamespaced } from \"../src/schema.js\";\n     8\t\n     9\tdescribe(\"validateSchema\", () => {\n    10\t  // TV-SCHEMA-001: Valid schema with indices normalization\n    11\t  it(\"TV-SCHEMA-001: accepts valid schema and normalizes indices array to object\", () => {\n    12\t    const input = {\n    13\t      resources: [\n    14\t        {\n    15\t          name: \"task\",\n    16\t          version: 1,\n    17\t          fields: [{ name: \"label\", type: \"string\", required: true }],\n    18\t          indices: [\"label\"],\n    19\t        },\n    20\t      ],\n    21\t    };\n    22\t\n    23\t    const result = validateSchema(input);\n    24\t\n    25\t    expect(result.ok).toBe(true);\n    26\t    if (result.ok) {\n    27\t      expect(result.result).toEqual({\n    28\t        resources: [\n    29\t          {\n    30\t            name: \"task\",\n    31\t            version: 1,\n    32\t            fields: [{ name: \"label\", type: \"string\", required: true }],\n    33\t            indices: { base: [\"label\"], search: [], vector: [] },\n    34\t          },\n    35\t        ],\n    36\t        relations: [],\n    37\t        namespaced: true,\n    38\t      });\n    39\t    }\n    40\t  });\n    41\t\n    42\t  // TV-SCHEMA-002: Invalid schema (missing resources)\n    43\t  it(\"TV-SCHEMA-002: rejects schema missing resources\", () => {\n    44\t    const input = { relations: [] };\n    45\t\n    46\t    const result = validateSchema(input);\n    47\t\n    48\t    expect(result.ok).toBe(false);\n    49\t    if (!result.ok) {\n    50\t      expect(result.error.code).toBe(\"SCHEMA_INVALID\");\n    51\t      expect(result.error.message).toBe(\"Invalid schema: missing resources\");\n    52\t      expect(result.error.details).toEqual({ path: \"resources\" });\n    53\t    }\n    54\t  });\n    55\t\n    56\t  // Additional validation tests\n    57\t  it(\"rejects duplicate resource names\", () => {\n    58\t    const input = {\n    59\t      resources: [\n    60\t        { name: \"task\", version: 1, fields: [] },\n    61\t        { name: \"task\", version: 2, fields: [] },\n    62\t      ],\n    63\t    };\n    64\t\n    65\t    const result = validateSchema(input);\n    66\t\n    67\t    expect(result.ok).toBe(false);\n    68\t    if (!result.ok) {\n    69\t      expect(result.error.code).toBe(\"SCHEMA_INVALID\");\n    70\t      expect(result.error.message).toContain(\"duplicate resource name\");\n    71\t    }\n    72\t  });\n    73\t\n    74\t  it(\"rejects resource idPrefix collisions after trailing-colon normalization\", () => {\n    75\t    const result = validateSchema({\n    76\t      resources: [\n    77\t        { name: \"projects\", version: 1, idPrefix: \"project:\", fields: [] },\n    78\t        { name: \"projectAliases\", version: 1, idPrefix: \"project\", fields: [] },\n    79\t      ],\n    80\t    });\n    81\t\n    82\t    expect(result.ok).toBe(false);\n    83\t    if (!result.ok) {\n    84\t      expect(result.error.code).toBe(\"SCHEMA_INVALID\");\n    85\t      expect(result.error.message).toContain(\"conflicts\");\n    86\t      expect(result.error.details).toEqual({\n    87\t        path: \"resources.projectAliases.idPrefix\",\n    88\t      });\n    89\t    }\n    90\t  });\n    91\t\n    92\t  it(\"reserves the implicit resource-name prefix during collision checks\", () => {\n    93\t    const result = validateSchema({\n    94\t      resources: [\n    95\t        { name: \"documents\", version: 1, fields: [] },\n    96\t        { name: \"documentAliases\", version: 1, idPrefix: \"documents:\", fields: [] },\n    97\t      ],\n    98\t    });\n    99\t\n   100\t    expect(result.ok).toBe(false);\n   101\t    if (!result.ok) {\n   102\t      expect(result.error.code).toBe(\"SCHEMA_INVALID\");\n   103\t      expect(result.error.message).toContain('resource \"documents\"');\n   104\t      expect(result.error.details).toEqual({\n   105\t        path: \"resources.documentAliases.idPrefix\",\n   106\t      });\n   107\t    }\n   108\t  });\n   109\t\n   110\t  it(\"rejects an empty resource idPrefix\", () => {\n   111\t    const result = validateSchema({\n   112\t      resources: [\n   113\t        { name: \"documents\", version: 1, idPrefix: \"\", fields: [] },\n   114\t      ],\n   115\t    });\n   116\t\n   117\t    expect(result.ok).toBe(false);\n   118\t    if (!result.ok) {\n   119\t      expect(result.error.code).toBe(\"SCHEMA_INVALID\");\n   120\t      expect(result.error.message).toContain(\"must not be empty\");\n   121\t      expect(result.error.details).toEqual({\n   122\t        path: \"resources.documents.idPrefix\",\n   123\t      });\n   124\t    }\n   125\t  });\n   126\t\n   127\t  it(\"rejects a resource idPrefix that normalizes to empty\", () => {\n   128\t    const result = validateSchema({\n   129\t      resources: [\n   130\t        { name: \"documents\", version: 1, idPrefix: \":\", fields: [] },\n   131\t      ],\n   132\t    });\n   133\t\n   134\t    expect(result.ok).toBe(false);\n   135\t    if (!result.ok) {\n   136\t      expect(result.error.code).toBe(\"SCHEMA_INVALID\");\n   137\t      expect(result.error.message).toContain(\"must not normalize to empty\");\n   138\t      expect(result.error.details).toEqual({\n   139\t        path: \"resources.documents.idPrefix\",\n   140\t      });\n   141\t    }\n   142\t  });\n   143\t\n   144\t  it(\"rejects duplicate field names within a resource\", () => {\n   145\t    const input = {\n   146\t      resources: [\n   147\t        {\n   148\t          name: \"task\",\n   149\t          version: 1,\n   150\t          fields: [\n   151\t            { name: \"label\", type: \"string\", required: true },\n   152\t            { name: \"label\", type: \"string\", required: false },\n   153\t          ],\n   154\t        },\n   155\t      ],\nfrom typing import Any, Dict, List, Optional, Set, Union\nfrom .envelope import DatafnError\nfrom .utils.validate_fields import validate_field_value\n\n\nclass SchemaIndex:\n    def __init__(self, schema: Dict[str, Any]):\n        self.schema = schema\n        self.resources_by_name: Dict[str, Dict[str, Any]] = {}\n        self.fields_by_resource: Dict[str, Set[str]] = {}\n        self.writable_fields_by_resource: Dict[str, Set[str]] = {}\n        self.readonly_fields: Dict[str, Set[str]] = {}\n        self.relations_by_resource: Dict[str, Set[str]] = {}\n        self.relation_defs_by_resource: Dict[str, Dict[str, Any]] = {}\n        self.field_schemas: Dict[str, Dict[str, dict]] = {}\n        self.required_fields: Dict[str, Set[str]] = {}\n        self.field_defaults: Dict[str, Dict[str, Any]] = {}\n        self.date_fields: Dict[str, Set[str]] = {}\n\n        self._build_index()\n\n    def _build_index(self):\n        resources = self.schema.get(\"resources\", [])\n        relations = self.schema.get(\"relations\", [])\n\n        for resource in resources:\n            name = resource[\"name\"]\n            self.resources_by_name[name] = resource\n\n            fields = set()\n            writable = set()\n            readonly = set()\n            field_schemas = {}\n            required = set()\n            defaults = {}\n            date_flds = set()\n\n            # System fields\n            core_fields = {\"id\", \"createdAt\", \"updatedAt\", \"createdBy\", \"updatedBy\", \"isArchived\", \"version\"}\n            READONLY_SYSTEM = {\"createdAt\", \"updatedAt\", \"createdBy\", \"updatedBy\"}\n\n            fields.update(core_fields)\n            readonly.add(\"id\")\n            readonly.update(READONLY_SYSTEM)\n\n            writable.add(\"id\")  # Writable on insert (backward compat)\n            writable.add(\"isArchived\")\n            writable.add(\"version\")\n\n            for field in resource.get(\"fields\", []):\n                fname = field[\"name\"]\n                fields.add(fname)\n                field_schemas[fname] = field\n\n                if field.get(\"readonly\"):\n                    readonly.add(fname)\n                else:\n                    writable.add(fname)\n\n                if field.get(\"required\") and \"default\" not in field:\n                    required.add(fname)\n\n                if \"default\" in field:\n                    defaults[fname] = field[\"default\"]\n\n                if field.get(\"type\") == \"date\":\n                    date_flds.add(fname)\n\n            self.fields_by_resource[name] = fields\n            self.writable_fields_by_resource[name] = writable\n            self.readonly_fields[name] = readonly\n            self.field_schemas[name] = field_schemas\n            self.required_fields[name] = required\n            self.field_defaults[name] = defaults\n            self.date_fields[name] = date_flds\n            self.relations_by_resource[name] = set()\n            self.relation_defs_by_resource[name] = {}\n\n        for relation in relations:\n            from_res_list = relation[\"from\"] if isinstance(relation[\"from\"], list) else [relation[\"from\"]]\n            to_res_list = relation[\"to\"] if isinstance(relation[\"to\"], list) else [relation[\"to\"]]\n\n            # FK injection for many-one relations\n            rel_type = relation.get(\"type\", \"\")\n            if rel_type == \"many-one\":\n                rel_name = relation.get(\"relation\", \"\")\n                fk_field = (\n                    relation.get(\"fkField\")\n                    or relation.get(\"foreignKey\")\n                    or (f\"{rel_name}Id\" if rel_name else None)\n                )\n                if fk_field:\n                    for from_res in from_res_list:\n                        if from_res in self.fields_by_resource:\n                            self.fields_by_resource[from_res].add(fk_field)\n                            self.writable_fields_by_resource[from_res].add(fk_field)\n                            self.field_schemas.setdefault(from_res, {})[fk_field] = {\n                                \"name\": fk_field,\n                                \"type\": \"string\",\n                                \"required\": False,\n                                \"readonly\": False,\n                            }\n\n            for from_res in from_res_list:\n                if from_res in self.relations_by_resource:\n                    if \"relation\" in relation:\n                        rel_name = relation[\"relation\"]\n                        self.relations_by_resource[from_res].add(rel_name)\n                        self.relation_defs_by_resource[from_res][rel_name] = relation\n\n            for to_res in to_res_list:\n                if to_res in self.relations_by_resource:\n                    if \"inverse\" in relation:\n                        inv_name = relation[\"inverse\"]\n                        self.relations_by_resource[to_res].add(inv_name)\n[build-system]\nrequires = [\"hatchling\"]\nbuild-backend = \"hatchling.build\"\n\n[project]\nname = \"datafn\"\nversion = \"0.1.0\"\ndescription = \"Python Server SDK for DataFn\"\nrequires-python = \">=3.8\"\ndependencies = []\n\n[tool.hatch.build.targets.wheel]\npackages = [\"datafn\"]\n\n[tool.hatch.build.targets.sdist]\nexclude = [\n    \"venv/\",\n    \".pytest_cache/\",\n    \"dist/\",\n    \"build/\",\n    \"*.egg-info/\",\n]\n\n[tool.pytest.ini_options]\naddopts = \"-ra -q\"\ntestpaths = [\"tests\"]\n{\n  \"name\": \"@datafn/client\",\n  \"version\": \"0.0.4\",\n  \"type\": \"module\",\n  \"description\": \"DataFn client with event bus and mutation support\",\n  \"main\": \"./dist/index.cjs\",\n  \"module\": \"./dist/index.js\",\n  \"types\": \"./dist/index.d.ts\",\n  \"exports\": {\n    \".\": {\n      \"types\": \"./dist/index.d.ts\",\n      \"import\": \"./dist/index.js\",\n      \"require\": \"./dist/index.cjs\"\n    }\n  },\n  \"scripts\": {\n    \"build\": \"tsup\",\n    \"test\": \"vitest run\",\n    \"test:watch\": \"vitest\",\n    \"typecheck\": \"tsc --noEmit\"\n  },\n  \"dependencies\": {\n    \"@datafn/core\": \"0.0.4\",\n    \"@superfunctions/http\": \"0.1.3\",\n    \"minisearch\": \"^7.1.0\"\n  },\n  \"devDependencies\": {\n    \"fake-indexeddb\": \"^5.0.0\",\n    \"tsup\": \"^8.0.0\",\n    \"typescript\": \"^5.3.0\",\n    \"vitest\": \"^1.0.0\"\n  },\n  \"files\": [\n    \"dist\"\n  ],\n  \"author\": \"21n\",\n  \"license\": \"MIT\",\n  \"bugs\": {\n    \"url\": \"https://github.com/21nCo/super-functions/issues\"\n  },\n  \"repository\": {\n    \"type\": \"git\",\n    \"url\": \"git+https://github.com/21nCo/super-functions.git\",\n    \"directory\": \"datafn/client\"\n  },\n  \"publishConfig\": {\n    \"access\": \"public\"\n  }\n}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787266273.67358}}}
