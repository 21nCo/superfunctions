{"timestamp":"2026-08-20T19:43:36.003Z","ordinal":21635,"type":"response_item","payload":{"type":"custom_tool_call_output","id":"ctco_01a020b3-4a43-79a0-b713-af459d4b50e8","call_id":"call_NxJekYIfxEkq7ob2iq7Y2IN2","output":[{"type":"input_text","text":"Script completed\nWall time 0.1 seconds\nOutput:\n"},{"type":"input_text","text":"1088:  const syncPermissionDirectoryAfterCommit = async (committedDb = db) => {\n1147:  const reconcilePermissionDirectoryAfterCommit = async () => {\n1154:        deferPermissionDirectorySync(syncPermissionDirectoryAfterCommit);\n1163:    await syncPermissionDirectoryAfterCommit();\n1350:        await syncPermissionDirectoryAfterCommit(db);\n1368:        await reconcilePermissionDirectoryAfterCommit();\n1373:        await syncPermissionDirectoryAfterCommit(db);\n1397:        await syncPermissionDirectoryAfterCommit(db);\n1465:        await reconcilePermissionDirectoryAfterCommit();\n1467:        await syncPermissionDirectoryAfterCommit(db);\n1548:    await reconcilePermissionDirectoryAfterCommit();\n1556:      await reconcilePermissionDirectoryAfterCommit();\n1558:      await syncPermissionDirectoryAfterCommit();\n  1125\t          error: String(error),\n  1126\t          operation: mutation.operation,\n  1127\t          resource: mutation.resource,\n  1128\t        });\n  1129\t      }\n  1130\t      return;\n  1131\t    }\n  1132\t    try {\n  1133\t      await syncDatafnPermissionGrantAfterCommit(\n  1134\t        committedDb,\n  1135\t        mutation,\n  1136\t        namespace,\n  1137\t        multiRegionRuntime,\n  1138\t      );\n  1139\t    } catch (error) {\n  1140\t      logger?.error(\"Permission directory reconciliation failed after commit\", {\n  1141\t        error: String(error),\n  1142\t        operation: mutation.operation,\n  1143\t        resource: mutation.resource,\n  1144\t      });\n  1145\t    }\n  1146\t  };\n  1147\t  const reconcilePermissionDirectoryAfterCommit = async () => {\n  1148\t    if (insideTransaction) {\n  1149\t      // External directory state must never observe the transaction adapter.\n  1150\t      // The enclosing transaction owner is the only layer that knows whether\n  1151\t      // the database committed or rolled back, so it must run reconciliation\n  1152\t      // against the settled outer adapter.\n  1153\t      if (deferPermissionDirectorySync) {\n  1154\t        deferPermissionDirectorySync(syncPermissionDirectoryAfterCommit);\n  1155\t      } else {\n  1156\t        logger?.error(\"Permission directory reconciliation requires settlement deferral\", {\n  1157\t          operation: mutation.operation,\n  1158\t          resource: mutation.resource,\n  1159\t        });\n  1160\t      }\n  1161\t      return;\n  1162\t    }\n  1163\t    await syncPermissionDirectoryAfterCommit();\n  1164\t  };\n  1165\t  // clientId and mutationId are optional. When absent, skip idempotency tracking.\n  1166\t  // EXE-009: Use crypto.randomUUID() for unpredictable anonymous mutation IDs\n  1167\t  const effectiveMutationId = mutation.mutationId || randomUUID();\n  1168\t\n  1169\t  // Check idempotency only when both IDs are provided\n  1170\t  if (mutation.clientId && mutation.mutationId) {\n  1171\t    const cached = await idempotencyStore.get(\n  1172\t      mutation.clientId,\n  1173\t      mutation.mutationId,\n  1174\t    );\n  1175\t    if (cached && !isRetryableMutationResult(cached)) {\n  1325\t        if (!txMutationResult.ok) {\n  1326\t          // A returned mutation failure is still an aborted transaction. Throw\n  1327\t          // after retaining the public result so adapters roll back relation\n  1328\t          // effects and change tracking together.\n  1329\t          throw { __datafnMutationFailed: true };\n  1330\t        }\n  1331\t      });\n  1332\t    } catch (err: any) {\n  1333\t      if (err?.__datafnGuardFailed) {\n  1334\t        guardFailed = true;\n  1335\t      } else if (!err?.__datafnMutationFailed) {\n  1336\t        // Transaction aborted for another reason\n  1337\t        txMutationResult = {\n  1338\t          ok: false,\n  1339\t          mutationId: effectiveMutationId,\n  1340\t          affectedIds: [],\n  1341\t          errors: [{ code: \"INTERNAL\", message: err?.message || \"Transaction failed\", path: \"$\", retryable: false }],\n  1342\t          deduped: false,\n  1343\t        };\n  1344\t      }\n  1345\t    }\n  1346\t\n  1347\t    if (guardFailed) {\n  1348\t      await releasePermissionDirectoryTask();\n  1349\t      if (permissionDirectoryTaskId) {\n  1350\t        await syncPermissionDirectoryAfterCommit(db);\n  1351\t      }\n  1352\t      const result: MutationResult = {\n  1353\t        ok: false,\n  1354\t        mutationId: effectiveMutationId,\n  1355\t        affectedIds: [],\n  1356\t        errors: [{ code: \"CONFLICT\", message: \"Guard condition not met\", path: \"if\", retryable: false }],\n  1357\t        deduped: false,\n  1358\t      };\n  1359\t      if (mutation.clientId && mutation.mutationId) {\n  1360\t        await idempotencyStore.set(mutation.clientId, mutation.mutationId, result);\n  1361\t      }\n  1362\t      return result;\n  1363\t    }\n  1364\t\n  1365\t    if (txMutationResult) {\n  1366\t      await releasePermissionDirectoryTask();\n  1367\t      if ((txMutationResult as MutationResult).ok) {\n  1368\t        await reconcilePermissionDirectoryAfterCommit();\n  1369\t      } else if (mutation.operation === \"unshare\") {\n  1370\t        // Fail-closed unshare invalidates the directory before the database\n  1371\t        // delete. A rolled-back transaction restores the grant, so restore its\n  1372\t        // directory entry from settled outer-adapter state as compensation.\n  1373\t        await syncPermissionDirectoryAfterCommit(db);\n  1374\t      }\n  1375\t      if (searchProvider && (txMutationResult as MutationResult).ok) {\n  1376\t        await tryUpdateSearchIndex(searchProvider, mutation, db, namespace, logger, multiRegionRuntime);\n  1377\t      }\n  1378\t      if (mutation.clientId && mutation.mutationId) {\n  1379\t        await idempotencyStore.set(mutation.clientId, mutation.mutationId, txMutationResult as MutationResult);\n  1380\t      }\n  1381\t      return txMutationResult as MutationResult;\n  1382\t    }\n  1383\t  } else if (hasGuard) {\n  1384\t    // No transaction available: evaluate guard outside transaction (TOCTOU possible but rare)\n  1385\t    const guardResult = await evaluateGuard(\n  1386\t      db,\n  1387\t      mutation.resource,\n  1388\t      mutation.id,\n  1389\t      mutation.if!,\n  1390\t      schema,\n  1391\t      namespace,\n  1392\t    );\n  1393\t\n  1394\t    if (!guardResult.match) {\n  1395\t      await releasePermissionDirectoryTask();\n  1396\t      if (permissionDirectoryTaskId) {\n  1397\t        await syncPermissionDirectoryAfterCommit(db);\n  1398\t      }\n  1399\t      const result: MutationResult = {\n  1400\t        ok: false,\n  1401\t        mutationId: effectiveMutationId,\n  1402\t        affectedIds: [],\n  1403\t        errors: [\n  1404\t          {\n  1405\t            code: \"CONFLICT\",\n  1406\t            message: \"Guard condition not met\",\n  1407\t            path: \"if\",\n  1408\t            retryable: false,\n  1409\t          },\n  1410\t        ],\n  1440\t          logger,\n  1441\t          multiRegionRuntime,\n  1442\t        );\n  1443\t        if (txMutationResult.ok && shouldQueuePermissionDirectorySync) {\n  1444\t          await queuePermissionDirectorySync(txDb);\n  1445\t        }\n  1446\t        if (!txMutationResult.ok) {\n  1447\t          throw { __datafnMutationFailed: true };\n  1448\t        }\n  1449\t      });\n  1450\t    } catch (err: any) {\n  1451\t      if (!err?.__datafnMutationFailed) {\n  1452\t        txMutationResult = {\n  1453\t          ok: false,\n  1454\t          mutationId: effectiveMutationId,\n  1455\t          affectedIds: [],\n  1456\t          errors: [{ code: \"INTERNAL\", message: err?.message || \"Transaction failed\", path: \"$\", retryable: false }],\n  1457\t          deduped: false,\n  1458\t        };\n  1459\t      }\n  1460\t    }\n  1461\t\n  1462\t    if (txMutationResult) {\n  1463\t      await releasePermissionDirectoryTask();\n  1464\t      if ((txMutationResult as MutationResult).ok) {\n  1465\t        await reconcilePermissionDirectoryAfterCommit();\n  1466\t      } else if (mutation.operation === \"unshare\") {\n  1467\t        await syncPermissionDirectoryAfterCommit(db);\n  1468\t      }\n  1469\t      if (searchProvider && (txMutationResult as MutationResult).ok) {\n  1470\t        await tryUpdateSearchIndex(searchProvider, mutation, db, namespace, logger, multiRegionRuntime);\n  1471\t      }\n  1472\t      if (mutation.clientId && mutation.mutationId) {\n  1473\t        await idempotencyStore.set(mutation.clientId, mutation.mutationId, txMutationResult as MutationResult);\n  1474\t      }\n  1475\t      return txMutationResult as MutationResult;\n  1476\t    }\n  1477\t  }\n  1478\t\n  1479\t  // REL-011: Execute operation + change tracking using executeMutationCore.\n  1480\t  // changeTracking.withDb(db) ensures the change tracking uses the same db as the\n  1540\t  } else {\n  1541\t    await releasePermissionDirectoryTask();\n  1542\t  }\n  1543\t\n  1544\t  if (result.ok) {\n  1545\t    if (insideTransaction && shouldQueuePermissionDirectorySync) {\n  1546\t      await queuePermissionDirectorySync(db);\n  1547\t    }\n  1548\t    await reconcilePermissionDirectoryAfterCommit();\n  1549\t  } else if (\n  1550\t    permissionDirectoryTaskId ||\n  1551\t    (multiRegionRuntime && mutation.operation === \"unshare\")\n  1552\t  ) {\n  1553\t    // Clear or repair against settled authoritative state. Outer transact\n  1554\t    // calls must defer this work until their enclosing transaction resolves.\n  1555\t    if (insideTransaction && deferPermissionDirectorySync) {\n  1556\t      await reconcilePermissionDirectoryAfterCommit();\n  1557\t    } else {\n  1558\t      await syncPermissionDirectoryAfterCommit();\n  1559\t    }\n  1560\t  }\n  1561\t\n  1562\t  if (searchProvider && result.ok) {\n  1563\t    await tryUpdateSearchIndex(searchProvider, mutation, db, namespace, logger, multiRegionRuntime);\n  1564\t  }\n  1565\t\n  1566\t  // Store for idempotency only when IDs were provided\n  1567\t  if (mutation.clientId && mutation.mutationId) {\n  1568\t    await idempotencyStore.set(mutation.clientId, mutation.mutationId, result);\n  1569\t  }\n  1570\t\n  1571\t  return result;\n  1572\t}\n"}],"internal_chat_message_metadata_passthrough":{"turn_id":"01a01efc-6d32-70b2-a5a3-6d2475cf5417","create_time":1787255016.003239}}}
