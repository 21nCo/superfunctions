# bash completion for demo, generated by @clifn/core. Works with bash 3.2 and later.

# Sets kind (none, flag, value or optional) and choices for the flag $2 as the subcommand path $1 defines it, or
# else its nearest ancestor that passes the flag down.
_clifn_demo_flag() {
  local p="$1"
  kind=none
  choices=''
  while [ "$kind" = none ]; do
    case "$p|$2" in
      '|--verbose'|'|-v') kind=flag ;;
      '|--format'|'|-f') kind=value; choices='text json' ;;
      '|--config') kind=value ;;
      'serve|--port'|'serve|-p') kind=value ;;
      'serve/start|--mode') kind=value; choices='dev prod' ;;
      'serve/start|--open'|'serve/start|-o') kind=optional; choices='chrome firefox' ;;
      'serve/stop|--force') kind=flag ;;
    esac
    if [ -z "$p" ]; then
      return 0
    fi
    case "$p" in
      */*) p="${p%/*}" ;;
      *) p='' ;;
    esac
  done
}

_clifn_demo() {
  local IFS=$' \t\n'
  local brk line known gap join word path opt eq kind choices cur rest words more p n i
  local -a w
  COMPREPLY=()
  # bash splits a word at ':' and '=' when COMP_WORDBREAKS holds them, and a run of them (as in 'a::b') is a part
  # of its own; join the parts of one word back up. A part made only of those characters, or one that follows such
  # a part, is joined when no blank comes before it on COMP_LINE (without COMP_LINE: always).
  brk=''
  case "$COMP_WORDBREAKS" in *:*) brk=':' ;; esac
  case "$COMP_WORDBREAKS" in *=*) brk="$brk=" ;; esac
  line="$COMP_LINE"
  known=0
  if [ -n "$line" ]; then
    known=1
  fi
  n=0
  i=0
  while [ "$i" -le "$COMP_CWORD" ]; do
    word="${COMP_WORDS[i]}"
    gap=0
    if [ "$known" = 1 ]; then
      rest="${line%%[![:blank:]]*}"
      line="${line#"$rest"}"
      if [ -n "$rest" ]; then
        gap=1
      fi
      case "$line" in
        "$word"*) line="${line#"$word"}" ;;
        *) known=0 ;;
      esac
    fi
    join=0
    if [ "$n" -ge 2 ] && [ "$gap" = 0 ] && [ -n "$brk" ]; then
      case "$word" in
        ''|*[!"$brk"]*) ;;
        *) join=1 ;;
      esac
      case "${w[n-1]}" in
        *:) case "$brk" in *:*) join=1 ;; esac ;;
        *=) case "$brk" in *=*) join=1 ;; esac ;;
      esac
    fi
    if [ "$join" = 1 ]; then
      w[n-1]="${w[n-1]}$word"
    else
      w[n]="$word"
      n=$((n + 1))
    fi
    i=$((i + 1))
  done
  cur="${w[n-1]}"
  # COMP_WORDS keeps the quotes and backslashes the user typed. No name can hold them, so the words before the
  # cursor are compared with them removed; nothing is evaluated.
  i=1
  while [ "$i" -lt $((n - 1)) ]; do
    word=${w[i]//\'/}
    word=${word//\"/}
    w[i]=${word//\\/}
    i=$((i + 1))
  done
  # Walk the words before the cursor: subcommands move the path, and a flag that reads a value skips it.
  path=''
  opt=''
  eq=''
  i=1
  while [ "$i" -lt $((n - 1)) ]; do
    word="${w[i]}"
    case "$word" in
      --)
        return 0
        ;;
      -*)
        _clifn_demo_flag "$path" "$word"
        case "$kind" in
          value|optional)
            if [ $((i + 1)) -eq $((n - 1)) ]; then
              opt="$word"
            fi
            case "$kind|${w[i+1]}" in
              'optional|-'*) ;;
              *) i=$((i + 1)) ;;
            esac
            ;;
        esac
        ;;
      *)
        case "$path|$word" in
          '|serve'|'|s') path='serve' ;;
          '|cache:clear') path='cache:clear' ;;
          'serve|start') path='serve/start' ;;
          'serve|stop'|'serve|halt') path='serve/stop' ;;
        esac
        ;;
    esac
    i=$((i + 1))
  done
  if [ -n "$opt" ]; then
    _clifn_demo_flag "$path" "$opt"
    # A flag whose value may be left out is followed by another flag here.
    case "$kind|$cur" in
      'optional|-'*) opt='' ;;
    esac
  fi
  if [ -z "$opt" ]; then
    case "$cur" in
      -*=*)
        opt="${cur%%=*}"
        eq="$opt="
        _clifn_demo_flag "$path" "$opt"
        ;;
    esac
  fi
  words=''
  if [ -n "$opt" ]; then
    # A flag's value: its choices, or bash's default completion when it has none.
    if [ "$kind" = none ] || [ "$kind" = flag ] || [ -z "$choices" ]; then
      return 0
    fi
    for word in $choices; do
      words="$words $eq$word"
    done
  else
    case "$cur" in
      -*)
        # The flags of this path, then those its ancestors pass down, nearest first.
        p="$path"
        while :; do
          case "$p" in
            '') more='--verbose -v --format -f --config' ;;
            'serve') more='--port -p' ;;
            'serve/start') more='--mode --open -o' ;;
            'serve/stop') more='--force' ;;
            *) more='' ;;
          esac
          for word in $more; do
            case " $words " in
              *" $word "*) ;;
              *) words="$words $word" ;;
            esac
          done
          if [ -z "$p" ]; then
            break
          fi
          case "$p" in
            */*) p="${p%/*}" ;;
            *) p='' ;;
          esac
        done
        ;;
      *)
        case "$path" in
          '') words='serve s cache:clear' ;;
          'serve') words='start stop halt' ;;
        esac
        ;;
    esac
  fi
  COMPREPLY=($(compgen -W "$words" -- "$cur"))
  # Readline replaces only the text after the last ':' or '=' it split at, so drop what comes before it.
  case "$brk" in
    ':=') rest="${cur##*[=:]}" ;;
    ':') rest="${cur##*:}" ;;
    '=') rest="${cur##*=}" ;;
    *) rest="$cur" ;;
  esac
  if [ "$rest" != "$cur" ]; then
    word="${cur%"$rest"}"
    i=0
    while [ "$i" -lt ${#COMPREPLY[@]} ]; do
      COMPREPLY[i]="${COMPREPLY[i]#"$word"}"
      i=$((i + 1))
    done
  fi
  return 0
}

complete -o default -F _clifn_demo demo
