{
  "description": "Credential injection. Credentials are keyed by security scheme. Each request uses the first alternative in catalog order whose credentials are all configured; with none it is sent without credentials, and an anonymous operation never sends any. Basic credentials are { username, password }.",
  "cases": [
    {
      "name": "bearer token",
      "operation": "tasks.replace",
      "parameters": { "path": { "projectId": "p1", "taskId": "t1" } },
      "body": { "title": "x" },
      "credentials": { "bearerAuth": "token-1" },
      "expect": { "headers": { "authorization": "Bearer token-1" }, "absentHeaders": ["x-api-key"], "query": "" }
    },
    {
      "name": "the first satisfiable alternative in catalog order wins",
      "operation": "tasks.list",
      "parameters": { "path": { "projectId": "p1" } },
      "credentials": { "bearerAuth": "token-1", "apiKeyHeader": "key-1" },
      "expect": { "headers": { "x-api-key": "key-1" }, "absentHeaders": ["authorization"], "query": "" }
    },
    {
      "name": "a later alternative when the first lacks credentials",
      "operation": "tasks.list",
      "parameters": { "path": { "projectId": "p1" } },
      "credentials": { "bearerAuth": "token-1" },
      "expect": { "headers": { "authorization": "Bearer token-1" }, "absentHeaders": ["x-api-key"], "query": "" }
    },
    {
      "name": "API key in the query",
      "operation": "tasks.get",
      "parameters": { "path": { "projectId": "p1", "taskId": "t1" } },
      "credentials": { "apiKeyQuery": "q key&1" },
      "expect": { "headers": {}, "absentHeaders": ["authorization", "x-api-key"], "query": "key=q%20key%261" }
    },
    {
      "name": "HTTP Basic",
      "operation": "tasks.export",
      "parameters": { "path": { "projectId": "p1" } },
      "credentials": { "basicAuth": { "username": "ada", "password": "pä:ss" } },
      "expect": { "headers": { "authorization": "Basic YWRhOnDDpDpzcw==" }, "query": "" }
    },
    {
      "name": "an anonymous operation sends no credentials",
      "operation": "system.health",
      "parameters": {},
      "credentials": { "bearerAuth": "token-1", "apiKeyHeader": "key-1" },
      "expect": { "headers": {}, "absentHeaders": ["authorization", "x-api-key"], "query": "" }
    },
    {
      "name": "no satisfiable alternative sends no credentials",
      "operation": "tasks.create",
      "parameters": { "path": { "projectId": "p1" } },
      "body": { "title": "x" },
      "credentials": { "apiKeyHeader": "key-1" },
      "expect": { "headers": {}, "absentHeaders": ["authorization", "x-api-key"], "query": "" }
    }
  ]
}
