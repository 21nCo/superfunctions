{
  "description": "Credential injection. Credentials are keyed by security scheme. Each request uses the first credentialed alternative in catalog order whose credentials are all configured; an anonymous alternative ({} in the spec, [] in the catalog) is used only when no credentialed one is satisfied, so optional authentication still sends configured credentials. With none satisfied the request is sent without credentials, and an anonymous-only operation never sends any. Basic credentials are { username, password }. A credential is the only value sent under its name: an API key replaces a header parameter with the same name (ignoring case); a query API key drops every wire query pair whose decoded name is the credential name or a deepObject member of it (name[...]), whatever style formed it (a form-exploded object member, or '&' and '=' kept by allowReserved), and is sent after the remaining pairs. A required query or header parameter with an API key's name may be omitted when the applied credentials supply it; otherwise omitting it is a validation error before anything is sent (rejected cases).",
  "cases": [
    {
      "name": "bearer token",
      "operation": "tasks.replace",
      "parameters": { "path": { "projectId": "p1", "taskId": "t1" } },
      "body": { "title": "x" },
      "credentials": { "bearerAuth": "token-1" },
      "expect": { "headers": { "authorization": "Bearer token-1" }, "absentHeaders": ["x-api-key"], "query": "" }
    },
    {
      "name": "the first satisfiable alternative in catalog order wins",
      "operation": "tasks.list",
      "parameters": { "path": { "projectId": "p1" } },
      "credentials": { "bearerAuth": "token-1", "apiKeyHeader": "key-1" },
      "expect": { "headers": { "x-api-key": "key-1" }, "absentHeaders": ["authorization"], "query": "" }
    },
    {
      "name": "a later alternative when the first lacks credentials",
      "operation": "tasks.list",
      "parameters": { "path": { "projectId": "p1" } },
      "credentials": { "bearerAuth": "token-1" },
      "expect": { "headers": { "authorization": "Bearer token-1" }, "absentHeaders": ["x-api-key"], "query": "" }
    },
    {
      "name": "API key in the query",
      "operation": "tasks.get",
      "parameters": { "path": { "projectId": "p1", "taskId": "t1" } },
      "credentials": { "apiKeyQuery": "q key&1" },
      "expect": { "headers": {}, "absentHeaders": ["authorization", "x-api-key"], "query": "key=q%20key%261" }
    },
    {
      "name": "HTTP Basic",
      "operation": "tasks.export",
      "parameters": { "path": { "projectId": "p1" } },
      "credentials": { "basicAuth": { "username": "ada", "password": "pä:ss" } },
      "expect": { "headers": { "authorization": "Basic YWRhOnDDpDpzcw==" }, "query": "" }
    },
    {
      "name": "an anonymous operation sends no credentials",
      "operation": "system.health",
      "parameters": {},
      "credentials": { "bearerAuth": "token-1", "apiKeyHeader": "key-1" },
      "expect": { "headers": {}, "absentHeaders": ["authorization", "x-api-key"], "query": "" }
    },
    {
      "name": "optional authentication sends configured credentials",
      "operation": "projects.summary.get",
      "parameters": { "path": { "projectId": "p1" } },
      "credentials": { "bearerAuth": "token-1" },
      "expect": { "headers": { "authorization": "Bearer token-1" }, "query": "" }
    },
    {
      "name": "optional authentication without credentials is anonymous",
      "operation": "projects.summary.get",
      "parameters": { "path": { "projectId": "p1" } },
      "credentials": { "apiKeyHeader": "key-1" },
      "expect": { "headers": {}, "absentHeaders": ["authorization", "x-api-key"], "query": "" }
    },
    {
      "name": "no satisfiable alternative sends no credentials",
      "operation": "tasks.create",
      "parameters": { "path": { "projectId": "p1" } },
      "body": { "title": "x" },
      "credentials": { "apiKeyHeader": "key-1" },
      "expect": { "headers": {}, "absentHeaders": ["authorization", "x-api-key"], "query": "" }
    },
    {
      "name": "a query API key replaces a query parameter with its name",
      "operation": "tasks.lookup",
      "parameters": { "path": { "projectId": "p1" }, "query": { "key": "stale", "q": "x" } },
      "credentials": { "apiKeyQuery": "injected" },
      "expect": { "headers": {}, "absentHeaders": ["x-api-key"], "query": "q=x&key=injected" }
    },
    {
      "name": "a query API key replaces a form-exploded object member with its name",
      "operation": "tasks.lookup",
      "parameters": { "path": { "projectId": "p1" }, "query": { "match": { "key": "stale", "a": "1" } } },
      "credentials": { "apiKeyQuery": "injected" },
      "expect": { "headers": {}, "query": "a=1&key=injected" }
    },
    {
      "name": "a header API key replaces a header parameter with its name and leaves query parameters alone",
      "operation": "tasks.lookup",
      "parameters": { "path": { "projectId": "p1" }, "query": { "key": "k1" }, "header": { "X-Api-Key": "stale" } },
      "credentials": { "apiKeyHeader": "injected" },
      "expect": { "headers": { "x-api-key": "injected" }, "query": "key=k1" }
    },
    {
      "name": "parameters named like a credential are sent when no credential applies",
      "operation": "tasks.lookup",
      "parameters": { "path": { "projectId": "p1" }, "query": { "key": "k1" }, "header": { "X-Api-Key": "h1" } },
      "credentials": {},
      "expect": { "headers": { "x-api-key": "h1" }, "query": "key=k1" }
    },
    {
      "name": "a query API key drops a pair an allowReserved value forms with its name",
      "operation": "tasks.lookup",
      "parameters": { "path": { "projectId": "p1" }, "query": { "raw": "x&key=stale" } },
      "credentials": { "apiKeyQuery": "injected" },
      "expect": { "headers": {}, "query": "raw=x&key=injected" }
    },
    {
      "name": "a query API key drops a percent-encoded pair name that decodes to its name",
      "operation": "tasks.lookup",
      "parameters": { "path": { "projectId": "p1" }, "query": { "raw": "x&k%65y=stale" } },
      "credentials": { "apiKeyQuery": "injected" },
      "expect": { "headers": {}, "query": "raw=x&key=injected" }
    },
    {
      "name": "a query API key drops deepObject members of a parameter with its name",
      "operation": "tasks.filter",
      "parameters": { "path": { "projectId": "p1" }, "query": { "key": { "a": "stale", "b": "2" } } },
      "credentials": { "apiKeyQuery": "injected" },
      "expect": { "headers": {}, "query": "key=injected" }
    },
    {
      "name": "a required query parameter a query API key supplies may be omitted",
      "operation": "tasks.find",
      "parameters": { "path": { "projectId": "p1" }, "header": { "x-api-key": "h1" } },
      "credentials": { "apiKeyQuery": "injected" },
      "expect": { "headers": { "x-api-key": "h1" }, "query": "key=injected" }
    },
    {
      "name": "a required header parameter a header API key supplies may be omitted",
      "operation": "tasks.find",
      "parameters": { "path": { "projectId": "p1" }, "query": { "key": "k1" } },
      "credentials": { "apiKeyHeader": "injected" },
      "expect": { "headers": { "x-api-key": "injected" }, "query": "key=k1" }
    }
  ],
  "rejected": [
    {
      "name": "a required parameter named like an API key without credentials",
      "operation": "tasks.find",
      "parameters": { "path": { "projectId": "p1" }, "header": { "x-api-key": "h1" } },
      "credentials": {},
      "kind": "validation"
    },
    {
      "name": "a required query parameter when the applied credential is a header API key",
      "operation": "tasks.find",
      "parameters": { "path": { "projectId": "p1" } },
      "credentials": { "apiKeyHeader": "injected" },
      "kind": "validation"
    },
    {
      "name": "a required header parameter when the applied credential is a query API key",
      "operation": "tasks.find",
      "parameters": { "path": { "projectId": "p1" } },
      "credentials": { "apiKeyQuery": "injected" },
      "kind": "validation"
    }
  ]
}
