{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apifn:schema:release-descriptor:v1",
  "title": "ApiFn release descriptor v1",
  "description": "One release of generated artifacts for a catalog. Version axes are separate: descriptorVersion, api.version, specDigest, manifestDigest, catalogDigest, generator.version, each artifact package version and releaseId.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "descriptorVersion": {"const": "apifn.release-descriptor/v1"},
    "releaseId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9._@+-]{0,127}$"},
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        }
      },
      "required": ["id", "version"]
    },
    "catalogDigest": {"type": "string", "minLength": 1, "pattern": "^sha256:[0-9a-f]{64}$"},
    "specDigest": {"type": "string", "minLength": 1, "pattern": "^sha256:[0-9a-f]{64}$"},
    "manifestDigest": {"type": "string", "minLength": 1, "pattern": "^sha256:[0-9a-f]{64}$"},
    "generator": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string", "minLength": 1, "maxLength": 214, "pattern": "^(?:@[a-z0-9][a-z0-9._~-]*\\/)?[A-Za-z0-9][A-Za-z0-9._~-]*$"},
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
        }
      },
      "required": ["name", "version"]
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "kind": {"enum": ["sdk", "agent-tools"]},
          "target": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-z][a-z0-9-]*$"},
          "package": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {"type": "string", "minLength": 1, "maxLength": 214, "pattern": "^(?:@[a-z0-9][a-z0-9._~-]*\\/)?[A-Za-z0-9][A-Za-z0-9._~-]*$"},
              "version": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
              }
            },
            "required": ["name", "version"]
          },
          "operations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)*$"
            }
          }
        },
        "required": ["kind", "target", "package", "operations"]
      }
    }
  },
  "required": [
    "descriptorVersion",
    "releaseId",
    "api",
    "catalogDigest",
    "specDigest",
    "manifestDigest",
    "generator",
    "artifacts"
  ]
}
