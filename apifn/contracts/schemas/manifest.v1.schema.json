{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:apifn:schema:manifest:v1",
  "title": "ApiFn companion manifest v1",
  "description": "Stable API and operation identity, naming, target exclusions, deprecation, serialization, provenance and execution-policy references for an OpenAPI document. validateManifest is authoritative and additionally checks HTTP methods and supported media types.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "manifestVersion": {"const": 1},
    "api": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        }
      },
      "required": ["id", "version"]
    },
    "serialization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mediaTypes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 128}
        }
      },
      "required": ["mediaTypes"]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {"type": "string", "minLength": 1, "maxLength": 512},
        "revision": {"type": "string", "minLength": 1, "maxLength": 128},
        "exporter": {"type": "string", "minLength": 1, "maxLength": 128}
      }
    },
    "operations": {"type": "array", "items": {"$ref": "#/$defs/binding"}}
  },
  "required": ["manifestVersion", "api", "operations"],
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)*$"
        },
        "operationId": {"type": "string", "minLength": 1, "maxLength": 256},
        "method": {"type": "string", "minLength": 1, "maxLength": 256},
        "path": {"type": "string", "minLength": 1, "maxLength": 1024, "pattern": "^/"},
        "name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z][A-Za-z0-9_]*$"},
        "sdk": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "include": {"type": "boolean"},
            "excludeTargets": {
              "type": "array",
              "items": {"type": "string", "minLength": 1, "maxLength": 32, "pattern": "^[a-z][a-z0-9-]*$"}
            }
          }
        },
        "agent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {"expose": {"type": "boolean"}}
        },
        "deprecation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "replacement": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[a-z][A-Za-z0-9]*(?:\\.[a-z][A-Za-z0-9]*)*$"
            },
            "since": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
            },
            "message": {"type": "string", "minLength": 1, "maxLength": 1024}
          }
        },
        "executionPolicy": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]*$"
        }
      },
      "required": ["id"],
      "oneOf": [
        {
          "required": ["operationId"],
          "not": {"anyOf": [{"required": ["method"]}, {"required": ["path"]}]}
        },
        {"required": ["method", "path"], "not": {"required": ["operationId"]}}
      ]
    }
  }
}
