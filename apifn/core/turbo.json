{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/apifn/collections/package.json"]
    },
    "test": {
      "dependsOn": ["^build", "build", "@apifn/collections#build"]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apifn/collections/package.json",
        "$TURBO_ROOT$/apifn/collections/src/**"
      ]
    }
  }
}
