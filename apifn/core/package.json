{
  "name": "@apifn/core",
  "version": "0.1.2",
  "description": "Core library for ApiFn — route introspection, schema conversion, OpenAPI generation, and diff",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./testfn": {
      "import": {
        "types": "./dist/testfn.d.ts",
        "default": "./dist/testfn.js"
      },
      "require": {
        "types": "./dist/testfn.d.cts",
        "default": "./dist/testfn.cjs"
      }
    }
  },
  "scripts": {
    "build": "tsup && node scripts/fix-testfn-cjs-types.mjs",
    "dev": "tsup --watch",
    "test": "vitest run && node scripts/verify-packed-consumer.mjs",
    "lint": "tsc --noEmit",
    "verify:packed": "node scripts/verify-packed-consumer.mjs"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "yaml": "^2.8.1",
    "zod": "^3.25.28",
    "zod-to-json-schema": "^3.24.6"
  },
  "peerDependencies": {
    "@sinclair/typebox": "*",
    "@superfunctions/http": ">=0.2.0 <0.4.0",
    "@testfn/core": ">=0.0.2 <0.1.0"
  },
  "peerDependenciesMeta": {
    "@sinclair/typebox": {
      "optional": true
    },
    "@superfunctions/http": {
      "optional": false
    },
    "@testfn/core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sinclair/typebox": "^0.34.41",
    "@superfunctions/http": "0.3.1",
    "@testfn/core": "0.0.4",
    "@types/node": "^20.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.3.0",
    "vitest": "^3.2.4"
  },
  "author": "21n",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/superfunctions.git",
    "directory": "apifn/core"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ]
}
