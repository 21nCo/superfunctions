{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/release-packages.json",
        "$TURBO_ROOT$/billfn/*/package.json",
        "$TURBO_ROOT$/datafn/**",
        "!$TURBO_ROOT$/datafn/**/node_modules/**",
        "!$TURBO_ROOT$/datafn/**/.next/**",
        "!$TURBO_ROOT$/datafn/**/dist/**",
        "!$TURBO_ROOT$/datafn/**/.turbo/**",
        "$TURBO_ROOT$/searchfn/**",
        "!$TURBO_ROOT$/searchfn/**/node_modules/**",
        "!$TURBO_ROOT$/searchfn/**/.next/**",
        "!$TURBO_ROOT$/searchfn/**/dist/**",
        "!$TURBO_ROOT$/searchfn/**/.turbo/**",
        "$TURBO_ROOT$/hostfn/**",
        "!$TURBO_ROOT$/hostfn/**/node_modules/**",
        "!$TURBO_ROOT$/hostfn/**/.next/**",
        "!$TURBO_ROOT$/hostfn/**/dist/**",
        "!$TURBO_ROOT$/hostfn/**/.turbo/**"
      ]
    },
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/datafn/**",
        "!$TURBO_ROOT$/datafn/**/node_modules/**",
        "!$TURBO_ROOT$/datafn/**/.next/**",
        "!$TURBO_ROOT$/datafn/**/dist/**",
        "!$TURBO_ROOT$/datafn/**/.turbo/**",
        "$TURBO_ROOT$/searchfn/**",
        "!$TURBO_ROOT$/searchfn/**/node_modules/**",
        "!$TURBO_ROOT$/searchfn/**/.next/**",
        "!$TURBO_ROOT$/searchfn/**/dist/**",
        "!$TURBO_ROOT$/searchfn/**/.turbo/**",
        "$TURBO_ROOT$/hostfn/**",
        "!$TURBO_ROOT$/hostfn/**/node_modules/**",
        "!$TURBO_ROOT$/hostfn/**/.next/**",
        "!$TURBO_ROOT$/hostfn/**/dist/**",
        "!$TURBO_ROOT$/hostfn/**/.turbo/**",
        "$TURBO_ROOT$/release-packages.json",
        "$TURBO_ROOT$/billfn/*/package.json"
      ]
    }
  }
}
