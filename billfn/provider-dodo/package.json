{
  "name": "@billfn/provider-dodo",
  "version": "0.9.1",
  "description": "Dodo provider adapter for billfn",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "author": "21n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/superfunctions.git",
    "directory": "billfn/provider-dodo"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@billfn/core": "^0.8.0",
    "@superfunctions/webhooks": "^0.1.0"
  },
  "devDependencies": {
    "@superfunctions/db": "0.3.4",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
