{
  "name": "@billfn/swift-bridge",
  "version": "0.0.2",
  "type": "module",
  "description": "WKWebView bridge primitives for native-backed BillFn clients",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/superfunctions.git",
    "directory": "billfn/swift-bridge"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
