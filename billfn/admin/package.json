{
  "name": "@billfn/admin",
  "version": "0.8.1",
  "description": "Function-owned Super Console administration capability for BillFn",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "billfn",
    "admin",
    "super-console",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/superfunctions.git",
    "directory": "billfn/admin"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@billfn/core": "0.7.1"
  },
  "peerDependencies": {
    "@superfunctions/admin": "^0.1.4"
  },
  "devDependencies": {
    "@superfunctions/admin": "^0.1.4",
    "@superfunctions/db": "0.3.3",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
