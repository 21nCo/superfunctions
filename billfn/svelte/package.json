{
  "name": "@billfn/svelte",
  "version": "0.7.1",
  "description": "Svelte wrappers for billfn client",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "npm run clean && tsc",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "author": "21n",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/superfunctions.git",
    "directory": "billfn/svelte"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@billfn/client": "^0.7.0",
    "@billfn/core": "^0.7.0",
    "svelte": "^5.0.0"
  },
  "devDependencies": {
    "@billfn/client": "^0.7.0",
    "@billfn/core": "^0.7.0",
    "@types/node": "^22.0.0",
    "svelte": "^5.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
