{
  "name": "docs",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "next dev -p 6010",
    "predev": "node ./scripts/ensure-styled-jsx.mjs && npx fumadocs-mdx",
    "prebuild": "npm run build --workspace=@superfunctions/docs-theme && node ./scripts/ensure-styled-jsx.mjs && npx fumadocs-mdx",
    "build": "next build",
    "start": "next start",
    "check:coverage": "tsx ./scripts/check-docs-catalog.mjs",
    "check:catalog": "tsx ./scripts/check-docs-catalog.mjs",
    "check:content": "tsx ./scripts/check-docs-content.mjs",
    "check:snippets": "node ./scripts/check-snippets.mjs",
    "check:links": "node ./scripts/check-links.mjs"
  },
  "dependencies": {
    "@21n/fonts": "^1.0.1",
    "@superfunctions/docs-theme": "*",
    "@tailwindcss/postcss": "^4",
    "fumadocs-core": "^15",
    "fumadocs-mdx": "^11.10.1",
    "fumadocs-ui": "^15",
    "lightningcss": "^1.31.1",
    "lucide-react": "^0.575.0",
    "mermaid": "^11.12.3",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "styled-jsx": "5.1.6"
  },
  "devDependencies": {
    "@types/mdx": "^2",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "autoprefixer": "^10",
    "postcss": "^8",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
