{
  "name": "logfn",
  "version": "0.0.1",
  "description": "Structured logging for browser and server with pluggable pipelines and transports",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./http/express": {
      "types": "./dist/http/express.d.ts",
      "default": "./dist/http/express.js"
    },
    "./http/fastify": {
      "types": "./dist/http/fastify.d.ts",
      "default": "./dist/http/fastify.js"
    },
    "./http/hono": {
      "types": "./dist/http/hono.d.ts",
      "default": "./dist/http/hono.js"
    },
    "./http/watch": {
      "types": "./dist/http/watch.d.ts",
      "default": "./dist/http/watch.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "lint": "echo 'lint not configured'",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "bench": "vitest bench"
  },
  "keywords": [
    "logging",
    "logger",
    "structured-logging",
    "observability",
    "superfunctions"
  ],
  "author": "21n",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/21nCo/super-functions/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/21nCo/super-functions.git",
    "directory": "logfn"
  },
  "publishConfig": {
    "access": "public"
  },
  "superfunctions": {
    "initFunction": "logFn",
    "schemaVersion": 1,
    "namespace": "logfn"
  },
  "peerDependencies": {
    "@superfunctions/http": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "@superfunctions/http": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@superfunctions/http": "^0.1.0",
    "typescript": "^5.6.0",
    "vitest": "^3.2.4"
  }
}
