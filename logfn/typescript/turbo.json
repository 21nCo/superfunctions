{
  "$schema": "https://turbo.build/schema.json",
  "extends": ["//"],
  "tasks": {
    "typecheck": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/logfn/python/**",
        "!$TURBO_ROOT$/logfn/python/**/__pycache__/**",
        "!$TURBO_ROOT$/logfn/python/**/.pytest_cache/**",
        "!$TURBO_ROOT$/logfn/python/**/.venv/**"
      ]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/logfn/python/**",
        "!$TURBO_ROOT$/logfn/python/**/__pycache__/**",
        "!$TURBO_ROOT$/logfn/python/**/.pytest_cache/**",
        "!$TURBO_ROOT$/logfn/python/**/.venv/**"
      ]
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/logfn/python/**",
        "!$TURBO_ROOT$/logfn/python/**/__pycache__/**",
        "!$TURBO_ROOT$/logfn/python/**/.pytest_cache/**",
        "!$TURBO_ROOT$/logfn/python/**/.venv/**"
      ]
    }
  }
}
